<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="{{ asset('assets/img/logoTeamT.png') }}">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ asset('assets/css/sidebar.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/forms.css') }}">
        <link rel="stylesheet" href="{{ asset('assets/css/main.css') }}">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
        <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/chosen.css') }}" />
        <style>
            .ui-filter-card {
                background: #ffffff;
                border: 1px solid #e5eceb;
                border-radius: 14px;
                box-shadow: 0 10px 28px rgba(19, 44, 43, 0.1);
                padding: 1rem;
                margin-bottom: 1rem;
            }

            .ui-filter-card .form-label {
                color: #647079;
                font-size: 0.8rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.35px;
                margin-bottom: 0.35rem;
            }

            .ui-filter-card .form-control,
            .ui-filter-card .form-select,
            .ui-filter-card .btn {
                height: 40px;
                border-radius: 10px;
            }

            .ui-filter-card .form-control,
            .ui-filter-card .form-select {
                border-color: #d9e4e2;
                box-shadow: none;
            }

            .ui-filter-card .form-control:focus,
            .ui-filter-card .form-select:focus {
                border-color: #849d9a;
                box-shadow: 0 0 0 0.2rem rgba(132, 157, 154, 0.16);
            }

            .actions-group {
                display: inline-flex;
                gap: 0.3rem;
                flex-wrap: nowrap;
                align-items: center;
            }

            .actions-group .btn {
                border-radius: 8px;
                width: 38px !important;
                min-width: 38px !important;
                height: 38px !important;
                padding: 0.2rem;
                flex-shrink: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .actions-group form {
                display: inline-flex;
                margin: 0;
            }

            td .actions-group {
                white-space: nowrap;
            }

            .ui-filter-card .btn-outline-secondary {
                border-color: #d9e4e2;
                color: #556067;
            }

            .ui-filter-card .btn-outline-secondary:hover {
                background: #f1f6f5;
                color: #3f4a50;
                border-color: #cfdcda;
            }

            /* Botones de acción solo icono en tablas: tamaño estándar */
            .btn-action-icon {
                width: 38px;
                min-width: 38px;
                height: 30px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }
        </style>
    {% endblock %}
</head>
<body>
    <div class="d-flex" id="wrapper">
        {% if app.user %}
            {{ include('_sidebar.html.twig') }}
        {% endif %}
        <div id="page-content-wrapper">
            <div class="container-fluid p-0">
                {% if app.user %}
                <div class="row g-0">
                    <div class="col-12">
                        <h1 class="title">
                            {% block panelTitle %}{% endblock %}
                        </h1>
                    </div>
                </div>
                {% endif %}
                <div class="row g-0">
                    <div class="container">
                        {% block body %}{% endblock %}
                    </div>
                </div>
                <div class="align-items-center justify-content-center d-flex">
                    {% block centeredBody %}{% endblock %}
                </div>
            </div>
        </div>
    </div>
    {# Mostrar mensajes flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success toast-custom">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger toast-custom">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning toast-custom">
            <strong>⚠️ Advertencia:</strong> {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info toast-custom">
            <strong>ℹ️ Información:</strong> {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('banner') %}
        <div class="alert alert-info toast-custom">
            <strong>ℹ️ Información:</strong> {{ message }}
        </div>
    {% endfor %}
    {{ include('components/loading.html.twig') }}
{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script type="text/javascript" src="{{ asset('assets/js/main.js') }}"></script>
    <script type="text/javascript" src="{{ asset('assets/js/chosen.jquery.min.js') }}"></script>
    <script src="{{ asset('js/alumno-cursos.js') }}"></script>

    <script>
        // Locale global para unificar los calendarios en español.
        if (typeof moment !== 'undefined') {
            moment.locale('es');
        }

        window.getDateRangePickerLocale = function(fmt) {
            return {
                format: fmt,
                applyLabel: 'Aplicar',
                cancelLabel: 'Cancelar',
                fromLabel: 'Desde',
                toLabel: 'Hasta',
                customRangeLabel: 'Personalizado',
                weekLabel: 'S',
                daysOfWeek: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
                monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
                firstDay: 1
            };
        };

        // Forzar locale en español en date inputs nativos.
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[type="date"]').forEach(function(input) {
                if (!input.getAttribute('lang')) {
                    input.setAttribute('lang', 'es-AR');
                }
            });
        });

        document.addEventListener('DOMContentLoaded', (event) => {
            const toastMessages = document.querySelectorAll('.toast-custom');

            toastMessages.forEach((toast) => {
                // Determinar tiempo de visualización según el tipo de mensaje
                let fadeOutTime = 3000; // Por defecto 3 segundos
                let removeTime = 4000;
                
                // Los mensajes de warning e info duran más tiempo para que el usuario los vea
                if ((toast.classList.contains('alert-warning') || toast.classList.contains('alert-info')) && !toast.classList.contains('banner-custom')) {
                    fadeOutTime = 10000; // 10 segundos antes de empezar a desaparecer
                    removeTime = 12000; // 12 segundos total antes de remover
                }
                
                // No aplicar fade a banner-custom
                if (!toast.classList.contains('banner-custom')) {
                    // Tiempo de espera antes de que el mensaje empiece a desaparecer
                    setTimeout(() => {
                        toast.classList.add('fade-out');
                    }, fadeOutTime);

                    // Tiempo total para remover el elemento del DOM, después de fade-in
                    setTimeout(() => {
                        if (toast.parentNode) {
                            toast.parentNode.removeChild(toast);
                        }
                    }, removeTime);
                }
            });
        });

        // Fix para el problema de doble clic en confirm()
        document.addEventListener('DOMContentLoaded', function() {
            // Encontrar todos los formularios con confirm
            const formsWithConfirm = document.querySelectorAll('form[onsubmit*="confirm"]');
            
            formsWithConfirm.forEach(function(form) {
                // Guardar el onsubmit original
                const originalOnsubmit = form.getAttribute('onsubmit');
                
                // Remover el atributo onsubmit para evitar que se ejecute
                form.removeAttribute('onsubmit');
                
                // Agregar un event listener que lo reemplace
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Ocultar el spinner por si se mostró
                    if (window.hideLoading) {
                        window.hideLoading();
                    }
                    
                    // Extraer el mensaje del confirm
                    const match = originalOnsubmit.match(/confirm\(['"](.+?)['"]\)/);
                    const message = match ? match[1] : '¿Está seguro?';
                    
                    // Mostrar el confirm una sola vez
                    if (confirm(message)) {
                        // Mostrar el spinner de nuevo antes de enviar
                        if (window.showLoading) {
                            window.showLoading();
                        }
                        // Enviar el formulario sin el event listener
                        form.removeEventListener('submit', arguments.callee);
                        form.submit();
                    }
                }, true);
            });
        });

        $(document).ready(function(){
            $("[data-toggle=tooltip]").tooltip({ placement: function(tooltip, link) {
                return $(link).data('placement') || 'right';
            }});

            // Inicialización global de Chosen para selectores
            // Nota: Chosen.js puede causar "Violation" warnings por event listeners no pasivos
            // Estos warnings no afectan la funcionalidad pero pueden aparecer en la consola
            if ($.fn.chosen) {
                // Inicializar todos los campos chosen-select
                $(".chosen-select").chosen({
                    no_results_text: "No se encontraron resultados para: ",
                    placeholder_text_multiple: "Seleccione opciones",
                    placeholder_text_single: "Seleccione una opción",
                    width: "100%",
                    search_contains: true,                // Permite búsqueda dentro del texto, no solo al principio
                    enable_search_threshold: 5,           // Mostrar búsqueda cuando hay más de 5 opciones
                    disable_search_threshold: 0           // Nunca deshabilitar la búsqueda
                });
            }
        });
    </script>
{% endblock %}
</body>
</html>