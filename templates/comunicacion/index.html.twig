{% extends 'base.html.twig' %}

{% block title %}Comunicaciones{% endblock %}

{% block panelTitle %}Comunicaciones{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <div class="row">
        <div class="col-lg-9">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-megaphone"></i> Enviar una comunicación</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Un aviso por email a varios alumn@s de una vez: un cambio de precio, un cambio
                        de horario, una clase que no se da. Cada envío queda registrado en el
                        <a href="{{ path('app_email_log_index') }}">Historial de Emails</a>.
                    </p>

                    <form method="post" action="{{ path('app_comunicacion_enviar') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('comunicacion_enviar') }}">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">¿A quiénes?</label>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="destino" id="destino_instituto"
                                       value="instituto" {% if destinoPrevio not in ['curso', 'deudores', 'seleccion'] %}checked{% endif %}>
                                <label class="form-check-label" for="destino_instituto">
                                    Todos los alumn@s del instituto
                                    <span class="badge bg-secondary">{{ conteos.instituto }}</span>
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="destino" id="destino_curso"
                                       value="curso" {% if destinoPrevio == 'curso' %}checked{% endif %}>
                                <label class="form-check-label" for="destino_curso">Los alumn@s de un curso</label>
                            </div>

                            <div class="ms-4 mb-2">
                                <select class="form-select" name="curso" id="curso_select">
                                    <option value="">Elegí un curso…</option>
                                    {% for curso in cursos %}
                                        <option value="{{ curso.id }}" {% if cursoPrevio == curso.id %}selected{% endif %}>
                                            {{ curso.nombre }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="destino" id="destino_deudores"
                                       value="deudores" {% if destinoPrevio == 'deudores' %}checked{% endif %}>
                                <label class="form-check-label" for="destino_deudores">
                                    Los alumn@s con cuotas vencidas
                                    <span class="badge bg-warning text-dark">{{ conteos.deudores }}</span>
                                </label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="destino" id="destino_seleccion"
                                       value="seleccion" {% if destinoPrevio == 'seleccion' %}checked{% endif %}>
                                <label class="form-check-label" for="destino_seleccion">
                                    Alumn@s elegid@s de a uno
                                    <span class="badge bg-primary" id="contador_seleccion">0</span>
                                </label>
                            </div>

                            <div class="ms-4 mb-2" id="caja_seleccion">
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control" id="filtro_alumnos"
                                           placeholder="Buscar por nombre, apellido o email…" autocomplete="off">
                                    <button type="button" class="btn btn-outline-secondary" id="marcar_visibles">
                                        Marcar los que se ven
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" id="desmarcar_todos">
                                        Desmarcar todo
                                    </button>
                                </div>

                                <div class="border rounded" style="max-height: 16rem; overflow-y: auto;" id="lista_alumnos">
                                    {% for alumno in alumnos %}
                                        <label class="d-flex align-items-center gap-2 px-2 py-1 fila-alumno mb-0"
                                               data-busqueda="{{ (alumno.apellido ~ ' ' ~ alumno.nombre ~ ' ' ~ (alumno.email ?: ''))|lower }}">
                                            <input class="form-check-input mt-0 check-alumno" type="checkbox"
                                                   name="alumnos[]" value="{{ alumno.id }}">
                                            <span>
                                                {{ alumno.apellido }}, {{ alumno.nombre }}
                                                {% if alumno.email %}
                                                    <span class="text-muted small">{{ alumno.email }}</span>
                                                {% else %}
                                                    <span class="badge bg-warning text-dark">sin email</span>
                                                {% endif %}
                                            </span>
                                        </label>
                                    {% else %}
                                        <p class="text-muted small m-2">No hay alumn@s activos.</p>
                                    {% endfor %}
                                </div>
                                <small class="form-text text-muted" id="sin_resultados" style="display: none;">
                                    Ningún alumn@ coincide con la búsqueda.
                                </small>
                            </div>

                            <small class="form-text text-muted">
                                Solo se les manda a los alumn@s activos. A los dados de baja no.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label for="asunto" class="form-label fw-semibold">Asunto</label>
                            <input type="text" class="form-control" id="asunto" name="asunto" maxlength="150" required
                                   value="{{ asuntoPrevio }}" placeholder="Ej: Actualización del valor de la cuota">
                        </div>

                        <div class="mb-3">
                            <label for="mensaje" class="form-label fw-semibold">Mensaje</label>
                            <textarea class="form-control" id="mensaje" name="mensaje" rows="9" required
                                      placeholder="Escribí el aviso como se lo querés mandar a las familias.">{{ mensajePrevio }}</textarea>
                            <small class="form-text text-muted">
                                Texto común, sin formato. Los saltos de línea se respetan. El email sale con
                                el nombre y el logo del instituto, y arranca saludando a cada alumn@ por su nombre.
                            </small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            Según la configuración del instituto, ahora mismo cada aviso va
                            {% if notificarA == 'ambos' %}
                                <strong>al alumn@ y a su tutor</strong>.
                            {% elseif notificarA == 'tutor' %}
                                <strong>solo al tutor</strong>.
                            {% else %}
                                <strong>solo al alumn@</strong>.
                            {% endif %}
                            Se cambia en <a href="{{ path('instituto_config_index', {'tab': 'notificaciones'}) }}">Configuración → Notificaciones</a>.
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg"
                                onclick="return confirm('¿Enviar la comunicación? Los emails salen en el momento.');">
                            <i class="bi bi-send"></i> Enviar
                        </button>
                        <a href="{{ path('dashboard_index') }}" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card">
                <div class="card-header bg-light"><strong>Antes de enviar</strong></div>
                <div class="card-body small text-muted">
                    <p>
                        Los emails se mandan <strong>en el momento</strong>, no en segundo plano. Con
                        muchos alumn@s la pantalla puede tardar unos segundos: no la cierres ni
                        recargues hasta que confirme.
                    </p>
                    <p>
                        Al alumn@ sin email cargado no le llega nada, y queda registrado como fallido
                        en el historial para que lo puedas ver.
                    </p>
                    <p class="mb-0">
                        No hay deshacer: un email enviado no se puede retirar. Leelo antes.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Elegir un curso en el desplegable implica que querés mandarle a ese curso.
        document.getElementById('curso_select').addEventListener('change', function () {
            if (this.value) {
                document.getElementById('destino_curso').checked = true;
            }
        });

        // Lista de alumn@s sueltos: filtro, marcado masivo de lo filtrado y contador.
        (function () {
            const radioSeleccion = document.getElementById('destino_seleccion');
            const caja = document.getElementById('caja_seleccion');
            const filtro = document.getElementById('filtro_alumnos');
            const contador = document.getElementById('contador_seleccion');
            const sinResultados = document.getElementById('sin_resultados');
            const filas = Array.from(document.querySelectorAll('.fila-alumno'));
            const checks = Array.from(document.querySelectorAll('.check-alumno'));

            function visibles() {
                return filas.filter(f => f.style.display !== 'none');
            }

            function actualizarContador() {
                contador.textContent = checks.filter(c => c.checked).length;
            }

            function aplicarFiltro() {
                const texto = filtro.value.trim().toLowerCase();
                filas.forEach(function (fila) {
                    const coincide = texto === '' || fila.dataset.busqueda.indexOf(texto) !== -1;
                    fila.style.display = coincide ? '' : 'none';
                });
                sinResultados.style.display = visibles().length === 0 && filas.length > 0 ? '' : 'none';
            }

            function habilitar() {
                // Deshabilitar los checkboxes cuando el destino es otro evita mandar ids que no
                // se van a usar y deja claro que la lista no está en juego.
                const activa = radioSeleccion.checked;
                caja.style.opacity = activa ? '1' : '0.5';
                filtro.disabled = !activa;
                checks.forEach(c => { c.disabled = !activa; });
            }

            filtro.addEventListener('input', aplicarFiltro);

            document.getElementById('marcar_visibles').addEventListener('click', function () {
                visibles().forEach(function (fila) {
                    const check = fila.querySelector('.check-alumno');
                    if (check && !check.disabled) {
                        check.checked = true;
                    }
                });
                actualizarContador();
            });

            document.getElementById('desmarcar_todos').addEventListener('click', function () {
                checks.forEach(c => { c.checked = false; });
                actualizarContador();
            });

            // Marcar a alguien implica que querés mandarle a los elegidos.
            checks.forEach(function (check) {
                check.addEventListener('change', function () {
                    if (check.checked) {
                        radioSeleccion.checked = true;
                        habilitar();
                    }
                    actualizarContador();
                });
            });

            document.querySelectorAll('input[name="destino"]').forEach(function (radio) {
                radio.addEventListener('change', habilitar);
            });

            habilitar();
            actualizarContador();
        })();
    </script>
{% endblock %}
