{% extends 'base.html.twig' %}

{% block title %}Historial de Emails{% endblock %}

{% block panelTitle %}
    Historial de Emails Enviados
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --email-primary: #5c6f6c;
            --email-secondary: #849d9a;
            --email-accent: #d4a373;
            --email-surface: #ffffff;
            --email-text: #1f2a2d;
            --email-muted: #647079;
            --email-border: #e5eceb;
            --email-shadow: 0 10px 28px rgba(19, 44, 43, 0.1);
        }

        .email-page {
            padding: 1.2rem 0.75rem;
            padding-bottom: 3rem;
        }

        .email-stats {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stat-card {
            flex: 1;
            background: var(--email-surface);
            border: 1px solid var(--email-border);
            border-radius: 14px;
            padding: 1.5rem;
            box-shadow: var(--email-shadow);
        }

        .stat-card h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
        }

        .stat-card p {
            margin: 0.5rem 0 0 0;
            color: var(--email-muted);
            font-size: 0.9rem;
        }

        .stat-card.success h3 {
            color: #198754;
        }

        .stat-card.danger h3 {
            color: #dc3545;
        }

        .email-panel {
            background: var(--email-surface);
            border: 1px solid var(--email-border);
            border-radius: 14px;
            box-shadow: var(--email-shadow);
            overflow: hidden;
        }

        .email-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.2px;
            border-bottom: 1px solid #dce7e4;
            padding: 0.72rem 0.6rem;
            vertical-align: middle;
        }

        .email-table td {
            vertical-align: middle;
            padding: 0.66rem 0.6rem;
            border-top-color: #ecf2f1;
            color: #27343a;
            font-size: 0.92rem;
        }

        .email-table tbody tr:hover {
            background: #fbfdfd;
        }

        .badge-tipo {
            font-size: 0.75rem;
            padding: 0.35rem 0.6rem;
            border-radius: 999px;
        }

        .badge-recibo {
            background: #e7f1ff;
            color: #0d6efd;
            border: 1px solid #b6d4fe;
        }

        .badge-recordatorio {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }

        .filters-bar {
            background: var(--email-surface);
            border: 1px solid var(--email-border);
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: var(--email-shadow);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid mt-3 email-page">
    <div class="email-stats">
        <div class="stat-card success">
            <h3>{{ totalEnviados }}</h3>
            <p><i class="bi bi-check-circle"></i> Emails Enviados</p>
        </div>
        <div class="stat-card danger">
            <h3>{{ totalFallidos }}</h3>
            <p><i class="bi bi-x-circle"></i> Emails Fallidos</p>
        </div>
    </div>

    <div class="filters-bar">
        <form method="get" action="{{ path('app_email_log_index') }}" class="row g-3">
            <div class="col-md-4">
                <label for="tipo" class="form-label">Tipo de Email</label>
                <select name="tipo" id="tipo" class="form-select">
                    <option value="">Todos</option>
                    <option value="recibo" {% if filtroTipo == 'recibo' %}selected{% endif %}>Recibos</option>
                    <option value="recordatorio" {% if filtroTipo == 'recordatorio' %}selected{% endif %}>Recordatorios</option>
                </select>
            </div>
            <div class="col-md-4">
                <label for="estado" class="form-label">Estado</label>
                <select name="estado" id="estado" class="form-select">
                    <option value="">Todos</option>
                    <option value="enviado" {% if filtroEstado == 'enviado' %}selected{% endif %}>Enviados</option>
                    <option value="fallido" {% if filtroEstado == 'fallido' %}selected{% endif %}>Fallidos</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
                <a href="{{ path('app_email_log_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Limpiar
                </a>
            </div>
        </form>
    </div>

    <div class="email-panel">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle email-table">
                <thead class="table-light">
                    <tr>
                        <th>Fecha/Hora</th>
                        <th>Tipo</th>
                        <th>Destinatario</th>
                        <th>Alumno</th>
                        <th>Asunto</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for email in emails %}
                    <tr>
                        <td>
                            <small>{{ email.fechaEnvio|date('d/m/Y H:i') }}</small>
                        </td>
                        <td>
                            <span class="badge-tipo badge-{{ email.tipo }}">
                                {% if email.tipo == 'recibo' %}
                                    <i class="bi bi-receipt"></i> Recibo
                                {% else %}
                                    <i class="bi bi-bell"></i> Recordatorio
                                {% endif %}
                            </span>
                        </td>
                        <td>{{ email.destinatario }}</td>
                        <td>
                            {% if email.alumno %}
                                <a href="{{ path('app_alumno_show', {'id': email.alumno.id}) }}">
                                    {{ email.alumno.nombreApellido }}
                                </a>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>{{ email.asunto|length > 50 ? email.asunto|slice(0, 50) ~ '...' : email.asunto }}</td>
                        <td>
                            {% if email.estado == 'enviado' %}
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Enviado
                                </span>
                            {% else %}
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle"></i> Fallido
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <a href="{{ path('app_email_log_show', {'id': email.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                            <p class="text-muted mt-2">No se encontraron emails</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        
        {% if emails.pageCount > 1 %}
        <div class="d-flex justify-content-center p-3">
            {{ knp_pagination_render(emails) }}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
