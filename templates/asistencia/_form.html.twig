{% if cursoSeleccionado %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asistencias - {{ cursoSeleccionado.nombre }} - {{ fecha|date('d/m/Y') }}</h5>
                </div>
                {% if fechaValida is defined and fechaValida.valida == false %}
                    <div class="alert alert-warning mb-0 border-0 border-bottom rounded-0" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>
                                <strong>Advertencia:</strong> {{ fechaValida.mensaje }}
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="card-body">
                    {% if soloLectura is not defined or not soloLectura %}
                        <form method="post" action="{{ path(rutaForm, {'fecha': fecha, 'curso': cursoSeleccionado.id, 'modo': modo|default('edicion')}) }}" id="form-asistencias">
                            <input type="hidden" name="modo" value="{{ modo|default('edicion') }}">
                    {% endif %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Estado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if asistenciasPorAlumno|length > 0 %}
                                        {% for asistencia in asistenciasPorAlumno %}
                                            <tr>
                                                <td>{{ asistencia.alumno.nombre }} {{ asistencia.alumno.apellido }}</td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {% if asistencia.presente %}
                                                            <span class="badge bg-success">Presente</span>
                                                        {% else %}
                                                            <span class="badge bg-danger">Ausente</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input asistencia-checkbox" type="checkbox" 
                                                                   name="asistencias[{{ asistencia.alumno.id }}]" 
                                                                   value="1" 
                                                                   data-alumno-id="{{ asistencia.alumno.id }}"
                                                                   {% if asistencia.presente %}checked{% endif %}>
                                                            {# Campo oculto para indicar que este alumno está siendo procesado #}
                                                            <input type="hidden" name="alumnos_procesados[]" value="{{ asistencia.alumno.id }}">
                                                            <label class="form-check-label">
                                                                {% if asistencia.presente is not null %}
                                                                    {% if asistencia.presente %}
                                                                        <span class="badge bg-success">Presente</span>
                                                                    {% else %}
                                                                        <span class="badge bg-danger">Ausente</span>
                                                                    {% endif %}
                                                                {% else %}
                                                                    <span class="badge bg-secondary">Sin registro</span>
                                                                {% endif %}
                                                            </label>
                                                        </div>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {{ asistencia.observaciones }}
                                                    {% else %}
                                                        <input type="text" class="form-control observaciones-input" 
                                                               name="observaciones[{{ asistencia.alumno.id }}]" 
                                                               value="{{ asistencia.observaciones }}"
                                                               data-alumno-id="{{ asistencia.alumno.id }}">
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center">
                                                {% if soloLectura is defined and soloLectura %}
                                                    No hay registros de asistencia para esta fecha
                                                {% else %}
                                                    No hay alumnos registrados en este curso
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% if soloLectura is not defined or not soloLectura %}
                            {# Botón de guardar y indicador de cambios pendientes #}
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div id="cambios-pendientes" class="text-muted" style="display: none;">
                                    <i class="bi bi-circle-fill text-warning" style="font-size: 0.6rem;"></i>
                                    <span id="contador-cambios">Cambios sin guardar</span>
                                </div>
                                <div class="ms-auto">
                                    <button type="button" class="btn btn-primary" id="btn-guardar" disabled>
                                        <i class="bi bi-save"></i> Guardar Asistencias
                                    </button>
                                </div>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                Seleccione un curso para {% if soloLectura is defined and soloLectura %}ver{% else %}ver y tomar{% endif %} las asistencias del día.
            </div>
        </div>
    </div>
{% endif %}

{% if soloLectura is not defined or not soloLectura %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formAsistencias = document.getElementById('form-asistencias');
        const checkboxes = document.querySelectorAll('.asistencia-checkbox');
        const observacionesInputs = document.querySelectorAll('.observaciones-input');
        const btnGuardar = document.getElementById('btn-guardar');
        const cambiosPendientes = document.getElementById('cambios-pendientes');
        const contadorCambios = document.getElementById('contador-cambios');
        
        let guardadoTimeout = null;
        let guardando = false;
        let hayCambios = false;
        let autoGuardadoTimeout = null;
        const AUTO_GUARDADO_DELAY = 5000; // 5 segundos de inactividad antes de auto-guardar
        
        if (formAsistencias && checkboxes.length > 0) {
            // Función para actualizar el label del badge según el estado del checkbox
            function actualizarBadge(checkbox) {
                const label = checkbox.closest('.form-check').querySelector('.form-check-label');
                const badge = label.querySelector('.badge');
                if (badge) {
                    if (checkbox.checked) {
                        badge.className = 'badge bg-success';
                        badge.textContent = 'Presente';
                    } else {
                        badge.className = 'badge bg-danger';
                        badge.textContent = 'Ausente';
                    }
                }
            }
            
            // Función para marcar que hay cambios pendientes
            function marcarCambios() {
                hayCambios = true;
                if (btnGuardar) btnGuardar.disabled = false;
                if (cambiosPendientes) cambiosPendientes.style.display = 'block';
            }
            
            // Función para limpiar el estado de cambios pendientes
            function limpiarCambios() {
                hayCambios = false;
                if (btnGuardar) btnGuardar.disabled = true;
                if (cambiosPendientes) cambiosPendientes.style.display = 'none';
            }
            
            // Función para guardar el formulario
            function guardarFormulario() {
                if (guardando) {
                    return;
                }
                
                // Permitir guardar siempre que se haya hecho clic en el botón o haya checkboxes modificados
                // Esto es importante porque guardar marca explícitamente el estado (presente/ausente)
                // incluso si visualmente no hay cambios (por ejemplo, cuando se carga por primera vez)
                
                guardando = true;
                hayCambios = false;
                
                // Actualizar el estado inicial después de guardar
                checkboxes.forEach(function(checkbox) {
                    estadoInicial.set(checkbox.dataset.alumnoId, checkbox.checked);
                });
                observacionesInputs.forEach(function(input) {
                    input.defaultValue = input.value;
                });
                
                // Actualizar UI durante el guardado
                if (btnGuardar) {
                    btnGuardar.disabled = true;
                    btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
                }
                if (cambiosPendientes) {
                    cambiosPendientes.style.display = 'block';
                    contadorCambios.textContent = 'Guardando...';
                }
                
                // Limpiar timeout de auto-guardado si existe
                if (autoGuardadoTimeout) {
                    clearTimeout(autoGuardadoTimeout);
                    autoGuardadoTimeout = null;
                }
                
                // Actualizar el estado inicial después de guardar y limpiar modificados
                checkboxes.forEach(function(checkbox) {
                    estadoInicial.set(checkbox.dataset.alumnoId, checkbox.checked);
                });
                observacionesInputs.forEach(function(input) {
                    input.defaultValue = input.value;
                });
                checkboxModificado.clear(); // Limpiar el set de modificados
                
                // Debug: verificar qué se está enviando
                const formData = new FormData(formAsistencias);
                console.log('Enviando formulario con datos:', Object.fromEntries(formData));
                
                formAsistencias.submit();
            }
            
            // Guardar el estado inicial de cada checkbox para detectar cambios
            const estadoInicial = new Map();
            const checkboxModificado = new Set(); // Track checkboxes que han sido modificados
            
            checkboxes.forEach(function(checkbox) {
                estadoInicial.set(checkbox.dataset.alumnoId, checkbox.checked);
                actualizarBadge(checkbox);
            });
            
            // Si hay alumnos en el formulario, habilitar el botón de guardar desde el inicio
            // Esto permite guardar el estado por defecto (ausente) sin necesidad de hacer cambios
            if (checkboxes.length > 0 && btnGuardar) {
                btnGuardar.disabled = false;
                hayCambios = true; // Marcar como si hubiera cambios para permitir guardar
            }
            
            // Función para verificar si hay cambios reales
            function hayCambiosReales() {
                // Si hay checkboxes modificados, hay cambios
                if (checkboxModificado.size > 0) {
                    return true;
                }
                
                // También verificar cambios en observaciones
                for (let input of observacionesInputs) {
                    const alumnoId = input.dataset.alumnoId;
                    const valorActual = input.value;
                    const valorOriginal = input.defaultValue || '';
                    if (valorActual !== valorOriginal) {
                        return true;
                    }
                }
                return false;
            }
            
            // Manejar cambios en checkboxes
            checkboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    const alumnoId = checkbox.dataset.alumnoId;
                    console.log('Checkbox cambiado:', alumnoId, 'checked:', checkbox.checked);
                    actualizarBadge(checkbox);
                    
                    // Marcar este checkbox como modificado
                    checkboxModificado.add(alumnoId);
                    
                    // Siempre marcar cambios cuando se modifica un checkbox
                    marcarCambios();
                    
                    // Limpiar timeout de auto-guardado anterior
                    if (autoGuardadoTimeout) {
                        clearTimeout(autoGuardadoTimeout);
                    }
                    
                    // Programar auto-guardado después de 5 segundos de inactividad
                    autoGuardadoTimeout = setTimeout(function() {
                        if (hayCambios && hayCambiosReales()) {
                            guardarFormulario();
                        }
                    }, AUTO_GUARDADO_DELAY);
                });
            });
            
            // Manejar cambios en observaciones
            observacionesInputs.forEach(function(input) {
                input.addEventListener('input', function() {
                    marcarCambios();
                    
                    // Limpiar timeout de auto-guardado anterior
                    if (autoGuardadoTimeout) {
                        clearTimeout(autoGuardadoTimeout);
                    }
                    
                    // Programar auto-guardado después de 5 segundos de inactividad
                    autoGuardadoTimeout = setTimeout(function() {
                        if (hayCambios) {
                            guardarFormulario();
                        }
                    }, AUTO_GUARDADO_DELAY);
                });
            });
            
            // Manejar clic en botón de guardar
            if (btnGuardar) {
                btnGuardar.addEventListener('click', function(e) {
                    e.preventDefault();
                    // Marcar todos los checkboxes como procesados cuando se hace clic en guardar
                    // Esto asegura que todos los alumnos visibles se guarden, incluso si no hubo cambios visuales
                    checkboxes.forEach(function(checkbox) {
                        checkboxModificado.add(checkbox.dataset.alumnoId);
                    });
                    // Forzar que haya cambios para permitir el guardado
                    hayCambios = true;
                    guardarFormulario();
                });
            }
            
            // Prevenir envío accidental del formulario con Enter
            formAsistencias.addEventListener('submit', function(e) {
                if (!guardando) {
                    e.preventDefault();
                    // Marcar todos los checkboxes como procesados cuando se envía el formulario
                    checkboxes.forEach(function(checkbox) {
                        checkboxModificado.add(checkbox.dataset.alumnoId);
                    });
                    // Forzar que haya cambios para permitir el guardado
                    hayCambios = true;
                    guardarFormulario();
                }
            });
        }
    });
</script>
{% endif %} 