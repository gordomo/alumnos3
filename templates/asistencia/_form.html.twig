{% if cursoSeleccionado %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asistencias - {{ cursoSeleccionado.nombre }} - {{ fecha|date('d/m/Y') }}</h5>
                </div>
                <div class="card-body">
                    {% if soloLectura is not defined or not soloLectura %}
                        <form method="post" action="{{ path(rutaForm, {'fecha': fecha, 'curso': cursoSeleccionado.id}) }}">
                    {% endif %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Estado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if asistenciasPorAlumno|length > 0 %}
                                        {% for asistencia in asistenciasPorAlumno %}
                                            <tr>
                                                <td>{{ asistencia.alumno.nombre }} {{ asistencia.alumno.apellido }}</td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {% if asistencia.presente %}
                                                            <span class="badge bg-success">Presente</span>
                                                        {% else %}
                                                            <span class="badge bg-danger">Ausente</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <div class="form-check form-switch">
                                                            <input class="form-check-input" type="checkbox" 
                                                                   name="asistencias[{{ asistencia.alumno.id }}]" 
                                                                   value="1" 
                                                                   {% if asistencia.presente %}checked{% endif %}>
                                                            <label class="form-check-label">
                                                                {% if asistencia.presente %}
                                                                    <span class="badge bg-success">Presente</span>
                                                                {% else %}
                                                                    <span class="badge bg-danger">Ausente</span>
                                                                {% endif %}
                                                            </label>
                                                        </div>
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {{ asistencia.observaciones }}
                                                    {% else %}
                                                        <input type="text" class="form-control" 
                                                               name="observaciones[{{ asistencia.alumno.id }}]" 
                                                               value="{{ asistencia.observaciones }}">
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center">
                                                {% if soloLectura is defined and soloLectura %}
                                                    No hay registros de asistencia para esta fecha
                                                {% else %}
                                                    No hay alumnos registrados en este curso
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                        {% if soloLectura is not defined or not soloLectura %}
                            <div class="mt-3">
                                <button type="submit" class="btn btn-primary">Guardar Asistencias</button>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                Seleccione un curso para {% if soloLectura is defined and soloLectura %}ver{% else %}ver y tomar{% endif %} las asistencias del día.
            </div>
        </div>
    </div>
{% endif %} 