{% if cursoSeleccionado %}
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Asistencias - {{ cursoSeleccionado.nombre }} - {{ fecha }}</h5>
                </div>
                {% if fechaValida is defined and fechaValida.valida == false %}
                    <div class="alert alert-warning mb-0 border-0 border-bottom rounded-0" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>
                                <strong>Advertencia:</strong> {{ fechaValida.mensaje }}
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="card-body">
                    {% if soloLectura is not defined or not soloLectura %}
                        <form method="post" action="{{ path(rutaForm, {'fecha': fecha, 'curso': cursoSeleccionado.id, 'modo': modo|default('edicion')}) }}" id="form-asistencias">
                            <input type="hidden" name="modo" value="{{ modo|default('edicion') }}">
                    {% endif %}
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Estado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if asistenciasPorAlumno|length > 0 %}
                                        {% for asistencia in asistenciasPorAlumno %}
                                            <tr>
                                                <td>{{ asistencia.alumno.nombre }} {{ asistencia.alumno.apellido }}</td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {% if asistencia.presente %}
                                                            <span class="badge bg-success">Presente</span>
                                                        {% else %}
                                                            <span class="badge bg-danger">Ausente</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <div class="btn-group btn-group-sm" role="group" data-alumno-id="{{ asistencia.alumno.id }}">
                                                            <input type="radio" class="btn-check asistencia-radio" name="asistencias[{{ asistencia.alumno.id }}]" 
                                                                   id="sin_registro_{{ asistencia.alumno.id }}" value="sin_registro"
                                                                   {% if asistencia.presente is null %}checked{% endif %}>
                                                            <label class="btn btn-outline-secondary" for="sin_registro_{{ asistencia.alumno.id }}" title="Sin dato registrado (no afecta el porcentaje)">
                                                                -
                                                            </label>
                                                            <input type="radio" class="btn-check asistencia-radio" name="asistencias[{{ asistencia.alumno.id }}]" 
                                                                   id="presente_{{ asistencia.alumno.id }}" value="1"
                                                                   {% if asistencia.presente is same as(true) %}checked{% endif %}>
                                                            <label class="btn btn-outline-success" for="presente_{{ asistencia.alumno.id }}" title="Presente">
                                                                <i class="bi bi-check"></i>
                                                            </label>
                                                            <input type="radio" class="btn-check asistencia-radio" name="asistencias[{{ asistencia.alumno.id }}]" 
                                                                   id="ausente_{{ asistencia.alumno.id }}" value="0"
                                                                   {% if asistencia.presente is same as(false) %}checked{% endif %}>
                                                            <label class="btn btn-outline-danger" for="ausente_{{ asistencia.alumno.id }}" title="Ausente">
                                                                <i class="bi bi-x"></i>
                                                            </label>
                                                        </div>
                                                        <input type="hidden" name="alumnos_procesados[]" value="{{ asistencia.alumno.id }}">
                                                    {% endif %}
                                                </td>
                                                <td>
                                                    {% if soloLectura is defined and soloLectura %}
                                                        {{ asistencia.observaciones }}
                                                    {% else %}
                                                        <input type="text" class="form-control observaciones-input" 
                                                               name="observaciones[{{ asistencia.alumno.id }}]" 
                                                               value="{{ asistencia.observaciones }}"
                                                               data-alumno-id="{{ asistencia.alumno.id }}">
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="text-center">
                                                {% if soloLectura is defined and soloLectura %}
                                                    No hay registros de asistencia para esta fecha
                                                {% else %}
                                                    No hay alumnos registrados en este curso
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% if soloLectura is not defined or not soloLectura %}
                            {# Botón de guardar y indicador de cambios pendientes #}
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div id="cambios-pendientes" class="text-muted" style="display: none;">
                                    <i class="bi bi-circle-fill text-warning" style="font-size: 0.6rem;"></i>
                                    <span id="contador-cambios">Cambios sin guardar</span>
                                </div>
                                <div class="ms-auto">
                                    <button type="button" class="btn btn-primary" id="btn-guardar" disabled>
                                        <i class="bi bi-save"></i> Guardar Asistencias
                                    </button>
                                </div>
                            </div>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                Seleccione un curso para {% if soloLectura is defined and soloLectura %}ver{% else %}ver y tomar{% endif %} las asistencias del día.
            </div>
        </div>
    </div>
{% endif %}

{% if soloLectura is not defined or not soloLectura %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const formAsistencias = document.getElementById('form-asistencias');
        const radioGroups = document.querySelectorAll('.btn-group[data-alumno-id]');
        const observacionesInputs = document.querySelectorAll('.observaciones-input');
        const btnGuardar = document.getElementById('btn-guardar');
        const cambiosPendientes = document.getElementById('cambios-pendientes');
        const contadorCambios = document.getElementById('contador-cambios');
        
        let guardando = false;
        let hayCambios = false;
        let autoGuardadoTimeout = null;
        const AUTO_GUARDADO_DELAY = 5000;
        
        if (formAsistencias && radioGroups.length > 0) {
            function obtenerValorSeleccionado(alumnoId) {
                const radio = formAsistencias.querySelector('input[name="asistencias[' + alumnoId + ']"]:checked');
                return radio ? radio.value : null;
            }
            
            function marcarCambios() {
                hayCambios = true;
                if (btnGuardar) btnGuardar.disabled = false;
                if (cambiosPendientes) cambiosPendientes.style.display = 'block';
            }
            
            function guardarFormulario() {
                if (guardando) return;
                guardando = true;
                hayCambios = false;
                
                radioGroups.forEach(function(group) {
                    const alumnoId = group.dataset.alumnoId;
                    estadoInicial.set(alumnoId, obtenerValorSeleccionado(alumnoId));
                });
                observacionesInputs.forEach(function(input) {
                    input.defaultValue = input.value;
                });
                radioModificado.clear();
                
                if (btnGuardar) {
                    btnGuardar.disabled = true;
                    btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...';
                }
                if (cambiosPendientes) {
                    cambiosPendientes.style.display = 'block';
                    contadorCambios.textContent = 'Guardando...';
                }
                if (autoGuardadoTimeout) {
                    clearTimeout(autoGuardadoTimeout);
                    autoGuardadoTimeout = null;
                }
                
                formAsistencias.submit();
            }
            
            const estadoInicial = new Map();
            const radioModificado = new Set();
            
            radioGroups.forEach(function(group) {
                const alumnoId = group.dataset.alumnoId;
                estadoInicial.set(alumnoId, obtenerValorSeleccionado(alumnoId));
            });
            
            if (radioGroups.length > 0 && btnGuardar) {
                btnGuardar.disabled = false;
                hayCambios = true;
            }
            
            function hayCambiosReales() {
                if (radioModificado.size > 0) return true;
                for (let input of observacionesInputs) {
                    const valorActual = input.value;
                    const valorOriginal = input.defaultValue || '';
                    if (valorActual !== valorOriginal) return true;
                }
                return false;
            }
            
            radioGroups.forEach(function(group) {
                const alumnoId = group.dataset.alumnoId;
                const radios = group.querySelectorAll('.asistencia-radio');
                radios.forEach(function(radio) {
                    radio.addEventListener('change', function() {
                        radioModificado.add(alumnoId);
                        marcarCambios();
                        if (autoGuardadoTimeout) clearTimeout(autoGuardadoTimeout);
                        autoGuardadoTimeout = setTimeout(function() {
                            if (hayCambios && hayCambiosReales()) guardarFormulario();
                        }, AUTO_GUARDADO_DELAY);
                    });
                });
            });
            
            observacionesInputs.forEach(function(input) {
                input.addEventListener('input', function() {
                    marcarCambios();
                    if (autoGuardadoTimeout) clearTimeout(autoGuardadoTimeout);
                    autoGuardadoTimeout = setTimeout(function() {
                        if (hayCambios) guardarFormulario();
                    }, AUTO_GUARDADO_DELAY);
                });
            });
            
            if (btnGuardar) {
                btnGuardar.addEventListener('click', function(e) {
                    e.preventDefault();
                    radioGroups.forEach(function(group) {
                        radioModificado.add(group.dataset.alumnoId);
                    });
                    hayCambios = true;
                    guardarFormulario();
                });
            }
            
            formAsistencias.addEventListener('submit', function(e) {
                if (!guardando) {
                    e.preventDefault();
                    radioGroups.forEach(function(group) {
                        radioModificado.add(group.dataset.alumnoId);
                    });
                    hayCambios = true;
                    guardarFormulario();
                }
            });
        }
    });
</script>
{% endif %} 