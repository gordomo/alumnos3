{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-color: #5c6f6c;
            --secondary-color: #849d9a;
            --accent-color: #d4a373;
            --bg-color: #f8f9fa;
            --text-color: #2c3e50;
        }

        body {
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated gradient background */
        .landing-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background: linear-gradient(-45deg, #1a3a38, #2c5f5d, #3d7a76, #4a938e);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }

        .landing-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 80%, rgba(212, 163, 115, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(132, 157, 154, 0.3) 0%, transparent 45%),
                radial-gradient(circle at 40% 40%, rgba(92, 111, 108, 0.2) 0%, transparent 40%);
            animation: meshPulse 20s ease-in-out infinite;
            pointer-events: none;
        }

        .landing-bg .floating-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.4;
            animation: float 25s ease-in-out infinite;
        }

        .landing-bg .floating-shape:nth-child(1) { width: 300px; height: 300px; background: #d4a373; top: 10%; left: 5%; animation-delay: 0s; }
        .landing-bg .floating-shape:nth-child(2) { width: 200px; height: 200px; background: #849d9a; top: 60%; right: 10%; animation-delay: -8s; }
        .landing-bg .floating-shape:nth-child(3) { width: 250px; height: 250px; background: #5c6f6c; bottom: 20%; left: 15%; animation-delay: -15s; }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        @keyframes meshPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.05); }
            66% { transform: translate(-20px, 20px) scale(0.95); }
        }

        .landing-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header + Hero Redesign */
        .landing-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 1rem;
            margin-bottom: 1.25rem;
            border-radius: 16px;
            background: rgba(16, 43, 41, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .landing-header-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: white;
            min-width: 0;
            transition: opacity 0.3s ease;
        }

        .landing-header-brand:hover {
            color: white;
            text-decoration: none;
            opacity: 0.92;
        }

        .landing-header-logo {
            display: inline-flex;
            flex-shrink: 0;
            padding: 0.35rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.5);
        }

        .landing-header-logo svg {
            width: 42px;
            height: 42px;
        }

        .landing-header-text {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            min-width: 0;
        }

        .landing-header-name {
            font-size: 1.35rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.02em;
            white-space: nowrap;
        }

        .landing-header-tagline {
            font-size: 0.78rem;
            font-weight: 500;
            opacity: 0.85;
            white-space: nowrap;
        }

        .landing-header-nav {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .landing-header-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 38px;
            padding: 0 1rem;
            border-radius: 999px;
            color: rgba(255, 255, 255, 0.92);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            transition: all 0.25s ease;
        }

        .landing-header-link:hover {
            color: white;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.35);
            transform: translateY(-1px);
        }

        .landing-header-link--primary {
            background: linear-gradient(135deg, var(--accent-color), #c49262);
            border-color: transparent;
            color: white;
            box-shadow: 0 8px 20px rgba(212, 163, 115, 0.35);
        }

        .landing-header-link--primary:hover {
            background: linear-gradient(135deg, #d7aa7e, #c08b58);
            color: white;
        }

        .auth-wrapper {
            width: 100%;
        }

        /* Hero Section */
        .hero-section {
            text-align: center;
            padding: 3rem 1.5rem;
            color: white;
            margin-bottom: 2rem;
            border-radius: 24px;
            background: linear-gradient(160deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.08));
            border: 1px solid rgba(255, 255, 255, 0.22);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(9px);
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.92);
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            padding: 0.5rem 0.95rem;
            margin-bottom: 1.1rem;
        }

        .hero-section h1 {
            font-size: clamp(2.1rem, 6vw, 4rem);
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
            line-height: 1.1;
            letter-spacing: -0.02em;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero-section p {
            font-size: 1.1rem;
            margin: 0 auto 2rem;
            opacity: 0.96;
            line-height: 1.6;
            max-width: 760px;
        }

        .login-button-hero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 210px;
            height: 50px;
            background: linear-gradient(135deg, var(--accent-color), #c49262);
            color: white;
            padding: 0.9rem 2.2rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 24px rgba(212, 163, 115, 0.35);
            border: none;
            cursor: pointer;
        }

        .login-button-hero:hover {
            background: #c49262;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(212, 163, 115, 0.5);
            color: white;
            text-decoration: none;
        }

        .login-button-hero:active {
            transform: translateY(-1px);
        }

        .login-button-hero i {
            margin-right: 0.5rem;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .register-button-hero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 210px;
            height: 50px;
            background: rgba(255, 255, 255, 0.08);
            color: white;
            padding: 0.9rem 2.2rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.9);
            cursor: pointer;
        }

        .register-button-hero:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: white;
            transform: translateY(-3px);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .register-button-hero i {
            margin-right: 0.5rem;
        }

        /* Promo Banner */
        .promo-banner {
            gap: 0.6rem;
            width: 100%;
            text-align: center;
            max-width: 100%;
            margin: 0 auto 1.5rem;
            background: rgba(255, 255, 255, 0.94);
            color: #264c49;
            padding: 0.75rem 1.25rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: 0.2px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }

        .promo-banner i {
            font-size: 2rem;
            color: var(--accent-color);
        }

        /* Features Section */
        .features-section {
            background: white;
            border-radius: 15px;
            padding: 3rem 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .features-section h2 {
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 2rem;
            font-size: 2rem;
            font-weight: 600;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 2rem;
        }

        .feature-card {
            text-align: center;
            padding: 2rem 1.5rem;
            border-radius: 10px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: #f8f9fa;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            background: white;
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--accent-color);
            margin-bottom: 1rem;
        }

        .feature-card h3 {
            color: var(--primary-color);
            margin-bottom: 0.75rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .feature-card p {
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 0;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1200px) {
            .landing-container {
                padding: 1.5rem;
            }
        }

        @media (max-width: 992px) {
            .landing-header {
                flex-wrap: wrap;
                justify-content: center;
                text-align: center;
                padding: 0.85rem;
            }

            .landing-header-nav {
                justify-content: center;
                flex-wrap: wrap;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }

            .features-section {
                padding: 2.5rem 1.5rem;
            }

            .features-section h2 {
                font-size: 1.75rem;
            }
        }

        @media (max-width: 768px) {
            .hero-section {
                padding: 2.2rem 1rem;
            }

            .hero-kicker {
                font-size: 0.76rem;
            }

            .hero-section h1 {
                font-size: 2.45rem;
                letter-spacing: -0.01em;
            }

            .hero-section p {
                font-size: 1rem;
                padding: 0;
            }

            .landing-header-link {
                height: 36px;
                padding: 0 0.85rem;
                font-size: 0.85rem;
            }

            .cta-text {
                font-size: 1.25rem;
            }

            .cta-subtext {
                font-size: 0.9rem;
            }

            .cta-badge {
                font-size: 0.85rem;
                padding: 0.4rem 1.2rem;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.25rem;
            }

            .features-section {
                padding: 2rem 1rem;
                border-radius: 10px;
            }

            .features-section h2 {
                font-size: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .feature-card {
                padding: 1.5rem 1rem;
            }

            .feature-icon {
                font-size: 2.5rem;
            }

            .feature-card h3 {
                font-size: 1.1rem;
            }

            .feature-card p {
                font-size: 0.9rem;
            }

            .auth-section {
                padding: 1.5rem;
                border-radius: 10px;
            }
        }

        @media (max-width: 576px) {
            .landing-container {
                padding: 1rem;
            }

            .landing-header {
                border-radius: 14px;
                margin-bottom: 1rem;
            }

            .landing-header-logo svg {
                width: 36px;
                height: 36px;
            }

            .landing-header-name {
                font-size: 1.1rem;
            }

            .landing-header-tagline {
                font-size: 0.72rem;
            }

            .promo-banner {
                width: 100%;
                font-size: 0.9rem;
                padding: 0.75rem 1rem;
            }

            .hero-section {
                padding: 1.8rem 0.9rem;
                border-radius: 18px;
            }

            .hero-section h1 {
                font-size: 1.9rem;
            }

            .hero-section p {
                font-size: 0.95rem;
            }

            .hero-buttons {
                flex-direction: column;
                align-items: center;
                gap: 0.75rem;
            }

            .login-button-hero,
            .register-button-hero {
                padding: 0.875rem 2rem;
                font-size: 0.95rem;
                width: 100%;
                max-width: 280px;
                text-align: center;
            }

            .features-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .features-section {
                padding: 1.5rem 1rem;
            }

            .features-section h2 {
                font-size: 1.35rem;
                margin-bottom: 1.25rem;
            }

            .feature-card {
                padding: 1.25rem 1rem;
            }

            .feature-icon {
                font-size: 2.25rem;
            }

            .cta-text {
                font-size: 1.1rem;
            }

            .cta-subtext {
                font-size: 0.85rem;
            }

            .cta-badge {
                font-size: 0.8rem;
                padding: 0.35rem 1rem;
            }

            .auth-section {
                padding: 1.25rem;
            }

            .auth-tabs {
                margin-bottom: 1.5rem;
            }

            .auth-tab {
                padding: 0.75rem;
                font-size: 0.9rem;
            }


            .features-section > div[style*="font-size: 3rem"] {
                font-size: 2rem !important;
            }
        }

        /* CTA Section */
        .cta-section {
            text-align: center;
            padding: 2rem 0;
            color: white;
            margin-bottom: 2rem;
            background-color: #849d9a;
        }

        .cta-text {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
        }

        .cta-subtext {
            font-size: 1rem;
            opacity: 0.9;
            margin-bottom: 1rem;
        }

        .cta-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 500;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        /* Auth Section */
        .auth-section {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            width: 100%;
            margin: 0 auto;
        }

        .auth-tabs {
            display: flex;
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .auth-tab {
            flex: 1;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            border: none;
            background: none;
            color: #6c757d;
            font-weight: 600;
            transition: all 0.3s;
            position: relative;
        }

        .auth-tab.active {
            color: var(--primary-color);
        }

        .auth-tab.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent-color);
        }

        .auth-tab:hover {
            color: var(--primary-color);
        }

        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--accent-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.1);
        }

        .btn-primary {
            width: 100%;
            background: var(--accent-color);
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary:hover {
            background: #c49262;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3);
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .forgot-password {
            color: var(--primary-color);
            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        /* Ventajas Section - Rediseño */
        .ventajas-section {
            margin-bottom: 2rem;
        }

        .ventajas-title {
            text-align: center;
            color: var(--primary-color);
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 2rem;
        }

        .ventajas-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .ventaja-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .ventaja-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 0;
            background: var(--accent-color);
            transition: height 0.3s ease;
        }

        .ventaja-card:hover {
            border-color: var(--accent-color);
            box-shadow: 0 8px 25px rgba(212, 163, 115, 0.2);
            transform: translateY(-2px);
        }

        .ventaja-card:hover::before {
            height: 100%;
        }

        .ventaja-card.ventaja-highlight {
            border-color: var(--accent-color);
            background: linear-gradient(135deg, rgba(212, 163, 115, 0.08) 0%, rgba(255,255,255,1) 100%);
        }

        .ventaja-card.ventaja-highlight::before {
            height: 100%;
            width: 4px;
        }

        .ventaja-icon {
            font-size: 2rem;
            color: var(--accent-color);
            margin-bottom: 0.75rem;
        }

        .ventaja-card h4 {
            color: var(--primary-color);
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .ventaja-card p {
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0;
        }

        @media (max-width: 768px) {
            .ventajas-grid {
                grid-template-columns: 1fr;
            }

            .ventajas-title {
                font-size: 1.35rem;
            }
        }

    </style>
{% endblock %}

{% block title %}Sistema de Gestión de Institutos{% endblock %}

{% block body %}
<div class="landing-bg">
    <span class="floating-shape"></span>
    <span class="floating-shape"></span>
    <span class="floating-shape"></span>
</div>

<div class="landing-container">
    <!-- Header principal -->
    <header class="landing-header">
        <a href="{{ path('app_start') }}" class="landing-header-brand" data-no-loading>
            <span class="landing-header-logo" aria-label="InstituteBuilder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="48" height="48">
                    <defs>
                        <linearGradient id="logo-teal" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#5c6f6c"/>
                            <stop offset="100%" style="stop-color:#849d9a"/>
                        </linearGradient>
                        <linearGradient id="logo-accent" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" style="stop-color:#d4a373"/>
                            <stop offset="100%" style="stop-color:#c49262"/>
                        </linearGradient>
                    </defs>
                    <rect x="8" y="28" width="48" height="28" rx="4" fill="url(#logo-teal)"/>
                    <rect x="16" y="36" width="32" height="2" rx="1" fill="rgba(255,255,255,0.3)"/>
                    <rect x="16" y="42" width="24" height="2" rx="1" fill="rgba(255,255,255,0.2)"/>
                    <path d="M20 20 L38 8 L38 28 L20 40 Z" fill="url(#logo-accent)"/>
                    <path d="M38 8 L56 20 L56 40 L38 28 Z" fill="rgba(196,146,98,0.85)"/>
                    <path d="M20 20 L38 8 L56 20 L38 28 Z" fill="rgba(212,163,115,0.95)"/>
                    <g transform="translate(48, 20)">
                        <circle r="12" fill="url(#logo-teal)"/>
                        <g fill="url(#logo-teal)">
