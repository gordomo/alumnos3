{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-color: #5c6f6c;
            --secondary-color: #849d9a;
            --accent-color: #d4a373;
            --bg-color: #f8f9fa;
            --text-color: #2c3e50;
        }

        body {
            background: linear-gradient(135deg, #5e706e 0%, #849d9a 100%);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        .landing-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        .auth-wrapper {
            width: 100%;
        }

        /* Hero Section */
        .hero-section {
            text-align: center;
            padding: 3rem 0 2rem;
            color: white;
        }

        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin-bottom: 2rem;
        }

        .logo-image {
            height: auto;
            margin-bottom: 1rem;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.2));
        }

        .logo-text {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.25rem;
        }

        .logo-main-text {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 2px;
            color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            margin: 0;
        }

        .logo-sub-text {
            font-size: 0.9rem;
            font-weight: 400;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.9);
            text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
            margin: 0;
        }

        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
            line-height: 1.2;
        }

        .hero-section p {
            font-size: 1.25rem;
            margin-bottom: 2rem;
            opacity: 0.95;
            line-height: 1.6;
        }

        /* Features Section */
        .features-section {
            background: white;
            border-radius: 15px;
            padding: 3rem 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .features-section h2 {
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 2rem;
            font-size: 2rem;
            font-weight: 600;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 2rem;
        }

        .feature-card {
            text-align: center;
            padding: 2rem 1.5rem;
            border-radius: 10px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: #f8f9fa;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            background: white;
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--accent-color);
            margin-bottom: 1rem;
        }

        .feature-card h3 {
            color: var(--primary-color);
            margin-bottom: 0.75rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .feature-card p {
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 0;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1200px) {
            .landing-container {
                padding: 1.5rem;
            }
        }

        @media (max-width: 992px) {
            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }

            .features-section {
                padding: 2.5rem 1.5rem;
            }

            .features-section h2 {
                font-size: 1.75rem;
            }
        }

        @media (max-width: 768px) {
            .hero-section {
                padding: 2rem 0 1.5rem;
            }

            .hero-section h1 {
                font-size: 2rem;
            }

            .hero-section p {
                font-size: 1rem;
                padding: 0 1rem;
            }

            .logo-image {
                max-width: 140px;
            }

            .logo-main-text {
                font-size: 1.5rem;
                letter-spacing: 1.5px;
            }

            .logo-sub-text {
                font-size: 0.8rem;
            }

            .cta-text {
                font-size: 1.25rem;
            }

            .cta-subtext {
                font-size: 0.9rem;
            }

            .cta-badge {
                font-size: 0.85rem;
                padding: 0.4rem 1.2rem;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.25rem;
            }

            .features-section {
                padding: 2rem 1rem;
                border-radius: 10px;
            }

            .features-section h2 {
                font-size: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .feature-card {
                padding: 1.5rem 1rem;
            }

            .feature-icon {
                font-size: 2.5rem;
            }

            .feature-card h3 {
                font-size: 1.1rem;
            }

            .feature-card p {
                font-size: 0.9rem;
            }

            .auth-section {
                padding: 1.5rem;
                border-radius: 10px;
            }
        }

        @media (max-width: 576px) {
            .landing-container {
                padding: 1rem;
            }

            .hero-section {
                padding: 1.5rem 0 1rem;
            }

            .hero-section h1 {
                font-size: 1.75rem;
            }

            .hero-section p {
                font-size: 0.95rem;
            }

            .logo-image {
                max-width: 120px;
            }

            .logo-main-text {
                font-size: 1.25rem;
                letter-spacing: 1px;
            }

            .logo-sub-text {
                font-size: 0.75rem;
            }

            .features-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .features-section {
                padding: 1.5rem 1rem;
            }

            .features-section h2 {
                font-size: 1.35rem;
                margin-bottom: 1.25rem;
            }

            .feature-card {
                padding: 1.25rem 1rem;
            }

            .feature-icon {
                font-size: 2.25rem;
            }

            .cta-text {
                font-size: 1.1rem;
            }

            .cta-subtext {
                font-size: 0.85rem;
            }

            .cta-badge {
                font-size: 0.8rem;
                padding: 0.35rem 1rem;
            }

            .auth-section {
                padding: 1.25rem;
            }

            .auth-tabs {
                margin-bottom: 1.5rem;
            }

            .auth-tab {
                padding: 0.75rem;
                font-size: 0.9rem;
            }

            /* Tokens section responsive */
            .features-section > div[style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }

            .features-section > div[style*="font-size: 3rem"] {
                font-size: 2rem !important;
            }
        }

        /* CTA Section */
        .cta-section {
            text-align: center;
            padding: 2rem 0;
            color: white;
            margin-bottom: 2rem;
            background-color: #849d9a;
        }

        .cta-text {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
        }

        .cta-subtext {
            font-size: 1rem;
            opacity: 0.9;
            margin-bottom: 1rem;
        }

        .cta-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 500;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        /* Auth Section */
        .auth-section {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            width: 100%;
            margin: 0 auto;
        }

        .auth-tabs {
            display: flex;
            border-bottom: 2px solid #e9ecef;
            margin-bottom: 2rem;
        }

        .auth-tab {
            flex: 1;
            padding: 1rem;
            text-align: center;
            cursor: pointer;
            border: none;
            background: none;
            color: #6c757d;
            font-weight: 600;
            transition: all 0.3s;
            position: relative;
        }

        .auth-tab.active {
            color: var(--primary-color);
        }

        .auth-tab.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent-color);
        }

        .auth-tab:hover {
            color: var(--primary-color);
        }

        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--accent-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.1);
        }

        .btn-primary {
            width: 100%;
            background: var(--accent-color);
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary:hover {
            background: #c49262;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3);
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .forgot-password {
            color: var(--primary-color);
            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        /* Token Reset Section */
        .token-reset-section {
            background: linear-gradient(135deg, #849d9a 0%, #6c757d 100%);
            color: white;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            border: none;
        }

        .token-reset-header {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            gap: 0.75rem;
        }

        .token-reset-header i {
            font-size: 2rem;
            color: white;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }

        .token-reset-header h3 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 700;
            color: white;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        .token-reset-alert {
            background: rgba(255,255,255,0.25);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .token-reset-alert-icon {
            flex-shrink: 0;
            font-size: 1.5rem;
            color: #ffc107;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }

        .token-reset-alert-content {
            flex: 1;
            font-size: 1rem;
            line-height: 1.7;
            color: white;
        }

        .token-reset-alert-content strong {
            font-weight: 600;
            font-size: 1.05rem;
        }

        .token-reset-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.25rem;
        }

        .token-reset-card {
            background: rgba(255,255,255,0.25);
            border-radius: 12px;
            padding: 1.5rem 1.25rem;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .token-reset-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
            background: rgba(255,255,255,0.35);
        }

        .token-reset-card-icon {
            font-size: 2rem;
            color: white;
            margin-bottom: 0.75rem;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));
        }

        .token-reset-card-content {
            color: white;
        }

        .token-reset-card-content strong {
            display: block;
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: white;
        }

        .token-reset-card-content p {
            margin: 0;
            font-size: 0.9rem;
            opacity: 0.95;
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            .token-reset-section {
                padding: 1.5rem;
            }

            .token-reset-header h3 {
                font-size: 1.25rem;
            }

            .token-reset-header i {
                font-size: 1.75rem;
            }

            .token-reset-alert {
                padding: 1rem;
                flex-direction: column;
                text-align: center;
            }

            .token-reset-alert-icon {
                align-self: center;
            }

            .token-reset-cards {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .token-reset-card {
                padding: 1.25rem 1rem;
            }
        }

        @media (max-width: 576px) {
            .token-reset-section {
                padding: 1.25rem;
            }

            .token-reset-header {
                flex-direction: column;
                gap: 0.5rem;
            }

            .token-reset-header h3 {
                font-size: 1.1rem;
                text-align: center;
            }

            .token-reset-alert-content {
                font-size: 0.95rem;
            }
        }
    </style>
{% endblock %}

{% block title %}Sistema de Gestión de Institutos{% endblock %}

{% block body %}
<div class="landing-container">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="logo-container">
            <img src="{{ asset('assets/img/logoteam.png') }}" alt="Team Builder Logo" class="logo-image">
            <div class="logo-text">
                <h2 class="logo-main-text">TEAM INSTITUTE</h2>
                <p class="logo-sub-text">by TEAM BUILDER</p>
            </div>
        </div>
        <h1>Gestiona tu Instituto de Forma Inteligente</h1>
        <p>La solución completa para administrar alumnos, profesores, cursos y pagos</p>
    </div>

    <!-- Features Section -->
    <div class="features-section">
        <h2 style="text-align: center; color: var(--primary-color); margin-bottom: 1rem;">¿Por qué elegir nuestro sistema?</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h3>Gestión de Alumnos</h3>
                <p>Administra fácilmente la información de tus alumnos, cursos, asistencia y pagos en un solo lugar.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <h3>Control de Pagos</h3>
                <p>Registra pagos, gestiona deudas pendientes y genera recibos automáticamente con notificaciones por email.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h3>Asistencia y Cursos</h3>
                <p>Lleva el control de asistencia de alumnos y profesores, y organiza tus cursos de manera eficiente.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>
                <h3>Notificaciones Automáticas</h3>
                <p>Envía recibos y recordatorios de deudas automáticamente por email a tus alumnos.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <h3>Reportes y Estadísticas</h3>
                <p>Visualiza estadísticas de pagos, deudas pendientes y asistencias para tomar mejores decisiones.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <h3>Seguro y Confiable</h3>
                <p>Tus datos están protegidos. Sistema robusto con respaldo automático y acceso seguro.</p>
            </div>
        </div>
    </div>

    <!-- Tokens & Pricing Section -->
    <div class="features-section" style="margin-bottom: 2rem;">
        <h2 style="text-align: center; color: var(--primary-color); margin-bottom: 1rem;">
            <i class="bi bi-coin" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
            Sistema de Tokens: Paga Solo por lo que Usas
        </h2>
        <p style="text-align: center; color: #6c757d; margin-bottom: 2rem; font-size: 1.1rem;">
            Modelo transparente y justo. Sin suscripciones fijas, sin sorpresas.
        </p>

        <div style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 15px; padding: 2rem; margin-bottom: 2rem; border: 2px solid var(--accent-color);">
            <div style="text-align: center; margin-bottom: 1.5rem;">
                <div style="font-size: 3rem; font-weight: 700; color: var(--accent-color); margin-bottom: 0.5rem;">
                    300 Tokens Gratis
                </div>
                <div style="font-size: 1.2rem; color: var(--primary-color); font-weight: 600;">
                    Al registrarte recibes 300 tokens de bienvenida
                </div>
                <div style="font-size: 0.95rem; color: #6c757d; margin-top: 0.5rem;">
                    Suficiente para comenzar a cargar tus datos y probar el sistema
                </div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
            <div style="background: white; padding: 1.5rem; border-radius: 10px; border: 1px solid #e9ecef;">
                <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.25rem;">
                    <i class="bi bi-lightning-charge-fill" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                    ¿Cómo Funciona?
                </h3>
                <p style="color: #6c757d; font-size: 0.95rem; line-height: 1.6; margin: 0;">
                    Cada acción en el sistema consume tokens. Los pagos, crear alumnos, cursos y notificaciones tienen un costo pequeño y transparente. Puedes ver tu consumo en tiempo real.
                </p>
            </div>

            <div style="background: white; padding: 1.5rem; border-radius: 10px; border: 1px solid #e9ecef;">
                <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.25rem;">
                    <i class="bi bi-cash-stack" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                    Precios Transparentes
                </h3>
                <div style="margin-bottom: 0.75rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                        <span style="color: #6c757d;">Precio Promocional (primeros 6 meses):</span>
                        <strong style="color: var(--accent-color);">$120/token</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6c757d;">Precio Normal:</span>
                        <strong style="color: var(--primary-color);">$150/token</strong>
                    </div>
                </div>
            </div>

            <div style="background: white; padding: 1.5rem; border-radius: 10px; border: 1px solid #e9ecef;">
                <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.25rem;">
                    <i class="bi bi-calculator" style="color: var(--accent-color); margin-right: 0.5rem;"></i>
                    Ejemplo de Consumo
                </h3>
                <p style="color: #6c757d; font-size: 0.95rem; line-height: 1.6; margin: 0;">
                    Para un instituto de <strong>50 alumnos</strong>: ~250 tokens/mes en operación normal. 
                    <strong>Costo mensual: $30,000-$37,500</strong>
                </p>
            </div>
        </div>

        <div style="background: #f8f9fa; border-radius: 10px; padding: 1.5rem; margin-bottom: 2rem;">
            <h3 style="color: var(--primary-color); margin-bottom: 1rem; font-size: 1.2rem; text-align: center;">
                Costos por Acción
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; font-size: 0.9rem;">
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Registrar Pago:</span>
                    <strong style="color: var(--primary-color);">3 tokens</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Crear Alumno:</span>
                    <strong style="color: var(--primary-color);">5 tokens</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Crear Curso:</span>
                    <strong style="color: var(--primary-color);">10 tokens</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Enviar Notificación:</span>
                    <strong style="color: var(--primary-color);">1 token</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Editar Alumno:</span>
                    <strong style="color: var(--primary-color);">1 token</strong>
                </div>
                <div style="display: flex; justify-content: space-between; padding: 0.5rem; background: white; border-radius: 5px;">
                    <span style="color: #6c757d;">Exportar a Excel:</span>
                    <strong style="color: var(--primary-color);">5 tokens</strong>
                </div>
            </div>
        </div>

        <div style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white; border-radius: 10px; padding: 1.5rem; text-align: center;">
            <div style="font-size: 1.1rem; margin-bottom: 0.5rem; font-weight: 600;">
                💡 Ventajas del Modelo de Tokens
            </div>
            <div style="font-size: 0.95rem; opacity: 0.95; line-height: 1.6;">
                • <strong>Paga solo por lo que usas</strong> - Sin costos fijos mensuales<br>
                • <strong>Escala con tu crecimiento</strong> - Más alumnos = más tokens, pero solo cuando los necesitas<br>
                • <strong>Transparencia total</strong> - Ves exactamente cuánto consumes y cuánto cuesta cada acción<br>
                • <strong>Costo mínimo</strong> - Representa menos del 2% de tus ingresos mensuales
            </div>
        </div>

        <!-- Información sobre Reseteo Mensual -->
        <div class="token-reset-section mt-4">
            <div class="token-reset-header">
                <i class="bi bi-calendar-x-fill"></i>
                <h3>Reseteo Mensual de Tokens</h3>
            </div>
            <div class="token-reset-alert">
                <div class="token-reset-alert-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div class="token-reset-alert-content">
                    <strong>Importante:</strong> Todos los tokens se resetean a <strong>0</strong> el día <strong>1 de cada mes</strong>. 
                    Recuerda usar tus tokens antes del fin de mes para aprovecharlos al máximo.
                </div>
            </div>
            <div class="token-reset-cards">
                <div class="token-reset-card">
                    <div class="token-reset-card-icon">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="token-reset-card-content">
                        <strong>Planifica tus compras</strong>
                        <p>Compra tokens cerca del día 1</p>
                    </div>
                </div>
                <div class="token-reset-card">
                    <div class="token-reset-card-icon">
                        <i class="bi bi-lightbulb-fill"></i>
                    </div>
                    <div class="token-reset-card-content">
                        <strong>Usa tus tokens</strong>
                        <p>Aprovecha antes del reseteo</p>
                    </div>
                </div>
                <div class="token-reset-card">
                    <div class="token-reset-card-icon">
                        <i class="bi bi-info-circle-fill"></i>
                    </div>
                    <div class="token-reset-card-content">
                        <strong>Transparencia total</strong>
                        <p>Siempre sabes cuándo resetea</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section">
        <div class="cta-text">¡Comienza hoy mismo!</div>
        <div class="cta-subtext">Regístrate gratis y obtén 300 tokens para comenzar</div>
        <div class="cta-badge">Sin tarjeta de crédito • Configuración en minutos • 300 tokens gratis</div>
    </div>

    <!-- Auth Section -->
    <div class="auth-wrapper">
        <div class="auth-section">
        <div class="auth-tabs">
            <button class="auth-tab active" onclick="showTab('login', this)">Iniciar Sesión</button>
            <button class="auth-tab" onclick="showTab('register', this)">Registrarse</button>
        </div>

        <!-- Login Form -->
        <div id="loginForm" class="auth-form active">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            {% if app.user %}
                <div class="alert alert-info">
                    Ya estás conectado como {{ app.user.username }}, 
                    <a href="{{ path('app_logout') }}" class="alert-link">Cerrar sesión</a>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="form-group">
                    <input type="email" 
                           value="{{ last_username ?? (app.request.query.get('email') ?: '') }}" 
                           name="email" 
                           id="inputEmail" 
                           class="form-control" 
                           placeholder="Correo electrónico"
                           autocomplete="email" 
                           required 
                           autofocus>
                </div>

                <div class="form-group">
                    <input type="password" 
                           name="password" 
                           id="inputPassword" 
                           class="form-control" 
                           placeholder="Contraseña"
                           autocomplete="current-password" 
                           required>
                </div>

                <div class="form-options">
                    <label style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" name="_remember_me" style="width: auto;">
                        <span>Recordarme</span>
                    </label>
                    <a href="{{ path('app_reset_password') }}" class="forgot-password">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary" type="submit">
                    Ingresar
                </button>
            </form>
        </div>

        <!-- Register Form -->
        <div id="registerForm" class="auth-form">

            <form method="post" action="{{ path('app_register') }}" enctype="multipart/form-data">
                <div class="form-group">
                    <input type="text" 
                           name="nombre" 
                           class="form-control" 
                           placeholder="Nombre del Instituto"
                           required>
                </div>

                <div class="form-group">
                    <input type="email" 
                           name="email" 
                           class="form-control" 
                           placeholder="Email del Instituto"
                           required>
                </div>

                <div class="form-group">
                    <input type="tel" 
                           name="tel" 
                           class="form-control" 
                           placeholder="Teléfono (opcional)"
                           maxlength="25">
                </div>

                <div class="form-group">
                    <textarea name="dir" 
                              class="form-control" 
                              rows="2"
                              placeholder="Dirección (opcional)"></textarea>
                </div>

                <div class="form-group">
                    <input type="password" 
                           name="password" 
                           class="form-control" 
                           placeholder="Contraseña"
                           required
                           minlength="6">
                    <small style="color: #6c757d; font-size: 0.85rem; display: block; margin-top: 0.25rem;">
                        Mínimo 6 caracteres
                    </small>
                </div>

                <div class="form-group">
                    <label style="display: block; margin-bottom: 0.5rem; color: var(--text-color); font-size: 0.9rem;">
                        Logo del Instituto (opcional)
                    </label>
                    <input type="file" 
                           name="logo" 
                           class="form-control" 
                           accept="image/jpeg,image/png">
                    <small style="color: #6c757d; font-size: 0.85rem; display: block; margin-top: 0.25rem;">
                        Formatos: JPG, PNG. Máximo 1MB
                    </small>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">

                <button class="btn btn-primary" type="submit">
                    Crear Cuenta
                </button>
            </form>
        </div>
        </div>
    </div>
</div>

<script>
    function showTab(tab, element) {
        // Ocultar todos los formularios
        document.querySelectorAll('.auth-form').forEach(form => {
            form.classList.remove('active');
        });
        
        // Remover active de todos los tabs
        document.querySelectorAll('.auth-tab').forEach(btn => {
            btn.classList.remove('active');
        });
        
        // Mostrar el formulario seleccionado
        document.getElementById(tab + 'Form').classList.add('active');
        
        // Activar el tab seleccionado
        if (element) {
            element.classList.add('active');
        }
    }

    // Si hay un mensaje de éxito, mostrar el tab de login
    document.addEventListener('DOMContentLoaded', function() {
        {% if app.flashes('success') %}
            const loginTab = document.querySelector('.auth-tab:first-child');
            if (loginTab) {
                showTab('login', loginTab);
                // Scroll suave al formulario de login
                setTimeout(() => {
                    document.getElementById('loginForm').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }, 100);
            }
        {% endif %}
        
        {% if app.flashes('error') and not error %}
            // Si hay error pero no es de login, mostrar tab de registro
            const registerTab = document.querySelector('.auth-tab:last-child');
            if (registerTab) {
                showTab('register', registerTab);
            }
        {% endif %}
    });
</script>
{% endblock %}

