<button type="button" class="back-to-top-btn" id="backToTopButton" aria-label="Volver arriba">
    <i class="bi bi-arrow-up"></i>
</button>

<script>
    function scrollToAuthForm(event) {
        if (event) event.preventDefault();
        const card = document.getElementById('auth-form-card');
        if (card) {
            card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Zona horaria del navegador para el instituto que se registra
    document.addEventListener('DOMContentLoaded', function() {
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const input = document.getElementById('register_timezone');
            if (input && tz) input.value = tz;
        } catch (e) {}
    });

    // Si hay un mensaje de éxito, mostrar el tab de login
    document.addEventListener('DOMContentLoaded', function() {
        const backToTopButton = document.getElementById('backToTopButton');
        const toggleBackToTopVisibility = () => {
            if (!backToTopButton) return;
            if (window.scrollY > 280) {
                backToTopButton.classList.add('is-visible');
            } else {
                backToTopButton.classList.remove('is-visible');
            }
        };

        toggleBackToTopVisibility();
        window.addEventListener('scroll', toggleBackToTopVisibility, { passive: true });
        if (backToTopButton) {
            backToTopButton.addEventListener('click', function() {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // Prevenir restauración automática de scroll del navegador
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }
        
        // Prevenir scroll automático del navegador en la home
        {% if is_home is defined and is_home == true %}
            // Forzar posición inicial inmediatamente
            window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
            
            // Si hay un hash en la URL, removerlo sin hacer scroll
            if (window.location.hash) {
                history.replaceState(null, null, window.location.pathname);
            }
            
            // Segunda verificación después de un breve delay
            requestAnimationFrame(() => {
                window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
            });
        {% endif %}

        // Solo hacer scroll si estamos en /login directamente (no en la home)
        {% if is_home is defined and is_home == false %}
            setTimeout(() => {
                const authSection = document.getElementById('auth-section');
                if (authSection) {
                    authSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 100);
        {% endif %}

    });

    // Funcionalidad para mostrar/ocultar contraseña en login
    const togglePassword = document.querySelector('#togglePassword');
    if (togglePassword) {
        const password = document.querySelector('#inputPassword');
        const icon = togglePassword.querySelector('i');
        
        togglePassword.addEventListener('click', function() {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            
            // Cambiar el ícono
            icon.classList.toggle('bi-eye');
            icon.classList.toggle('bi-eye-slash');
        });
    }

    // Funcionalidad para mostrar/ocultar contraseña en registro
    const togglePasswordRegister = document.querySelector('#togglePasswordRegister');
    if (togglePasswordRegister) {
        const passwordRegister = document.querySelector('#inputPasswordRegister');
        const iconRegister = togglePasswordRegister.querySelector('i');
        
        togglePasswordRegister.addEventListener('click', function() {
            const type = passwordRegister.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordRegister.setAttribute('type', type);
            
            // Cambiar el ícono
            iconRegister.classList.toggle('bi-eye');
            iconRegister.classList.toggle('bi-eye-slash');
        });
    }
</script>
{% endblock %}

