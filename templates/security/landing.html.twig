{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            /* Azul de marca. Todo lo accionable y todo lo decorativo sale de estos tres. */
            --primary-color: #2f7ef0;
            /* El azul de marca sobre blanco da 3.92:1, abajo del 4.5 que pide AA. Este tono es
               el que se usa para texto y botones: 5.02:1, y a simple vista es el mismo azul. */
            --primary-legible: #1b6ae0;
            --primary-dark: #1b5fc4;
            --primary-darker: #123a7a;
            --primary-soft: #eaf2fe;

            /* Bloques oscuros con texto blanco encima: necesitan contraste de verdad. */
            --secondary-color: #1b4f9c;

            /* El ámbar se usa a cuentagotas: solo la promo y el precio. Si el acento está en
               todos los elementos, no destaca ninguno. */
            --accent-color: #f59e0b;
            --accent-dark: #d98806;
            /* Para texto: el ámbar claro sobre fondo claro no se lee (2:1). */
            --accent-legible: #c2650a;

            --bg-color: #f8f9fa;
            --text-color: #1f2d3d;
        }

        body {
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated gradient background */
        .landing-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            background: linear-gradient(-45deg, #071c3f, #123a7a, #1b5fc4, #2f7ef0);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }

        .landing-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 80%, rgba(245, 158, 11, 0.14) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(47, 126, 240, 0.32) 0%, transparent 45%),
                radial-gradient(circle at 40% 40%, rgba(18, 58, 122, 0.28) 0%, transparent 40%);
            animation: meshPulse 20s ease-in-out infinite;
            pointer-events: none;
        }

        .landing-bg .floating-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.4;
            animation: float 25s ease-in-out infinite;
        }

        .landing-bg .floating-shape:nth-child(1) { width: 300px; height: 300px; background: #f59e0b; top: 10%; left: 5%; animation-delay: 0s; }
        .landing-bg .floating-shape:nth-child(2) { width: 200px; height: 200px; background: #2f7ef0; top: 60%; right: 10%; animation-delay: -8s; }
        .landing-bg .floating-shape:nth-child(3) { width: 250px; height: 250px; background: #123a7a; bottom: 20%; left: 15%; animation-delay: -15s; }

        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        @keyframes meshPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.05); }
            66% { transform: translate(-20px, 20px) scale(0.95); }
        }

        .landing-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* Header + Hero Redesign */
        .landing-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.85rem 1rem;
            margin-bottom: 1.25rem;
            border-radius: 16px;
            background: rgba(16, 43, 41, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .landing-header-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.85rem;
            text-decoration: none;
            color: white;
            min-width: 0;
            transition: opacity 0.3s ease;
        }

        .landing-header-brand:hover {
            color: white;
            text-decoration: none;
            opacity: 0.92;
        }

        .landing-header-logo {
            display: inline-flex;
            flex-shrink: 0;
            padding: 0.35rem;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(255, 255, 255, 0.5);
        }

        .landing-header-logo svg {
            width: 42px;
            height: 42px;
        }

        .landing-header-text {
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
            min-width: 0;
        }

        .landing-header-name {
            font-size: 1.35rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.02em;
            white-space: nowrap;
        }

        .landing-header-tagline {
            font-size: 0.78rem;
            font-weight: 500;
            opacity: 0.85;
            white-space: nowrap;
        }

        .landing-header-nav {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .landing-header-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 38px;
            padding: 0 1rem;
            border-radius: 999px;
            color: rgba(255, 255, 255, 0.92);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            transition: all 0.25s ease;
        }

        .landing-header-link:hover {
            color: white;
            text-decoration: none;
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.35);
            transform: translateY(-1px);
        }

        .landing-header-link--primary {
            background: linear-gradient(135deg, var(--primary-legible), var(--primary-dark));
            border-color: transparent;
            color: white;
            box-shadow: 0 8px 20px rgba(212, 163, 115, 0.35);
        }

        .landing-header-link--primary:hover {
            background: linear-gradient(135deg, #4b93f4, var(--primary-dark));
            color: white;
        }

        .auth-wrapper {
            width: 100%;
        }

        /* Hero Section */
        .hero-section {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.3fr);
            align-items: center;
            gap: 2rem;
            padding: 3rem 2.25rem;
            color: white;
            margin-bottom: 2rem;
            border-radius: 24px;
            background: linear-gradient(160deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.08));
            border: 1px solid rgba(255, 255, 255, 0.22);
            box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(9px);
        }

        /* Marco de ventana alrededor de la captura del producto. */
        .hero-producto {
            margin-right: -1.25rem;
        }

        @media (max-width: 900px) {
            .hero-producto {
                margin-right: 0;
            }
        }

        .hero-producto .ventana {
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.35);
        }

        .hero-producto .ventana-barra {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.55rem 0.75rem;
            background: #eef1f5;
            border-bottom: 1px solid #dfe4ea;
        }

        .hero-producto .punto {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #c7ced8;
        }

        .hero-producto img {
            display: block;
            width: 100%;
            height: auto;
        }

        @media (max-width: 900px) {
            .hero-section {
                grid-template-columns: 1fr;
                text-align: center;
                padding: 2.5rem 1.5rem;
            }

            /* En pantalla chica la captura no se lee: se muestra debajo y más contenida. */
            .hero-producto {
                max-width: 520px;
                margin: 0 auto;
            }
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.92);
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 999px;
            padding: 0.5rem 0.95rem;
            margin-bottom: 1.1rem;
        }

        .hero-section h1 {
            font-size: clamp(2rem, 3.6vw, 3.1rem);
            font-weight: 800;
            margin-bottom: 1rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.2);
            line-height: 1.12;
            letter-spacing: -0.02em;
        }

        .hero-section p {
            font-size: 1.1rem;
            margin: 0 0 2rem;
            opacity: 0.96;
            line-height: 1.6;
            max-width: 46ch;
        }

        @media (max-width: 900px) {
            .hero-section p {
                margin-left: auto;
                margin-right: auto;
            }
        }

        .login-button-hero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 190px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary-legible), var(--primary-dark));
            color: white;
            padding: 0.9rem 2.2rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 24px rgba(212, 163, 115, 0.35);
            border: none;
            cursor: pointer;
        }

        .login-button-hero:hover {
            background: var(--primary-dark);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(212, 163, 115, 0.5);
            color: white;
            text-decoration: none;
        }

        .login-button-hero:active {
            transform: translateY(-1px);
        }

        .login-button-hero i {
            margin-right: 0.5rem;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            /* Alineados con el titulo, no centrados: el hero es a dos columnas. */
            justify-content: flex-start;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        @media (max-width: 900px) {
            .hero-buttons {
                justify-content: center;
            }
        }

        .register-button-hero {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 190px;
            height: 50px;
            background: rgba(255, 255, 255, 0.08);
            color: white;
            padding: 0.9rem 1.8rem;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            transition: all 0.3s ease;
            border: 2px solid rgba(255, 255, 255, 0.9);
            cursor: pointer;
        }

        .register-button-hero:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: white;
            transform: translateY(-3px);
            color: white;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .register-button-hero i {
            margin-right: 0.5rem;
        }

        /* Promo Banner */
        .promo-banner {
            gap: 0.6rem;
            width: 100%;
            text-align: center;
            max-width: 100%;
            margin: 0 auto 1.5rem;
            background: rgba(255, 255, 255, 0.94);
            color: var(--primary-darker);
            padding: 0.75rem 1.25rem;
            border-radius: 50px;
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: 0.2px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.6);
        }

        .promo-banner i {
            font-size: 2rem;
            color: var(--accent-color);
        }

        /* Features Section */
        .features-section {
            background: white;
            /* La segunda seccion de este tipo (precios) usa el celeste suave: alternar los
               fondos le da ritmo a la pagina, que antes eran todas tarjetas blancas iguales. */
            border-radius: 15px;
            padding: 3rem 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        .features-section h2 {
            text-align: center;
            color: var(--text-color);
            margin-bottom: 2rem;
            font-size: 2rem;
            font-weight: 600;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 2rem;
        }

        .feature-card {
            text-align: center;
            padding: 2rem 1.5rem;
            border-radius: 10px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: #f8f9fa;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            background: white;
        }

        .feature-icon {
            font-size: 3rem;
            color: var(--primary-legible);
            margin-bottom: 1rem;
        }

        .feature-card h3 {
            color: var(--text-color);
            margin-bottom: 0.75rem;
            font-size: 1.25rem;
            font-weight: 600;
        }

        .feature-card p {
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 0;
        }

        /* Responsive Breakpoints */
        @media (max-width: 1200px) {
            .landing-container {
                padding: 1.5rem;
            }
        }

        @media (max-width: 992px) {
            .landing-header {
                flex-wrap: wrap;
                justify-content: center;
                text-align: center;
                padding: 0.85rem;
            }

            .landing-header-nav {
                justify-content: center;
                flex-wrap: wrap;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }

            .features-section {
                padding: 2.5rem 1.5rem;
            }

            .features-section h2 {
                font-size: 1.75rem;
            }
        }

        @media (max-width: 768px) {
            .hero-section {
                padding: 2.2rem 1rem;
            }

            .hero-kicker {
                font-size: 0.76rem;
            }

            .hero-section h1 {
                font-size: 2.45rem;
                letter-spacing: -0.01em;
            }

            .hero-section p {
                font-size: 1rem;
                padding: 0;
            }

            .landing-header-link {
                height: 36px;
                padding: 0 0.85rem;
                font-size: 0.85rem;
            }

            .cta-text {
                font-size: 1.25rem;
            }

            .cta-subtext {
                font-size: 0.9rem;
            }

            .cta-badge {
                font-size: 0.85rem;
                padding: 0.4rem 1.2rem;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.25rem;
            }

            .features-section {
                padding: 2rem 1rem;
                border-radius: 10px;
            }

            .features-section h2 {
                font-size: 1.5rem;
                margin-bottom: 1.5rem;
            }

            .feature-card {
                padding: 1.5rem 1rem;
            }

            .feature-icon {
                font-size: 2.5rem;
            }

            .feature-card h3 {
                font-size: 1.1rem;
            }

            .feature-card p {
                font-size: 0.9rem;
            }

            .auth-section {
                padding: 1.5rem;
                border-radius: 10px;
            }
        }

        @media (max-width: 576px) {
            .landing-container {
                padding: 1rem;
            }

            .landing-header {
                border-radius: 14px;
                margin-bottom: 1rem;
            }

            .landing-header-logo svg {
                width: 36px;
                height: 36px;
            }

            .landing-header-name {
                font-size: 1.1rem;
            }

            .landing-header-tagline {
                font-size: 0.72rem;
            }

            .promo-banner {
                width: 100%;
                font-size: 0.9rem;
                padding: 0.75rem 1rem;
            }

            .hero-section {
                padding: 1.8rem 0.9rem;
                border-radius: 18px;
            }

            .hero-section h1 {
                font-size: 1.9rem;
            }

            .hero-section p {
                font-size: 0.95rem;
            }

            .hero-buttons {
                flex-direction: column;
                align-items: center;
                gap: 0.75rem;
            }

            .login-button-hero,
            .register-button-hero {
                padding: 0.875rem 2rem;
                font-size: 0.95rem;
                width: 100%;
                max-width: 280px;
                text-align: center;
            }

            .features-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .features-section {
                padding: 1.5rem 1rem;
            }

            .features-section h2 {
                font-size: 1.35rem;
                margin-bottom: 1.25rem;
            }

            .feature-card {
                padding: 1.25rem 1rem;
            }

            .feature-icon {
                font-size: 2.25rem;
            }

            .cta-text {
                font-size: 1.1rem;
            }

            .cta-subtext {
                font-size: 0.85rem;
            }

            .cta-badge {
                font-size: 0.8rem;
                padding: 0.35rem 1rem;
            }

            .auth-section {
                padding: 1.25rem;
            }

            .features-section > div[style*="font-size: 3rem"] {
                font-size: 2rem !important;
            }
        }

        /* CTA Section */
        .cta-section {
            text-align: center;
            padding: 2rem 0;
            color: white;
            margin-bottom: 2rem;
            background-color: var(--secondary-color);
        }

        .cta-text {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
        }

        .cta-subtext {
            font-size: 1rem;
            opacity: 0.9;
            margin-bottom: 1rem;
        }

        .cta-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.2);
            padding: 0.5rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 500;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        /* Auth Section */
        .auth-section {
            background: white;
            border-radius: 15px;
            padding: 2.25rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            /* Un formulario de seis campos a 1400px de ancho no se lee: se acota y se centra.
               Antes el ancho lo daban las pestañas de login/registro, que ya no están. */
            width: 100%;
            max-width: 560px;
            margin: 0 auto 2rem;
        }

        .auth-encabezado {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .auth-encabezado h2 {
            color: var(--text-color);
            font-size: 1.6rem;
            margin-bottom: 0.35rem;
        }

        .auth-encabezado p {
            color: #6c757d;
            font-size: 0.95rem;
            margin: 0;
        }

        .auth-encabezado a {
            color: var(--primary-legible);
            font-weight: 600;
        }

        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.1);
        }

        .btn-primary {
            width: 100%;
            background: var(--primary-legible);
            border: none;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3);
        }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .forgot-password {
            color: var(--primary-legible);
            text-decoration: none;
        }

        .forgot-password:hover {
            text-decoration: underline;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        /* Ventajas Section - Rediseño */
        .incluido-bloque {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-darker) 100%);
            border-radius: 15px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .incluido-bloque h3 {
            color: #fff;
            text-align: center;
            font-size: 1.9rem;
            font-weight: 700;
            /* Sin la sombra del texto: sobre un fondo saturado dejaba el titulo borroso. */
            margin-bottom: 1.75rem;
        }

        .incluido-lista {
            list-style: none;
            padding: 0;
            margin: 0 auto;
            max-width: 780px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 0.75rem 2rem;
        }

        .incluido-lista li {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            color: rgba(255, 255, 255, 0.95);
            font-size: 1.02rem;
        }

        .incluido-lista i {
            color: #7dd3a7;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .ventajas-section {
            margin-bottom: 2rem;
        }

        .ventajas-title {
            text-align: center;
            color: var(--text-color);
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 2rem;
        }

        .ventajas-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.25rem;
        }

        .ventaja-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .ventaja-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 0;
            background: var(--primary-color);
            transition: height 0.3s ease;
        }

        .ventaja-card:hover {
            border-color: var(--primary-color);
            box-shadow: 0 8px 25px rgba(212, 163, 115, 0.2);
            transform: translateY(-2px);
        }

        .ventaja-card:hover::before {
            height: 100%;
        }

        .ventaja-card.ventaja-highlight {
            border-color: var(--primary-color);
            background: linear-gradient(135deg, rgba(212, 163, 115, 0.08) 0%, rgba(255,255,255,1) 100%);
        }

        .ventaja-card.ventaja-highlight::before {
            height: 100%;
            width: 4px;
        }

        .ventaja-icon {
            font-size: 2rem;
            color: var(--primary-legible);
            margin-bottom: 0.75rem;
        }

        .ventaja-card h4 {
            color: var(--text-color);
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .ventaja-card p {
            color: #6c757d;
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0;
        }

        .back-to-top-btn {
            position: fixed;
            right: 1.25rem;
            bottom: 1.25rem;
            width: 52px;
            height: 52px;
            border: none;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--primary-legible), var(--primary-dark));
            color: #fff;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
            cursor: pointer;
            z-index: 1100;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(10px);
            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
        }

        .back-to-top-btn i {
            font-size: 1.2rem;
            line-height: 1;
        }

        .back-to-top-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
        }

        .back-to-top-btn.is-visible {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0);
        }

        @media (max-width: 768px) {
            .ventajas-grid {
                grid-template-columns: 1fr;
            }

            .ventajas-title {
                font-size: 1.35rem;
            }

            .back-to-top-btn {
                right: 0.9rem;
                bottom: 0.9rem;
                width: 48px;
                height: 48px;
            }
        }

    </style>
{% endblock %}

