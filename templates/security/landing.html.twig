                <div style="padding: 1rem; background: rgba(255, 255, 255, 0.95); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <span style="color: #2c3e50; font-weight: 600;">Gestión completa de alumnos</span>
                </div>
                <div style="padding: 1rem; background: rgba(255, 255, 255, 0.95); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <span style="color: #2c3e50; font-weight: 600;">Creación ilimitada de cursos</span>
                </div>
                <div style="padding: 1rem; background: rgba(255, 255, 255, 0.95); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <span style="color: #2c3e50; font-weight: 600;">Notificaciones por email</span>
                </div>
                <div style="padding: 1rem; background: rgba(255, 255, 255, 0.95); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <span style="color: #2c3e50; font-weight: 600;">Control de asistencia</span>
                </div>
                <div style="padding: 1rem; background: rgba(255, 255, 255, 0.95); border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); text-align: center;">
                    <span style="color: #2c3e50; font-weight: 600;">Reportes y estadísticas</span>
                </div>
            </div>
