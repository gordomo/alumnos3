{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/loginform.css') }}">
{% endblock %}

{% block title %}Elegí tu contraseña{% endblock %}

{% block body %}
<div class="wrapper">
    <div id="formContent">
        <div class="logo-container">
            {{ include('security/_logo.html.twig', {'tamano': 56}) }}
            <div class="logo-nombre">{{ productos[vertical]|default('Team Builder') }}</div>
        </div>

        <h1 class="h5 text-center mb-2">Bienvenid@ a {{ usuario.instituto.nombre }}</h1>
        <p class="text-center text-muted small">
            Elegí la contraseña con la que vas a entrar a <strong>{{ usuario.email }}</strong>.
        </p>

        {% for message in app.flashes('invitacion_error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <form method="post" class="login-form">
            <input type="hidden" name="_token" value="{{ csrf_token('invitacion') }}">

            <div class="input-group">
                <input type="password" name="password" id="inputPassword" class="form-control"
                       placeholder="Contraseña nueva" autocomplete="new-password" required autofocus minlength="8">
                <button class="btn btn-outline-secondary" type="button" data-ver-clave="#inputPassword"
                        tabindex="-1" aria-label="Mostrar u ocultar la contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <div class="input-group">
                <input type="password" name="password_repetida" id="inputPasswordRepetida"
                       class="form-control" placeholder="Repetila" autocomplete="new-password"
                       required minlength="8">
                <button class="btn btn-outline-secondary" type="button" data-ver-clave="#inputPasswordRepetida"
                        tabindex="-1" aria-label="Mostrar u ocultar la contraseña">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <p class="small text-muted">Mínimo 8 caracteres.</p>

            <button class="btn btn-primary" type="submit">
                Entrar a mi {{ sustantivos[vertical]|default('instituto') }}
            </button>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Un solo mecanismo para los dos campos: cada botón dice a qué input mira. Antes el
        // script estaba atado por id a uno solo, y el de repetir la contraseña -que es donde más
        // se equivoca uno, porque hay que escribir de memoria lo que no se vio- no tenía ojo.
        document.querySelectorAll('[data-ver-clave]').forEach(function (boton) {
            boton.addEventListener('click', function () {
                const campo = document.querySelector(boton.dataset.verClave);
                const icono = boton.querySelector('i');
                if (!campo) return;

                const oculta = campo.getAttribute('type') === 'password';
                campo.setAttribute('type', oculta ? 'text' : 'password');
                icono.classList.toggle('bi-eye', !oculta);
                icono.classList.toggle('bi-eye-slash', oculta);
            });
        });
    </script>
{% endblock %}
