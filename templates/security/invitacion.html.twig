{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/loginform.css') }}">
{% endblock %}

{% block title %}Elegí tu contraseña{% endblock %}

{% block body %}
<div class="wrapper">
    <div id="formContent">
        <div class="logo-container">
            {{ include('security/_logo.html.twig', {'tamano': 56}) }}
            <div class="logo-nombre">Team Builder Institute</div>
        </div>

        <h1 class="h5 text-center mb-2">Bienvenid@ a {{ usuario.instituto.nombre }}</h1>
        <p class="text-center text-muted small">
            Elegí la contraseña con la que vas a entrar a <strong>{{ usuario.email }}</strong>.
        </p>

        {% for message in app.flashes('invitacion_error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <form method="post" class="login-form">
            <input type="hidden" name="_token" value="{{ csrf_token('invitacion') }}">

            <div class="input-group">
                <input type="password" name="password" id="inputPassword" class="form-control"
                       placeholder="Contraseña nueva" autocomplete="new-password" required autofocus minlength="8">
                <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <div class="form-group">
                <input type="password" name="password_repetida" class="form-control"
                       placeholder="Repetila" autocomplete="new-password" required minlength="8">
            </div>

            <p class="small text-muted">Mínimo 8 caracteres.</p>

            <button class="btn btn-primary" type="submit">Entrar a mi instituto</button>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.querySelector('#togglePassword');
            const password = document.querySelector('#inputPassword');
            if (!toggle || !password) return;
            const icon = toggle.querySelector('i');
            toggle.addEventListener('click', function() {
                password.setAttribute('type', password.getAttribute('type') === 'password' ? 'text' : 'password');
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });
        });
    </script>
{% endblock %}
