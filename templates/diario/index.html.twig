{% extends 'base.html.twig' %}

{% block title %}Diario de clases y materiales{% endblock %}

{% block panelTitle %}Diario de clases y materiales{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-3" style="padding-bottom: 3rem;">
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-0 small text-muted">
                Por cada curso, lo que se fue dando clase por clase y los materiales de consulta.
                El alumn@ lo ve en <strong>Mis Cursos</strong>, así que el que faltó se entera de qué
                se perdió y de dónde estudiarlo.
            </p>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Curso</th>
                        <th class="text-center">Clases registradas</th>
                        <th class="text-center">Materiales</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for curso in cursos %}
                    <tr>
                        <td>
                            <strong>{{ curso.nombre }}</strong>
                            {% if curso.horarios|length > 0 %}
                                <div class="small text-muted">
                                    {% for h in curso.horarios %}{{ h.dia }}{% if not loop.last %}, {% endif %}{% endfor %}
                                </div>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% set n = clases[curso.id]|default(0) %}
                            <span class="badge {{ n > 0 ? 'bg-primary' : 'bg-secondary' }}">{{ n }}</span>
                        </td>
                        <td class="text-center">
                            {% set m = materiales[curso.id]|default(0) %}
                            <span class="badge {{ m > 0 ? 'bg-primary' : 'bg-secondary' }}">{{ m }}</span>
                        </td>
                        <td class="text-end">
                            <a href="{{ path(rutas.curso, {'id': curso.id}) }}" class="btn btn-sm btn-primary">
                                <i class="bi bi-journal-text"></i> Abrir
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            No hay cursos para mostrar.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
