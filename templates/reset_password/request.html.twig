{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/loginform.css') }}">
{% endblock %}

{% block title %}Recuperar Contraseña{% endblock %}

{% block body %}
<div class="wrapper">
    <div id="formContent">
        <div class="logo-container">
            <img src="{{ asset('assets/img/logoteam.png') }}" alt="Logo" class="logo">
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {% for flash_success in app.flashes('success') %}
            <div class="alert alert-success" role="alert">{{ flash_success }}</div>
        {% endfor %}

        <form method="post" class="login-form" id="resetPasswordForm">
            <div class="form-group">
                <input type="email" 
                       name="email" 
                       id="inputEmail" 
                       class="form-control" 
                       placeholder="Correo electrónico"
                       autocomplete="email" 
                       required 
                       autofocus
                       {% if email is defined %}value="{{ email }}"{% endif %}>
            </div>

            <button class="btn btn-primary" type="submit">
                Enviar instrucciones
            </button>

            {% if has_valid_token is defined and has_valid_token and token is defined %}
                <div class="text-center mt-3">
                    <a href="{{ path('app_reset_password_resend', {'token': token}) }}" class="btn btn-link text-decoration-none">
                        Reenviar correo
                    </a>
                </div>
            {% endif %}

            <div class="text-center {% if has_valid_token is defined and has_valid_token %}mt-2{% else %}mt-3{% endif %}">
                {{ include('components/back_button.html.twig', {'default_path': path('app_login')}) }}
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %} 