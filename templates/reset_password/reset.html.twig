{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/loginform.css') }}">
{% endblock %}

{% block title %}Restablecer Contraseña{% endblock %}

{% block body %}
<div class="wrapper">
    <div id="formContent">
        <div class="logo-container">
            <img src="{{ asset('assets/img/logoteam.png') }}" alt="Logo" class="logo">
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_reset_password_confirm', {'token': token}) }}" class="login-form" id="resetPasswordForm">
            <div class="form-group">
                <input type="password" 
                       name="password" 
                       id="inputPassword" 
                       class="form-control" 
                       placeholder="Nueva contraseña"
                       autocomplete="new-password" 
                       required>
            </div>

            <div class="form-group">
                <input type="password" 
                       name="confirm_password" 
                       id="inputConfirmPassword" 
                       class="form-control" 
                       placeholder="Confirmar contraseña"
                       autocomplete="new-password" 
                       required>
            </div>

            <button class="btn btn-primary" type="submit">
                Restablecer contraseña
            </button>

            <div class="text-center mt-3">
                {{ include('components/back_button.html.twig', {'default_path': path('app_login')}) }}
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %} 