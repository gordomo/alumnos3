{% extends 'base.html.twig' %}

{% block title %}Asistencias de Alumnos - {{ app.user.instituto.nombre }}{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Asistencias de Alumnos - {{ app.user.instituto.nombre }}</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <form method="get" action="{{ path('app_instituto_asistencias_index') }}" class="row g-3" id="form-filtro-asistencias">
                <div class="col-md-6">
                    <label for="fecha" class="form-label">Fecha</label>
                    <input type="date" class="form-control" id="fecha" name="fecha" value="{{ fecha }}" max="{{ "now"|date("Y-m-d") }}">
                </div>
                <div class="col-md-6">
                    <label for="curso" class="form-label">Curso</label>
                    <select class="form-select chosen-select" id="curso" name="curso">
                        <option value="">Seleccione un curso</option>
                        {% for curso in cursos %}
                            <option value="{{ curso.id }}" {% if cursoSeleccionado and cursoSeleccionado.id == curso.id %}selected{% endif %}>
                                {{ curso.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Auto-filtrar cuando cambien la fecha o el curso
        document.addEventListener('DOMContentLoaded', function() {
            const formFiltro = document.getElementById('form-filtro-asistencias');
            const inputFecha = document.getElementById('fecha');
            const selectCurso = document.getElementById('curso');
            
            if (formFiltro && inputFecha && selectCurso) {
                // Auto-submit cuando cambie la fecha
                inputFecha.addEventListener('change', function() {
                    if (selectCurso.value) {
                        formFiltro.submit();
                    }
                });
                
                // Auto-submit cuando cambie el curso
                selectCurso.addEventListener('change', function() {
                    formFiltro.submit();
                });
            }
        });
    </script>

    {% set rutaForm = 'app_instituto_asistencias_index' %}
    {% set soloLectura = modo is defined and modo == 'lectura' %}
    {% include 'asistencia/_form.html.twig' %}
</div>
{% endblock %} 