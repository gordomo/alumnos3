{% extends 'base.html.twig' %}

{% block title %}Exportar Asistencias{% endblock %}

{% block panelTitle %}Exportar Asistencias{% endblock %}

{% block body %}
<div class="container-fluid pagina">
    <div class="row">
        <div class="col-md-12 text-center">
            <div class="alert alert-info">
                <h4>Exportación de Asistencias</h4>
                <p>{{ mensaje }}</p>
