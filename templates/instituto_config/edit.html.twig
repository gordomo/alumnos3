                                                            <i class="bi bi-trash"></i> Eliminar
                                                        </button>
                                                        {% else %}
                                                        <span class="badge bg-warning text-dark">Requerido</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                                
                                                <!-- Modal Editar -->
