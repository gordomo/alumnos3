                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Pestaña: Notificaciones -->
                        <div class="tab-pane fade" id="edit-notificaciones" role="tabpanel" aria-labelledby="edit-notificaciones-tab">
                            <form method="post" action="{{ path('instituto_config_edit') }}">
                                <input type="hidden" name="section" value="notificaciones">
                                <div class="card mb-3">
                                    <div class="card-header bg-secondary text-white">
                                        <h5 class="mb-0">
                                            <i class="bi bi-envelope"></i> Configuración de Notificaciones por Email
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-check mb-3">
                                            <input type="checkbox" 
                                                   class="form-check-input" 
                                                   id="enviarFacturasRecibos" 
                                                   name="enviarFacturasRecibos"
                                                   {% if configuracion.enviarFacturasRecibos %}checked{% endif %}>
                                            <label class="form-check-label" for="enviarFacturasRecibos">
                                                <strong>Enviar recibos automáticamente al registrar pagos</strong>
                                            </label>
                                            <div class="form-text text-muted">
                                                <strong>Activado:</strong> Cada vez que se registre un pago, se enviará automáticamente un email al alumno con el comprobante de pago.<br>
                                                <strong>Desactivado:</strong> Los recibos solo se pueden enviar manualmente desde el historial de emails.
                                            </div>
                                        </div>
                                        
                                        <div class="form-check mb-3">
                                            <input type="checkbox" 
                                                   class="form-check-input" 
                                                   id="enviarRecordatoriosDeudas" 
                                                   name="enviarRecordatoriosDeudas"
                                                   {% if configuracion.enviarRecordatoriosDeudas %}checked{% endif %}>
                                            <label class="form-check-label" for="enviarRecordatoriosDeudas">
                                                <strong>Enviar recordatorios de deudas automáticamente</strong>
                                            </label>
                                            <div class="form-text text-muted">
                                                <strong>Activado:</strong> Se enviarán recordatorios automáticos cada 3 días desde que se genera la deuda. Por ejemplo, si una deuda se genera el día 10, se enviarán recordatorios el día 10, 13, 16, 19, etc. <strong>Requiere configurar un cron job en el servidor.</strong><br>
                                                <strong>Desactivado:</strong> Los recordatorios solo se pueden enviar manualmente desde el botón "Enviar Recordatorio" en la vista de cada alumno (con límite de 48 horas entre envíos).
                                            </div>
                                        </div>
                                        
                                        <div class="form-check mb-3">
                                            <input type="checkbox" 
                                                   class="form-check-input" 
                                                   id="enviarRecordatorioEnDiaVencimiento" 
                                                   name="enviarRecordatorioEnDiaVencimiento"
                                                   {% if configuracion.enviarRecordatorioEnDiaVencimiento %}checked{% endif %}>
                                            <label class="form-check-label" for="enviarRecordatorioEnDiaVencimiento">
                                                <strong>Enviar recordatorio adicional en el día de vencimiento</strong>
                                            </label>
