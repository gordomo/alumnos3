{% extends 'base.html.twig' %}

{% block title %}Editar Configuración del Instituto{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">Editar Configuración del Instituto</h1>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-4 text-center mb-4">
                                <div class="mb-3">
                                    {% if instituto.logo %}
                                        <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" 
                                             alt="Logo actual" 
                                             class="img-fluid rounded mb-3"
                                             style="max-height: 200px;">
                                    {% endif %}
                                    <div class="form-group">
                                        <label for="logo" class="form-label">Logo del Instituto</label>
                                        <input type="file" 
                                               class="form-control" 
                                               id="logo" 
                                               name="logo" 
                                               accept="image/*">
                                        <small class="form-text text-muted">
                                            Formatos permitidos: JPG, PNG, GIF. Tamaño máximo: 2MB
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="nombre" class="form-label">Nombre del Instituto</label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="nombre" 
                                           name="nombre" 
                                           value="{{ instituto.nombre }}" 
                                           required>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" 
                                           class="form-control" 
                                           id="email" 
                                           name="email" 
                                           value="{{ instituto.email }}">
                                </div>
                                <div class="mb-3">
                                    <label for="tel" class="form-label">Teléfono</label>
                                    <input type="tel" 
                                           class="form-control" 
                                           id="tel" 
                                           name="tel" 
                                           maxlength="25"
                                           value="{{ instituto.tel }}">
                                </div>
                                <div class="mb-3">
                                    <label for="dir" class="form-label">Dirección</label>
                                    <textarea class="form-control" 
                                              id="dir" 
                                              name="dir" 
                                              rows="3">{{ instituto.dir }}</textarea>
                                </div>
                            </div>
                        </div>
                        
                        <hr class="my-4">
                        
                        <h4 class="mb-3">Configuración de Descuentos</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="descuentoEfectivo" class="form-label">Descuento por pago en efectivo (%)</label>
                                    <input type="number" 
                                           class="form-control" 
                                           id="descuentoEfectivo" 
                                           name="descuentoEfectivo" 
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="{{ configuracion.descuentoEfectivo }}">
                                    <small class="form-text text-muted">
                                        Porcentaje de descuento aplicado cuando se paga en efectivo. Dejar en blanco para no aplicar descuento.
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="descuentoHermanos" class="form-label">Descuento por hermanos (%)</label>
                                    <input type="number" 
                                           class="form-control" 
                                           id="descuentoHermanos" 
                                           name="descuentoHermanos" 
                                           min="0"
                                           max="100"
                                           step="0.01"
                                           value="{{ configuracion.descuentoHermanos }}">
                                    <small class="form-text text-muted">
                                        Porcentaje de descuento aplicado a alumnos con hermanos en el instituto. Dejar en blanco para no aplicar descuento.
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-check mb-3">
                                    <input type="checkbox" 
                                           class="form-check-input" 
                                           id="deshabilitarDescuentosEnDeuda" 
                                           name="deshabilitarDescuentosEnDeuda"
                                           {% if configuracion.deshabilitarDescuentosEnDeuda %}checked{% endif %}>
                                    <label class="form-check-label" for="deshabilitarDescuentosEnDeuda">
                                        Deshabilitar descuentos para alumnos con deudas
                                    </label>
                                    <div class="form-text text-muted">
                                        Si se activa esta opción, los alumnos con deudas no podrán beneficiarse de los descuentos configurados.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label for="ordenCalculoInteresesDescuentos" class="form-label">Orden de cálculo de intereses y descuentos</label>
                                    <select class="form-select" 
                                            id="ordenCalculoInteresesDescuentos" 
                                            name="ordenCalculoInteresesDescuentos">
                                        <option value="interes_primero" {% if configuracion.ordenCalculoInteresesDescuentos == 'interes_primero' %}selected{% endif %}>
                                            Interés primero, luego descuentos (recomendado)
                                        </option>
                                        <option value="descuento_primero" {% if configuracion.ordenCalculoInteresesDescuentos == 'descuento_primero' %}selected{% endif %}>
                                            Descuentos primero, luego interés
                                        </option>
                                        <option value="neto" {% if configuracion.ordenCalculoInteresesDescuentos == 'neto' %}selected{% endif %}>
                                            Neto (diferencia entre intereses y descuentos)
                                        </option>
                                        <option value="descuentos_solo_base" {% if configuracion.ordenCalculoInteresesDescuentos == 'descuentos_solo_base' %}selected{% endif %}>
                                            Descuentos sobre base, interés sobre base original
                                        </option>
                                    </select>
                                    <div class="form-text text-muted">
                                        <strong>Interés primero:</strong> Se aplica el interés sobre el monto base, luego los descuentos sobre el resultado. Ejemplo: Base $100, Interés 10% = $110, Descuento 10% = $99.<br>
                                        <strong>Descuento primero:</strong> Se aplican los descuentos sobre el monto base, luego el interés sobre el resultado. Ejemplo: Base $100, Descuento 10% = $90, Interés 10% = $99.<br>
                                        <strong>Neto:</strong> Ambos se calculan sobre la base y se hace la diferencia. Ejemplo: Base $100, Interés +$10, Descuento -$10 = $100.<br>
                                        <strong>Descuentos solo base:</strong> Los descuentos se aplican sobre la base, el interés se suma sobre la base original. Ejemplo: Base $100, Descuento 10% = $90, Interés +$10 = $100.
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                            <a href="{{ path('instituto_config_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 