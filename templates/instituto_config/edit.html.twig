{% extends 'base.html.twig' %}

{% block title %}Editar Configuración del Instituto{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">Editar Configuración del Instituto</h1>
                </div>
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-4 text-center mb-4">
                                <div class="mb-3">
                                    {% if instituto.logo %}
                                        <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" 
                                             alt="Logo actual" 
                                             class="img-fluid rounded mb-3"
                                             style="max-height: 200px;">
                                    {% endif %}
                                    <div class="form-group">
                                        <label for="logo" class="form-label">Logo del Instituto</label>
                                        <input type="file" 
                                               class="form-control" 
                                               id="logo" 
                                               name="logo" 
                                               accept="image/*">
                                        <small class="form-text text-muted">
                                            Formatos permitidos: JPG, PNG, GIF. Tamaño máximo: 2MB
                                        </small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="nombre" class="form-label">Nombre del Instituto</label>
                                    <input type="text" 
                                           class="form-control" 
                                           id="nombre" 
                                           name="nombre" 
                                           value="{{ instituto.nombre }}" 
                                           required>
                                </div>
                                <div class="mb-3">
                                    <label for="email" class="form-label">Email</label>
                                    <input type="email" 
                                           class="form-control" 
                                           id="email" 
                                           name="email" 
                                           value="{{ instituto.email }}">
                                </div>
                                <div class="mb-3">
                                    <label for="tel" class="form-label">Teléfono</label>
                                    <input type="tel" 
                                           class="form-control" 
                                           id="tel" 
                                           name="tel" 
                                           maxlength="25"
                                           value="{{ instituto.tel }}">
                                </div>
                                <div class="mb-3">
                                    <label for="dir" class="form-label">Dirección</label>
                                    <textarea class="form-control" 
                                              id="dir" 
                                              name="dir" 
                                              rows="3">{{ instituto.dir }}</textarea>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Guardar Cambios
                            </button>
                            <a href="{{ path('instituto_config_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 