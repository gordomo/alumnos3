                                        <div class="card-body">
                                            <h5 class="card-title mb-3">
                                                <i class="bi bi-plus-circle"></i> Agregar Nuevo Método de Pago
                                            </h5>
                                            <form method="post" action="{{ path('instituto_config_metodo_pago_new') }}">
                                                <div class="row g-3">
                                                    <div class="col-md-9">
                                                        <label class="form-label">Nombre del Método</label>
                                                        <input type="text" name="nombre" class="form-control" placeholder="Ej: Transferencia, Mercado Pago" required>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <label class="form-label">&nbsp;</label>
                                                        <button type="submit" class="btn btn-primary w-100">
                                                            <i class="bi bi-plus-lg"></i> Agregar
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Lista de métodos de pago -->
                                    <div class="table-responsive">
                                        <table class="table table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Orden</th>
                                                    <th>Nombre</th>
                                                    <th>Estado</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for metodo in metodos_pago %}
                                                <tr>
                                                    <td>{{ metodo.orden }}</td>
                                                    <td>
                                                        <strong>{{ metodo.nombre }}</strong>
                                                    </td>
                                                    <td>
                                                        {% if metodo.activo %}
                                                            <span class="badge bg-success">Activo</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">Inactivo</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editMetodoModal{{ metodo.id }}">
                                                            <i class="bi bi-pencil"></i> Editar
                                                        </button>
