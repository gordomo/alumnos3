                        <!-- Pestaña: Métodos de Pago -->
                        <div class="tab-pane fade" id="edit-metodos-pago" role="tabpanel" aria-labelledby="edit-metodos-pago-tab">
                            <div class="card mb-4">
                                <div class="card-header bg-info">
                                    <h4 class="card-title mb-0">
                                        <i class="bi bi-credit-card"></i> Métodos de Pago
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <div class="alert alert-info mb-4">
                                        <i class="bi bi-info-circle"></i> Configure los métodos de pago disponibles para su instituto. El método "Efectivo" aplicará automáticamente el descuento configurado en la sección de Pagos.
                                    </div>

                                    <!-- Formulario para agregar nuevo método -->
