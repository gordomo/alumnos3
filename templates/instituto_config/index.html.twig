{% extends 'base.html.twig' %}

{% block title %}Configuración del Instituto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --cfg-primary: #5c6f6c;
            --cfg-secondary: #849d9a;
            --cfg-accent: #d4a373;
            --cfg-surface: #ffffff;
            --cfg-text: #1f2a2d;
            --cfg-muted: #647079;
            --cfg-border: #e5eceb;
            --cfg-shadow: 0 10px 28px rgba(19, 44, 43, 0.1);
        }

        .config-page {
            padding: 1.2rem 0.75rem;
        }

        .config-shell {
            border: 1px solid var(--cfg-border);
            border-radius: 14px;
            box-shadow: var(--cfg-shadow);
            overflow: hidden;
        }

        .config-toolbar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 1rem;
        }

        .config-edit-btn {
            border: none;
            border-radius: 10px;
            padding: 0.5rem 0.9rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--cfg-primary), var(--cfg-secondary));
            box-shadow: 0 10px 24px rgba(92, 111, 108, 0.25);

            
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            z-index: 1030;
        
        }

        .config-edit-btn:hover {
            background: linear-gradient(135deg, #5f7471, #77908d);
        }

        .config-tabs.nav-tabs {
            border-bottom: none;
            gap: 0.45rem;
        }

        .config-tabs .nav-link {
            border-radius: 10px;
            color: #3f5359;
            border: 1px solid #dbe5e3;
            background: #f8fbfa;
            font-weight: 600;
        }

        .config-tabs .nav-link.active {
            background: linear-gradient(135deg, var(--cfg-primary), var(--cfg-secondary));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 8px 22px rgba(92, 111, 108, 0.28);
        }

        .config-section-card {
            border: 1px solid var(--cfg-border);
            border-radius: 14px;
            box-shadow: var(--cfg-shadow);
            overflow: hidden;
        }

        .config-section-header {
            color: #fff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        }

        .config-section-header--general {
            background: linear-gradient(135deg, #2f7ef0, #2368ce);
        }

        .config-section-header--payments {
            background: linear-gradient(135deg, #d4a373, #c38f5d);
            color: #2f2417;
        }

        .config-section-header--discounts {
            background: linear-gradient(135deg, #28b5d4, #1f98b4);
        }

        .config-section-header--promos {
            background: linear-gradient(135deg, #2c9e67, #228556);
        }

        .config-section-header--notify {
            background: linear-gradient(135deg, #6c7f88, #5a6b73);
        }

        .config-section-title {
            font-size: 1rem;
            font-weight: 700;
        }

        .config-data-table th {
            width: 32%;
            color: #5a6c73;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            font-weight: 700;
        }

        .config-data-table td {
            color: #27343a;
            font-weight: 500;
        }

        .config-grid-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            border-bottom-color: #dce7e4;
        }

        .config-grid-table td {
            color: #27343a;
            vertical-align: middle;
            border-top-color: #ecf2f1;
        }

        @media (max-width: 768px) {
            .config-page {
                padding: 0.9rem 0.2rem;
            }

            .config-data-table th {
                width: 45%;
            }
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Configuración del Instituto
{% endblock %}

{% block body %}
    <div class="container-fluid mt-3 config-page">
        <div class="row">
            <div class="col-md-12">
                <div class="card config-shell">
                    <div class="card-body">
                        <div class="config-toolbar">
                            <a href="{{ path('instituto_config_edit') }}" id="btn-editar-config" class="btn btn-primary config-edit-btn">
                                <i class="bi bi-pencil"></i> Editar Configuración
                            </a>
                        </div>

                        <!-- Pestañas -->
                        <ul class="nav nav-tabs config-tabs mb-4" id="configTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                                    <i class="bi bi-building"></i> Información General
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="pagos-tab" data-bs-toggle="tab" data-bs-target="#pagos" type="button" role="tab" aria-controls="pagos" aria-selected="false">
                                    <i class="bi bi-cash-coin"></i> Pagos y Vencimientos
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="descuentos-tab" data-bs-toggle="tab" data-bs-target="#descuentos" type="button" role="tab" aria-controls="descuentos" aria-selected="false">
                                    <i class="bi bi-percent"></i> Descuentos
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="metodos-pago-tab" data-bs-toggle="tab" data-bs-target="#metodos-pago" type="button" role="tab" aria-controls="metodos-pago" aria-selected="false">
                                    <i class="bi bi-credit-card"></i> Métodos de Pago
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="notificaciones-tab" data-bs-toggle="tab" data-bs-target="#notificaciones" type="button" role="tab" aria-controls="notificaciones" aria-selected="false">
                                    <i class="bi bi-envelope"></i> Notificaciones
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="configTabsContent">
                            <!-- Pestaña: Información General -->
                            <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                        <div class="card config-section-card mb-4">
                                    <div class="card-header config-section-header config-section-header--general">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-building"></i> Información General del Instituto
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 text-center mb-4">
                                        {% if instituto.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" 
                                                 alt="Logo del Instituto" 
                                                         class="img-fluid rounded shadow-sm"
                                                 style="max-height: 200px;">
                                        {% else %}
                                                    <div class="bg-light p-4 rounded shadow-sm">
                                                <i class="fas fa-building fa-4x text-muted"></i>
                                                        <p class="mt-2 text-muted">Sin logo</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-md-8">
                                                <table class="table table-borderless config-data-table">
                                            <tr>
                                                        <th width="30%">Nombre:</th>
                                                        <td><strong>{{ instituto.nombre }}</strong></td>
                                            </tr>
                                            <tr>
                                                <th>Email:</th>
                                                        <td>
                                                            {% if instituto.email %}
                                                                {{ instituto.email }}
                                                            {% else %}
                                                                <span class="text-muted">No especificado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Teléfono:</th>
                                                        <td>
                                                            {% if instituto.tel %}
                                                                {{ instituto.tel }}
                                                            {% else %}
                                                                <span class="text-muted">No especificado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Dirección:</th>
                                                        <td>
                                                            {% if instituto.dir %}
                                                                {{ instituto.dir }}
                                                            {% else %}
                                                                <span class="text-muted">No especificada</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Zona horaria:</th>
                                                        <td>
                                                            {% if configuracion.timezone %}
                                                                {{ configuracion.timezone }}
                                                            {% else %}
                                                                <span class="text-muted">Zona horaria no configurada</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>  
                                            <tr>
                                                <th>Formato de fecha:</th>
                                                        <td>
                                                            {% if configuracion.dateFormat %}
                                                                {{ configuracion.dateFormat }}
                                                            {% else %}
                                                                <span class="text-muted">Formato de fecha no configurado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>   
                                        </table>
                                    </div>
                                </div>
                                    </div>
                                </div>

                                <!-- Configuración Académica -->
                                <div class="card config-section-card mt-4">
                                    <div class="card-header config-section-header config-section-header--general">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-mortarboard"></i> Configuración Académica
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-borderless config-data-table">
                                            <tr>
                                                <th width="40%">% mínimo de asistencia para aprobar:</th>
                                                <td>
                                                    {% if configuracion.porcentajeAsistenciaAprobacion is not null %}
                                                        <span class="badge bg-primary">{{ configuracion.porcentajeAsistenciaAprobacion }}%</span>
                                                        <small class="text-muted d-block">Al finalizar un curso, se verificará que el alumno cumpla este porcentaje de asistencia</small>
                                                    {% else %}
                                                        <span class="badge bg-secondary">No configurado</span>
                                                        <small class="text-muted d-block">No se verifica asistencia al finalizar un curso. Todos los alumnos se marcan como "Finalizado".</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Pago total del curso requerido para aprobar:</th>
                                                <td>
                                                    {% if configuracion.requierePagoTotalParaAprobar %}
                                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activado</span>
                                                        <small class="text-muted d-block">El alumno debe tener todas las cuotas del curso pagadas para aprobar</small>
                                                    {% else %}
                                                        <span class="badge bg-secondary">Desactivado</span>
                                                        <small class="text-muted d-block">No se verifica el pago de cuotas al finalizar un curso</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Pestaña: Pagos y Vencimientos -->
                            <div class="tab-pane fade" id="pagos" role="tabpanel" aria-labelledby="pagos-tab">
                                <!-- Vencimientos -->
                                <div class="card config-section-card">
                                    <div class="card-header config-section-header config-section-header--payments">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-calendar-event"></i> Vencimientos e Intereses
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-striped table-hover config-grid-table">
                                                <thead>
                                                    <tr>
                                                        <th>Día de Vencimiento</th>
                                                        <th>Porcentaje de Interés</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for vencimiento in vencimientos %}
                                                        <tr>
                                                            <td><strong>Día {{ vencimiento.diaVencimiento }}</strong></td>
                                                            <td><span class="badge bg-success text-white">{{ vencimiento.porcentajeInteres }}%</span></td>
                                                        </tr>
                                                    {% else %}
                                                        <tr>
                                                            <td colspan="2" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox"></i> No se encontraron vencimientos configurados
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                </div>
                            </div>
                        </div>
                            </div>

                            <!-- Pestaña: Descuentos -->
                            <div class="tab-pane fade" id="descuentos" role="tabpanel" aria-labelledby="descuentos-tab">
                                <!-- Configuración de Descuentos -->
                                <div class="card config-section-card mb-4">
                                    <div class="card-header config-section-header config-section-header--discounts">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-percent"></i> Configuración de Descuentos
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                                <table class="table table-borderless config-data-table">
                                                    <tr>
                                                        <th width="40%">Descuento por pago en efectivo:</th>
                                                        <td>
                                                            {% if configuracion.descuentoEfectivo is not null %}
                                                                <span class="badge bg-success">{{ configuracion.descuentoEfectivo }}%</span>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Descuento por hermanos:</th>
                                                        <td>
                                                            {% if configuracion.descuentoHermanos is not null %}
                                                                <span class="badge bg-success">{{ configuracion.descuentoHermanos }}%</span>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Habilitar descuentos en deuda:</th>
                                                <td>
                                                    {% if not configuracion.deshabilitarDescuentosEnDeuda %}
                                                        <span class="badge bg-success">Sí</span>
                                                        <small class="text-muted">(Los alumnos con deudas reciben descuentos)</small>
                                                    {% else %}
                                                        <span class="badge bg-warning">No</span>
                                                        <small class="text-muted">(Los alumnos con deudas no reciben descuentos normalmente)</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Orden de cálculo:</th>
                                                <td>
                                                    {% set ordenTexto = {
                                                        'interes_primero': 'Interés primero, luego descuentos',
                                                        'descuento_primero': 'Descuentos primero, luego interés',
                                                        'neto': 'Neto (diferencia entre intereses y descuentos)',
                                                        'descuentos_solo_base': 'Descuentos sobre base, interés sobre base original'
                                                    } %}
                                                    <span class="badge bg-primary">{{ ordenTexto[configuracion.ordenCalculoInteresesDescuentos] ?? 'Interés primero, luego descuentos' }}</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                    </div>
                        </div>

                                <!-- Descuentos Promocionales -->
                                <div class="card config-section-card">
                                    <div class="card-header config-section-header config-section-header--promos">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-tag"></i> Descuentos Promocionales
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                            <table class="table table-bordered table-striped table-hover config-grid-table">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Porcentaje</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for descuento in descuentosPromocionales %}
                                                <tr>
                                                    <td>{{ descuento.nombre }}</td>
                                                            <td><strong>{{ descuento.porcentaje }}%</strong></td>
                                                    <td>
                                                        {% if descuento.activo %}
                                                            <span class="badge bg-success">Activo</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">Inactivo</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                            <td colspan="3" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox"></i> No se encontraron descuentos promocionales configurados
                                                            </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                  <div class="card-body">
                                        <div class="alert alert-info mb-4">
                                            <i class="bi bi-info-circle"></i> Métodos de pago disponibles en su instituto. El método "Efectivo" aplicará automáticamente el descuento configurado en la sección de Pagos.
                                        </div>

                                        <!-- Lista de métodos de pago (solo lectura) -->
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead>
                                                    <tr>
                                                                       <th>Nombre</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for metodo in metodos_pago %}
                                                    <tr>
                                                        <td>
                                                            <strong>{{ metodo.nombre }}</strong>
                                                        </td>
                                                        <td>
                                                            {% if metodo.activo %}
                                                                <span class="badge bg-success">Activo</span>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Inactivo</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pestaña: Notificaciones -->
                            <div class="tab-pane fade" id="notificaciones" role="tabpanel" aria-labelledby="notificaciones-tab">
                        <div class="card config-section-card">
                                    <div class="card-header config-section-header config-section-header--notify">
                                        <h4 class="card-title config-section-title mb-0">
                                            <i class="bi bi-envelope"></i> Configuración de Notificaciones por Email
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <table class="table table-borderless config-data-table">
                                                    <tr>
                                                        <th width="40%">Enviar emails con facturas/recibos:</th>
                                                        <td>
                                                            {% if configuracion.enviarFacturasRecibos %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Se enviará automáticamente un email al registrar un pago</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Enviar recordatorios de deudas:</th>
                                                        <td>
                                                            {% if configuracion.enviarRecordatoriosDeudas %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Permite enviar emails manuales recordando deudas pendientes</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Recordatorio automático el día de vencimiento:</th>
                                                        <td>
                                                            {% if configuracion.enviarRecordatorioEnDiaVencimiento %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Se enviará automáticamente un email el primer día de vencimiento configurado</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Texto personalizado para emails:</th>
                                                        <td>
                                                            {% if configuracion.textoPersonalizadoEmail %}
                                                                <div class="alert alert-light">
                                                                    {{ configuracion.textoPersonalizadoEmail|raw|nl2br }}
                                                                </div>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

</div>
    </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const urlActual = new URL(window.location.href);
            const tabParam = urlActual.searchParams.get('tab');
            if (tabParam) {
                const tabElement = document.getElementById(tabParam + '-tab');
                if (tabElement) {
                    const tab = new bootstrap.Tab(tabElement);
                    tab.show();
                }
            }

            const btnEditar = document.getElementById('btn-editar-config');
            if (btnEditar) {
                btnEditar.addEventListener('click', function(e) {
                    const tabActivo = document.querySelector('#configTabs .nav-link.active');
                    if (tabActivo) {
                        const target = tabActivo.getAttribute('data-bs-target');
                        const tabId = target ? target.replace('#', '') : 'general';
                        const url = new URL(btnEditar.href);
                        url.searchParams.set('tab', tabId);
                        btnEditar.href = url.toString();
                    }
                });
            }
        });
    </script>
{% endblock %} 
