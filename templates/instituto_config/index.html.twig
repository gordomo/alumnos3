{% extends 'base.html.twig' %}

{% block title %}Configuración del Instituto{% endblock %}

{% block panelTitle %}
    Configuración del Instituto
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Información General</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 text-center mb-4">
                                        {% if instituto.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" 
                                                 alt="Logo del Instituto" 
                                                 class="img-fluid rounded"
                                                 style="max-height: 200px;">
                                        {% else %}
                                            <div class="bg-light p-4 rounded">
                                                <i class="fas fa-building fa-4x text-muted"></i>
                                                <p class="mt-2">Sin logo</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-md-8">
                                        <table class="table">
                                            <tr>
                                                <th>Nombre:</th>
                                                <td>{{ instituto.nombre }}</td>
                                            </tr>
                                            <tr>
                                                <th>Email:</th>
                                                <td>{{ instituto.email ?? 'No especificado' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Teléfono:</th>
                                                <td>{{ instituto.tel ?? 'No especificado' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Dirección:</th>
                                                <td>{{ instituto.dir ?? 'No especificada' }}</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="text-center mt-4">
                                    <a href="{{ path('instituto_config_edit') }}" class="btn btn-primary">
                                        <i class="bi bi-pencil"></i> Editar Información
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Configuración de Descuentos</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                        <table class="table">
                                            <tr>
                                                <th>Descuento por pago en efectivo:</th>
                                                <td>{{ configuracion.descuentoEfectivo is not null ? configuracion.descuentoEfectivo ~ '%' : 'No configurado' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Descuento por hermanos:</th>
                                                <td>{{ configuracion.descuentoHermanos is not null ? configuracion.descuentoHermanos ~ '%' : 'No configurado' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Deshabilitar descuentos en deuda:</th>
                                                <td>
                                                    {% if configuracion.deshabilitarDescuentosEnDeuda %}
                                                        <span class="badge bg-warning">Sí</span> 
                                                        <small class="text-muted">(Los alumnos con deudas no reciben descuentos)</small>
                                                    {% else %}
                                                        <span class="badge bg-success">No</span>
                                                        <small class="text-muted">(Los alumnos con deudas reciben descuentos normalmente)</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Orden de cálculo:</th>
                                                <td>
                                                    {% set ordenTexto = {
                                                        'interes_primero': 'Interés primero, luego descuentos',
                                                        'descuento_primero': 'Descuentos primero, luego interés',
                                                        'neto': 'Neto (diferencia entre intereses y descuentos)',
                                                        'descuentos_solo_base': 'Descuentos sobre base, interés sobre base original'
                                                    } %}
                                                    <span class="badge bg-primary">{{ ordenTexto[configuracion.ordenCalculoInteresesDescuentos] ?? 'Interés primero, luego descuentos' }}</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                <div class="text-center mt-4">
                                    <a href="{{ path('instituto_config_edit') }}" class="btn btn-primary">
                                        <i class="bi bi-pencil"></i> Editar Configuración de Descuentos
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Descuentos Promocionales</h4>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <a href="{{ path('instituto_config_descuento_promocional_new') }}" class="btn btn-primary">
                                        <i class="bi bi-plus"></i> Nuevo Descuento Promocional
                                    </a>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Porcentaje</th>
                                                <th>Estado</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for descuento in descuentosPromocionales %}
                                                <tr>
                                                    <td>{{ descuento.nombre }}</td>
                                                    <td>{{ descuento.porcentaje }}%</td>
                                                    <td>
                                                        {% if descuento.activo %}
                                                            <span class="badge bg-success">Activo</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">Inactivo</span>
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('instituto_config_descuento_promocional_edit', {'id': descuento.id}) }}" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <form method="post" action="{{ path('instituto_config_descuento_promocional_delete', {'id': descuento.id}) }}" onsubmit="return confirm('¿Está seguro que desea eliminar este descuento promocional?');" style="display: inline-block;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ descuento.id) }}">
                                                            <button class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                    <td colspan="4" class="text-center">No se encontraron descuentos promocionales configurados</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h4 class="card-title mb-0">Vencimientos</h4>
                            </div>
                            <div class="card-body">
                                <div class="mb-3">
                                    <a href="{{ path('instituto_config_vencimiento_new') }}" class="btn btn-primary">
                                        <i class="bi bi-plus"></i> Nuevo Vencimiento
                                    </a>
                                </div>

                                {% for message in app.flashes('success') %}
                                    <div class="alert alert-success">
                                        {{ message }}
                                    </div>
                                {% endfor %}

                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Día de Vencimiento</th>
                                                <th>Porcentaje de Interés</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for vencimiento in vencimientos %}
                                                <tr>
                                                    <td>{{ vencimiento.diaVencimiento }}</td>
                                                    <td>{{ vencimiento.porcentajeInteres }}%</td>
                                                    <td>
                                                        <a href="{{ path('instituto_config_vencimiento_edit', {'id': vencimiento.id}) }}" class="btn btn-sm btn-outline-primary">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <form method="post" action="{{ path('instituto_config_vencimiento_delete', {'id': vencimiento.id}) }}" onsubmit="return confirm('¿Está seguro que desea eliminar este vencimiento?');" style="display: inline-block;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vencimiento.id) }}">
                                                            <button class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                    <td colspan="4" class="text-center">No se encontraron vencimientos configurados</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 