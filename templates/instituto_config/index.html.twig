{% extends 'base.html.twig' %}

{% block title %}Configuración del Instituto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .collapse-icon {
            transition: transform 0.3s ease;
        }
        [data-bs-toggle="collapse"][aria-expanded="true"] .collapse-icon {
            transform: rotate(180deg);
        }
        [data-bs-toggle="collapse"]:hover {
            background-color: rgba(0,0,0,0.02);
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Configuración del Instituto
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="text-end mb-4">
                            <a href="{{ path('instituto_config_edit') }}" class="btn btn-primary">
                                <i class="bi bi-pencil"></i> Editar Configuración
                            </a>
                        </div>

                        <!-- Pestañas -->
                        <ul class="nav nav-tabs mb-4" id="configTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" aria-controls="general" aria-selected="true">
                                    <i class="bi bi-building"></i> Información General
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="pagos-tab" data-bs-toggle="tab" data-bs-target="#pagos" type="button" role="tab" aria-controls="pagos" aria-selected="false">
                                    <i class="bi bi-cash-coin"></i> Pagos y Vencimientos
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="descuentos-tab" data-bs-toggle="tab" data-bs-target="#descuentos" type="button" role="tab" aria-controls="descuentos" aria-selected="false">
                                    <i class="bi bi-percent"></i> Descuentos
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="notificaciones-tab" data-bs-toggle="tab" data-bs-target="#notificaciones" type="button" role="tab" aria-controls="notificaciones" aria-selected="false">
                                    <i class="bi bi-envelope"></i> Notificaciones
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tokens-tab" data-bs-toggle="tab" data-bs-target="#tokens" type="button" role="tab" aria-controls="tokens" aria-selected="false">
                                    <i class="bi bi-coin"></i> Tokens
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de las pestañas -->
                        <div class="tab-content" id="configTabsContent">
                            <!-- Pestaña: Información General -->
                            <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                        <div class="card mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-building"></i> Información General del Instituto
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4 text-center mb-4">
                                        {% if instituto.logo %}
                                            <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" 
                                                 alt="Logo del Instituto" 
                                                         class="img-fluid rounded shadow-sm"
                                                 style="max-height: 200px;">
                                        {% else %}
                                                    <div class="bg-light p-4 rounded shadow-sm">
                                                <i class="fas fa-building fa-4x text-muted"></i>
                                                        <p class="mt-2 text-muted">Sin logo</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="col-md-8">
                                                <table class="table table-borderless">
                                            <tr>
                                                        <th width="30%">Nombre:</th>
                                                        <td><strong>{{ instituto.nombre }}</strong></td>
                                            </tr>
                                            <tr>
                                                <th>Email:</th>
                                                        <td>{{ instituto.email ?? '<span class="text-muted">No especificado</span>' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Teléfono:</th>
                                                        <td>{{ instituto.tel ?? '<span class="text-muted">No especificado</span>' }}</td>
                                            </tr>
                                            <tr>
                                                <th>Dirección:</th>
                                                        <td>{{ instituto.dir ?? '<span class="text-muted">No especificada</span>' }}</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pestaña: Pagos y Vencimientos -->
                            <div class="tab-pane fade" id="pagos" role="tabpanel" aria-labelledby="pagos-tab">
                                <!-- Vencimientos -->
                                <div class="card">
                                    <div class="card-header bg-warning text-dark">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-calendar-event"></i> Vencimientos e Intereses
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-bordered table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Día de Vencimiento</th>
                                                        <th>Porcentaje de Interés</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for vencimiento in vencimientos %}
                                                        <tr>
                                                            <td><strong>Día {{ vencimiento.diaVencimiento }}</strong></td>
                                                            <td><span class="badge bg-warning text-dark">{{ vencimiento.porcentajeInteres }}%</span></td>
                                                        </tr>
                                                    {% else %}
                                                        <tr>
                                                            <td colspan="2" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox"></i> No se encontraron vencimientos configurados
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                </div>
                            </div>
                        </div>
                            </div>

                            <!-- Pestaña: Descuentos -->
                            <div class="tab-pane fade" id="descuentos" role="tabpanel" aria-labelledby="descuentos-tab">
                                <!-- Configuración de Descuentos -->
                                <div class="card mb-4">
                                    <div class="card-header bg-info text-white">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-percent"></i> Configuración de Descuentos
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12">
                                                <table class="table table-borderless">
                                                    <tr>
                                                        <th width="40%">Descuento por pago en efectivo:</th>
                                                        <td>
                                                            {% if configuracion.descuentoEfectivo is not null %}
                                                                <span class="badge bg-success">{{ configuracion.descuentoEfectivo }}%</span>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Descuento por hermanos:</th>
                                                        <td>
                                                            {% if configuracion.descuentoHermanos is not null %}
                                                                <span class="badge bg-success">{{ configuracion.descuentoHermanos }}%</span>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                            </tr>
                                            <tr>
                                                <th>Deshabilitar descuentos en deuda:</th>
                                                <td>
                                                    {% if configuracion.deshabilitarDescuentosEnDeuda %}
                                                        <span class="badge bg-warning">Sí</span> 
                                                        <small class="text-muted">(Los alumnos con deudas no reciben descuentos)</small>
                                                    {% else %}
                                                        <span class="badge bg-success">No</span>
                                                        <small class="text-muted">(Los alumnos con deudas reciben descuentos normalmente)</small>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            <tr>
                                                <th>Orden de cálculo:</th>
                                                <td>
                                                    {% set ordenTexto = {
                                                        'interes_primero': 'Interés primero, luego descuentos',
                                                        'descuento_primero': 'Descuentos primero, luego interés',
                                                        'neto': 'Neto (diferencia entre intereses y descuentos)',
                                                        'descuentos_solo_base': 'Descuentos sobre base, interés sobre base original'
                                                    } %}
                                                    <span class="badge bg-primary">{{ ordenTexto[configuracion.ordenCalculoInteresesDescuentos] ?? 'Interés primero, luego descuentos' }}</span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                                    </div>
                        </div>

                                <!-- Descuentos Promocionales -->
                                <div class="card">
                                    <div class="card-header bg-success text-white">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-tag"></i> Descuentos Promocionales
                                        </h4>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                            <table class="table table-bordered table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Porcentaje</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for descuento in descuentosPromocionales %}
                                                <tr>
                                                    <td>{{ descuento.nombre }}</td>
                                                            <td><strong>{{ descuento.porcentaje }}%</strong></td>
                                                    <td>
                                                        {% if descuento.activo %}
                                                            <span class="badge bg-success">Activo</span>
                                                        {% else %}
                                                            <span class="badge bg-secondary">Inactivo</span>
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% else %}
                                                <tr>
                                                            <td colspan="3" class="text-center text-muted py-4">
                                                                <i class="bi bi-inbox"></i> No se encontraron descuentos promocionales configurados
                                                            </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                        </div>
                                </div>
                            </div>
                        </div>

                            <!-- Pestaña: Notificaciones -->
                            <div class="tab-pane fade" id="notificaciones" role="tabpanel" aria-labelledby="notificaciones-tab">
                        <div class="card">
                                    <div class="card-header bg-secondary text-white">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-envelope"></i> Configuración de Notificaciones por Email
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <table class="table table-borderless">
                                                    <tr>
                                                        <th width="40%">Enviar emails con facturas/recibos:</th>
                                                        <td>
                                                            {% if configuracion.enviarFacturasRecibos %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Se enviará automáticamente un email al registrar un pago</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Enviar recordatorios de deudas:</th>
                                                        <td>
                                                            {% if configuracion.enviarRecordatoriosDeudas %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Permite enviar emails manuales recordando deudas pendientes</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Recordatorio automático el día de vencimiento:</th>
                                                        <td>
                                                            {% if configuracion.enviarRecordatorioEnDiaVencimiento %}
                                                                <span class="badge bg-success">Activado</span>
                                                                <small class="text-muted d-block">Se enviará automáticamente un email el primer día de vencimiento configurado</small>
                                                            {% else %}
                                                                <span class="badge bg-secondary">Desactivado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <th>Texto personalizado para emails:</th>
                                                        <td>
                                                            {% if configuracion.textoPersonalizadoEmail %}
                                                                <div class="alert alert-light">
                                                                    {{ configuracion.textoPersonalizadoEmail|raw|nl2br }}
                                                                </div>
                                                            {% else %}
                                                                <span class="text-muted">No configurado</span>
                                                            {% endif %}
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Pestaña: Tokens -->
                            <div class="tab-pane fade" id="tokens" role="tabpanel" aria-labelledby="tokens-tab">
                                {% set now = date() %}
                                {% set firstOfNextMonth = now|date_modify('first day of next month')|date('Y-m-d') %}
                                {% set daysUntilReset = (firstOfNextMonth|date('U') - now|date('U')) / 86400 %}
                                {% set isUrgent = daysUntilReset <= 7 %}
                                {% set isVeryUrgent = daysUntilReset <= 3 %}
                                
                                {% if isUrgent %}
                                <!-- Alerta Urgente de Reseteo (Solo si faltan 7 días o menos) -->
                                <div class="row mb-3">
                                    <div class="col-12">
                                        <div class="alert {% if isVeryUrgent %}alert-danger{% else %}alert-warning{% endif %} border-0 shadow-sm mb-0" style="{% if isVeryUrgent %}background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;{% else %}background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #212529;{% endif %}">
                                            <div class="d-flex align-items-center justify-content-between flex-wrap">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-exclamation-triangle-fill me-2" style="font-size: 1.5rem;"></i>
                                                    <div>
                                                        <strong style="font-size: 1.1rem;">
                                                            {% if isVeryUrgent %}
                                                                ⚠️ ¡ATENCIÓN! El reseteo de tokens es en {{ daysUntilReset|round }} día{{ daysUntilReset|round != 1 ? 's' : '' }}!
                                                            {% else %}
                                                                ⏰ El reseteo mensual de tokens es en {{ daysUntilReset|round }} día{{ daysUntilReset|round != 1 ? 's' : '' }}
                                                            {% endif %}
                                                        </strong>
                                                        <div class="small mt-1" style="opacity: 0.9;">
                                                            Todos los tokens se resetean a 0 el {{ firstOfNextMonth|date('d/m/Y') }}
                                                        </div>
                                                    </div>
                                                </div>
                                                {% if tokenBalance.balance > 0 %}
                                                    <div class="mt-2 mt-md-0">
                                                        <span class="badge {% if isVeryUrgent %}bg-light text-danger{% else %}bg-light text-warning{% endif %}" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                                            <i class="bi bi-coin"></i> {{ tokenBalance.balance }} tokens disponibles
                                                        </span>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}
                                
                                <div class="row mb-4">
                                    <div class="col-md-4">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body text-center">
                                                <h5 class="card-title text-muted mb-3">Balance Actual</h5>
                                                <h2 class="display-4 mb-0" style="color: {% if tokenBalance.balance > 100 %}green{% elseif tokenBalance.balance > 20 %}orange{% else %}red{% endif %};">
                                                    {{ tokenBalance.balance }}
                                                </h2>
                                                <p class="text-muted mt-2 mb-0">tokens disponibles</p>
                                                <small class="text-muted">Actualizado: {{ tokenBalance.updatedAt|date('d/m/Y H:i') }}</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body text-center">
                                                <h5 class="card-title text-muted mb-3">Consumo Semanal</h5>
                                                <h2 class="display-4 mb-0 text-primary">{{ weeklyConsumption }}</h2>
                                                <p class="text-muted mt-2 mb-0">tokens consumidos</p>
                                                <small class="text-muted">Esta semana</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card shadow-sm border-0">
                                            <div class="card-body text-center">
                                                <h5 class="card-title text-muted mb-3">Consumo Mensual</h5>
                                                <h2 class="display-4 mb-0 text-info">{{ monthlyConsumption }}</h2>
                                                <p class="text-muted mt-2 mb-0">tokens consumidos</p>
                                                <small class="text-muted">Este mes</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Información básica -->
                                <div class="card mb-3">
                                    <div class="card-header bg-warning text-dark">
                                        <h4 class="card-title mb-0">
                                            <i class="bi bi-coin"></i> Información sobre Tokens
                                        </h4>
                            </div>
                            <div class="card-body">
                                        {% set now = date() %}
                                        {% set firstOfNextMonth = now|date_modify('first day of next month')|date('Y-m-d') %}
                                        {% set daysUntilReset = (firstOfNextMonth|date('U') - now|date('U')) / 86400 %}
                                        {% set isUrgent = daysUntilReset <= 7 %}
                                        {% set isVeryUrgent = daysUntilReset <= 3 %}
                                        
                                        <div class="alert {% if isVeryUrgent %}alert-danger{% elseif isUrgent %}alert-warning{% else %}alert-info{% endif %} border-0 shadow-sm" style="{% if isVeryUrgent %}background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;{% elseif isUrgent %}background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #212529;{% else %}background: linear-gradient(135deg, #17a2b8 0%, #138496 100%); color: white;{% endif %}">
                                            <div class="d-flex align-items-start">
                                                <div class="flex-shrink-0 me-3">
                                                    <i class="bi bi-calendar-x-fill" style="font-size: 2.5rem; {% if not isVeryUrgent and not isUrgent %}opacity: 0.9;{% endif %}"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <h5 class="alert-heading mb-3 d-flex align-items-center">
                                                        <span class="me-2">Reseteo Mensual de Tokens</span>
                                                        {% if isVeryUrgent %}
                                                            <span class="badge bg-light text-danger ms-2">¡URGENTE!</span>
                                                        {% elseif isUrgent %}
                                                            <span class="badge bg-light text-warning ms-2">Próximo</span>
                                                        {% endif %}
                                                    </h5>
                                                    
                                <div class="mb-3">
                                                        <p class="mb-2" style="font-size: 1.05rem;">
                                                            <strong>⚠️ Importante:</strong> Todos los tokens se resetean a <strong>0</strong> el día <strong>1 de cada mes</strong>.
                                                        </p>
                                                        
                                                        <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-calendar3 me-2" style="font-size: 1.2rem;"></i>
                                                                <span><strong>Próximo reseteo:</strong> {{ firstOfNextMonth|date('d/m/Y') }}</span>
                                                            </div>
                                                            <div class="d-flex align-items-center">
                                                                <i class="bi bi-clock-history me-2" style="font-size: 1.2rem;"></i>
                                                                <span>
                                                                    <strong>Faltan:</strong> 
                                                                    <span class="badge {% if isVeryUrgent %}bg-light text-danger{% elseif isUrgent %}bg-light text-warning{% else %}bg-light text-info{% endif %}" style="font-size: 1rem; padding: 0.5rem 0.75rem;">
                                                                        {{ daysUntilReset|round }} día{{ daysUntilReset|round != 1 ? 's' : '' }}
                                                                    </span>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                    <hr style="border-color: {% if isVeryUrgent or isUrgent %}rgba(255,255,255,0.3){% else %}rgba(0,0,0,0.1){% endif %}; margin: 1rem 0;">
                                                    
                                                    <div class="d-flex align-items-start">
                                                        <i class="bi bi-lightbulb-fill me-2 mt-1" style="font-size: 1.1rem;"></i>
                                                        <div>
                                                            <strong>💡 Recomendación:</strong>
                                                            <ul class="mb-0 mt-1" style="padding-left: 1.2rem; font-size: 0.95rem;">
                                                                <li>Usa tus tokens antes del fin de mes para aprovecharlos al máximo</li>
                                                                <li>Solicita tokens cerca del día 1 para tener todo el mes para usarlos</li>
                                                                {% if tokenBalance.balance > 0 %}
                                                                    <li>Tienes <strong>{{ tokenBalance.balance }} tokens</strong> disponibles - ¡úsalos antes del reseteo!</li>
                                                                {% endif %}
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="alert alert-info">
                                            <h5 class="alert-heading"><i class="bi bi-info-circle"></i> ¿Qué son los Tokens?</h5>
                                            <p>Los tokens son unidades de consumo que se utilizan para realizar acciones en el sistema. Cada acción tiene un costo en tokens que se descuenta de tu balance.</p>
                                        </div>
                                        
                                        {% if tokenBalance.balance < 20 %}
                                            <div class="alert alert-warning">
                                                <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Tokens Insuficientes</h5>
                                                <p class="mb-0">Tu balance de tokens está bajo. Contacta al administrador para solicitar más tokens.</p>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <!-- Gestión Completa (Colapsada) -->
                                <div class="card">
                                    <div class="card-header bg-light">
                                        <button class="btn btn-link text-decoration-none w-100 text-start p-0" type="button" data-bs-toggle="collapse" data-bs-target="#gestionCompletaTokens" aria-expanded="false" aria-controls="gestionCompletaTokens">
                                            <h5 class="mb-0 d-flex justify-content-between align-items-center">
                                                <span><i class="bi bi-coin"></i> Gestión Completa de Tokens</span>
                                                <i class="bi bi-chevron-down collapse-icon"></i>
                                            </h5>
                                        </button>
                                    </div>
                                    <div class="collapse" id="gestionCompletaTokens">
                                        <div class="card-body">
                                            <!-- Consumo por Acción -->
                                            <div class="row mb-4">
                                                <div class="col-md-6">
                                                    <div class="card shadow-sm border-0">
                                                        <div class="card-header bg-white">
                                                            <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Consumo Semanal por Acción</h5>
                                                        </div>
                                                        <div class="card-body">
                                                            {% if weeklyConsumptionByAction|length > 0 %}
                                                                <div class="table-responsive">
                                                                    <table class="table table-sm">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Acción</th>
                                                                                <th class="text-end">Tokens</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            {% for item in weeklyConsumptionByAction %}
                                                                                <tr>
                                                                                    <td>{{ item.action }}</td>
                                                                                    <td class="text-end"><strong>{{ item.total }}</strong></td>
                                                                                </tr>
                                {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            {% else %}
                                                                <p class="text-muted text-center mb-0">No hay consumo esta semana</p>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="card shadow-sm border-0">
                                                        <div class="card-header bg-white">
                                                            <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Consumo Mensual por Acción</h5>
                                                        </div>
                                                        <div class="card-body">
                                                            {% if monthlyConsumptionByAction|length > 0 %}
                                <div class="table-responsive">
                                                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                                                <th>Acción</th>
                                                                                <th class="text-end">Tokens</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                                                            {% for item in monthlyConsumptionByAction %}
                                                                                <tr>
                                                                                    <td>{{ item.action }}</td>
                                                                                    <td class="text-end"><strong>{{ item.total }}</strong></td>
                                                </tr>
                                                                            {% endfor %}
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                            {% else %}
                                                                <p class="text-muted text-center mb-0">No hay consumo este mes</p>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Costos de Acciones -->
                                            <div class="row mb-4">
                                                <div class="col-12">
                                                    <div class="card shadow-sm border-0">
                                                        <div class="card-header bg-white">
                                                            <h5 class="mb-0"><i class="bi bi-list-check"></i> Costos de Acciones</h5>
                                                        </div>
                                                        <div class="card-body">
                                                            <div class="row">
                                                                {% for action in allActions %}
                                                                    <div class="col-md-4 mb-3">
                                                                        <div class="border rounded p-3">
                                                                            <h6 class="mb-1">{{ action.name }}</h6>
                                                                            <p class="text-muted small mb-2">{{ action.description }}</p>
                                                                            <span class="badge bg-primary">Costo: {{ action.cost }} token{{ action.cost != 1 ? 's' : '' }}</span>
                                                                        </div>
                                                                    </div>
                                                                {% endfor %}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Transacciones Recientes -->
                                            <div class="row">
                                                <div class="col-12">
                                                    <div class="card shadow-sm border-0">
                                                        <div class="card-header bg-white">
                                                            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Transacciones Recientes</h5>
                                                        </div>
                                                        <div class="card-body">
                                                            {% if recentTransactions|length > 0 %}
                                                                <div class="table-responsive">
                                                                    <table class="table table-hover">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Fecha</th>
                                                                                <th>Acción</th>
                                                                                <th>Descripción</th>
                                                                                <th class="text-end">Cantidad</th>
                                                                                <th class="text-end">Balance</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            {% for transaction in recentTransactions %}
                                                                                <tr>
                                                                                    <td>{{ transaction.createdAt|date('d/m/Y H:i') }}</td>
                                                                                    <td><code>{{ transaction.action }}</code></td>
                                                                                    <td>{{ transaction.description }}</td>
                                                                                    <td class="text-end">
                                                                                        <span class="badge {% if transaction.amount > 0 %}bg-success{% else %}bg-danger{% endif %}">
                                                                                            {% if transaction.amount > 0 %}+{% endif %}{{ transaction.amount }}
                                                                                        </span>
                                                                                    </td>
                                                                                    <td class="text-end"><strong>{{ transaction.balanceAfter }}</strong></td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                                                </div>
                                                            {% else %}
                                                                <p class="text-muted text-center mb-0">No hay transacciones registradas</p>
                                                            {% endif %}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
    // Actualizar icono del chevron cuando se expande/colapsa
    document.addEventListener('DOMContentLoaded', function() {
        const collapseElement = document.getElementById('gestionCompletaTokens');
        const collapseIcon = document.querySelector('[data-bs-target="#gestionCompletaTokens"] .collapse-icon');
        
        if (collapseElement && collapseIcon) {
            collapseElement.addEventListener('show.bs.collapse', function () {
                collapseIcon.style.transform = 'rotate(180deg)';
            });
            collapseElement.addEventListener('hide.bs.collapse', function () {
                collapseIcon.style.transform = 'rotate(0deg)';
            });
        }
    });
</script>
{% endblock %} 
