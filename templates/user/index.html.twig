{% extends 'base.html.twig' %}

{% block title %}Usuarios{% endblock %}

{% block panelTitle %}
    Usuarios <a href="{{ path('app_user_new') }}" class="btn btn-success btn-sm">Crear Nuevo</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Email</th>
                            <th>Roles</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% set role_names = {
                        'ROLE_USER': 'Usuario',
                        'ROLE_ADMIN': 'Administrador'
                    } %}
                    {% for user in users %}
                        {% if 'ROLE_ADMIN_INSTITUTO' in user.roles %}
                        {% else %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% if user.roles %}
                                        {% for role in user.roles %}
                                            <span class="badge bg-primary me-1">{{ role_names[role] | default(role) }}</span>
                                        {% endfor %}
                                    {% endif %}
                                </td>
                                <td>    
                                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary btn-action-icon" title="Editar" data-toggle="tooltip" data-placement="top">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                                <td>
                                    {{ include('user/_delete_form.html.twig') }}
                                </td>
                            </tr>
                        {% endif %}
                        
                    {% else %}
                        <tr>
                            <td colspan="5">No se encontraron registros</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
        </div>
    </div>
</div>
{% endblock %}
