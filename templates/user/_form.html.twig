{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
<div class="form-group">
    <div class="row mb-3">
        <div class="col-md-6">
            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.email) }}
        </div>
        <div class="col-md-6">
            {{ form_label(form.password, 'Password', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.password) }}
        </div>
    </div>
    <fieldset class="row mb-3">
        <div class="col-md-12">
            {{ form_label(form.roles, 'Roles', {'label_attr': {'class': 'form-label'}}) }}
            <div class="d-flex flex-wrap">
                {% for child in form.roles.children %}
                    <div class="form-check me-3">
                        {{ form_widget(child, {'attr': {'class': 'form-check-input'}}) }}
                        <label class="form-check-label" for="{{ child.vars.id }}" >{{ child.vars.label }}</label>
                    </div>
                {% endfor %}
            </div>
        </div>
    </fieldset>
    <div class="row">
        <div class="col text-end">
            <button class="btn btn-success">{{ button_label|default('Save') }}</button>
            <a class="btn btn-primary" href="{{ path('app_user_index') }}">Volver</a>
        </div>
    </div>
</div>
{{ form_end(form) }}