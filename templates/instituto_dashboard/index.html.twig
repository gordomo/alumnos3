{% extends 'base.html.twig' %}

{% block title %}Dashboard Instituto{% endblock %}

{% block panel_title %}
    Dashboard Instituto
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        {% for instituto in institutos %}
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ instituto.nombre }}</h5>
                        <p class="card-text">
                            <strong>Dirección:</strong> {{ instituto.dir }}<br>
                            <strong>Teléfono:</strong> {{ instituto.tel }}<br>
                            <strong>{{ Term('cursos') }} Activos:</strong> {{ instituto.cursos|length }}<br>
                            <strong>{{ Term('profesores') }}:</strong> {{ instituto.profesores|length }}<br>
                            <strong>{{ Term('alumnos') }}:</strong> {{ instituto.alumnos|length }}
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('app_curso_index', {'instituto': instituto.id}) }}" class="btn btn-primary">
                            <i class="fas fa-book"></i> Gestionar {{ Term('cursos') }}
                        </a>
                        <a href="{{ path('app_profesor_index', {'instituto': instituto.id}) }}" class="btn btn-info">
                            <i class="fas fa-chalkboard-teacher"></i> Gestionar {{ Term('profesores') }}
                        </a>
                        <a href="{{ path('app_alumno_index', {'instituto': instituto.id}) }}" class="btn btn-success">
                            <i class="fas fa-user-graduate"></i> Gestionar {{ Term('alumnos') }}
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    No hay {{ term('instituto_plural') }} disponibles.
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %} 