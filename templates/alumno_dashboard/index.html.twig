{% extends 'base.html.twig' %}

{% block title %}Dashboard Alumno{% endblock %}

{% block panelTitle %}
    Bienvenido, {{ alumno.nombre }} {{ alumno.apellido }}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <!-- Estadísticas rápidas -->
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Cursos Activos</h5>
                    <h2 class="text-primary">{{ totalCursos }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Asistencias (30 días)</h5>
                    <h2 class="text-info">{{ totalAsistencias }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Pagos (30 días)</h5>
                    <h2 class="text-success">{{ totalPagos }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-muted">Deudas Pendientes</h5>
                    <h2 class="text-danger">{{ deudasPendientes|length }}</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            {% if usaCalificaciones|default(false) %}
                <a href="{{ path('app_alumno_notas') }}" class="btn btn-outline-primary">
                    <i class="bi bi-mortarboard"></i> Ver mis notas
                </a>
            {% endif %}
            {# Las tareas no dependen de que el instituto use calificaciones. #}
            <a href="{{ path('app_alumno_tareas') }}" class="btn btn-outline-primary">
                <i class="bi bi-journal-text"></i> Ver mis tareas
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Mis Cursos -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-book"></i> Mis Cursos</h5>
                </div>
                <div class="card-body">
                    {% if cursos|length > 0 %}
                        <div class="list-group">
                            {% for curso in cursos %}
                                <div class="list-group-item">
                                    <h6 class="mb-1">{{ curso.nombre }}</h6>
                                    <p class="mb-1 text-muted small">
                                        <strong>Horario:</strong> {{ curso.horarioInicio|date('H:i') }} - {{ curso.horarioFin|date('H:i') }}<br>
                                        <strong>Días:</strong> {{ curso.dias|join(', ') }}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            No estás inscrito en ningún curso actualmente.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Deudas Pendientes -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Deudas Pendientes</h5>
                </div>
                <div class="card-body">
                    {% if deudasPendientes|length > 0 %}
                        <div class="list-group">
                            {% for deuda in deudasPendientes %}
                                <div class="list-group-item">
                                    <h6 class="mb-1">{{ deuda.curso ? deuda.curso.nombre : 'Cuota de inscripción' }}</h6>
                                    <p class="mb-1 text-muted small">
                                        <strong>Período:</strong> {{ deuda.mes }}/{{ deuda.ano }}<br>
                                        <strong>Monto:</strong> ${{ deuda.montoTotal|number_format(2, ',', '.') }}
                                    </p>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-success mb-0">
                            <i class="bi bi-check-circle"></i> No tienes deudas pendientes.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Asistencias Recientes -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-clipboard-check"></i> Asistencias Recientes</h5>
                </div>
                <div class="card-body">
                    {% if asistenciasRecientes|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Curso</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for asistencia in asistenciasRecientes %}
                                        <tr>
                                            <td>{{ asistencia.fecha|date(app_date_format|default('d/m/Y')) }}</td>
                                            <td>{{ asistencia.curso.nombre }}</td>
                                            <td>
                                                {% if asistencia.presente %}
                                                    <span class="badge bg-success">Presente</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Ausente</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            No hay asistencias registradas en los últimos 30 días.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Pagos Recientes -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-cash"></i> Pagos Recientes</h5>
                </div>
                <div class="card-body">
                    {% if pagosRecientes|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Curso</th>
                                        <th>Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for pago in pagosRecientes %}
                                        <tr>
                                            <td>{{ pago.fecha|date(app_date_format|default('d/m/Y')) }}</td>
                                            <td>{{ pago.curso ? pago.curso.nombre : 'Cuota de inscripción' }}</td>
                                            <td>${{ pago.monto|number_format(2, ',', '.') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info mb-0">
                            No hay pagos registrados en los últimos 30 días.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

