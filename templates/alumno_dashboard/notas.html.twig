{% extends 'base.html.twig' %}

{% block title %}Mis Notas{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-mortarboard"></i> Mis Notas</h1>
        <a href="{{ path('app_alumno_dashboard') }}" class="btn btn-secondary btn-sm">← Volver al panel</a>
    </div>

    {% if not usaCalificaciones %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Tu instituto no usa calificaciones.
        </div>
    {% elseif cursos is empty %}
        <div class="alert alert-light border">
            <i class="bi bi-inbox"></i> Todavía no tenés notas cargadas.
        </div>
    {% else %}
        {% for datos in cursos %}
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">{{ datos.curso.nombre }}</h5>
                    <div>
                        {% if datos.resumen.promedio is not null %}
                            <span class="badge bg-light text-dark me-2">
                                Promedio: {{ datos.resumen.promedio|number_format(2, ',', '.') }}
                            </span>
                        {% endif %}
                        {% if datos.resumen.resultado == 'aprobado' %}
                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Aprobado</span>
                        {% elseif datos.resumen.resultado == 'desaprobado' %}
                            <span class="badge bg-danger"><i class="bi bi-x-circle-fill"></i> Desaprobado</span>
                        {% else %}
                            <span class="badge bg-secondary">Sin datos suficientes</span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Evaluación</th>
                                    <th style="width: 120px;">Fecha</th>
                                    <th style="width: 160px;">Nota</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for calificacion in datos.calificaciones %}
                                    <tr>
                                        <td>
                                            {{ calificacion.evaluacion.nombre }}
                                            {% if not calificacion.evaluacion.cuentaParaPromedio %}
                                                <span class="badge bg-secondary ms-1">no promedia</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ calificacion.evaluacion.fecha|date(date_format) }}</td>
                                        <td>
                                            {% if calificacion.ausente %}
                                                <span class="badge bg-warning text-dark">Ausente</span>
                                            {% else %}
                                                <strong>{{ calificacion.etiqueta }}</strong>
                                            {% endif %}
                                        </td>
                                        <td class="text-muted small">{{ calificacion.observaciones ?: '—' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>
{% endblock %}
