{% extends 'base.html.twig' %}

{% block title %}Editar Curso{% endblock %}

{% block panelTitle %}
    Editar Curso
{% endblock %}

{% block body %}
<style>
    /* Hacer que el contenido ocupe todo el ancho disponible */
    .container {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }
    
    /* Asegurar que las cards ocupen todo el ancho */
    .card {
        width: 100% !important;
        max-width: 100% !important;
    }
</style>
<div class="container-fluid px-4 mt-4" style="width: 100%; max-width: 100%;">
    <div class="row">
        <div class="col-12">
                {{ include('curso/_form.html.twig', {
                    'button_label': 'Guardar', 
                    'mostrar_confirmacion': mostrar_confirmacion|default(false),
                    'mostrar_confirmacion_conflictos': mostrar_confirmacion_conflictos|default(false)
                }) }}
            </div>
        </div>
    <div class="row mt-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body text-center">
            {{ include('curso/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


