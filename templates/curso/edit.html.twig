{% extends 'base.html.twig' %}

{% block title %}Editar Curso{% endblock %}

{% block body %}
<div class="container mt-3 d-flex justify-content-center">
    <div class="col-lg-12">
        <h1 class="mb-4 text-center">Editar Curso</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('curso/_form.html.twig', {'button_label': 'Guardar'}) }}
            </div>
        </div>
        <div class="mt-3 text-center">
            {{ include('curso/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $('.predictivo').chosen();
    </script>
{% endblock %}

