<!-- Modal de advertencia de conflictos de horarios -->
{% if mostrar_confirmacion_conflictos is defined and mostrar_confirmacion_conflictos %}
{% set conflictosData = app.session.get('conflictos_horarios_warning') %}
{% if conflictosData and conflictosData.conflictos|length > 0 %}
<div class="modal fade show" id="conflictosHorariosModal" tabindex="-1" aria-labelledby="conflictosHorariosModalLabel" aria-hidden="false" style="display: block;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="conflictosHorariosModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Advertencia: Conflictos de Horarios Detectados
                </h5>
                <button type="button" class="btn-close" id="cerrarModalBtn" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <strong>Se detectaron conflictos de horarios con otros cursos asignados a los profesores:</strong>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-warning">
                            <tr>
                                <th>Curso con Conflicto</th>
                                <th>Días</th>
                                <th>Horario Existente</th>
                                <th>Horario Nuevo</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for conflicto in conflictosData.conflictos %}
                            <tr>
                                <td><strong>{{ conflicto.curso_nombre }}</strong></td>
                                <td>{{ conflicto.dias|join(', ') }}</td>
                                <td>{{ conflicto.horario_existente }}</td>
                                <td class="text-danger"><strong>{{ conflicto.horario_nuevo }}</strong></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>¿Está seguro de que desea continuar?</strong><br>
                    Los profesores asignados tendrán cursos con horarios solapados. Esto puede causar problemas en la gestión de asistencias y reportes.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelarModalBtn">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn btn-warning" id="confirmarConflictosBtn">
                    <i class="bi bi-check-circle"></i> Sí, continuar de todas formas
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('conflictosHorariosModal');
    const backdrop = document.querySelector('.modal-backdrop');
    const cerrarBtn = document.getElementById('cerrarModalBtn');
    const cancelarBtn = document.getElementById('cancelarModalBtn');
    const confirmarBtn = document.getElementById('confirmarConflictosBtn');
    const form = document.querySelector('form.form-horizontal');
    
    // Función para cerrar el modal y recargar la página
    function cerrarModal() {
        // Ocultar el modal
        if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
        }
        // Ocultar el backdrop
        if (backdrop) {
            backdrop.classList.remove('show');
            backdrop.style.display = 'none';
        }
        // Recargar la página con el parámetro para limpiar conflictos
        const url = new URL(window.location.href);
        url.searchParams.set('limpiar_conflictos', '1');
        window.location.href = url.toString();
    }
    
    // Cerrar modal al hacer clic en la X
    if (cerrarBtn) {
        cerrarBtn.addEventListener('click', cerrarModal);
    }
    
    // Cerrar modal al hacer clic en Cancelar
    if (cancelarBtn) {
        cancelarBtn.addEventListener('click', cerrarModal);
    }
    
    // Cerrar modal al hacer clic fuera del modal (en el backdrop)
    if (modal) {
        modal.addEventListener('click', function(e) {
            if (e.target === this) {
                cerrarModal();
            }
        });
    }
    
    // Manejar confirmación de conflictos
    if (confirmarBtn && form) {
        confirmarBtn.addEventListener('click', function() {
            if (typeof window.showLoading === 'function') {
                window.showLoading();
            }
            // Agregar campo hidden para confirmar conflictos
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'confirmar_conflictos_horarios';
            hiddenInput.value = '1';
            form.appendChild(hiddenInput);
            
            // Enviar el formulario
            form.submit();
        });
    }
});
</script>
{% endif %}
{% endif %}
