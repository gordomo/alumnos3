{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
<div class="form-group">
    <div class="row g-3 mb-3">
        {% for field in [
            {form: form.nombre, label: 'Nombre', class: ''},
            {form: form.precio, label: 'Precio', class: ''},
            {form: form.dias, label: 'Dias', class: 'chosen-select'},
            {form: form.duracion, label: 'Duracion', class: 'chosen-select' }
        ] %}
            <div class="col-md-3 mb-3">
                {{ form_label(field.form, field.label) }}
                {{ form_widget(field.form, {'attr': {'class': 'form-control ' ~ field.class}}) }}
                <small class="form-error text-danger">
                    {{ form_errors(field.form) }}
                </small>
            </div>
        {% endfor %}
    </div>
    <div class="row g-3">
        <div class="col-md-12" style="text-align: right;">
            <button class="btn btn-success">{{ button_label|default('Save') }}</button>
            <a class="btn btn-primary" href="{{ path('app_curso_index') }}">Volver</a>
        </div>
    </div>
</div>
{{ form_end(form) }}

<script>
    document.addEventListener("DOMContentLoaded", function() {
        $(".chosen-select").chosen({
            width: "100%",
            no_results_text: "No se encontraron coincidencias"
        });
    });
</script>