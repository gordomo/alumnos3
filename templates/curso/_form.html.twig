{{ form_start(form) }}
    <div class="row">
        <div class="col-md-7">
            {{ include('components/formGroup.html.twig', {form: form.nombre, label: 'Nombre', required: true}) }}
        </div>
        <div class="col-md-5">
            {{ include('components/formGroup.html.twig', {form: form.precio, label: 'Precio', required: true}) }}
        </div>

        {% for formGroup in [
            {form: form.dias, label: 'Días', class: 'chosen-select'},
            {form: form.profesores, label: 'Profesores', class: 'chosen-select'}
        ] %}
            <div class="col-md-6">
                {{ include('components/formGroup.html.twig', formGroup) }}
            </div>
        {% endfor %}
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.fechaInicio, label: 'Fecha de Inicio', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.fechaFin, label: 'Fecha de Fin', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.horarioInicio, label: 'Horario de Inicio', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.horarioFin, label: 'Horario de Fin', required: true}) }}
        </div>
    </div>
    
    {% if mostrar_confirmacion is defined and mostrar_confirmacion %}
        <div class="alert alert-warning mt-3">
            <p><strong>Atención:</strong> Este curso ya ha comenzado y tiene registros de asistencia para el profesor actual.</p>
            <p>Si cambia el profesor, todas las asistencias registradas serán transferidas al nuevo profesor.</p>
            <div class="form-check mt-3">
                <input type="checkbox" class="form-check-input" id="confirmar_cambio_profesor" name="confirmar_cambio_profesor" value="1" required>
                <label class="form-check-label" for="confirmar_cambio_profesor">
                    Confirmo que deseo transferir todas las asistencias al nuevo profesor
                </label>
            </div>
        </div>
    {% endif %}
    
    <button class="btn btn-primary">{{ button_label|default('Guardar') }}</button>
{{ form_end(form) }}
