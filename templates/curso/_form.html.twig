<div style="max-width: 100%; width: 100%;">
{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

{# Información Básica #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-info-circle" style="color: #0d6efd;"></i> Información Básica
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.nombre.vars.id }}" class="form-label fw-semibold text-dark">
                        Nombre <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.precio.vars.id }}" class="form-label fw-semibold text-dark">
                        Precio <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.precio, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.precio) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Fechas y Horarios #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-calendar-event" style="color: #0d6efd;"></i> Fechas y Horarios
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.fechaInicio.vars.id }}" class="form-label fw-semibold text-dark">
                        Fecha de Inicio <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.fechaInicio, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.fechaInicio) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.fechaFin.vars.id }}" class="form-label fw-semibold text-dark">
                        Fecha de Fin <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.fechaFin, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.fechaFin) }}
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.horarioInicio.vars.id }}" class="form-label fw-semibold text-dark">
                        Horario de Inicio <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.horarioInicio, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.horarioInicio) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.horarioFin.vars.id }}" class="form-label fw-semibold text-dark">
                        Horario de Fin <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.horarioFin, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.horarioFin) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Días y Profesores #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #d1e7dd; border-bottom: 2px solid #198754;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-calendar-week" style="color: #198754;"></i> Días y Profesores
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.dias.vars.id }}" class="form-label fw-semibold text-dark">
                        Días
                    </label>
                    <small class="text-muted d-block mb-2">Puede seleccionar múltiples días. Use Ctrl+Click (o Cmd+Click en Mac) para seleccionar varios.</small>
                    {{ form_widget(form.dias, {'attr': {'class': 'form-control chosen-select'}}) }}
                    {{ form_errors(form.dias) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.profesores.vars.id }}" class="form-label fw-semibold text-dark">
                        Profesores
                    </label>
                    <small class="text-muted d-block mb-2">Puede seleccionar múltiples profesores. Use Ctrl+Click (o Cmd+Click en Mac) para seleccionar varios.</small>
                    {{ form_widget(form.profesores, {'attr': {'class': 'form-control chosen-select'}}) }}
                    {{ form_errors(form.profesores) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% if mostrar_confirmacion is defined and mostrar_confirmacion %}
    <div class="alert alert-warning mt-3">
        <p><strong>Atención:</strong> Este curso ya ha comenzado y tiene registros de asistencia para el profesor actual.</p>
        <p>Si cambia el profesor, todas las asistencias registradas serán transferidas al nuevo profesor.</p>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="confirmar_cambio_profesor" name="confirmar_cambio_profesor" value="1" required>
            <label class="form-check-label" for="confirmar_cambio_profesor">
                Confirmo que deseo transferir todas las asistencias al nuevo profesor
            </label>
        </div>
    </div>
{% endif %}

{# Botones de Acción #}
<div class="d-flex gap-2 mt-3 pt-2 border-top">
    <a href="{{ path('app_curso_index') }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> {{ button_label|default('Guardar') }}
    </button>
</div>

{{ form_end(form) }}
</div>

<style>
    /* Estilos para mejorar la visualización de los campos chosen-select */
    .chosen-select {
        width: 100% !important;
    }
    
    /* Estilos para el campo de días */
    #{{ form.dias.vars.id }}_chosen,
    #{{ form.profesores.vars.id }}_chosen {
        width: 100% !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices {
        height: 200px !important;
        min-height: 200px !important;
        max-height: 200px !important;
        overflow-y: auto;
        overflow-x: visible !important;
        padding: 8px;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        background-color: #fff;
        display: flex !important;
        flex-wrap: wrap !important;
        width: 100% !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-choice,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-choice {
        margin: 4px 4px 4px 0 !important;
        padding: 6px 25px 6px 10px !important;
        background-color: #0d6efd !important;
        color: #fff !important;
        border: none !important;
        border-radius: 0.375rem !important;
        font-size: 0.875rem !important;
        line-height: 1.4 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        display: inline-flex !important;
        align-items: center !important;
        position: relative !important;
        max-width: 300px !important;
        width: auto !important;
        min-width: 80px;
        max-height: 70px !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-choice span,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-choice span {
        color: #fff !important;
        display: inline-block !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        max-width: 250px !important;
        width: auto !important;
        padding-right: 5px;
        line-height: 1.4;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close {
        position: absolute !important;
        top: 50% !important;
        right: 8px !important;
        transform: translateY(-50%) !important;
        color: #fff !important;
        opacity: 1 !important;
        width: 16px !important;
        height: 16px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: rgba(255, 255, 255, 0.2) !important;
        border-radius: 50% !important;
        cursor: pointer !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:hover,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:hover {
        background-color: rgba(255, 255, 255, 0.4) !important;
        color: #fff !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:before,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:before {
        content: "×" !important;
        font-size: 18px !important;
        line-height: 1 !important;
        color: #fff !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-field,
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-field {
        flex: 1 1 auto !important;
        min-width: 200px !important;
    }
    
    #{{ form.dias.vars.id }}_chosen .chosen-choices li.search-field input[type="text"],
    #{{ form.profesores.vars.id }}_chosen .chosen-choices li.search-field input[type="text"] {
        color: #212529 !important;
        height: auto !important;
        min-height: 30px;
        width: 100% !important;
    }
</style>
