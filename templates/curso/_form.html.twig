<div style="max-width: 100%; width: 100%;">
{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

{# Información Básica #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-info-circle" style="color: #0d6efd;"></i> Información Básica
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.nombre.vars.id }}" class="form-label fw-semibold text-dark">
                        Nombre <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.precio.vars.id }}" class="form-label fw-semibold text-dark">
                        Precio <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.precio, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.precio) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Fechas #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-calendar-event" style="color: #0d6efd;"></i> Fechas del curso
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.fechaInicio.vars.id }}" class="form-label fw-semibold text-dark">Fecha de Inicio <span class="text-danger">*</span></label>
                    {{ form_widget(form.fechaInicio, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.fechaInicio) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.fechaFin.vars.id }}" class="form-label fw-semibold text-dark">Fecha de Fin <span class="text-danger">*</span></label>
                    {{ form_widget(form.fechaFin, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.fechaFin) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% set df = date_format|default('d/m/Y') %}
{% set moment_format = df == 'd/m/Y' ? 'DD/MM/YYYY' : (df == 'm/d/Y' ? 'MM/DD/YYYY' : (df == 'Y-m-d' ? 'YYYY-MM-DD' : (df == 'd-m-Y' ? 'DD-MM-YYYY' : 'DD/MM/YYYY'))) %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof $ !== 'undefined' && $.fn.daterangepicker) {
        var fmt = "{{ moment_format }}";
        var idInicio = "{{ form.fechaInicio.vars.id }}";
        var idFin = "{{ form.fechaFin.vars.id }}";
        var inputInicio = document.getElementById(idInicio);
        var inputFin = document.getElementById(idFin);
        if (inputInicio) {
            var startInicio = moment(inputInicio.value, fmt);
            if (!startInicio.isValid()) { startInicio = moment(); }
            $(inputInicio).daterangepicker({ singleDatePicker: true, startDate: startInicio, locale: { format: fmt } }, function(start) { inputInicio.value = start.format(fmt); });
        }
        if (inputFin) {
            var startFin = moment(inputFin.value, fmt);
            if (!startFin.isValid()) { startFin = moment(); }
            $(inputFin).daterangepicker({ singleDatePicker: true, startDate: startFin, locale: { format: fmt } }, function(start) { inputFin.value = start.format(fmt); });
        }
    }
});
</script>

{# Horarios por día (ej: Martes 18-19, Jueves 18:30-19:30) #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-clock-history" style="color: #0d6efd;"></i> Horarios por día
        </h4>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">Agregue cada bloque de horario: día de la semana + hora inicio + hora fin. Por ejemplo: Martes 18:00-19:00 y Jueves 18:30-19:30.</p>
        {{ form_errors(form.horarios) }}
        {% set proto = form.horarios.vars.prototype %}
        {% set prototypeRow %}
            <div class="row g-2 align-items-end mb-2 horario-row">
                <div class="col-md-3">{{ form_row(proto.dia) }}</div>
                <div class="col-md-2">{{ form_row(proto.horarioInicio) }}</div>
                <div class="col-md-2">
                    {{ form_label(proto.horarioFin) }}
                    <div class="d-flex align-items-end gap-2 horario-fin-cell">
                        {{ form_widget(proto.horarioFin) }}
                        <button style="margin-bottom: 1rem;" type="button" class="btn btn-outline-danger btn-sm remove-horario flex-shrink-0" title="Quitar horario"><i class="bi bi-dash-circle"></i></button>
                    </div>
                    {{ form_errors(proto.horarioFin) }}
                </div>
            </div>
        {% endset %}
        <div id="curso-horarios-list" data-prototype="{{ prototypeRow|e('html_attr') }}" data-index="{{ form.horarios|length }}">
            {% for horario in form.horarios %}
                <div class="row g-2 align-items-end mb-2 horario-row">
                    <div class="col-md-3">{{ form_row(horario.dia) }}</div>
                    <div class="col-md-2">{{ form_row(horario.horarioInicio) }}</div>
                    <div class="col-md-2">
                        {{ form_label(horario.horarioFin) }}
                        <div class="d-flex align-items-end gap-2 horario-fin-cell">
                            {{ form_widget(horario.horarioFin) }}
                            <button style="margin-bottom: 1rem;" type="button" class="btn btn-outline-danger btn-sm remove-horario flex-shrink-0" title="Quitar horario"><i class="bi bi-dash-circle"></i></button>
                        </div>
                        {{ form_errors(horario.horarioFin) }}
                    </div>
                </div>
            {% endfor %}
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="add-horario">
            <i class="bi bi-plus-circle"></i> Agregar otro horario
        </button>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var list = document.getElementById('curso-horarios-list');
    if (!list) return;
    var prototype = list.getAttribute('data-prototype');
    var addBtn = document.getElementById('add-horario');
    var index = parseInt(list.getAttribute('data-index') || '0', 10);

    // Franjas cada 15 min (00:00 a 23:45), igual que en el backend
    var timeSlots = [];
    for (var h = 0; h < 24; h++) {
        for (var m = 0; m < 60; m += 15) {
            timeSlots.push(('0' + h).slice(-2) + ':' + ('0' + m).slice(-2));
        }
    }

    var diasOrden = ['Lunes', 'Martes', 'Miercoles', 'Jueves', 'Viernes', 'Sabado', 'Domingo'];

    // Función para ordenar los horarios al cargar la página
    function ordenarHorarios() {
        var rows = Array.from(list.querySelectorAll('.horario-row'));
        if (rows.length === 0) return;
        
        // Ordenar las filas
        rows.sort(function(rowA, rowB) {
            var diaSelectA = getDiaSelect(rowA);
            var diaSelectB = getDiaSelect(rowB);
            
            if (!diaSelectA || !diaSelectB) return 0;
            
            var diaA = diaSelectA.value;
            var diaB = diaSelectB.value;
            
            var idxA = diasOrden.indexOf(diaA);
            var idxB = diasOrden.indexOf(diaB);
            
            // Ordenar por día
            if (idxA !== idxB) {
                return idxA - idxB;
            }
            
            // Si es el mismo día, ordenar por hora de inicio
            var selectsA = getInicioFinSelects(rowA);
            var selectsB = getInicioFinSelects(rowB);
            
            if (selectsA && selectsB && selectsA.inicio && selectsB.inicio) {
                var horaA = selectsA.inicio.value || '';
                var horaB = selectsB.inicio.value || '';
                return horaA.localeCompare(horaB);
            }
            
            return 0;
        });
        
        // Reordenar en el DOM
        rows.forEach(function(row) {
            list.appendChild(row);
        });
    }

    function getDiaSelect(row) {
        var selects = row.querySelectorAll('select.form-select, select.form-control');
        return selects.length >= 1 ? selects[0] : null;
    }

    function getInicioFinSelects(row) {
        var selects = row.querySelectorAll('select.form-select, select.form-control');
        if (selects.length >= 3) {
            return { inicio: selects[1], fin: selects[2] };
        }
        return null;
    }

    function getSiguienteDia() {
        var rows = list.querySelectorAll('.horario-row');
        var maxIdx = -1;
        for (var i = 0; i < rows.length; i++) {
            var diaSelect = getDiaSelect(rows[i]);
            if (diaSelect && diaSelect.value) {
                var idx = diasOrden.indexOf(diaSelect.value);
                if (idx !== -1 && idx > maxIdx) maxIdx = idx;
            }
        }
        return diasOrden[(maxIdx + 1) % 7];
    }

    function actualizarFinDesdeInicio(row) {
        var sel = getInicioFinSelects(row);
        if (!sel) return;
        var inicioVal = sel.inicio.value;
        if (!inicioVal) {
            sel.fin.innerHTML = timeSlots.map(function(t) { return '<option value="' + t + '">' + t + '</option>'; }).join('');
            return;
        }
        var idx = timeSlots.indexOf(inicioVal);
        var opcionesFin = timeSlots.slice(idx + 1);
        var finActual = sel.fin.value;
        sel.fin.innerHTML = opcionesFin.map(function(t) { return '<option value="' + t + '">' + t + '</option>'; }).join('');
        if (opcionesFin.indexOf(finActual) !== -1) {
            sel.fin.value = finActual;
        } else {
            sel.fin.value = opcionesFin[0] || '';
        }
    }

    function bindInicioFinRow(row) {
        var sel = getInicioFinSelects(row);
        if (!sel) return;
        sel.inicio.addEventListener('change', function() { 
            actualizarFinDesdeInicio(row);
            ordenarHorarios();
        });
        actualizarFinDesdeInicio(row);
        
        // También reordenar cuando cambie el día
        var diaSelect = getDiaSelect(row);
        if (diaSelect) {
            diaSelect.addEventListener('change', function() {
                ordenarHorarios();
            });
        }
    }

    function addHorarioRow() {
        var siguienteDia = getSiguienteDia();
        var newRow = document.createElement('div');
        newRow.className = 'row g-2 align-items-end mb-2 horario-row';
        newRow.innerHTML = prototype.replace(/__name__/g, index);
        list.appendChild(newRow);
        var diaSelect = getDiaSelect(newRow);
        if (diaSelect) diaSelect.value = siguienteDia;
        var sel = getInicioFinSelects(newRow);
        if (sel) {
            sel.inicio.value = '08:00';
            sel.fin.value = '09:00';
            actualizarFinDesdeInicio(newRow);
            sel.inicio.addEventListener('change', function() { actualizarFinDesdeInicio(newRow); });
        }
        // Reordenar después de agregar
        ordenarHorarios();
        list.setAttribute('data-index', index + 1);
        index++;
    }

    list.querySelectorAll('.horario-row').forEach(bindInicioFinRow);

    if (addBtn) {
        addBtn.addEventListener('click', addHorarioRow);
    }

    list.addEventListener('click', function(e) {
        if (e.target.closest('.remove-horario')) {
            var row = e.target.closest('.horario-row');
            if (list.querySelectorAll('.horario-row').length > 1) {
                row.remove();
            }
        }
    });
    
    // Ordenar horarios al cargar la página
    ordenarHorarios();
});
</script>

{# Profesores #}
