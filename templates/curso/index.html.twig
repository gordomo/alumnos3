{% extends 'base.html.twig' %}

{% block title %}Curso index{% endblock %}

{% block panelTitle %}
    Cursos 
    <a href="{{ path('app_curso_new') }}" class="btn btn-success btn-sm">Nuevo Curso</a>
    <a href="{{ path('app_curso_calendario') }}" class="btn btn-primary btn-sm">Ver Calendario</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {# Barra de búsqueda y filtros #}
    <div class="row mb-3">
        <div class="col-md-6">
            <form method="get" action="{{ path('app_curso_index') }}" class="d-flex gap-2">
                <div class="input-group">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por nombre" value="{{ busqueda is defined ? busqueda : '' }}" aria-label="Buscar curso">
                    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                </div>
                {% if busqueda %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_curso_index') }}" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </form>
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <ul class="nav nav-pills" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">
                        Activos <span class="badge bg-primary ms-1">{{ totalCursos }}</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">
                        Deshabilitados <span class="badge bg-secondary ms-1">{{ totalCursosDeshabilitados }}</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="w-auto">
                                <a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'nombre',
                                    'busqueda': busqueda
                                }) }}" class="text-decoration-none text-dark">
                                    Nombre
                                    <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                                </a>
                            </th>
                            <th class="w-auto">Profesor</th>
                            <th class="w-auto">
                                <a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'precio',
                                    'busqueda': busqueda
                                }) }}" class="text-decoration-none text-dark">
                                    Precio
                                    <i class="bi bi-arrow-{{ sort == 'precio' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                                </a>
                            </th>
                            <th class="w-auto">Días</th>
                            <th class="w-auto">Horario</th>
                            <th class="w-auto">Duración</th>
                            <th class="w-auto">Fecha Inicio</th>
                            <th class="w-auto">Fecha Fin</th>
                            <th class="text-center" style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursos %}
                        <tr>
                            <td><strong>{{ curso.nombre }}</strong></td>
                            <td>
                                {% for profesor in curso.profesores %}
                                    <div class="mb-1">
                                        <span class="badge bg-info text-dark" style="font-size: 0.9rem; padding: 0.5rem 0.75rem; white-space: nowrap;">{{ profesor.apellido }} {{ profesor.nombre }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sin profesores</span>
                                {% endfor %}
                            </td>
                            <td><strong class="text-success">${{ curso.precio | number_format(2, ',', '.') }}</strong></td>
                            <td>
                                {% for key in curso.dias %}
                                    <span class="badge bg-secondary mb-1">{{ key }}</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if curso.horarioInicio|date('H:i') == curso.horarioFin|date('H:i') %}
                                    <span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Sin horario</span>
                                {% else %}
                                    <span class="badge bg-light text-dark">{{ curso.horarioInicio|date('H:i') }}hs - {{ curso.horarioFin|date('H:i') }}hs</span>
                                {% endif %} 
                            </td>
                            <td>
                                {% if curso.horarioInicio|date('H:i') == curso.horarioFin|date('H:i') %}
                                    <span class="text-danger small">-</span>
                                {% else %}
                                    {% set horas = (curso.duracion)|round(0, 'floor') %}
                                    {% set minutos = ((curso.duracion - horas) * 60)|round(0, 'floor') %}
                                    <span class="badge bg-light text-dark">{{ horas }}:{{ '%02d'|format(minutos) }}hs</span>
                                {% endif %} 
                            </td>
                            <td>{{ curso.fechaInicio|date('d/m/Y') }}</td>
                            <td>{{ curso.fechaFin|date('d/m/Y') }}</td>
                            <td class="text-center position-relative">
                                <div class="dropdown dropstart">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" id="dropdownMenuButton{{ curso.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton{{ curso.id }}">
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_curso_show', {'id': curso.id}) }}">
                                                <i class="bi bi-eye me-2"></i> Ver detalle
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_curso_edit', {'id': curso.id}) }}">
                                                <i class="bi bi-pencil me-2"></i> Editar
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form method="post" action="{{ path('app_curso_delete', {'id': curso.id}) }}" onsubmit="return confirm('Está seguro que desea deshabilitar este curso?');" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ curso.id) }}">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-x-circle me-2"></i> Deshabilitar
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                <p class="text-muted mt-2">No se encontraron cursos activos</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="w-auto">Nombre</th>
                            <th class="w-auto">Profesor</th>
                            <th class="w-auto">Precio</th>
                            <th class="w-auto">Días</th>
                            <th class="w-auto">Horario</th>
                            <th class="w-auto">Duración</th>
                            <th class="w-auto">Fecha Inicio</th>
                            <th class="w-auto">Fecha Fin</th>
                            <th class="text-center" style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursosDeshabilitados %}
                        <tr>
                            <td><strong>{{ curso.nombre }}</strong></td>
                            <td>
                                {% for profesor in curso.profesores %}
                                    <div class="mb-1">
                                        <span class="badge bg-info text-dark" style="font-size: 0.9rem; padding: 0.5rem 0.75rem; white-space: nowrap;">{{ profesor.apellido }} {{ profesor.nombre }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sin profesores</span>
                                {% endfor %}
                            </td>
                            <td><strong class="text-success">${{ curso.precio | number_format(2, ',', '.') }}</strong></td>
                            <td>
                                {% for key in curso.dias %}
                                    <span class="badge bg-secondary mb-1">{{ key }}</span>
                                {% endfor %}
                            </td>
                            <td>
                                <span class="badge bg-light text-dark">{{ curso.horarioInicio|date('H:i') }}hs - {{ curso.horarioFin|date('H:i') }}hs</span>
                            </td>
                            <td>
                                {% set horas = (curso.duracion)|round(0, 'floor') %}
                                {% set minutos = ((curso.duracion - horas) * 60)|round(0, 'floor') %}
                                <span class="badge bg-light text-dark">{{ horas }}:{{ '%02d'|format(minutos) }}hs</span>
                            </td>
                            <td>{{ curso.fechaInicio|date('d/m/Y') }}</td>
                            <td>{{ curso.fechaFin|date('d/m/Y') }}</td>
                            <td class="text-center position-relative">
                                <div class="dropdown dropstart">
                                    <button class="btn btn-sm btn-outline-secondary" type="button" id="dropdownMenuButtonDisabled{{ curso.id }}" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButtonDisabled{{ curso.id }}">
                                        <li>
                                            <a class="dropdown-item" href="{{ path('app_curso_show', {'id': curso.id}) }}">
                                                <i class="bi bi-eye me-2"></i> Ver detalle
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item text-success" href="{{ path('app_curso_habilitar', {id: curso.id}) }}">
                                                <i class="bi bi-check-circle me-2"></i> Habilitar
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                <p class="text-muted mt-2">No se encontraron cursos deshabilitados</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
