{% extends 'base.html.twig' %}

{% block title %}Curso index{% endblock %}

{% block panelTitle %}
    Cursos 
    <a href="{{ path('app_curso_new') }}" class="btn btn-success btn-sm">Nuevo Curso</a>
    <a href="{{ path('app_curso_calendario') }}" class="btn btn-primary btn-sm">Ver Calendario</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-5">
            <form method="get" action="{{ path('app_curso_index') }}">
                <div class="input-group mb-3">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por nombre" value="{{ busqueda is defined ? busqueda : '' }}" aria-label="Buscar curso" aria-describedby="button-addon2">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-7">
            <a class="btn btn-outline-secondary" href="{{ path('app_curso_index') }}">Todos</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <ul class="nav nav-tabs w-100" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Activos</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Deshabilitados</button>
                </li>
            </ul>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>
                                <a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'nombre',
                                    'busqueda': busqueda
                                }) }}" class="text-decoration-none text-dark">
                                    Nombre
                                <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                            </a> </th>
                            <th>Profesor</th>
                            <th><a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'precio',
                                    'busqueda': busqueda
                                }) }}" class="text-decoration-none text-dark">
                                    Precio
                                <i class="bi bi-arrow-{{ sort == 'precio' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i></th>
                            <th>Días</th>
                            <th>Horario</th>
                            <th>Duración</th>
                            <th>Fecha de Inicio</th>
                            <th>Fecha de Fin</th>
                            <th>Acciones</th>
                            <th>Total: {{totalCursos}}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursos %}
                        <tr>
                            <td>{{ curso.nombre }}</td>
                            <td>
                                {% for profesor in curso.profesores %}
                                    {{ profesor.apellido }} {{ profesor.nombre }}
                                    {% if not loop.last %}
                                        <br>
                                    {% endif %}
                                    {% else %}
                                        <span class="text-danger">No tiene profesor</span>
                                    {% endfor %}
                            </td>
                            <td>${{ curso.precio | number_format(2, ',', '.') }} </td>
                            <td>
                                {% for key in curso.dias %}
                                    {{ key }}
                                    {% if curso.dias | length > 1 %}
                                        <br>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {% if curso.horarioInicio|date('H:i') == curso.horarioFin|date('H:i') %}
                                    <span class="text-danger">No tiene horario</span>
                                {% else %}
                                    {{ curso.horarioInicio|date('H:i') }}hs - {{ curso.horarioFin|date('H:i') }}hs
                                {% endif %} 
                            </td>
                            <td>
                                {% if curso.horarioInicio|date('H:i') == curso.horarioFin|date('H:i') %}
                                    <span class="text-danger">No tiene horario</span>
                                {% else %}
                                    {% set horas = (curso.duracion)|round(0, 'floor') %}
                                    {% set minutos = ((curso.duracion - horas) * 60)|round(0, 'floor') %}
                                    {{ horas }}:{{ '%02d'|format(minutos) }}hs
                                {% endif %} 
                            </td>
                            <td>
                                {{ curso.fechaInicio|date('d/m/Y') }}
                            </td>
                            <td>
                                {{ curso.fechaFin|date('d/m/Y') }}
                            </td>
                            <td>
                                <a href="{{ path('app_curso_edit', {'id': curso.id}) }}" class="btn btn-sm btn-outline-primary" title="Editar" data-toggle="tooltip" data-placement="left">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                            <td>
                                {{ include('curso/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">No se encontraron registros</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <table class="table table-striped table-sm">
                <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Profesor</th>
                    <th>Precio</th>
                    <th>Días</th>
                    <th>Horario</th>
                    <th>Duración</th>
                    <th>Fecha de Inicio</th>
                    <th>Fecha de Fin</th>
                    <th>Acciones</th>
                    <th>Total: {{ totalCursosDeshabilitados }}</th>
                </tr>
                </thead>
                <tbody>
                {% for curso in cursosDeshabilitados %}
                    <tr>
                        <td>{{ curso.nombre }}</td>
                        <td>
                            {% for profesor in curso.profesores %}
                                {{ profesor.apellido }}, {{ profesor.nombre }}
                                {% if not loop.last %}
                                    <br>
                                {% endif %}
                                {% else %}
                                    <span class="text-danger">No tiene profesor</span>
                                {% endfor %}
                        </td>
                        <td>${{ curso.precio }}</td>
                        <td>
                            {% for key in curso.dias %}
                                {{ key }}
                                {% if curso.dias | length > 1 %}
                                    <br>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {{ curso.horarioInicio|date('H:i') }} - {{ curso.horarioFin|date('H:i') }}
                        </td>
                        <td>
                            {% set horas = (curso.duracion)|round(0, 'floor') %}
                            {% set minutos = ((curso.duracion - horas) * 60)|round(0, 'floor') %}
                            {{ horas }}:{{ '%02d'|format(minutos) }}hs    
                        </td>
                        <td>
                            {{ curso.fechaInicio|date('d/m/Y') }}
                        </td>
                        <td>
                            {{ curso.fechaFin|date('d/m/Y') }}
                        </td>
                        <td colspan="2">
                            <a class="btn btn-success" href="{{ path('app_curso_habilitar', {id: curso.id}) }}">Habilitar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="10">No se encontraron registros</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
