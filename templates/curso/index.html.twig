{% extends 'base.html.twig' %}

{% block title %}Curso index{% endblock %}

{% block panelTitle %}
    Cursos <a href="{{ path('app_curso_new') }}" class="btn btn-success btn-sm">Nuevo Curso</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-5">
            <form method="get" action="{{ path('app_curso_index') }}">
                <div class="input-group mb-3">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por nombre" value="{{ busqueda is defined ? busqueda : '' }}" aria-label="Buscar curso" aria-describedby="button-addon2">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-7">
            <a class="btn btn-outline-secondary" href="{{ path('app_curso_index') }}">Todos</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <ul class="nav nav-tabs w-100" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">Activos</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Desabilitados</button>
                </li>
            </ul>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Nombre </th>
                            <th>Precio</th>
                            <th>Días</th>
                            <th>Duración</th>
                            <th>Acciones</th>
                            <th>Total: {{totalCursos}}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursos %}
                        <tr>
                            <td>{{ curso.nombre }}</td>
                            <td>${{ curso.precio }}</td>
                            <td>
                                {% for key in curso.dias %}
                                    {{ key }}
                                    {% if curso.dias | length > 1 %}
                                        <br>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {% if curso.duracion == 1 %}
                                    1:00hs
                                {% elseif curso.duracion == 1.25 %}
                                    1:15hs
                                {% elseif curso.duracion == 1.5 %}
                                    1:30hs
                                {% elseif curso.duracion == 1.75 %}
                                    1:45hs
                                {% elseif curso.duracion == 2 %}
                                    2:00hs
                                {% elseif curso.duracion == 2.25 %}
                                    2:15hs
                                {% elseif curso.duracion == 2.5 %}
                                    2:30hs
                                {% elseif curso.duracion == 2.75 %}
                                    2:45hs
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_curso_edit', {'id': curso.id}) }}"><i class="bi bi-pencil" data-toggle="tooltip" title="editar"></i></a>
                            </td>
                            <td>
                                {{ include('curso/_delete_form.html.twig') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">No se encontraron registros</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <table class="table">
                <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Días</th>
                    <th>Duración</th>
                    <th>Acciones</th>
                    <th>Total: {{ totalCursosDesabilitados }}</th>
                </tr>
                </thead>
                <tbody>
                {% for curso in cursosDesabilitados %}
                    <tr>
                        <td>{{ curso.nombre }}</td>
                        <td>${{ curso.precio }}</td>
                        <td>
                            {% for key in curso.dias %}
                                {{ key }}
                                {% if curso.dias | length > 1 %}
                                    <br>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            {{ curso.duracion }}hs
                        </td>
                        <td>
                            <a class="btn btn-success" href="{{ path('app_curso_habilitar', {id: curso.id}) }}">Habilitar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">No se encontraron registros</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function(){
            $("[data-toggle=tooltip]").tooltip({ placement: 'right'});
        });
    </script>
{% endblock %}