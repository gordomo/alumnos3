{% extends 'base.html.twig' %}

{% block title %}{{ Term('curso') }} index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        .curso-toolbar {
            background: var(--ui-superficie);
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            padding: 1rem;
            margin-bottom: 1rem;
            margin-left: 0;
            margin-right: 0;
        }

        .curso-search-form .form-control,
        .curso-search-form .btn {
            height: 40px;
            border-radius: 10px;
        }

        .curso-search-form .form-control {
            border-color: #d9e4e2;
            box-shadow: none;
        }

        .curso-search-form .form-control:focus {
            border-color: var(--ui-secundario);
            box-shadow: 0 0 0 0.2rem var(--marca-tenue);
        }

        .curso-search-form .btn-outline-secondary {
            border-color: #d9e4e2;
            color: #556067;
        }

        .curso-search-form .btn-outline-secondary:hover {
            background: #f1f6f5;
            color: #3f4a50;
        }

        .curso-tabs.nav-pills .nav-link {
            border-radius: 10px;
            color: #3f5359;
            border: 1px solid #dbe5e3;
            background: #f8fbfa;
            font-weight: 600;
        }

        .curso-tabs.nav-pills .nav-link.active {
            background: linear-gradient(135deg, var(--ui-primario), var(--ui-secundario));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 8px 22px var(--marca-tenue);
        }

        .curso-tabs .badge {
            border-radius: 999px;
            font-size: 0.72rem;
            padding: 0.3rem 0.5rem;
        }

        .curso-panel {
            background: var(--ui-superficie);
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            overflow: visible;
        }

        /* Permitir que el dropdown de acciones no quede recortado por la tabla */
        .curso-panel .table-responsive {
            overflow: visible;
        }

        .curso-panel .table {
            margin-bottom: 0;
        }

        .curso-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.2px;
            border-bottom: 1px solid #dce7e4;
            padding: 0.72rem 0.6rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        .curso-table td {
            vertical-align: middle;
            padding: 0.66rem 0.6rem;
            border-top-color: #ecf2f1;
            color: #27343a;
            font-size: 0.92rem;
        }

        .curso-table tbody tr:hover {
            background: #fbfdfd;
        }

        .curso-table .sort-link {
            color: #425257;
            text-decoration: none;
            font-weight: 700;
        }

        .curso-table .sort-link:hover {
            color: #2f4348;
        }

        .profesor-badge {
            background: #e5f4f1;
            color: #2a5a56;
            border: 1px solid #cde5e0;
            font-size: 0.8rem;
            padding: 0.35rem 0.55rem;
            border-radius: 999px;
            white-space: nowrap;
            display: inline-flex;
            margin-bottom: 0.25rem;
        }

        .dia-badge {
            background: #f0f4f7;
            color: #4b5a61;
            border: 1px solid #dbe4ea;
            border-radius: 999px;
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
            margin-bottom: 0.2rem;
        }

        .time-badge {
            background: #f8fafb;
            color: #41535a;
            border: 1px solid #dce7ec;
            border-radius: 8px;
            font-size: 0.8rem;
            padding: 0.25rem 0.45rem;
        }

        .dropdown-toggle-clean {
            border-radius: 8px;
            border-color: #d9e4e2;
            color: #556067;
        }

        .dropdown-toggle-clean:hover {
            background: #f3f7f6;
            border-color: #cfdcda;
            color: #3e4f55;
        }

        .curso-pagination {
            margin-top: 1rem;
            display: flex;
            justify-content: center;
        }

        .curso-pagination .pagination {
            margin-bottom: 0;
        }

        .curso-pagination .page-link {
            border-radius: 8px;
            border-color: #d9e4e2;
            color: #4b5d61;
            margin: 0 0.15rem;
        }

        .curso-pagination .page-item.active .page-link {
            background: var(--ui-primario);
            border-color: var(--ui-primario);
            color: #fff;
        }

        @media (max-width: 768px) {

            .curso-toolbar {
                padding: 0.85rem;
            }

            .curso-tabs {
                margin-top: 0.8rem;
                width: 100%;
                justify-content: flex-start;
            }

        }
    </style>
{% endblock %}

{% block panelTitle %}
    {{ Term('cursos') }}
{% endblock %}

{% block body %}
{% set currentTab = app.request.query.get('tab') ?: (app.request.query.get('page_disabled') ? 'disabled' : 'active') %}
<div class="container-fluid pagina curso-page">
    {# Barra de búsqueda y filtros #}
    <div class="row mb-3 curso-toolbar ui-filter-card">
        <div class="col-md-6">
            <form method="get" action="{{ path('app_curso_index') }}" class="d-flex gap-2 curso-search-form ui-filter-search">
                <div class="input-group">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por nombre" value="{{ busqueda is defined ? busqueda : '' }}" aria-label="Buscar {{ term('curso') }}">
                    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                </div>
                {% if busqueda %}
                    <a class="btn btn-outline-secondary" href="{{ path('app_curso_index') }}" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            </form>
        </div>
        <div class="col-md-6 d-flex justify-content-end align-items-center">
            <ul class="nav nav-pills curso-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link {{ currentTab == 'active' ? 'active' : '' }}" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="{{ currentTab == 'active' ? 'true' : 'false' }}">
                        Activos <span class="badge bg-primary ms-1">{{ totalCursos }}</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link {{ currentTab == 'disabled' ? 'active' : '' }}" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="{{ currentTab == 'disabled' ? 'true' : 'false' }}">
                        Deshabilitados <span class="badge bg-secondary ms-1">{{ totalCursosDeshabilitados }}</span>
                    </button>
                </li>
            </ul>
        </div>
    </div>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade {{ currentTab == 'active' ? 'show active' : '' }}" id="home" role="tabpanel" aria-labelledby="home-tab">
            <div class="curso-panel">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle curso-table">
                    <thead class="table-light">
                        <tr>
                            <th class="w-auto">
                                <a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'nombre',
                                    'busqueda': busqueda
                                }) }}" class="sort-link">
                                    Nombre
                                    <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                                </a>
                            </th>
                            <th class="w-auto">{{ Term('profesor') }}</th>
                            <th class="w-auto">
                                <a href="{{ path('app_curso_index', {
                                    'action': 'cursos',
                                    'order': order == 'asc' ? 'desc' : 'asc',
                                    'sort': 'precio',
                                    'busqueda': busqueda
                                }) }}" class="sort-link">
                                    Precio
                                    <i class="bi bi-arrow-{{ sort == 'precio' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                                </a>
                            </th>
                            <th class="w-auto">Día y Horario</th>
                            <th class="w-auto">Fecha Inicio</th>
                            <th class="w-auto">Fecha Fin</th>
                            <th class="text-center" style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursos %}
                        <tr>
                            <td><strong>{{ curso.nombre }}</strong></td>
                            <td>
                                {% for profesor in curso.profesores %}
                                    <div class="mb-1">
                                        <span class="profesor-badge">{{ profesor.apellido }} {{ profesor.nombre }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sin {{ term('profesores') }}</span>
                                {% endfor %}
                            </td>
                            <td><strong class="text-success">${{ curso.precio | number_format(2, ',', '.') }}</strong></td>
                            <td>
                                {% if curso.horarios|length > 0 %}
                                    {% for h in curso.horarios|sort_horarios %}
                                        {% set duracionHorario = h.getDuracion() %}
                                        <span class="time-badge d-block mb-1">{{ h.dia }} {{ h.horarioInicio|date('H:i') }}-{{ h.horarioFin|date('H:i') }} - {{ duracionHorario|format_duracion }}</span>
                                    {% endfor %}
                                {% elseif curso.horarioInicio and curso.horarioFin and curso.horarioInicio|date('H:i') != curso.horarioFin|date('H:i') %}
                                    <span class="time-badge">{{ curso.horarioInicio|date('H:i') }}hs - {{ curso.horarioFin|date('H:i') }}hs - {{ curso.duracion|format_duracion }}</span>
                                {% else %}
                                    <span class="text-danger small"><i class="bi bi-exclamation-triangle"></i> Sin horario</span>
                                {% endif %}
                            </td>
                            <td>{{ curso.fechaInicio|date(app_date_format|default('d/m/Y')) }}</td>
                            <td>{{ curso.fechaFin|date(app_date_format|default('d/m/Y')) }}</td>
                            <td class="text-end">
                                {{ include('components/action_buttons.html.twig', {
                                    'show_url': path('app_curso_show', {'id': curso.id}),
                                    'edit_url': path('app_curso_edit', {'id': curso.id}),
                                    'app_curso_cerrar_preview': path('app_curso_cerrar_preview', {'id': curso.id}),
                                    'custom_buttons': [
                                        {
                                            'url': path('app_curso_duplicar', {'id': curso.id}),
                                            'icon': 'bi-files',
                                            'title': 'Duplicar',
                                            'class': 'btn-outline-info'
                                        }
                                    ],
                                    'delete_url': path('app_curso_delete', {'id': curso.id}),
                                    'delete_confirm': '¿Está seguro que desea deshabilitar este curso?',
                                    'delete_token': csrf_token('delete' ~ curso.id),
                                    'delete_label': 'Deshabilitar'
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                <p class="text-muted mt-2">No se encontraron {{ term('cursos') }} activos</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="curso-pagination">
                {{ knp_pagination_render(cursos, null, {'tab': 'active'}) }}
            </div>
            </div>
        </div>
        <div class="tab-pane fade {{ currentTab == 'disabled' ? 'show active' : '' }}" id="profile" role="tabpanel" aria-labelledby="profile-tab">
            <div class="curso-panel">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle curso-table">
                    <thead class="table-light">
                        <tr>
                            <th class="w-auto">Nombre</th>
                            <th class="w-auto">{{ Term('profesor') }}</th>
                            <th class="w-auto">Precio</th>
                            <th class="w-auto">Horario</th>
                            <th class="w-auto">Fecha Inicio</th>
                            <th class="w-auto">Fecha Fin</th>
                            <th class="text-center" style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursosDeshabilitados %}
                        <tr>
                            <td><strong>{{ curso.nombre }}</strong></td>
                            <td>
                                {% for profesor in curso.profesores %}
                                    <div class="mb-1">
                                        <span class="profesor-badge">{{ profesor.apellido }} {{ profesor.nombre }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sin {{ term('profesores') }}</span>
                                {% endfor %}
                            </td>
                            <td><strong class="text-success">${{ curso.precio | number_format(2, ',', '.') }}</strong></td>
                            <td>
                                {% if curso.horarios|length > 0 %}
                                    {% for h in curso.horarios|sort_horarios %}
                                        {% set duracionHorario = h.getDuracion() %}
                                        <span class="time-badge d-block mb-1">{{ h.dia }} {{ h.horarioInicio|date('H:i') }}-{{ h.horarioFin|date('H:i') }} - {{ duracionHorario|format_duracion }}</span>
                                    {% endfor %}
                                {% else %}
                                    <span class="time-badge">{{ curso.horarioInicio|date('H:i') }}hs - {{ curso.horarioFin|date('H:i') }}hs - {{ curso.duracion|format_duracion }}</span>
                                {% endif %}
                            </td>
                            <td>{{ curso.fechaInicio|date(app_date_format|default('d/m/Y')) }}</td>
                            <td>{{ curso.fechaFin|date(app_date_format|default('d/m/Y')) }}</td>
                            <td class="text-end">
                                {{ include('components/action_buttons.html.twig', {
                                    'show_url': path('app_curso_show', {'id': curso.id}),
                                    'enable_url': path('app_curso_habilitar', {'id': curso.id})
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                <p class="text-muted mt-2">No se encontraron {{ term('cursos') }} deshabilitados</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="curso-pagination">
                {{ knp_pagination_render(cursosDeshabilitados, null, {'tab': 'disabled'}) }}
            </div>
            </div>
        </div>
    </div>
</div>

<div class="pagina-acciones">
    <a href="{{ path('app_curso_new') }}" class="pagina-boton-flotante">
        <i class="bi bi-plus-circle"></i> Nuevo {{ Term('curso') }}
    </a>
    <a href="{{ path('app_curso_calendario') }}" class="pagina-boton-flotante pagina-boton-flotante--marca">
        <i class="bi bi-calendar3"></i> Ver Calendario
    </a>
</div>
{% endblock %}
