{% extends 'base.html.twig' %}

{% block title %}Calendario de Cursos{% endblock %}

{% block panelTitle %}
    Calendario de Cursos
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
    <style>
        .fc-toolbar-title {
            text-transform: capitalize;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row">     
            <div class="col-md-12">
                <div id="calendar"></div>
            </div>
            {% if cursosSinHorario|length > 0 %}  
            <div class="col-md-12">
                
                    <div class="alert alert-warning mb-4">
                        <h4 class="alert-heading">Cursos sin horario establecido</h4>
                <p>Los siguientes cursos necesitan tener sus horarios configurados para aparecer en el calendario:</p>
                <ul class="list-unstyled">
                    {% for curso in cursosSinHorario %}
                        <li>
                            <a href="{{ path('app_curso_edit', {'id': curso.id}) }}" class="text-decoration-none">
                                {{ curso.nombre }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                </div>
            {% endif %}
            
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/es.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: '08:00:00',
                slotMaxTime: '24:00:00',
                allDaySlot: false,
                height:'auto',
                events: {{ eventos|raw }},
                eventClick: function(info) {
                    // Ocultar el spinner si está visible
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                    var props = info.event.extendedProps;
                    var profesoresTexto = props.profesor;
                    
                    // Si hay múltiples profesores, mostrar la lista completa
                    if (props.profesores && Array.isArray(props.profesores) && props.profesores.length > 1) {
                        profesoresTexto = props.profesores.join(', ');
                    }
                    
                    alert(
                        'Curso: ' + info.event.title + '\n' +
                        'Profesor' + (props.profesores && props.profesores.length > 1 ? 'es' : '') + ': ' + profesoresTexto + '\n' +
                        'Duración: ' + props.duracion + ' horas\n' +
                        'Precio: $' + props.precio
                    );
                },
                dateClick: function(info) {
                    // Ocultar el spinner cuando se hace clic en un día
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                },
                viewDidMount: function() {
                    // Ocultar el spinner cuando cambia la vista del calendario
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                }
            });
            calendar.render();
            
            // Ocultar el spinner después de que el calendario se renderice
            if (typeof hideLoading === 'function') {
                hideLoading();
            }
            
            // Prevenir que los clics en el calendario muestren el spinner
            calendarEl.addEventListener('click', function(e) {
                // Si el clic es en un elemento del calendario (no en un enlace de navegación)
                const target = e.target;
                const isCalendarElement = target.closest('.fc-day') || 
                                         target.closest('.fc-event') ||
                                         target.closest('.fc-button') ||
                                         target.closest('.fc-toolbar');
                
                if (isCalendarElement && typeof hideLoading === 'function') {
                    // Ocultar el spinner después de un pequeño delay para asegurar que se procese el clic
                    setTimeout(function() {
                        hideLoading();
                    }, 100);
                }
            }, true); // Usar capture phase para interceptar antes que el listener de loading
        });
    </script>
{% endblock %}
