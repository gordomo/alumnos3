{% extends 'base.html.twig' %}

{% block title %}Calendario de Cursos{% endblock %}

{% block panelTitle %}
    Calendario de Cursos
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
    <style>
        :root {
            --cal-primary: #5c6f6c;
            --cal-secondary: #849d9a;
            --cal-accent: #d4a373;
            --cal-surface: #ffffff;
            --cal-text: #1f2a2d;
            --cal-muted: #647079;
            --cal-border: #e5eceb;
            --cal-shadow: 0 12px 30px rgba(19, 44, 43, 0.12);
        }

        .calendar-page {
            padding: 1.2rem 0.75rem;
        }

        .calendar-intro {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .calendar-title {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--cal-text);
            letter-spacing: -0.02em;
        }

        .calendar-subtitle {
            margin: 0.35rem 0 0;
            color: var(--cal-muted);
            font-size: 0.93rem;
        }

        .calendar-actions {
            display: inline-flex;
            gap: 0.5rem;
            align-items: center;
        }

        .calendar-action-btn {
            border: none;
            border-radius: 10px;
            padding: 0.5rem 0.85rem;
            font-size: 0.82rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
        }

        .calendar-action-btn:hover {
            color: #fff;
            text-decoration: none;
        }

        .calendar-action-btn--index {
            background: linear-gradient(135deg, var(--cal-primary), var(--cal-secondary));
        }

        .calendar-action-btn--new {
            background: linear-gradient(135deg, #2c9e67, #228556);
        }

        .calendar-shell {
            background: var(--cal-surface);
            border: 1px solid var(--cal-border);
            border-radius: 16px;
            box-shadow: var(--cal-shadow);
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .calendar-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 0.7rem;
            margin-bottom: 0.9rem;
        }

        .calendar-stat-card {
            border: 1px solid var(--cal-border);
            border-radius: 12px;
            background: linear-gradient(180deg, #fcfdfd 0%, #f7faf9 100%);
            padding: 0.75rem 0.85rem;
        }

        .calendar-stat-label {
            font-size: 0.76rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.4px;
            color: var(--cal-muted);
            margin-bottom: 0.2rem;
        }

        .calendar-stat-value {
            margin: 0;
            color: var(--cal-text);
            font-size: 1.15rem;
            font-weight: 800;
            line-height: 1.1;
        }

        #calendar {
            min-height: 650px;
        }

        .fc .fc-toolbar {
            gap: 0.6rem;
            margin-bottom: 1rem;
        }

        .fc .fc-toolbar-title {
            text-transform: capitalize;
            color: var(--cal-text);
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .fc .fc-button {
            border-radius: 8px !important;
            border: 1px solid #d9e4e2 !important;
            background: #f7fbfa !important;
            color: #415257 !important;
            text-transform: capitalize;
            font-weight: 600;
            box-shadow: none !important;
            padding: 0.35rem 0.65rem !important;
        }

        .fc .fc-button:hover {
            background: #eef6f4 !important;
            border-color: #ccdcd8 !important;
        }

        .fc .fc-button-primary:not(:disabled).fc-button-active,
        .fc .fc-button-primary:not(:disabled):active {
            background: linear-gradient(135deg, var(--cal-primary), var(--cal-secondary)) !important;
            border-color: transparent !important;
            color: #fff !important;
        }

        .fc .fc-col-header-cell-cushion {
            color: #526167;
            font-weight: 700;
            text-decoration: none;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.25px;
            padding: 0.55rem 0;
        }

        .fc .fc-daygrid-day-number,
        .fc .fc-timegrid-axis-cushion,
        .fc .fc-timegrid-slot-label-cushion {
            color: #607077;
            text-decoration: none;
            font-size: 0.82rem;
        }

        .fc .fc-daygrid-day.fc-day-today {
            background: rgba(132, 157, 154, 0.12) !important;
        }

        .fc .fc-event {
            border: none !important;
            border-radius: 8px !important;
            padding: 2px 4px !important;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            font-size: 0.78rem;
            font-weight: 600;
            cursor: pointer;
        }

        .fc .fc-event-main {
            white-space: normal;
        }

        .calendar-warning {
            border: 1px solid rgba(212, 163, 115, 0.45);
            border-radius: 12px;
            background: linear-gradient(180deg, #fffaf3 0%, #fff7ed 100%);
            color: #664b2e;
        }

        .calendar-warning h4 {
            margin-bottom: 0.45rem;
            font-size: 1rem;
            font-weight: 800;
        }

        .calendar-warning ul {
            margin: 0;
            padding-left: 1rem;
        }

        .calendar-warning li + li {
            margin-top: 0.28rem;
        }

        .calendar-warning a {
            color: #5a4a33;
            font-weight: 600;
        }

        .calendar-warning a:hover {
            color: #433723;
        }

        .calendar-modal .modal-content {
            border: 1px solid var(--cal-border);
            border-radius: 14px;
            box-shadow: var(--cal-shadow);
        }

        .calendar-modal .modal-header {
            background: linear-gradient(180deg, #fcfdfd 0%, #f7faf9 100%);
            border-bottom: 1px solid var(--cal-border);
        }

        .calendar-modal-label {
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: var(--cal-muted);
            margin-bottom: 0.15rem;
        }

        .calendar-modal-value {
            margin: 0;
            color: var(--cal-text);
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .calendar-page {
                padding: 0.9rem 0.25rem;
            }

            .calendar-shell {
                padding: 0.75rem;
            }

            #calendar {
                min-height: 560px;
            }

            .fc .fc-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .fc .fc-toolbar-title {
                text-align: center;
                font-size: 1.05rem;
            }

            .fc .fc-toolbar-chunk {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 0.35rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container-fluid mt-3 calendar-page">
        <div class="calendar-intro">
            <div>
                <p class="calendar-subtitle">Visualiza horarios, dias y detalles de cada curso en una vista clara y centralizada.</p>
            </div>
            <div class="calendar-actions">
                <a href="{{ path('app_curso_index') }}" class="calendar-action-btn calendar-action-btn--index">
                    <i class="bi bi-list-ul"></i> Ver Cursos
                </a>
                <a href="{{ path('app_curso_new') }}" class="calendar-action-btn calendar-action-btn--new">
                    <i class="bi bi-plus-circle"></i> Nuevo Curso
                </a>
            </div>
        </div>

        <div class="calendar-shell">
            <div class="calendar-stats">
                <div class="calendar-stat-card">
                    <div class="calendar-stat-label">Total de Clases Cargadas</div>
                    <p class="calendar-stat-value">{{ eventos|length }}</p>
                </div>
                <div class="calendar-stat-card">
                    <div class="calendar-stat-label">Cursos sin Horario</div>
                    <p class="calendar-stat-value">{{ cursosSinHorario|length }}</p>
                </div>
            </div>

            <div id="calendar"></div>

            {% if cursosSinHorario|length > 0 %}  
                <div class="alert calendar-warning mb-0 mt-3">
                    <h4 class="alert-heading">Cursos sin horario establecido</h4>
                    <p>Los siguientes cursos necesitan configurar horario y fechas para aparecer en el calendario:</p>
                    <ul>
                    {% for curso in cursosSinHorario %}
                        <li>
                            <a href="{{ path('app_curso_edit', {'id': curso.id}) }}" class="text-decoration-none">
                                {{ curso.nombre }}
                            </a>
                        </li>
                    {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="modal fade calendar-modal" id="calendarEventModal" tabindex="-1" aria-labelledby="calendarEventModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="calendarEventModalLabel">Detalle del Curso</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <div class="calendar-modal-label">Curso</div>
                        <p class="calendar-modal-value" id="modalCursoNombre">-</p>
                    </div>
                    <div class="mb-3">
                        <div class="calendar-modal-label">Profesor(es)</div>
                        <p class="calendar-modal-value" id="modalCursoProfesor">-</p>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="calendar-modal-label">Duración</div>
                            <p class="calendar-modal-value" id="modalCursoDuracion">-</p>
                        </div>
                        <div class="col-6">
                            <div class="calendar-modal-label">Precio</div>
                            <p class="calendar-modal-value" id="modalCursoPrecio">-</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/es.js'></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var eventModalEl = document.getElementById('calendarEventModal');
            var eventModal = (eventModalEl && typeof bootstrap !== 'undefined')
                ? new bootstrap.Modal(eventModalEl)
                : null;

            function formatMoney(value) {
                if (typeof value === 'number') {
                    return value.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
                return value;
            }

            var calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                slotMinTime: '08:00:00',
                slotMaxTime: '24:00:00',
                allDaySlot: false,
                height:'auto',
                buttonText: {
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    day: 'Dia'
                },
                events: {{ eventos|raw }},
                eventClick: function(info) {
                    // Ocultar el spinner si está visible
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                    var props = info.event.extendedProps;
                    var profesoresTexto = props.profesor;
                    
                    // Si hay múltiples profesores, mostrar la lista completa
                    if (props.profesores && Array.isArray(props.profesores) && props.profesores.length > 1) {
                        profesoresTexto = props.profesores.join(', ');
                    }

                    if (eventModal) {
                        document.getElementById('modalCursoNombre').textContent = info.event.title || '-';
                        document.getElementById('modalCursoProfesor').textContent = profesoresTexto || 'Sin profesor';
                        document.getElementById('modalCursoDuracion').textContent = (props.duracion || '-') + ' hs';
                        document.getElementById('modalCursoPrecio').textContent = '$' + formatMoney(props.precio);
                        eventModal.show();
                    }
                },
                dateClick: function(info) {
                    // Ocultar el spinner cuando se hace clic en un día
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                },
                viewDidMount: function() {
                    // Ocultar el spinner cuando cambia la vista del calendario
                    if (typeof hideLoading === 'function') {
                        hideLoading();
                    }
                }
            });
            calendar.render();
            
            // Ocultar el spinner después de que el calendario se renderice
            if (typeof hideLoading === 'function') {
                hideLoading();
            }
            
            // Prevenir que los clics en el calendario muestren el spinner
            calendarEl.addEventListener('click', function(e) {
                // Si el clic es en un elemento del calendario (no en un enlace de navegación)
                const target = e.target;
                const isCalendarElement = target.closest('.fc-day') || 
                                         target.closest('.fc-event') ||
                                         target.closest('.fc-button') ||
                                         target.closest('.fc-toolbar');
                
                if (isCalendarElement && typeof hideLoading === 'function') {
                    // Ocultar el spinner después de un pequeño delay para asegurar que se procese el clic
                    setTimeout(function() {
                        hideLoading();
                    }, 100);
                }
            }, true); // Usar capture phase para interceptar antes que el listener de loading
        });
    </script>
{% endblock %}
