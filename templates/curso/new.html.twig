{% extends 'base.html.twig' %}

{% block title %}Nuevo {{ Term('curso') }}{% endblock %}

{% block panelTitle %}
    Nuevo {{ Term('curso') }}
{% endblock %}

{% block body %}
<style>
    /* Hacer que el contenido ocupe todo el ancho disponible */
    .container {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }
    
    /* Asegurar que las cards ocupen todo el ancho */
    .card {
        width: 100% !important;
        max-width: 100% !important;
    }
</style>
<div class="container-fluid pagina" style="width: 100%; max-width: 100%;">
    <div class="row">
        <div class="col-12">
                    {{ include('curso/_form.html.twig', {
                        button_label: 'Guardar',
                        mostrar_confirmacion_conflictos: mostrar_confirmacion_conflictos|default(false),
                        date_format: date_format|default('d/m/Y')
                    }) }}
        </div>
    </div>
</div>
{% endblock %}
