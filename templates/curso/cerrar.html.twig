{% extends 'base.html.twig' %}

{% block title %}Cerrar Curso - {{ curso.nombre }}{% endblock %}

{% block panelTitle %}
    Cerrar Curso
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="bi bi-lock"></i> Vista previa de cierre: {{ curso.nombre }}
            </h6>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                {% if porcentajeRequerido is not null %}
                    El porcentaje de asistencia requerido para aprobar es <strong>{{ porcentajeRequerido }}%</strong>.
                    Los alumnos que no alcancen este porcentaje serán marcados como <span class="badge bg-danger">No finalizado</span>.
                {% else %}
                    No se configuró un porcentaje de asistencia mínimo. Todos los alumnos serán marcados como <span class="badge bg-primary">Finalizado</span>.
                    <br><small>Podés configurar el porcentaje en <strong>Configuración del Instituto → Configuración Académica</strong>.</small>
                {% endif %}
            </div>

            {% if preview|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-sm">
                        <thead>
                            <tr>
                                <th>Alumno</th>
                                <th class="text-center">Clases Totales</th>
                                <th class="text-center">Presentes</th>
                                <th class="text-center">% Asistencia</th>
                                <th class="text-center">Estado Resultante</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in preview %}
                                <tr>
                                    <td>{{ item.alumno.apellido }}, {{ item.alumno.nombre }}</td>
                                    <td class="text-center">{{ item.clasesTotales }}</td>
                                    <td class="text-center">{{ item.clasesPresentes }}</td>
                                    <td class="text-center">
                                        {% if item.clasesTotales > 0 %}
                                            <span class="{% if porcentajeRequerido is not null and item.porcentajeAsistencia < porcentajeRequerido %}text-danger fw-bold{% else %}text-success{% endif %}">
                                                {{ item.porcentajeAsistencia }}%
                                            </span>
                                        {% else %}
                                            <span class="text-muted">Sin datos</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if item.estadoPrediccion == 'finalizado' %}
                                            <span class="badge bg-primary">Finalizado</span>
                                        {% else %}
                                            <span class="badge bg-danger">No finalizado</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <hr>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <a href="{{ path('app_curso_show', {'id': curso.id}) }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver sin cerrar
                        </a>
                    </div>
                    <div>
                        <form method="post" action="{{ path('app_curso_cerrar', {'id': curso.id}) }}" onsubmit="return confirm('¿Estás seguro de cerrar este curso? Esta acción no se puede deshacer.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('cerrar_curso_' ~ curso.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-lock"></i> Confirmar cierre del curso
                            </button>
                        </form>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i> No hay alumnos activos en este curso para procesar.
                </div>
                <a href="{{ path('app_curso_show', {'id': curso.id}) }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
