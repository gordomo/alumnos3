<form method="post" action="{{ path('app_alumnos_pagos_delete', {'id': pagoId}) }}" onsubmit="return confirm('Seguro desea borrar este pago?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pagoId) }}">
    <button class="btn btn-sm btn-outline-danger btn-action-icon" title="Borrar" data-toggle="tooltip" data-placement="left">
        <i class="bi bi-trash"></i>
    </button>
</form>
