{% extends 'base.html.twig' %}

{% block title %}Pagos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --pag-primary: #5c6f6c;
            --pag-secondary: #849d9a;
            --pag-surface: #ffffff;
            --pag-text: #1f2a2d;
            --pag-muted: #647079;
            --pag-border: #e5eceb;
            --pag-shadow: 0 10px 28px rgba(19, 44, 43, 0.1);
        }

        .pagos-page {
            width: 100%;
            max-width: 100%;
            padding: 1rem 0.25rem 6.1rem !important;
        }

        .pagos-page .row {
            --bs-gutter-x: 0.5rem;
        }

        .pagos-tabs {
            border-bottom: none;
            gap: 0.4rem;
        }

        .pagos-tabs .nav-link {
            border-radius: 10px;
            color: #3f5359;
            border: 1px solid #dbe5e3;
            background: #f8fbfa;
            font-weight: 600;
        }

        .pagos-tabs .nav-link.active {
            background: linear-gradient(135deg, var(--pag-primary), var(--pag-secondary));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 8px 22px rgba(92, 111, 108, 0.28);
        }

        .pagos-filter-card,
        .pagos-panel-card {
            width: 100%;
            border: 1px solid var(--pag-border);
            border-radius: 14px;
            box-shadow: var(--pag-shadow);
            overflow: hidden;
        }

        .pagos-panel-card .table-responsive {
            width: 100%;
        }

        .pagos-filter-card .card-body {
            padding-top: 0.7rem !important;
            padding-bottom: 0.7rem !important;
        }

        .pagos-filter-card .form-control,
        .pagos-filter-card .form-select,
        .pagos-filter-card .btn {
            height: 40px;
            border-radius: 10px;
        }

        .pagos-filter-card .form-control,
        .pagos-filter-card .form-select {
            border-color: #d9e4e2;
            box-shadow: none;
        }

        .pagos-filter-card .form-control:focus,
        .pagos-filter-card .form-select:focus {
            border-color: var(--pag-secondary);
            box-shadow: 0 0 0 0.2rem rgba(132, 157, 154, 0.15);
        }

        .pagos-filter-card .form-label {
            font-size: 0.8rem !important;
            text-transform: uppercase;
            letter-spacing: 0.35px;
            font-weight: 700;
            color: var(--pag-muted) !important;
        }

        .pagos-table thead th,
        .deudas-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            border-bottom-color: #dce7e4;
            white-space: nowrap;
        }

        .pagos-table td,
        .deudas-table td {
            color: #27343a;
            font-size: 0.9rem;
            border-top-color: #ecf2f1;
            vertical-align: middle;
        }

        .pagos-table .text-dark {
            color: #425257 !important;
            font-weight: 700;
        }

        .pagos-table .badge.bg-secondary {
            background: #6d7980 !important;
            font-weight: 600;
        }

        .pagos-table tfoot tr td,
        .deudas-table tfoot tr td {
            border-top: 2px solid var(--pag-border);
            font-size: 0.95rem;
        }

        .acciones-pago-group {
            display: inline-flex;
            gap: 0.3rem;
        }

        .acciones-pago-group .btn {
            border-radius: 8px;
        }

        .pagos-pagination .pagination {
            margin-bottom: 0;
        }

        .pagos-pagination .page-link {
            border-radius: 8px;
            border-color: #d9e4e2;
            color: #4b5d61;
            margin: 0 0.15rem;
        }

        .pagos-pagination .page-item.active .page-link {
            background: var(--pag-primary);
            border-color: var(--pag-primary);
            color: #fff;
        }

        .pagos-floating-actions {
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            z-index: 1030;
        }

        .pagos-floating-btn {
            border: none;
            border-radius: 999px;
            padding: 0.58rem 0.95rem;
            font-size: 0.84rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .pagos-floating-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.26);
            text-decoration: none;
        }

        .pagos-floating-btn--new {
            background: linear-gradient(135deg, #2c9e67, #228556);
        }

        .pagos-floating-btn--deuda {
            background: linear-gradient(135deg, #f2b644, #d29523);
            color: #3a2a07;
        }

        .pagos-floating-btn--deuda:hover {
            color: #3a2a07;
        }

        @media (max-width: 992px) {
            .pagos-filter-card .row.flex-nowrap {
                flex-wrap: wrap !important;
            }
        }

        @media (max-width: 768px) {
            .pagos-page {
                padding: 0.8rem 0.1rem 6.4rem !important;
            }

            .pagos-floating-actions {
                right: 0.75rem;
                bottom: 0.75rem;
            }

            .pagos-floating-btn {
                padding: 0.54rem 0.85rem;
                font-size: 0.8rem;
            }
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Pagos
{% endblock %}

{% block body %}
<div class="container-fluid mt-3 pagos-page">
    {# Tabs Navigation #}
    <ul class="nav nav-tabs pagos-tabs mb-3" id="pagosTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link {% if activeTab == 'pagos' or activeTab is empty %}active{% endif %}" id="pagos-tab" data-bs-toggle="tab" data-bs-target="#pagos" type="button" role="tab" aria-controls="pagos" aria-selected="{% if activeTab == 'pagos' or activeTab is empty %}true{% else %}false{% endif %}">
                <i class="bi bi-cash-coin"></i> Pagos
                {% if total > 0 %}
                    <span class="badge bg-primary ms-1">{{ total }}</span>
                {% endif %}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link {% if activeTab == 'deudas' %}active{% endif %}" id="deudas-tab" data-bs-toggle="tab" data-bs-target="#deudas" type="button" role="tab" aria-controls="deudas" aria-selected="{% if activeTab == 'deudas' %}true{% else %}false{% endif %}">
                <i class="bi bi-exclamation-triangle"></i> Deudas Pendientes
                {% if deudasPendientes is defined and deudasPendientes.getTotalItemCount() > 0 %}
                    <span class="badge bg-warning text-dark ms-1">{{ deudasPendientes.getTotalItemCount() }}</span>
                {% endif %}
            </button>
        </li>
    </ul>

    {# Tab Content #}
    <div class="tab-content" id="pagosTabsContent">
        {# Tab Pagos #}
        <div class="tab-pane fade {% if activeTab == 'pagos' or activeTab is empty %}show active{% endif %}" id="pagos" role="tabpanel" aria-labelledby="pagos-tab">
            {# Filtros para Pagos #}
            <div class="row mb-3">
                <div class="col-12">
                    <form method="get" class="card pagos-filter-card ui-filter-card">
                        <div class="card-body py-2">
                            <div class="row g-2 align-items-end flex-nowrap">
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Buscar</label>
                                    <input type="text" name="busqueda" class="form-control" placeholder="Por nombre..." value="{{ busqueda }}">
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Alumno</label>
                                    <select name="alumnoId" class="form-select" onchange="this.form.submit()">
                                        <option value="">Todos los alumnos</option>
                                        {% for alu in alumnos %}
                                            <option value="{{ alu.id }}" {% if alumnoSelected == alu.id or (alumnoId is defined and alumnoId == alu.id) %}selected{% endif %}>
                                                {{ alu.apellido }}, {{ alu.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Curso</label>
                                    <select name="curso" class="form-select" onchange="this.form.submit()">
                                        <option value="">Todos los cursos</option>
                                        {% for curso in cursos %}
                                            <option value="{{ curso.id }}" {% if cursoSelected == curso.id %}selected{% endif %}>{{ curso.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Método</label>
                                    <select name="metodoPago" class="form-select" onchange="this.form.submit()">
                                        <option value="">Todos</option>
                                        {% for metodo in metodosPago %}
                                            <option value="{{ metodo }}" {% if metodoSelected == metodo %}selected{% endif %}>{{ metodo }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Desde</label>
                                    <input type="date" name="fechaDesde" class="form-control" value="{{ fechaDesde }}" onchange="this.form.submit()">
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Hasta</label>
                                    <input type="date" name="fechaHasta" class="form-control" value="{{ fechaHasta }}" onchange="this.form.submit()">
                                </div>
                                {% if fechaDesde or fechaHasta or busqueda or cursoSelected or metodoSelected or alumnoSelected or (alumnoId is defined and alumnoId) %}
                                <div class="col-auto">
                                    <label class="form-label small text-muted mb-1 d-block">&nbsp;</label>
                                    <a href="{{ path('app_alumnos_pagos_index', {'tab': 'pagos'}) }}" class="btn btn-outline-secondary" title="Limpiar filtros">
                                        <i class="bi bi-x-circle"></i> Limpiar
                                    </a>
                                </div>
                                {% endif %}
                            </div>
                            <input type="hidden" name="tab" value="pagos">
                            {# No mantener el parámetro alumno si se selecciona "Todos los alumnos" #}
                            {# Solo mantenerlo si hay un alumno seleccionado explícitamente #}
                            {% if alumnoSelected and alumnoSelected != '' %}
                                <input type="hidden" name="alumno" value="{{ alumnoSelected }}">
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>

            {# Tabla de Pagos #}
            <div class="row">
                <div class="col-12">
                    <div class="card pagos-panel-card">
                        <div class="card-body p-0">
                            {# Info de paginación #}
                            {% if total > 0 %}
                            <div class="px-3 py-2 border-bottom bg-light">
                                <small class="text-muted">
                                    Mostrando 
                                    <strong>{{ pagos.currentPageNumber == 1 ? 1 : ((pagos.currentPageNumber - 1) * pagos.itemNumberPerPage) + 1 }}</strong>
                                    - 
                                    <strong>{{ pagos.currentPageNumber * pagos.itemNumberPerPage > total ? total : pagos.currentPageNumber * pagos.itemNumberPerPage }}</strong>
                                    de 
                                    <strong>{{ total }}</strong> 
                                    registro{{ total != 1 ? 's' : '' }}
                                </small>
                            </div>
                            {% endif %}
            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0 pagos-table">
                                    <thead class="table-light">
                <tr>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {
                                                    'tab': 'pagos',
                                                    'sort': 'fecha',
                                                    'order': sort == 'fecha' ? (order == 'asc' ? 'desc' : 'asc') : 'desc',
                                                    'busqueda': busqueda,
                                                    'alumnoId': alumnoSelected,
                                                    'curso': cursoSelected,
                                                    'metodoPago': metodoSelected,
                                                    'fechaDesde': fechaDesde,
                                                    'fechaHasta': fechaHasta
                                                }) }}" class="text-decoration-none text-dark">
                            Fecha
                            <i class="bi bi-arrow-{{ sort == 'fecha' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {
                            'tab': 'pagos',
                            'sort': 'alumno',
                            'order': sort == 'alumno' ? (order == 'asc' ? 'desc' : 'asc') : 'asc',
                            'busqueda': busqueda,
                            'alumnoId': alumnoSelected,
                            'curso': cursoSelected,
                            'metodoPago': metodoSelected,
                            'fechaDesde': fechaDesde,
                            'fechaHasta': fechaHasta
                        }) }}" class="text-decoration-none text-dark">
                            Alumno
                            <i class="bi bi-arrow-{{ sort == 'alumno' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {
                            'tab': 'pagos',
                            'sort': 'curso',
                            'order': sort == 'curso' ? (order == 'asc' ? 'desc' : 'asc') : 'asc',
                            'busqueda': busqueda,
                            'alumnoId': alumnoSelected,
                            'curso': cursoSelected,
                            'metodoPago': metodoSelected,
                            'fechaDesde': fechaDesde,
                            'fechaHasta': fechaHasta
                        }) }}" class="text-decoration-none text-dark">
                            Curso
                            <i class="bi bi-arrow-{{ sort == 'curso' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {
                                                    'tab': 'pagos',
                                                    'sort': 'monto',
                                                    'order': sort == 'monto' ? (order == 'asc' ? 'desc' : 'asc') : 'desc',
                                                    'busqueda': busqueda,
                                                    'alumnoId': alumnoSelected,
                                                    'curso': cursoSelected,
                                                    'metodoPago': metodoSelected,
                                                    'fechaDesde': fechaDesde,
                                                    'fechaHasta': fechaHasta
                                                }) }}" class="text-decoration-none text-dark">
                            Monto
                            <i class="bi bi-arrow-{{ sort == 'monto' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {
                            'tab': 'pagos',
                            'sort': 'metodoPago',
                            'order': sort == 'metodoPago' ? (order == 'asc' ? 'desc' : 'asc') : 'asc',
                            'busqueda': busqueda,
                            'alumnoId': alumnoSelected,
                            'curso': cursoSelected,
                            'metodoPago': metodoSelected,
                            'fechaDesde': fechaDesde,
                            'fechaHasta': fechaHasta
                        }) }}" class="text-decoration-none text-dark">
                            Método
                            <i class="bi bi-arrow-{{ sort == 'metodoPago' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {
                            'tab': 'pagos',
                            'sort': 'mes',
                            'order': sort == 'mes' ? (order == 'asc' ? 'desc' : 'asc') : 'asc',
                            'busqueda': busqueda,
                            'alumnoId': alumnoSelected,
                            'curso': cursoSelected,
                            'metodoPago': metodoSelected,
                            'fechaDesde': fechaDesde,
                            'fechaHasta': fechaHasta
                        }) }}" class="text-decoration-none text-dark">
                            Mes
                            <i class="bi bi-arrow-{{ sort == 'mes' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {
                                                    'tab': 'pagos',
                                                    'sort': 'ano',
                                                    'order': sort == 'ano' ? (order == 'asc' ? 'desc' : 'asc') : 'desc',
                                                    'busqueda': busqueda,
                                                    'alumnoId': alumnoSelected,
                                                    'curso': cursoSelected,
                                                    'metodoPago': metodoSelected,
                                                    'fechaDesde': fechaDesde,
                                                    'fechaHasta': fechaHasta
                                                }) }}" class="text-decoration-none text-dark">
                            Año
                            <i class="bi bi-arrow-{{ sort == 'ano' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% set nombresMeses = {
                                        1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                                        5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                                        9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
            } %}
            {% for pago in pagos %}
                <tr>
                    <td>{{ pago.fecha|date('d/m/Y') }}</td>
                    <td>{{ pago.alumno.apellido }}, {{ pago.alumno.nombre }}</td>
                    <td>{{ pago.curso.nombre }}</td>
                                            <td><strong>${{ pago.monto|number_format(2, ',', '.') }}</strong></td>
                                            <td><span class="badge bg-secondary">{{ pago.metodoPago }}</span></td>
                    <td>{{ nombresMeses[pago.mes] ?? pago.mes }}</td>
                    <td>{{ pago.ano }}</td>
                                            <td>
                                                <div class="acciones-pago-group" role="group">
                                                    <a href="{{ path('app_alumnos_pagos_show', {'id': pago.id}) }}" target="_blank" class="btn btn-sm btn-outline-primary" title="Imprimir" data-toggle="tooltip">
                            <i class="bi bi-printer"></i>
                        </a>
                                                    <a href="{{ path('app_alumnos_pagos_edit', {'id': pago.id}) }}" class="btn btn-sm btn-outline-secondary" title="Editar" data-toggle="tooltip">
                                <i class="bi bi-pencil"></i>
                        </a>
                        {{ include('alumnos_pagos/_delete_form.html.twig', {
                            'pagoId': pago.id
                        }) }}
                                                </div>
                    </td>
                </tr>
                                    {% else %}
                <tr>
                                            <td colspan="8" class="text-center py-4">
                                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                                <p class="text-muted mt-2 mb-0">No se encontraron registros</p>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                    {% if total > 0 and totalMontoPagos is defined %}
                                    <tfoot class="table-light border-top-2">
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold py-2">Total (página):</td>
                                            <td class="fw-bold py-2"><strong>${{ totalMontoPagos|number_format(2, ',', '.') }}</strong></td>
                                            <td colspan="4"></td>
                                        </tr>
                                    </tfoot>
                                    {% endif %}
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Paginación #}
            {% if pagos.pageCount > 1 %}
            <div class="row mt-3">
                <div class="col-12">
                        <div class="d-flex justify-content-center pagos-pagination">
                        {% set pagosRouteParams = {'tab': 'pagos'} %}
                        {% if app.request.query.get('alumnoId') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'alumnoId': app.request.query.get('alumnoId')}) %}
                        {% endif %}
                        {% if app.request.query.get('alumno') and not app.request.query.get('alumnoId') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'alumno': app.request.query.get('alumno')}) %}
                        {% endif %}
                        {% if app.request.query.get('curso') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'curso': app.request.query.get('curso')}) %}
                        {% endif %}
                        {% if app.request.query.get('metodoPago') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'metodoPago': app.request.query.get('metodoPago')}) %}
                        {% endif %}
                        {% if app.request.query.get('busqueda') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'busqueda': app.request.query.get('busqueda')}) %}
                        {% endif %}
                        {% if app.request.query.get('fechaDesde') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'fechaDesde': app.request.query.get('fechaDesde')}) %}
                        {% endif %}
                        {% if app.request.query.get('fechaHasta') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'fechaHasta': app.request.query.get('fechaHasta')}) %}
                        {% endif %}
                        {% if app.request.query.get('sort') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'sort': app.request.query.get('sort')}) %}
                        {% endif %}
                        {% if app.request.query.get('order') %}
                            {% set pagosRouteParams = pagosRouteParams|merge({'order': app.request.query.get('order')}) %}
                        {% endif %}
                        {{ knp_pagination_render(pagos, null, {}, {'routeParams': pagosRouteParams}) }}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        {# Tab Deudas Pendientes #}
        <div class="tab-pane fade {% if activeTab == 'deudas' %}show active{% endif %}" id="deudas" role="tabpanel" aria-labelledby="deudas-tab">
            {# Filtros para Deudas - mismos que Pagos + Estado #}
            <div class="row mb-3">
                <div class="col-12">
                    <form method="get" class="card pagos-filter-card ui-filter-card">
                        <div class="card-body py-2">
                            <div class="row g-2 align-items-end flex-nowrap">
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Buscar</label>
                                    <input type="text" name="busqueda" class="form-control" placeholder="Por nombre..." value="{{ busqueda }}">
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Alumno</label>
                                    <select name="alumnoId" class="form-select" onchange="this.form.submit()">
                                        <option value="">Todos los alumnos</option>
                                        {% for alu in alumnos %}
                                            <option value="{{ alu.id }}" {% if alumnoSelected == alu.id or (alumnoId is defined and alumnoId == alu.id) %}selected{% endif %}>
                                                {{ alu.apellido }}, {{ alu.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Curso</label>
                                    <select name="curso" class="form-select" onchange="this.form.submit()">
                                        <option value="">Todos los cursos</option>
                                        {% for curso in cursos %}
                                            <option value="{{ curso.id }}" {% if cursoSelected == curso.id %}selected{% endif %}>{{ curso.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Desde</label>
                                    <input type="date" name="fechaDesde" class="form-control" value="{{ fechaDesde }}" onchange="this.form.submit()">
                                </div>
                                <div class="col">
                                    <label class="form-label small text-muted mb-1">Hasta</label>
                                    <input type="date" name="fechaHasta" class="form-control" value="{{ fechaHasta }}" onchange="this.form.submit()">
                                </div>
                                {% if busqueda or cursoSelected or alumnoSelected or estadoDeuda or fechaDesde or fechaHasta or (alumnoId is defined and alumnoId) %}
                                <div class="col-auto">
                                    <label class="form-label small text-muted mb-1 d-block">&nbsp;</label>
                                    <a href="{{ path('app_alumnos_pagos_index', {'tab': 'deudas'}) }}" class="btn btn-outline-secondary" title="Limpiar filtros">
                                        <i class="bi bi-x-circle"></i> Limpiar
                                    </a>
                                </div>
                                {% endif %}
                            </div>
                            <input type="hidden" name="tab" value="deudas">
                            {# Mantener el parámetro alumno si viene en la URL #}
                            {# No mantener el parámetro alumno si se selecciona "Todos los alumnos" #}
                            {% if alumnoSelected and alumnoSelected != '' %}
                                <input type="hidden" name="alumno" value="{{ alumnoSelected }}">
                            {% endif %}
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="row">
                <div class="col-12">
                    <div class="card pagos-panel-card">
                        <div class="card-body p-0">
                            {# Info de registros #}
                            {% if deudasPendientes.getTotalItemCount() > 0 %}
                            <div class="px-3 py-2 border-bottom bg-light">
                                <small class="text-muted">
                                    Mostrando
                                    <strong>{{ deudasPendientes.currentPageNumber == 1 ? 1 : ((deudasPendientes.currentPageNumber - 1) * deudasPendientes.itemNumberPerPage) + 1 }}</strong>
                                    -
                                    <strong>{{ deudasPendientes.currentPageNumber * deudasPendientes.itemNumberPerPage > deudasPendientes.getTotalItemCount() ? deudasPendientes.getTotalItemCount() : deudasPendientes.currentPageNumber * deudasPendientes.itemNumberPerPage }}</strong>
                                    de
                                    <strong>{{ deudasPendientes.getTotalItemCount() }}</strong>
                                    deuda{{ deudasPendientes.getTotalItemCount() != 1 ? 's' : '' }}
                                    {% set totalPendientePagina = 0 %}
                                    {% for deuda in deudasPendientes %}
                                        {% set totalPendientePagina = totalPendientePagina + deuda.montoPendiente %}
                                    {% endfor %}
                                    {% if totalPendientePagina > 0 %}
                                        — Pendiente (pág.): <strong>${{ totalPendientePagina|number_format(2, ',', '.') }}</strong>
                                    {% endif %}
                                </small>
                            </div>
                            {% endif %}
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0 deudas-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Alumno</th>
                                            <th>Curso</th>
                                            <th>Período</th>
                                            <th class="text-end">Monto Total</th>
                                            <th class="text-center">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set nombresMeses = {
                                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                                        } %}
                                        {% if deudasPendientes.getTotalItemCount() > 0 %}
                                            {% for deuda in deudasPendientes %}
                                                {% set montoTotal = deuda.montoTotal %}
                                                {% set montoPagado = deuda.montoPagado %}
                                                {% set montoPendiente = deuda.montoPendiente %}
                                            <tr>
                                                <td>
                                                    <strong>{{ deuda.alumno.apellido }}, {{ deuda.alumno.nombre }}</strong>
                                                </td>
                                                <td>{{ deuda.curso.nombre }}</td>
                                                <td>
                                                    <span class="badge bg-secondary">
                                                        {{ nombresMeses[deuda.mes] ?? deuda.mes }} {{ deuda.ano }}
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    ${{ montoTotal|number_format(2, ',', '.') }}
                                                    {% if deuda.interes > 0 %}
                                                        <small class="text-muted d-block">
                                                            Base: ${{ deuda.monto|number_format(2, ',', '.') }} + 
                                                            Int: ${{ deuda.interes|number_format(2, ',', '.') }}
                                                        </small>
                                                    {% endif %}
                                                </td>
                                                <td class="text-center">
                                                    {% if montoPendiente > 0 %}
                                                        <a href="{{ path('app_alumnos_pagos_new', {'id': deuda.alumno.id}) }}" class="btn btn-sm btn-success" title="Registrar pago">
                                                            <i class="bi bi-cash-coin"></i> Pagar
                                                        </a>
                                                    {% else %}
                                                        <span class="text-muted small">Completa</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="8" class="text-center py-4">
                                                    <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                                    <p class="text-muted mt-2 mb-0">No se encontraron deudas pendientes</p>
                                                </td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                    {% if deudasPendientes.getTotalItemCount() > 0 and totalMontoDeudas is defined %}
                                    <tfoot class="table-light border-top-2">
                                        <tr>
                                            <td colspan="3" class="text-end fw-bold py-2">Total (página):</td>
                                            <td class="text-end fw-bold py-2"><strong>${{ totalMontoDeudas|number_format(2, ',', '.') }}</strong></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                    {% endif %}
                                </table>
                            </div>
                            
                            {# Paginación de deudas #}
                            {% if deudasPendientes.pageCount > 1 %}
                            <div class="px-3 py-2 border-top pagos-pagination">
                                {# Construir parámetros para mantener los filtros y la tab activa #}
                                {% set routeParams = {'tab': 'deudas'} %}
                                {# Mantener todos los filtros excepto los parámetros de paginación #}
                                {% if app.request.query.get('alumnoId') %}
                                    {% set routeParams = routeParams|merge({'alumnoId': app.request.query.get('alumnoId')}) %}
                                {% endif %}
                                {% if app.request.query.get('curso') %}
                                    {% set routeParams = routeParams|merge({'curso': app.request.query.get('curso')}) %}
                                {% endif %}
                                {% if app.request.query.get('estadoDeuda') %}
                                    {% set routeParams = routeParams|merge({'estadoDeuda': app.request.query.get('estadoDeuda')}) %}
                                {% endif %}
                                {% if app.request.query.get('busqueda') %}
                                    {% set routeParams = routeParams|merge({'busqueda': app.request.query.get('busqueda')}) %}
                                {% endif %}
                                {% if app.request.query.get('fechaDesde') %}
                                    {% set routeParams = routeParams|merge({'fechaDesde': app.request.query.get('fechaDesde')}) %}
                                {% endif %}
                                {% if app.request.query.get('fechaHasta') %}
                                    {% set routeParams = routeParams|merge({'fechaHasta': app.request.query.get('fechaHasta')}) %}
                                {% endif %}
                                {{ knp_pagination_render(deudasPendientes, null, {}, {'pageParameterName': 'pageDeudas', 'routeParams': routeParams}) }}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>

</div>

<div class="pagos-floating-actions">
    <a href="{{ path('app_alumnos_pagos_new', alumnoId ? {'alumnoId': alumnoId} : {}) }}" class="pagos-floating-btn pagos-floating-btn--new">
        <i class="bi bi-plus-circle"></i> Nuevo Pago
    </a>
    {% if alumnoId %}
        <a href="{{ path('app_alumno_deudas', {'id': alumnoId}) }}" class="pagos-floating-btn pagos-floating-btn--deuda">
            <i class="bi bi-cash-coin"></i> Gestionar Deudas
        </a>
    {% endif %}
</div>

<script>
    function switchTab(tabName) {
        const tabElement = document.getElementById(tabName + '-tab');
        if (tabElement) {
            const tab = new bootstrap.Tab(tabElement);
            tab.show();
        }
    }
    
    // Mantener la pestaña activa según parámetro URL
    function activateTabFromUrl() {
        const urlParams = new URLSearchParams(window.location.search);
        const activeTab = urlParams.get('tab');
        const pageDeudas = urlParams.get('pageDeudas');
        
        // Si hay parámetro pageDeudas o tab=deudas, mostrar tab de deudas
        if (activeTab === 'deudas' || pageDeudas) {
            const deudasTab = document.getElementById('deudas-tab');
            if (deudasTab) {
                const tab = new bootstrap.Tab(deudasTab);
                tab.show();
            }
        } else {
            // Por defecto mostrar tab de pagos
            const pagosTab = document.getElementById('pagos-tab');
            if (pagosTab) {
                const tab = new bootstrap.Tab(pagosTab);
                tab.show();
            }
        }
    }
    
    // Ejecutar al cargar la página
    document.addEventListener('DOMContentLoaded', activateTabFromUrl);
    
    // También ejecutar cuando cambie la URL (para paginación)
    window.addEventListener('popstate', activateTabFromUrl);
    
    // Interceptar clics en enlaces de paginación para mantener la tab activa
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link && link.href && (link.href.includes('pageDeudas') || link.href.includes('tab=deudas'))) {
            // Pequeño delay para asegurar que la URL cambie antes de activar la tab
            setTimeout(activateTabFromUrl, 100);
        }
    });
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
{% endblock %}
