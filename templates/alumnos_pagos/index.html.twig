{% extends 'base.html.twig' %}

{% block title %}Pagos de Alumno{% endblock %}

{% block body %}
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="h3">Pagos de {{ alumno }}</h1>
        </div>
        <div class="col text-end">
            <a class="btn btn-primary" href="javascript:history.back()">Volver</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Monto</th>
                    <th scope="col">Mes</th>
                    <th scope="col">Año</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for alumnos_pago in alumnos_pagos %}
                <tr>
                    <td>{{ alumnos_pago.fecha ? alumnos_pago.fecha|date('d/m/Y') : '' }}</td>
                    <td>{{ alumnos_pago.monto }}</td>
                    <td>{{ alumnos_pago.mes }}</td>
                    <td>{{ alumnos_pago.ano }}</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-primary btn-sm" target="_blank" href="{{ path('app_alumnos_pagos_show', {'id': alumnos_pago.id}) }}">
                                <i class="bi bi-printer"></i>
                            </a>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_alumnos_pagos_edit', {'id': alumnos_pago.id}) }}">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">No se encontraron registros.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}