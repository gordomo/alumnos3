{% extends 'base.html.twig' %}

{% block title %}Pagos{% endblock %}

{% block panelTitle %}
    Pagos de {{ nombreAlumno }}
    <a href="{{ path('app_alumnos_pagos_new', alumnoId ? {'alumnoId': alumnoId} : {}) }}" class="btn btn-success btn-sm">
        Nuevo Pago
    </a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <form method="get" class="mb-3">
                <div class="row">
                    <div class="col-md-3">
                        <div class="input-group">
                            <input type="text" name="busqueda" class="form-control" placeholder="Buscar alumno..." value="{{ busqueda }}">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="submit">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="curso" class="form-control">
                            <option value="">Todos los cursos</option>
                            {% for curso in cursos %}
                                <option value="{{ curso.id }}" {% if cursoSelected == curso.id %}selected{% endif %}>{{ curso.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="metodoPago" class="form-control">
                            <option value="">Todos los métodos</option>
                            {% for metodo in metodosPago %}
                                <option value="{{ metodo }}" {% if metodoSelected == metodo %}selected{% endif %}>{{ metodo }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group">
                            <input type="date" name="fechaDesde" class="form-control" value="{{ fechaDesde }}" placeholder="Desde">
                            <input type="date" name="fechaHasta" class="form-control" value="{{ fechaHasta }}" placeholder="Hasta">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="bi bi-filter"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if total > 0 %}
        <p class="mt-3">Total: {{ total }} pagos</p>
                {% endif %}

            <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'fecha', 'order': sort == 'fecha' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Fecha
                            <i class="bi bi-arrow-{{ sort == 'fecha' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'alumno', 'order': sort == 'alumno' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Alumno
                            <i class="bi bi-arrow-{{ sort == 'alumno' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'curso', 'order': sort == 'curso' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Curso
                            <i class="bi bi-arrow-{{ sort == 'curso' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'monto', 'order': sort == 'monto' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Monto
                            <i class="bi bi-arrow-{{ sort == 'monto' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'metodoPago', 'order': sort == 'metodoPago' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Método de Pago
                            <i class="bi bi-arrow-{{ sort == 'metodoPago' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'mes', 'order': sort == 'mes' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Mes
                            <i class="bi bi-arrow-{{ sort == 'mes' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'ano', 'order': sort == 'ano' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Año
                            <i class="bi bi-arrow-{{ sort == 'ano' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% for pago in pagos %}
                <tr>
                    <td>{{ pago.fecha|date('d/m/Y') }}</td>
                    <td>{{ pago.alumno.apellido }}, {{ pago.alumno.nombre }}</td>
                    <td>{{ pago.curso.nombre }}</td>
                    <td>${{ pago.monto|number_format(2, ',', '.') }}</td>
                    <td>{{ pago.metodoPago }}</td>
                    <td>{{ pago.mes }}</td>
                    <td>{{ pago.ano }}</td>
                    <td>
                        <a href="{{ path('app_alumnos_pagos_show', {'id': pago.id}) }}" class="btn btn-sm btn-outline-primary" title="Ver" data-toggle="tooltip" data-placement="left">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('app_alumnos_pagos_edit', {'id': pago.id}) }}" class="btn btn-sm btn-outline-secondary" title="Editar" data-toggle="tooltip" data-placement="top">
                                <i class="bi bi-pencil"></i>
                            </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">No se encontraron registros</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    <div class="navigation d-flex justify-content-center mt-4">
        {{ knp_pagination_render(pagos) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
{% endblock %}