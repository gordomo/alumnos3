{% extends 'base.html.twig' %}

{% block title %}Pagos{% endblock %}

{% block panelTitle %}
    Pagos
    <a href="{{ path('app_alumnos_pagos_new', alumnoId ? {'alumnoId': alumnoId} : {}) }}" class="btn btn-success btn-sm">
        Nuevo Pago
    </a>
    {% if alumnoId %}
        <a href="{{ path('app_alumno_deudas', {'id': alumnoId}) }}" class="btn btn-warning btn-sm">
            Gestionar Deudas
        </a>
    {% endif %}
{% endblock %}

{% block body %}
<style>
    .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }
    .card {
        width: 100% !important;
        max-width: 100% !important;
    }
    .table-responsive {
        width: 100% !important;
    }
    table {
        width: 100% !important;
    }
</style>
<div class="container-fluid mt-4" style="width: 100%; max-width: 100%;">
    {# Resumen Simple #}
    {% if estadisticas is defined %}
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Este Mes</small>
                            <h5 class="mb-0">${{ estadisticas.mes.total|number_format(2, ',', '.') }}</h5>
                            <small class="text-muted">{{ estadisticas.mes.cantidad }} pago{{ estadisticas.mes.cantidad != 1 ? 's' : '' }}</small>
                        </div>
                        <div>
                            <small class="text-muted">Este Año</small>
                            <h5 class="mb-0">${{ estadisticas.ano.total|number_format(2, ',', '.') }}</h5>
                            <small class="text-muted">{{ estadisticas.ano.cantidad }} pago{{ estadisticas.ano.cantidad != 1 ? 's' : '' }}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            {% if deudasPendientes is defined and deudasPendientes|length > 0 %}
            <div class="card shadow-sm border-warning">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted">Deudas Pendientes</small>
                            <h5 class="mb-0 text-warning">{{ deudasPendientes|length }}</h5>
                            <small class="text-muted">requieren atención</small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-warning" onclick="switchTab('deudas')">
                                <i class="bi bi-exclamation-triangle"></i> Ver
                                </button>
                            </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# Tabs Navigation #}
    <ul class="nav nav-tabs mb-3" id="pagosTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pagos-tab" data-bs-toggle="tab" data-bs-target="#pagos" type="button" role="tab" aria-controls="pagos" aria-selected="true">
                <i class="bi bi-cash-coin"></i> Pagos
                {% if total > 0 %}
                    <span class="badge bg-primary ms-1">{{ total }}</span>
                {% endif %}
            </button>
        </li>
        {% if deudasPendientes is defined and deudasPendientes|length > 0 %}
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="deudas-tab" data-bs-toggle="tab" data-bs-target="#deudas" type="button" role="tab" aria-controls="deudas" aria-selected="false">
                <i class="bi bi-exclamation-triangle"></i> Deudas Pendientes
                <span class="badge bg-warning text-dark ms-1">{{ deudasPendientes|length }}</span>
            </button>
        </li>
        {% endif %}
    </ul>

    {# Tab Content #}
    <div class="tab-content" id="pagosTabsContent">
        {# Tab Pagos #}
        <div class="tab-pane fade show active" id="pagos" role="tabpanel" aria-labelledby="pagos-tab">
            {# Filtros Simplificados #}
            <div class="row mb-3">
                <div class="col-12">
                    <form method="get" class="card shadow-sm">
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <input type="text" name="busqueda" class="form-control form-control-sm" placeholder="Buscar por nombre..." value="{{ busqueda }}">
                                </div>
                                <div class="col-md-2">
                                    <select name="alumnoId" class="form-control form-control-sm" onchange="this.form.submit()">
                                        <option value="">Todos los alumnos</option>
                                        {% for alu in alumnos %}
                                            <option value="{{ alu.id }}" {% if alumnoSelected == alu.id %}selected{% endif %}>
                                                {{ alu.apellido }}, {{ alu.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <select name="curso" class="form-control form-control-sm" onchange="this.form.submit()">
                                        <option value="">Todos los cursos</option>
                                        {% for curso in cursos %}
                                            <option value="{{ curso.id }}" {% if cursoSelected == curso.id %}selected{% endif %}>{{ curso.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <select name="metodoPago" class="form-control form-control-sm" onchange="this.form.submit()">
                                        <option value="">Todos los métodos</option>
                                        {% for metodo in metodosPago %}
                                            <option value="{{ metodo }}" {% if metodoSelected == metodo %}selected{% endif %}>{{ metodo }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <input type="date" name="fechaDesde" class="form-control form-control-sm" value="{{ fechaDesde }}" placeholder="Desde">
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-sm btn-primary w-100" type="submit">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                {% if fechaDesde or fechaHasta or busqueda or cursoSelected or metodoSelected or alumnoSelected %}
                                <div class="col-md-1">
                                    <a href="{{ path('app_alumnos_pagos_index') }}" class="btn btn-sm btn-outline-secondary w-100" title="Limpiar filtros">
                                        <i class="bi bi-x-circle"></i>
                                    </a>
                                </div>
                                {% endif %}
                            </div>
                            <input type="hidden" name="tab" value="pagos">
                </div>
            </form>
        </div>
    </div>

            {# Tabla de Pagos #}
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            {# Info de paginación #}
                            {% if total > 0 %}
                            <div class="px-3 py-2 border-bottom bg-light">
                                <small class="text-muted">
                                    Mostrando 
                                    <strong>{{ pagos.currentPageNumber == 1 ? 1 : ((pagos.currentPageNumber - 1) * pagos.itemNumberPerPage) + 1 }}</strong>
                                    - 
                                    <strong>{{ pagos.currentPageNumber * pagos.itemNumberPerPage > total ? total : pagos.currentPageNumber * pagos.itemNumberPerPage }}</strong>
                                    de 
                                    <strong>{{ total }}</strong> 
                                    registro{{ total != 1 ? 's' : '' }}
                                </small>
                            </div>
                            {% endif %}
            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-light">
                <tr>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {'sort': 'fecha', 'order': sort == 'fecha' ? (order == 'asc' ? 'desc' : 'asc') : 'desc'}) }}" class="text-decoration-none text-dark">
                            Fecha
                            <i class="bi bi-arrow-{{ sort == 'fecha' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'alumno', 'order': sort == 'alumno' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Alumno
                            <i class="bi bi-arrow-{{ sort == 'alumno' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'curso', 'order': sort == 'curso' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Curso
                            <i class="bi bi-arrow-{{ sort == 'curso' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {'sort': 'monto', 'order': sort == 'monto' ? (order == 'asc' ? 'desc' : 'asc') : 'desc'}) }}" class="text-decoration-none text-dark">
                            Monto
                            <i class="bi bi-arrow-{{ sort == 'monto' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'metodoPago', 'order': sort == 'metodoPago' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                                                    Método
                            <i class="bi bi-arrow-{{ sort == 'metodoPago' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                        <a href="{{ path('app_alumnos_pagos_index', {'sort': 'mes', 'order': sort == 'mes' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                            Mes
                            <i class="bi bi-arrow-{{ sort == 'mes' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>
                                                <a href="{{ path('app_alumnos_pagos_index', {'sort': 'ano', 'order': sort == 'ano' ? (order == 'asc' ? 'desc' : 'asc') : 'desc'}) }}" class="text-decoration-none text-dark">
                            Año
                            <i class="bi bi-arrow-{{ sort == 'ano' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                        </a>
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
            {% set nombresMeses = {
                                        1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                                        5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                                        9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
            } %}
            {% for pago in pagos %}
                <tr>
                    <td>{{ pago.fecha|date('d/m/Y') }}</td>
                    <td>{{ pago.alumno.apellido }}, {{ pago.alumno.nombre }}</td>
                    <td>{{ pago.curso.nombre }}</td>
                                            <td><strong>${{ pago.monto|number_format(2, ',', '.') }}</strong></td>
                                            <td><span class="badge bg-secondary">{{ pago.metodoPago }}</span></td>
                    <td>{{ nombresMeses[pago.mes] ?? pago.mes }}</td>
                    <td>{{ pago.ano }}</td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="{{ path('app_alumnos_pagos_show', {'id': pago.id}) }}" target="_blank" class="btn btn-sm btn-outline-primary" title="Imprimir" data-toggle="tooltip">
                            <i class="bi bi-printer"></i>
                        </a>
                                                    <a href="{{ path('app_alumnos_pagos_edit', {'id': pago.id}) }}" class="btn btn-sm btn-outline-secondary" title="Editar" data-toggle="tooltip">
                                <i class="bi bi-pencil"></i>
                        </a>
                        {{ include('alumnos_pagos/_delete_form.html.twig', {
                            'pagoId': pago.id
                        }) }}
                                                </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                                            <td colspan="8" class="text-center py-4">
                                                <i class="bi bi-inbox" style="font-size: 2rem; color: #ccc;"></i>
                                                <p class="text-muted mt-2 mb-0">No se encontraron registros</p>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Paginación #}
            {% if pagos.pageCount > 1 %}
            <div class="row mt-3">
                <div class="col-12">
                    <div class="d-flex justify-content-center">
                        {{ knp_pagination_render(pagos) }}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        {# Tab Deudas Pendientes #}
        {% if deudasPendientes is defined and deudasPendientes|length > 0 %}
        <div class="tab-pane fade" id="deudas" role="tabpanel" aria-labelledby="deudas-tab">
            {# Filtros para Deudas #}
            <div class="row mb-3">
                <div class="col-12">
                    <form method="get" class="card shadow-sm border-warning">
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <input type="text" name="busqueda" class="form-control form-control-sm" placeholder="Buscar por nombre..." value="{{ busqueda }}">
                                </div>
                                <div class="col-md-3">
                                    <select name="alumnoId" class="form-control form-control-sm" onchange="this.form.submit()">
                                        <option value="">Todos los alumnos</option>
                                        {% for alu in alumnos %}
                                            <option value="{{ alu.id }}" {% if alumnoSelected == alu.id %}selected{% endif %}>
                                                {{ alu.apellido }}, {{ alu.nombre }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <select name="curso" class="form-control form-control-sm" onchange="this.form.submit()">
                                        <option value="">Todos los cursos</option>
                                        {% for curso in cursos %}
                                            <option value="{{ curso.id }}" {% if cursoSelected == curso.id %}selected{% endif %}>{{ curso.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-sm btn-primary w-100" type="submit">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                </div>
                                {% if busqueda or cursoSelected or alumnoSelected %}
                                <div class="col-md-1">
                                    <a href="{{ path('app_alumnos_pagos_index', {'tab': 'deudas'}) }}" class="btn btn-sm btn-outline-secondary w-100" title="Limpiar filtros">
                                        <i class="bi bi-x-circle"></i>
                                    </a>
                                </div>
                                {% endif %}
                            </div>
                            <input type="hidden" name="tab" value="deudas">
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="row">
                <div class="col-12">
                    <div class="card shadow-sm border-warning">
                        <div class="card-body p-0">
                            {# Info de registros #}
                            <div class="px-3 py-2 border-bottom bg-light">
                                <small class="text-muted">
                                    Total de deudas pendientes: <strong>{{ deudasPendientes|length }}</strong>
                                </small>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="table-warning">
                                        <tr>
                                            <th>Alumno</th>
                                            <th>Curso</th>
                                            <th>Mes/Año</th>
                                            <th>Monto</th>
                                            <th>Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set nombresMeses = {
                                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                                        } %}
                                        {% for deuda in deudasPendientes %}
                                        <tr>
                                            <td>{{ deuda.alumno.apellido }}, {{ deuda.alumno.nombre }}</td>
                                            <td>{{ deuda.curso.nombre }}</td>
                                            <td>
                                                <span class="badge bg-warning text-dark">
                                                    {{ nombresMeses[deuda.mes] ?? deuda.mes }} {{ deuda.ano }}
                                                </span>
                                            </td>
                                            <td><strong>${{ deuda.monto|number_format(2, ',', '.') }}</strong></td>
                                            <td>
                                                <a href="{{ path('app_alumnos_pagos_new', {'id': deuda.alumno.id, 'curso': deuda.curso.id}) }}" class="btn btn-sm btn-success">
                                                    <i class="bi bi-cash-coin"></i> Pagar
                                                </a>
                                            </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        </div>

    {# Paginación #}
    {% if pagos.pageCount > 1 %}
    <div class="row mt-3">
        <div class="col-12">
            <div class="d-flex justify-content-center">
        {{ knp_pagination_render(pagos) }}
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script>
    function switchTab(tabName) {
        const tabElement = document.getElementById(tabName + '-tab');
        if (tabElement) {
            const tab = new bootstrap.Tab(tabElement);
            tab.show();
        }
    }
    
    // Mantener la pestaña activa según parámetro URL
    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const activeTab = urlParams.get('tab');
        
        if (activeTab === 'deudas') {
            const deudasTab = document.getElementById('deudas-tab');
            if (deudasTab) {
                const tab = new bootstrap.Tab(deudasTab);
                tab.show();
            }
        }
    });
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Inicializar tooltips de Bootstrap
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });
    </script>
{% endblock %}
