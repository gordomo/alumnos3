{{ form_start(form) }}
    <div class="row">
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.alumno, label: 'Alumno', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.curso, label: 'Curso', required: true}) }}
        </div>
        <div class="col-md-4">
            {{ include('components/formGroup.html.twig', {form: form.fecha, label: 'Fecha de Pago', required: true}) }}
        </div>
        <div class="col-md-4">
            {{ include('components/formGroup.html.twig', {form: form.mes, label: 'Mes', required: true}) }}
        </div>
        <div class="col-md-4">
            {{ include('components/formGroup.html.twig', {form: form.ano, label: 'Año', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.monto, label: 'Monto', required: true}) }}
        </div>
        <div class="col-md-6">
            {{ include('components/formGroup.html.twig', {form: form.metodoPago, label: 'Método de Pago', required: true}) }}
        </div>
        <div class="col-md-12">
            {{ include('components/formGroup.html.twig', {form: form.observacion, label: 'Observaciones'}) }}
        </div>
    </div>

    {% if motivoInteres is defined and motivoInteres %}
        <div class="alert alert-info mt-4">
            <h5>Interés por vencimiento:</h5>
            <p>{{ motivoInteres }}</p>
        </div>
    {% endif %}

    {% if descuentosAplicados is defined and descuentosAplicados|length > 0 %}
        <div class="alert alert-success mt-4">
            <h5>Descuentos aplicados:</h5>
            <ul class="mb-0">
                {% for descuento in descuentosAplicados %}
                    <li>{{ descuento }}</li>
                {% endfor %}
            </ul>
            {% if porcentajeDescuentoTotal is defined and porcentajeDescuentoTotal > 0 %}
                <p class="mt-2 mb-0"><strong>Total descuentos aplicados: {{ porcentajeDescuentoTotal }}%</strong></p>
            {% endif %}
        </div>
    {% endif %}

    {% if vencimientos is defined and vencimientos|length > 0 %}
        <div class="alert alert-info mt-4">
            <h5>Vencimientos Configurados:</h5>
            <ul class="mb-0">
                {% for vencimiento in vencimientos %}
                    <li>Día {{ vencimiento.diaVencimiento }} - {{ vencimiento.porcentajeInteres }}% de interés</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="form-group row mt-3">
        <div class="col-sm-12">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> {{ button_label|default('Guardar') }}
            </button>
            {% if is_general %}
                <a href="{{ path('app_alumnos_pagos_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            {% else %}
                <a href="{{ path('app_alumno_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            {% endif %}
        </div>
    </div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Método 1: Usar el evento chosen:ready de Chosen
        $('#alumnos_pagos_curso').on('chosen:ready', function() {
            initializeChosenEventsCursos();
        });

        $('#alumnos_pagos_alumno').on('chosen:ready', function() {
            initializeChosenEventsAlumnos();
        });
    
        
        // Función para inicializar los eventos una vez que Chosen esté listo
        function initializeChosenEventsCursos() {
            // Usar jQuery para detectar cambios en los selects originales
            $('#alumnos_pagos_curso').on('change', function() {
                // Obtener el valor del curso seleccionado
                const cursoId = $(this).val();
                // Agregar el valor como parámetro a la URL actual
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('curso', cursoId);
                // Recargar la página con el nuevo parámetro
                window.location.href = currentUrl.toString();
            });
        }

        function initializeChosenEventsAlumnos() {
            
            $('#alumnos_pagos_alumno').on('change', function() {
                // Obtener el valor del alumno seleccionado
                const id = $(this).val();
                // Agregar el valor como parámetro a la URL actual
                const currentUrl = new URL(window.location.href);
                currentUrl.searchParams.set('id', id);
                // Recargar la página con el nuevo parámetro
                window.location.href = currentUrl.toString();
            });
        }
    });
</script>