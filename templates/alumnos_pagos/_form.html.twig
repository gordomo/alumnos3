{{ form_start(form) }}
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.fecha) }}
                {{ form_widget(form.fecha) }}
                {{ form_errors(form.fecha) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.metodoPago) }}
                {{ form_widget(form.metodoPago) }}
                {{ form_errors(form.metodoPago) }}
            </div>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="form-group">
                {{ form_label(form.alumno) }}
                {{ form_widget(form.alumno) }}
                {{ form_errors(form.alumno) }}
            </div>
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.mes) }}
                {{ form_widget(form.mes) }}
                {{ form_errors(form.mes) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.ano) }}
                {{ form_widget(form.ano) }}
                {{ form_errors(form.ano) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_label(form.curso) }}
                {{ form_widget(form.curso) }}
                {{ form_errors(form.curso) }}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.monto) }}
                {{ form_widget(form.monto) }}
                {{ form_errors(form.monto) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                {{ form_label(form.observacion) }}
                {{ form_widget(form.observacion) }}
                {{ form_errors(form.observacion) }}
            </div>
        </div>
    </div>

    {% if vencimientos is defined and vencimientos|length > 0 %}
        <div class="alert alert-info mt-4">
            <h5>Vencimientos Configurados:</h5>
            <ul class="mb-0">
                {% for vencimiento in vencimientos %}
                    <li>Día {{ vencimiento.diaVencimiento }} - {{ vencimiento.porcentajeInteres }}% de interés</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="row mt-4">
        <div class="col-md-12 text-center">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> {{ button_label|default('Guardar') }}
            </button>
            {% if is_general %}
                <a href="{{ path('app_alumnos_pagos_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            {% else %}
                <a href="{{ path('app_alumno_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            {% endif %}
        </div>
    </div>
{{ form_end(form) }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelector('#alumnos_pagos_curso').addEventListener('change', function() {
            // Obtener el valor del curso seleccionado
            const cursoId = this.value;
            // Agregar el valor como parámetro a la URL actual
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('curso', cursoId);
            // Recargar la página con el nuevo parámetro
            window.location.href = currentUrl.toString();
        });
    });
</script>