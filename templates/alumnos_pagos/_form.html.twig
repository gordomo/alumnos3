{{ form_start(form) }}
<div class="form-group">
    <div class="row g-3">
        <div class="col-md-6">
            {{ form_label(form.fecha, 'Fecha') }}
            {{ form_widget(form.fecha) }}
            <small class="form-error">
                {{ form_errors(form.fecha) }}
            </small>
        </div>
        <div class="col-md-6">
            {{ form_label(form.mes, 'Mes') }}
            {{ form_widget(form.mes) }}
            <small class="form-error">
                {{ form_errors(form.mes) }}
            </small>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            {{ form_label(form.ano, 'Año') }}
            {{ form_widget(form.ano) }}
            <small class="form-error">
                {{ form_errors(form.ano) }}
            </small>
        </div>
        <div class="col-md-6">
            {{ form_label(form.monto, 'Monto') }}
            {{ form_widget(form.monto) }}
            <small class="form-error">
                {{ form_errors(form.monto) }}<br>
            </small>
            {% if bonificacionHermanos %}
                <small class="form-success">
                    Precio binificado 20% por hermanos<br>
                </small>
            {% endif %}
            {% if recargo %}
                <small class="form-error">
                    Precio con recargo 10% por pago fuera de fecha<br>
                </small>
            {% endif %}
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            {{ form_label(form.curso, 'Curso') }}
            {{ form_widget(form.curso) }}
            <small class="form-error">
                {{ form_errors(form.curso) }}
            </small>
        </div>
        <div class="col-md-6">
            {{ form_label(form.metodoPago, 'Método de Pago') }}
            {{ form_widget(form.metodoPago) }}
            <small class="form-error">
                {{ form_errors(form.metodoPago) }}
            </small>
        </div>
    </div>
    <div class="row g-3 mt-3 ">
        <div class="col-12 gap-3">
            <button class="btn btn-success mr-1">{{ button_label|default('Save') }}</button>
            {% if alumnoId is defined %}
                <a class="btn btn-secondary" href="{{ path('app_alumnos_pagos_index', {'alumno': alumnoId}) }}">Ver pagos</a>
            {% endif %}
            {{ include('components/back_button.html.twig', {'default_path': path('dashboard_index', {'action': 'pagos'})}) }}
        </div>
    </div>
</div>
{{ form_end(form) }}
