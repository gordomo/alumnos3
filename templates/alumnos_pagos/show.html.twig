<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Example 1</title>
    <link rel="stylesheet" href="{{ asset('assets/css/invoice.css') }}" media="all" />
</head>
<body>
<header class="clearfix">
    <div id="logo">
        <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}">
    </div>
    <h1>Recibo</h1>
    <div id="company" class="clearfix">
        <div>{{ instituto.nombre }}</div>
        <div>{{ instituto.dir }}</div>
        <div>{{ instituto.tel }}</div>
    </div>
    <div id="project">
        <div><span>Alumno:</span> {{ alumnos_pago.alumno.nombreApellido }}</div>
        <div><span>email:</span> <a href="mailto:john@example.com">{{ alumnos_pago.alumno.email }}</a></div>
        <div><span>Fecha:</span> {{ 'now' | date(app_date_format|default('d/m/Y')) }}</div>
        <div><span>Pago:</span> {{ alumnos_pago.fecha | date(app_date_format|default('d/m/Y')) }}</div>
    </div>
</header>
<main>
    <table>
        <thead>
        <tr>
            <th class="service">Curso</th>
            <th class="desc">Descripción</th>
            <th>Precio</th>
            <th>TOTAL</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td class="service">{{ alumnos_pago.curso ? alumnos_pago.curso.nombre : 'Cuota de inscripción' }}</td>
            <td class="desc"><b>{% if alumnos_pago.curso %}Pago Cuota - {{ ('months.' ~ alumnos_pago.mes)|trans }}/{{ alumnos_pago.ano }}{% else %}Cuota de inscripción {{ alumnos_pago.ano }}{% endif %}</b></td>
            <td class="unit">${{ alumnos_pago.monto }}</td>
            <td class="unit">${{ alumnos_pago.monto }}</td>
        </tr>
        <tr>
            <td colspan="3" class="grand total">TOTAL</td>
            <td class="grand total">${{ alumnos_pago.monto }}</td>
        </tr>
        </tbody>
    </table>
    <div id="notices">
        <br>
        <br>
        <div style="font-size: 120%">Recibí conforme la suma de ${{ alumnos_pago.monto }}, por parte de: </div>
        <br>
        <br>
        <br>
        <div>-----------------------------------------------------------------------------------------------------------</div>
        <br>
        <div style="font-size: 120%" >como pago por los servicios previamente detallados en este recibo</div>
        <br><br>
        {# <div>Nota:</div>
        <div>Se cobra un recargo del 10% por pagar después del 20 de cada mes.</div> #}
    </div>
</main>
<footer>
    Esta recibo fue creado por computadora. Es válido si se acompaña de la firma correspondiente
</footer>
</body>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function(){
            //window.print();
        })
    </script>
</html>