{% extends 'base.html.twig' %}

{% block title %}Nuevo Pago{% endblock %}


{% block body %}
    <div class="mx-4 mt-4">
        <h1 class="h3 mb-4 text-dark">Nuevo Pago</h1>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'id': 'alumnos_pagos', 'name': 'alumnos_pagos'}}) }}
                <input type="hidden" name="modo_pago_multiple" id="modo-pago-multiple-hidden" value="0">

                {# MÓDULO 0: ALUMNO - Primer paso: a quién se le imputa el pago #}
                <div class="card mb-4 shadow-sm">
                    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
                        <h4 class="mb-0 text-dark">
                            <i class="bi bi-person-badge" style="color: #0d6efd;"></i> Alumno
                        </h4>
                    </div>
                    <div class="card-body">
                        <div style="border-left: 4px solid #0d6efd; background-color: #e7f3ff; padding: 1rem; border-radius: 4px;">
                            <label for="{{ form.alumno.vars.id }}" class="form-label fw-bold text-dark mb-2">
                                Seleccione a quién se le imputa el pago <span class="text-danger">*</span>
                            </label>
                            {{ form_widget(form.alumno, {'attr': {'class': 'form-select form-select-lg chosen-select', 'data-placeholder': 'Buscar alumno por nombre o apellido...'}}) }}
                            {{ form_errors(form.alumno) }}
                        </div>
                    </div>
                </div>

                {% if not alumno %}
                <div class="alert alert-info mb-4" role="alert">
                    <i class="bi bi-info-circle"></i> Seleccione un alumno de la lista para ver sus deudas y registrar un pago.
                </div>
                {% endif %}

                {# MÓDULO 1: INFORMACIÓN DE ESTADO - visible solo cuando hay alumno seleccionado #}
                {% if alumno %}
                <div class="card mb-4 shadow-sm">
                    <div class="card-header" style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
                        <h4 class="mb-0 text-dark">
                            <i class="bi bi-info-circle" style="color: #0d6efd;"></i> Información de Estado
                        </h4>
                    </div>
                    <div class="card-body">
                        {# Selector de curso si hay múltiples cursos #}
                        {% set cursosUnicos = [] %}
                        {% set cursosIdsVistos = [] %}
                        {% if mesesAdeudados is defined and mesesAdeudados|length > 0 %}
                            {% for mes in mesesAdeudados %}
                                {% set cursoId = mes.curso_obj.id %}
                                {% set cursoEncontrado = false %}
                                {% for idVisto in cursosIdsVistos %}
                                    {% if idVisto == cursoId %}
                                        {% set cursoEncontrado = true %}
                                    {% endif %}
                                {% endfor %}
                                {% if not cursoEncontrado %}
                                    {% set cursosIdsVistos = cursosIdsVistos|merge([cursoId]) %}
                                    {% set cursosUnicos = cursosUnicos|merge([mes.curso_obj]) %}
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                        
                        {% if cursosUnicos|length > 1 %}
                            <div class="mb-4" style="border-left: 4px solid #0d6efd; background-color: #e7f3ff; padding: 1rem; border-radius: 4px;">
                                <label for="filtro-curso-pago" class="form-label fw-bold text-dark mb-2">
                                    <i class="bi bi-book" style="color: #0d6efd;"></i> Seleccionar Curso para Pagar
                                </label>
                                <select id="filtro-curso-pago" class="form-select form-select-lg">
                                    <option value="">Todos los cursos</option>
                                    {% for cursoObj in cursosUnicos %}
                                        <option value="{{ cursoObj.id }}" {% if cursoSeleccionado is defined and cursoSeleccionado and cursoSeleccionado.id == cursoObj.id %}selected{% endif %}>
                                            {{ cursoObj.nombre }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-info-circle"></i> Puede seleccionar meses de diferentes cursos, pero es recomendable pagar por curso separadamente.
                                </small>
                            </div>
                        {% endif %}
                        
                        {# Meses adeudados #}
                        {% if mesesAdeudados is defined and mesesAdeudados|length > 0 %}
                            <div class="mb-4" style="border-left: 4px solid #ffc107; background-color: #fffbf0; padding: 1rem; border-radius: 4px;">
                                <h5 class="mb-3 text-dark">
                                    <i class="bi bi-exclamation-circle" style="color: #ff9800;"></i> Meses para Pagar
                                </h5>
                                <p class="text-muted mb-3">
                                    Seleccione los meses que desea pagar (puede seleccionar múltiples).  
                                </p>
                                {% set cursos = {} %}
                                {% for mes in mesesAdeudados %}
                                    {% if not cursos[mes.curso] is defined %}
                                        {% set cursos = cursos|merge({(mes.curso): []}) %}
                                    {% endif %}
                                    {% set cursos = cursos|merge({(mes.curso): cursos[mes.curso]|merge([mes])}) %}
                                {% endfor %}
                                
                                <div class="row">
                                    {% for curso, meses in cursos %}
                                        {% set cursoId = meses[0].curso_obj.id %}
                                        <div class="col-md-12 mb-3 curso-meses-container" data-curso-id="{{ cursoId }}">
                                            <div class="card border-0" style="background-color: #ffffff;">
                                                <div class="card-body">
                                                    <h6 class="card-title text-dark mb-3">
                                                        <strong>{{ curso }}</strong>
                                                        <button type="button" class="btn btn-sm btn-outline-primary ms-2 seleccionar-todos-btn" data-curso="{{ curso }}">
                                                            Seleccionar todos
                                                        </button>
                                                    </h6>
                                                    <div class="row">
                                                        {% for mes in meses %}
                                                            {% set esAdelantado = mes.esAdelantado is defined ? mes.esAdelantado : false %}
                                                            {% set estaPagado = mes.estaPagado is defined ? mes.estaPagado : false %}
                                                            {% set fechaActual = date() %}
                                                            {% set mesActual = fechaActual|date('n')|number_format %}
                                                            {% set anoActual = fechaActual|date('Y')|number_format %}
                                                            {% set esMesFuturo = (mes.ano > anoActual) or (mes.ano == anoActual and mes.mes > mesActual) %}
                                                            <div class="col-md-3 mb-2">
                                                                <div class="mes-adeudado-checkbox-container position-relative" 
                                                                     style="background-color: {% if estaPagado %}#d4edda{% elseif esAdelantado %}#e7f3ff{% else %}#f8f9fa{% endif %}; border: 2px solid {% if estaPagado %}#28a745{% elseif esAdelantado %}#0d6efd{% else %}#dee2e6{% endif %}; border-radius: 8px; padding: 1rem; cursor: {% if estaPagado %}default{% else %}pointer{% endif %}; transition: all 0.2s ease; user-select: none; opacity: {% if estaPagado %}0.7{% else %}1{% endif %};"
                                                                     data-mes-checkbox-id="mes_{{ mes.mes }}_{{ mes.ano }}_{{ mes.curso_obj.id }}"
                                                                     data-es-adelantado="{{ esAdelantado ? 'true' : 'false' }}"
                                                                     data-es-mes-futuro="{{ esMesFuturo ? 'true' : 'false' }}"
                                                                     data-esta-pagado="{{ estaPagado ? 'true' : 'false' }}">
                                                                    <input type="checkbox" 
                                                                           class="mes-adeudado-checkbox position-absolute" 
                                                                           style="opacity: 0; position: absolute; pointer-events: none;"
                                                                           id="mes_{{ mes.mes }}_{{ mes.ano }}_{{ mes.curso_obj.id }}" 
                                                                           name="meses_adeudados[]"
                                                                           value="{{ mes.mes }}_{{ mes.ano }}_{{ mes.curso_obj.id }}"
                                                                           data-mes="{{ mes.mes }}"
                                                                           data-ano="{{ mes.ano }}"
                                                                           data-curso-id="{{ mes.curso_obj.id }}"
                                                                           data-curso-nombre="{{ mes.curso }}"
                                                                           data-monto-base="{{ mes.monto }}"
                                                                           data-es-adelantado="{{ esAdelantado ? 'true' : 'false' }}"
                                                                           {% if estaPagado %}disabled{% endif %}
                                                                           form="alumnos_pagos">
                                                                    <div class="d-flex align-items-center justify-content-between">
                                                                        <div>
                                                                            <strong class="d-block text-dark">
                                                                                {{ mes.nombre }}
                                                                                {% if estaPagado %}
                                                                                    <span class="badge bg-success ms-1" style="font-size: 0.7rem;">PAGADA</span>
                                                                                {% elseif esAdelantado %}
                                                                                    <span class="badge bg-info ms-1" style="font-size: 0.7rem;">Adelantado</span>
                                                                                {% endif %}
                                                                            </strong>
                                                                            <small class="text-muted">
                                                                                ${{ mes.monto | number_format(2, ',', '.') }}
                                                                            </small>
                                                                        </div>
                                                                        <div class="mes-check-icon" style="width: 24px; height: 24px; border: 2px solid {% if estaPagado %}#28a745{% else %}#dee2e6{% endif %}; border-radius: 4px; display: flex; align-items: center; justify-content: center; background-color: {% if estaPagado %}#28a745{% else %}white{% endif %}; transition: all 0.2s ease;">
                                                                            <i class="bi bi-check" style="color: white; font-size: 16px; display: {% if estaPagado %}block{% else %}none{% endif %};"></i>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# MÓDULO 1B: INFORMACIÓN DE LOS CURSOS - card independiente alineado #}
                {% if mesesAdeudados is defined and mesesAdeudados|length > 0 %}
                    {% set cursosUnicosArray = [] %}
                    {% set cursosIdsVistos = [] %}
                    {% for mes in mesesAdeudados %}
                        {% set cursoId = mes.curso_obj.id %}
                        {% set yaVisto = false %}
                        {% for idVisto in cursosIdsVistos %}
                            {% if idVisto == cursoId %}
                                {% set yaVisto = true %}
                            {% endif %}
                        {% endfor %}
                        {% if not yaVisto %}
                            {% set cursosIdsVistos = cursosIdsVistos|merge([cursoId]) %}
                            {% set cursosUnicosArray = cursosUnicosArray|merge([mes.curso_obj]) %}
                        {% endif %}
                    {% endfor %}
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
                            <h4 class="mb-0 text-dark">
                                <i class="bi bi-book" style="color: #0d6efd;"></i> Información de los Cursos
                            </h4>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                {% for cursoObj in cursosUnicosArray %}
                                    <div class="col-md-{% if cursosUnicosArray|length > 1 %}6{% else %}12{% endif %} mb-3">
                                        <div class="card border-0" style="background-color: #f8f9fa; border-left: 3px solid #0d6efd !important;">
                                            <div class="card-body">
                                                <h6 class="card-title text-dark mb-2">
                                                    <strong>{{ cursoObj.nombre }}</strong>
                                                </h6>
                                                <p class="mb-1 text-muted small">
                                                    <strong>Precio base:</strong> <span class="text-dark">${{ cursoObj.precio | number_format(2, ',', '.')}}</span>
                                                </p>
                                                <p class="mb-0 text-muted small">
                                                    <strong>Período:</strong> {{ cursoObj.fechaInicio | date(app_date_format|default('d/m/Y')) }} - {{ cursoObj.fechaFin | date(app_date_format|default('d/m/Y')) }}
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% elseif curso is defined and curso %}
                    <div class="card mb-4 shadow-sm">
                        <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
                            <h4 class="mb-0 text-dark">
                                <i class="bi bi-book" style="color: #0d6efd;"></i> Información del Curso
                            </h4>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong class="text-dark">{{ curso.nombre }}</strong></p>
                            <p class="mb-0 text-muted">
                                Precio base: <strong class="text-dark">${{ curso.precio | number_format(2, ',', '.')}}</strong> | 
                                Período: {{ curso.fechaInicio | date(app_date_format|default('d/m/Y')) }} - {{ curso.fechaFin | date(app_date_format|default('d/m/Y')) }}
                            </p>
                        </div>
                    </div>
                {% endif %}

                {# MÉTODO DE PAGO - arriba para que el descuento por efectivo se refleje en el precio #}
                <div class="card mb-4 shadow-sm">
                    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
                        <h4 class="mb-0 text-dark">
                            <i class="bi bi-credit-card-2-front" style="color: #0d6efd;"></i> Método de Pago
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="mb-0">
                            <label for="{{ form.metodoPago.vars.id }}" class="form-label fw-semibold text-dark mb-1">Método de Pago <span class="text-danger">*</span></label>
                            {{ form_widget(form.metodoPago, {'attr': {'class': 'form-select form-select-lg metodo-pago-select'}}) }}
                            {{ form_errors(form.metodoPago) }}
                            <small class="text-muted d-block mt-1">Si elige Efectivo, puede aplicarse un descuento según la configuración del instituto.</small>
                        </div>
                    </div>
                </div>

                {# MÓDULO 2: CÁLCULO DEL PAGO #}
                <div class="card mb-4 shadow-sm">
                    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
                        <h4 class="mb-0 text-dark">
                            <i class="bi bi-calculator" style="color: #0d6efd;"></i> Cálculo del Pago
                        </h4>
                    </div>
                    <div class="card-body">
                        {# Regla de cálculo aplicada #}
                        {% set ordenTexto = {
                            'interes_primero': 'Interés primero, luego descuentos',
                            'descuento_primero': 'Descuentos primero, luego interés',
                            'neto': 'Neto (diferencia entre intereses y descuentos)',
                            'descuentos_solo_base': 'Descuentos sobre base, interés sobre base original'
                        } %}
                        {% set ordenDescripcion = {
                            'interes_primero': 'Se aplica el interés sobre el monto base, luego los descuentos sobre el resultado.',
                            'descuento_primero': 'Se aplican los descuentos sobre el monto base, luego el interés sobre el resultado.',
                            'neto': 'Ambos se calculan sobre la base y se hace la diferencia.',
                            'descuentos_solo_base': 'Los descuentos se aplican sobre la base, el interés se suma sobre la base original.'
                        } %}
                        <div id="regla-calculo-container" class="mb-3" style="border-left: 4px solid #6c757d; background-color: #f8f9fa; padding: 0.75rem 1rem; border-radius: 4px;">
                            <h6 class="mb-1 text-dark">
                                <i class="bi bi-info-circle" style="color: #6c757d;"></i> Regla de Cálculo Aplicada
                            </h6>
                            <p class="mb-1" id="regla-calculo-texto">
                                <strong class="text-dark">{{ ordenTexto[ordenCalculo] ?? 'Interés primero, luego descuentos' }}</strong>
                            </p>
                            <small class="text-muted" id="regla-calculo-descripcion">{{ ordenDescripcion[ordenCalculo] ?? 'Se aplica el interés sobre el monto base, luego los descuentos sobre el resultado.' }}</small>
                        </div>
                        
                        {# Resumen de meses seleccionados (oculto inicialmente) #}
                        <div id="resumen-meses-seleccionados" class="mb-3" style="display: none;">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="card-title">Meses seleccionados para pago:</h6>
                                    <div id="lista-meses-seleccionados" class="d-flex flex-wrap gap-2"></div>
                                </div>
                            </div>
                        </div>
                        
                        {# Interés por vencimiento #}
                        {% if motivoInteres is defined and motivoInteres and porcentajeInteres is defined and porcentajeInteres > 0 %}
                            <div class="mb-3" style="border-left: 4px solid #ffc107; background-color: #fffbf0; padding: 1rem; border-radius: 4px;">
                                <h6 class="mb-2 text-dark">
                                    <i class="bi bi-clock-history" style="color: #ff9800;"></i> Interés por Vencimiento
                                </h6>
                                <p class="mb-1 text-muted">{{ motivoInteres }}</p>
                                <p class="mb-0">
                                    <strong class="text-dark">Interés aplicado: {{ porcentajeInteres }}%</strong>
                                </p>
                            </div>
                        {% else %}
                            <div class="mb-3" style="border-left: 4px solid #198754; background-color: #d1e7dd; padding: 0.75rem 1rem; border-radius: 4px;">
                                <i class="bi bi-check-circle" style="color: #198754;"></i> <span class="text-muted">Sin interés aplicado</span>
                    </div>
                {% endif %}

                        {# Descuentos Promocionales Disponibles #}
                        {% if descuentosPromocionales is defined and descuentosPromocionales|length > 0 and puedeRecibirDescuentos is defined and puedeRecibirDescuentos %}
                            <div class="mb-3" id="descuentos-promocionales-container" style="border-left: 4px solid #0dcaf0; background-color: #cff4fc; padding: 1rem; border-radius: 4px;">
                                <h6 class="mb-2 text-dark">
                                    <i class="bi bi-tag" style="color: #0dcaf0;"></i> Descuentos Promocionales Disponibles
                                </h6>
                                <p class="text-muted small mb-3">Seleccione los descuentos que desea aplicar:</p>
                                <div class="row">
                                    {% for descuento in descuentosPromocionales %}
                                        <div class="col-md-3 col-sm-6 mb-2">
                                            <div class="form-check ps-4 py-2">
                                                <input type="checkbox" 
                                                       class="form-check-input descuento-promocional-checkbox" 
                                                       id="descuento_{{ descuento.id }}" 
                                                       name="descuentos_promocionales[]"
                                                       value="{{ descuento.id }}"
                                                       data-porcentaje="{{ descuento.porcentaje }}"
                                                       style="margin-left: -1.5rem;"
                                                       {% if descuentosPromocionalesSeleccionados is defined and descuento in descuentosPromocionalesSeleccionados %}checked{% endif %}>
                                                <label class="form-check-label ms-2" for="descuento_{{ descuento.id }}">
                                                    <strong class="text-dark">{{ descuento.nombre }}</strong> 
                                                    <span class="badge ms-2" style="background-color: #0dcaf0; color: white;">{{ descuento.porcentaje }}%</span>
                                                </label>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {# Descuentos aplicados - contenedor con id para actualizar/ocultar desde JS según método de pago #}
                        <div id="descuentos-aplicados-container" class="mb-3" style="border-left: 4px solid #198754; background-color: #d1e7dd; padding: 1rem; border-radius: 4px; {% if not (descuentosAplicados is defined and descuentosAplicados|length > 0 and porcentajeDescuentoTotal is defined and porcentajeDescuentoTotal > 0) %}display: none;{% endif %}">
                            <h6 class="mb-2 text-dark">
                                <i class="bi bi-check-circle" style="color: #198754;"></i> Descuentos Aplicados
                            </h6>
                            <ul class="mb-2 text-muted" id="descuentos-aplicados-lista">
                                {% for descuento in descuentosAplicados|default([]) %}
                                    <li>{{ descuento }}</li>
                                {% endfor %}
                            </ul>
                            <p class="mb-0" id="descuentos-aplicados-total">
                                {% if porcentajeDescuentoTotal is defined and porcentajeDescuentoTotal > 0 %}
                                    <strong class="text-dark">Total descuentos: {{ porcentajeDescuentoTotal }}%</strong>
                                {% endif %}
                            </p>
                        </div>

                        {# PRECIO A COBRAR - campo editable único (reemplaza Monto redundante) #}
                        <div class="border-0" id="precio-final-container" style="background: linear-gradient(135deg, #d1e7dd 0%, #ffffff 100%); border-left: 4px solid #198754 !important; padding: 2rem; border-radius: 4px;">
                            <label for="{{ form.monto.vars.id }}" class="form-label fw-bold mb-2" style="color: #198754; font-size: 1.1rem;">
                                Precio a Cobrar
                            </label>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="fw-bold" style="color: #198754; font-size: 1.5rem;">$</span>
                                {{ form_widget(form.monto, {'attr': {'class': 'form-control form-control-lg monto-input-field', 'style': 'max-width: 12rem; font-size: 1.5rem; font-weight: 600;', 'min': '0.01', 'step': '0.01', 'placeholder': '0.00'}}) }}
                            </div>
                            {{ form_errors(form.monto) }}
                            {% if calculoMonto is defined and calculoMonto and calculoMonto.montoBase != calculoMonto.monto %}
                                <small class="text-muted d-block mt-2">
                                    Precio base: ${{ calculoMonto.montoBase | number_format(2, ',', '.') }}
                                </small>
                            {% endif %}
                            <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                                Puede modificar. Si ingresa menos, la deuda se cancela igual. Adelantado: seleccione meses futuros.
                            </small>
                        </div>
                    </div>
                </div>

                {# MÓDULO 3: REGISTRO DEL PAGO #}
                {{ include('alumnos_pagos/_form.html.twig', {
                            'button_label': 'Guardar Pago',
                    'alumno': alumno,
                    'alumnos': alumnos is defined ? alumnos : [alumno],
                    'cursos': cursos,
                    'vencimientos': vencimientos,
                            'is_general': is_general,
                            'calculoMonto': calculoMonto is defined ? calculoMonto : null
                }) }}
                {% else %}
                {{ form_end(form, {'render_rest': false}) }}
                {% endif %}
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const modoPagoMultiple = document.getElementById('modo-pago-multiple');
            const mesesCheckboxes = document.querySelectorAll('.mes-adeudado-checkbox');
            const mesesContainers = document.querySelectorAll('.mes-adeudado-checkbox-container');
            const resumenMeses = document.getElementById('resumen-meses-seleccionados');
            const listaMeses = document.getElementById('lista-meses-seleccionados');
            const campoMonto = document.querySelector('.monto-input-field') || document.querySelector('input[name="alumnos_pagos[monto]"]');
            const reglaCalculoTexto = document.getElementById('regla-calculo-texto');
            const reglaCalculoDescripcion = document.getElementById('regla-calculo-descripcion');
            
            // Filtro de curso
            const filtroCurso = document.getElementById('filtro-curso-pago');
            if (filtroCurso) {
                filtroCurso.addEventListener('change', function() {
                    const cursoIdSeleccionado = this.value;
                    const cursoContainers = document.querySelectorAll('.curso-meses-container');
                    
                    cursoContainers.forEach(function(container) {
                        const cursoId = container.dataset.cursoId;
                        if (!cursoIdSeleccionado || cursoIdSeleccionado === cursoId) {
                            container.style.display = '';
                        } else {
                            container.style.display = 'none';
                            // Deseleccionar meses del curso oculto
                            const checkboxesOcultos = container.querySelectorAll('.mes-adeudado-checkbox:checked');
                            checkboxesOcultos.forEach(function(cb) {
                                cb.checked = false;
                                const container = cb.closest('.mes-adeudado-checkbox-container');
                                if (container) {
                                    actualizarEstiloMes(container, cb);
                                }
                            });
                        }
                    });
                    
                    // Actualizar resumen y precio
                    actualizarResumenMeses();
                    // No llamar a actualizarPrecioFinal() aquí porque puede interferir con el cálculo AJAX
                });
            }
            
            // Función para actualizar la regla de cálculo
            function actualizarReglaCalculo(texto, descripcion) {
                if (reglaCalculoTexto && texto) {
                    reglaCalculoTexto.innerHTML = '<strong class="text-dark">' + texto + '</strong>';
                }
                if (reglaCalculoDescripcion && descripcion) {
                    reglaCalculoDescripcion.textContent = descripcion;
                }
            }
            
            // Función para actualizar el estilo visual del contenedor según el estado del checkbox
            function actualizarEstiloMes(container, checkbox) {
                const checkIcon = container.querySelector('.mes-check-icon');
                const checkIconInner = container.querySelector('.mes-check-icon i');
                
                // Verificar si el mouse está sobre el elemento antes de restaurar estilos
                const isHovering = container._isHovering && container._isHovering();
                
                // Verificar si está pagado
                const estaPagado = container.dataset.estaPagado === 'true';
                
                if (estaPagado) {
                    // Si está pagado, mantener estilo de pagado (verde) independientemente del checkbox
                    container.style.transform = 'translateY(0)';
                    container.style.backgroundColor = '#d4edda';
                    container.style.borderColor = '#28a745';
                    container.style.opacity = '0.7';
                    container.style.cursor = 'default';
                    container.style.boxShadow = 'none';
                    if (checkIcon) {
                        checkIcon.style.backgroundColor = '#28a745';
                        checkIcon.style.borderColor = '#28a745';
                        if (checkIconInner) {
                            checkIconInner.style.display = 'block';
                        }
                    }
                } else if (checkbox.checked) {
                    // Si está seleccionado (y NO está pagado), mostrar estilo seleccionado
                    container.style.transform = 'translateY(0)';
                    container.style.backgroundColor = '#e7f1ff';
                    container.style.borderColor = '#0d6efd';
                    container.style.boxShadow = '0 2px 4px rgba(13, 110, 253, 0.2)';
                    if (checkIcon) {
                        checkIcon.style.backgroundColor = '#0d6efd';
                        checkIcon.style.borderColor = '#0d6efd';
                        if (checkIconInner) {
                            checkIconInner.style.display = 'block';
                        }
                    }
                } else {
                    // Si está deshabilitado (pero no pagado), usar estilos de deshabilitado
                    if (checkbox.disabled) {
                        container.style.transform = 'translateY(0)';
                        container.style.backgroundColor = '#f8f9fa';
                        container.style.borderColor = '#dee2e6';
                        container.style.opacity = '0.6';
                        container.style.cursor = 'not-allowed';
                        container.style.boxShadow = 'none';
                    } else {
                        // Si no está deshabilitado y no está en hover, usar estilos normales
                        if (!isHovering) {
                            container.style.transform = 'translateY(0)';
                            container.style.backgroundColor = '#f8f9fa';
                            container.style.borderColor = '#dee2e6';
                            container.style.opacity = '1';
                            container.style.cursor = 'pointer';
                            container.style.boxShadow = 'none';
                        }
                        // Si está en hover, mantener el estilo de hover (no sobrescribir)
                    }
                    
                    if (checkIcon) {
                        checkIcon.style.backgroundColor = 'white';
                        checkIcon.style.borderColor = '#dee2e6';
                        if (checkIconInner) {
                            checkIconInner.style.display = 'none';
                        }
                    }
                }
            }
            
            // Función para inicializar los contenedores de meses
            function inicializarContenedoresMeses() {
                mesesContainers.forEach(function(container) {
                    const checkboxId = container.dataset.mesCheckboxId;
                    const checkbox = document.getElementById(checkboxId);
                    if (checkbox) {
                        // Si el mes está pagado, forzar que no esté seleccionado
                        const estaPagado = container.dataset.estaPagado === 'true';
                        if (estaPagado) {
                            checkbox.checked = false;
                            checkbox.disabled = true;
                        }
                        
                        // Inicializar estilo
                        actualizarEstiloMes(container, checkbox);
                        
                        // Hacer el contenedor clickeable
                        container.addEventListener('click', function(e) {
                            // Prevenir el comportamiento por defecto pero permitir que el checkbox cambie
                            e.preventDefault();
                            e.stopPropagation();
                            
                            // Verificar si está pagado
                            const estaPagado = container.dataset.estaPagado === 'true';
                            if (estaPagado) {
                                return; // No hacer nada si ya está pagado
                            }
                            
                            // Solo procesar si el checkbox no está deshabilitado
                            if (checkbox.disabled) {
                                // Mostrar mensaje informativo
                                const containerAnterior = checkbox.closest('.mes-adeudado-checkbox-container');
                                if (containerAnterior && containerAnterior.title) {
                                    alert(containerAnterior.title);
                                } else {
                                    alert('Debe seleccionar primero los meses anteriores pendientes antes de seleccionar este mes futuro.');
                                }
                                return;
                            }
                            
                            // Cambiar el estado del checkbox
                            const nuevoEstado = !checkbox.checked;
                            checkbox.checked = nuevoEstado;
                            
                            // Disparar evento change manualmente para que otros listeners lo detecten
                            // Esto activará la selección automática de meses anteriores si es necesario
                            const changeEvent = new Event('change', { bubbles: true });
                            checkbox.dispatchEvent(changeEvent);
                            
                            // Actualizar estilo visual inmediatamente
                            actualizarEstiloMes(container, checkbox);
                            
                            // Actualizar resumen (no sincronizar con select en modo múltiple)
                            actualizarResumenMeses();
                        });
                        
                        // Efectos hover - usar una referencia estable al checkbox
                        const checkboxRef = checkbox;
                        let isHovering = false;
                        
                        container.addEventListener('mouseenter', function() {
                            isHovering = true;
                            const estaPagado = container.dataset.estaPagado === 'true';
                            // Verificar el estado actual del checkbox (puede haber cambiado)
                            if (!checkboxRef.checked && !checkboxRef.disabled && !estaPagado) {
                                container.style.backgroundColor = '#e9ecef';
                                container.style.borderColor = '#adb5bd';
                                container.style.transform = 'translateY(-2px)';
                                container.style.boxShadow = '0 4px 6px rgba(0, 0, 0, 0.1)';
                            }
                        });
                        
                        container.addEventListener('mouseleave', function() {
                            isHovering = false;
                            // Siempre restaurar el estilo al salir del hover
                            actualizarEstiloMes(container, checkboxRef);
                        });
                        
                        // Guardar referencia para poder restaurar hover después de actualizaciones automáticas
                        container._checkboxRef = checkboxRef;
                        container._isHovering = function() { return isHovering; };
                        
                        // Efecto active (click)
                        container.addEventListener('mousedown', function() {
                            if (!checkbox.disabled) {
                                container.style.transform = 'translateY(0)';
                                container.style.boxShadow = '0 1px 2px rgba(0, 0, 0, 0.1)';
                            }
                        });
                        
                        container.addEventListener('mouseup', function() {
                            if (!checkbox.disabled) {
                                actualizarEstiloMes(container, checkbox);
                            }
                        });
                    }
                });
            }
            
            // Si hay meses adeudados, activar modo múltiple automáticamente
            const hayMesesAdeudados = mesesCheckboxes.length > 0;
            let modoMultipleActivo = hayMesesAdeudados;
            
            // Inicializar contenedores de meses ANTES de habilitar checkboxes
            inicializarContenedoresMeses();
            
            // === LÓGICA SIMPLE: Solo se puede seleccionar un mes si el inmediato anterior está seleccionado ===
            
            // Obtener meses ordenados cronológicamente por curso (retorna Map cursoId -> [checkbox1, checkbox2, ...])
            function getMesesOrdenadosPorCurso() {
                const porCurso = {};
                mesesCheckboxes.forEach(function(cb) {
                    const cursoId = cb.dataset.cursoId;
                    if (!porCurso[cursoId]) porCurso[cursoId] = [];
                    porCurso[cursoId].push({
                        checkbox: cb,
                        mes: parseInt(cb.dataset.mes),
                        ano: parseInt(cb.dataset.ano)
                    });
                });
                Object.keys(porCurso).forEach(function(cursoId) {
                    porCurso[cursoId].sort(function(a, b) {
                        if (a.ano !== b.ano) return a.ano - b.ano;
                        return a.mes - b.mes;
                    });
                });
                return porCurso;
            }
            
            // Verificar si un mes puede ser seleccionado (el inmediato anterior debe estar seleccionado)
            function puedeSeleccionarMes(checkbox) {
                const cursoId = checkbox.dataset.cursoId;
                const mes = parseInt(checkbox.dataset.mes);
                const ano = parseInt(checkbox.dataset.ano);
                const mesesOrdenados = getMesesOrdenadosPorCurso()[cursoId];
                if (!mesesOrdenados) return true;
                const idx = mesesOrdenados.findIndex(function(m) {
                    return m.checkbox === checkbox;
                });
                if (idx <= 0) return true; // El primero siempre se puede seleccionar
                const anterior = mesesOrdenados[idx - 1].checkbox;
                return anterior.checked;
            }
            
            // Obtener el mes inmediatamente anterior en la lista del curso
            function getMesAnterior(checkbox) {
                const cursoId = checkbox.dataset.cursoId;
                const mesesOrdenados = getMesesOrdenadosPorCurso()[cursoId];
                if (!mesesOrdenados) return null;
                const idx = mesesOrdenados.findIndex(function(m) { return m.checkbox === checkbox; });
                return idx > 0 ? mesesOrdenados[idx - 1].checkbox : null;
            }
            
            // Obtener todos los meses posteriores a uno dado (en orden cronológico)
            function getMesesPosteriores(checkbox) {
                const cursoId = checkbox.dataset.cursoId;
                const mesesOrdenados = getMesesOrdenadosPorCurso()[cursoId];
                if (!mesesOrdenados) return [];
                const idx = mesesOrdenados.findIndex(function(m) { return m.checkbox === checkbox; });
                if (idx < 0) return [];
                return mesesOrdenados.slice(idx + 1).map(function(m) { return m.checkbox; });
            }
            
            // Actualizar estado: deshabilitar meses cuyo anterior no está seleccionado
            function actualizarEstadoMeses() {
                mesesCheckboxes.forEach(function(checkbox) {
                    const container = checkbox.closest('.mes-adeudado-checkbox-container');
                    const puede = puedeSeleccionarMes(checkbox);
                    checkbox.disabled = !puede;
                    if (container) {
                        container.title = puede ? '' : 'Debe seleccionar primero el mes inmediatamente anterior';
                        actualizarEstiloMes(container, checkbox);
                    }
                });
            }
            
            requestAnimationFrame(function() {
                actualizarEstadoMeses();
            });
            
            // Actualizar estilos cuando cambia el checkbox directamente (por ejemplo, con "Seleccionar todos")
            mesesCheckboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    // Evitar recursión al deseleccionar posteriores en cascada
                    if (window._deseleccionandoPosteriores) return;
                    
                    const container = document.querySelector(`[data-mes-checkbox-id="${this.id}"]`);
                    
                    if (this.checked) {
                        // Al seleccionar: si no debería poder (ej. por manipulación), revertir
                        if (!puedeSeleccionarMes(this)) {
                            this.checked = false;
                        }
                    } else {
                        // Al deseleccionar: quitar todos los meses posteriores (dependen de este)
                        const posteriores = getMesesPosteriores(this);
                        if (posteriores.length > 0) {
                            window._deseleccionandoPosteriores = true;
                            posteriores.forEach(function(cb) {
                                cb.checked = false;
                                const c = document.querySelector(`[data-mes-checkbox-id="${cb.id}"]`);
                                if (c) actualizarEstiloMes(c, cb);
                            });
                            window._deseleccionandoPosteriores = false;
                        }
                    }
                    
                    if (container) {
                        actualizarEstiloMes(container, this);
                    }
                    
                    actualizarEstadoMeses();
                    if (typeof actualizarResumenMeses === 'function') {
                        actualizarResumenMeses();
                    }
                });
            });
            
            // Función para calcular el total de meses seleccionados
            function calcularTotalMesesSeleccionados() {
                let total = 0;
                const mesesSeleccionados = [];
                
                mesesCheckboxes.forEach(function(checkbox) {
                    if (checkbox.checked) {
                        const montoBase = parseFloat(checkbox.dataset.montoBase) || 0;
                        total += montoBase;
                        mesesSeleccionados.push({
                            mes: checkbox.dataset.mes,
                            ano: checkbox.dataset.ano,
                            cursoId: checkbox.dataset.cursoId,
                            cursoNombre: checkbox.dataset.cursoNombre,
                            monto: montoBase
                        });
                    }
                });
                
                return { total, mesesSeleccionados };
            }
            
            // Variable para evitar múltiples llamadas simultáneas
            let calculandoMonto = false;
            let ultimoCalculoPromise = null;
            
            // Función para calcular el monto total con descuentos e intereses
            function calcularMontoTotalConDescuentos() {
                const { total, mesesSeleccionados } = calcularTotalMesesSeleccionados();
                
                if (mesesSeleccionados.length === 0) {
                    return Promise.resolve({ monto: 0, montoBase: 0 });
                }
                
                // Si ya hay un cálculo en curso, esperar a que termine y devolver ese resultado
                if (calculandoMonto && ultimoCalculoPromise) {
                    return ultimoCalculoPromise;
                }
                
                // Marcar que estamos calculando
                calculandoMonto = true;
                
                // Obtener descuentos promocionales seleccionados
                const checkboxesMarcados = document.querySelectorAll('.descuento-promocional-checkbox:checked');
                const descuentosIds = Array.from(checkboxesMarcados)
                    .map(cb => cb.value);
                
                // Preparar datos para enviar
                const formData = new URLSearchParams();
                formData.append('alumno_id', document.getElementById('alumnos_pagos_alumno')?.value || '');
                mesesSeleccionados.forEach(function(mes) {
                    formData.append('meses_seleccionados[]', mes.mes + '_' + mes.ano + '_' + mes.cursoId);
                });
                descuentosIds.forEach(id => {
                    formData.append('descuentos_promocionales[]', id);
                });
                const metodoPagoSelect = document.querySelector('.metodo-pago-select') || document.querySelector('select[name="alumnos_pagos[metodoPago]"]');
                if (metodoPagoSelect) {
                    formData.append('metodo_pago', metodoPagoSelect.value || 'efectivo');
                }
                
                // Llamar al endpoint AJAX
                ultimoCalculoPromise = fetch('{{ path("app_alumnos_pagos_calcular_monto") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    calculandoMonto = false;
                    if (data.error) {
                        console.error('Error:', data.error);
                        return { monto: total, montoBase: total };
                    }
                    return data;
                })
                .catch(error => {
                    calculandoMonto = false;
                    console.error('Error al calcular monto:', error);
                    return { monto: total, montoBase: total };
                });
                
                return ultimoCalculoPromise;
            }
            
            // Función para actualizar el resumen de meses seleccionados
            function actualizarResumenMeses() {
                const { total, mesesSeleccionados } = calcularTotalMesesSeleccionados();
                
                if (mesesSeleccionados.length > 0) {
                    if (resumenMeses) {
                        resumenMeses.style.display = 'block';
                    }
                    if (listaMeses) {
                        listaMeses.innerHTML = '';
                        
                        mesesSeleccionados.forEach(function(mes) {
                            const badge = document.createElement('span');
                            badge.className = 'badge bg-primary me-2 mb-2';
                            const montoFormateado = mes.monto.toLocaleString('es-AR', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                            badge.textContent = mes.cursoNombre + ' - ' + mes.mes + '/' + mes.ano + ' ($' + montoFormateado + ')';
                            listaMeses.appendChild(badge);
                        });
                    }
                    
                    // Calcular monto total con descuentos e intereses
                    if (modoMultipleActivo) {
                        calcularMontoTotalConDescuentos().then(function(data) {
                            // Usar data.monto directamente, solo usar total como fallback si data.monto es null/undefined
                            // No usar || porque 0 es un valor válido
                            const montoFinal = (data.monto !== null && data.monto !== undefined) ? data.monto : total;
                            
                            // Actualizar campo Precio a Cobrar (input único) (para evitar conflictos con listeners)
                            if (campoMonto) {
                                // Marcar que la actualización es programática
                                campoMonto.dataset.updatingProgrammatically = 'true';
                                campoMonto.value = montoFinal.toFixed(2);
                                // Remover la marca después de un pequeño delay más largo para evitar race conditions
                                setTimeout(function() {
                                    delete campoMonto.dataset.updatingProgrammatically;
                                }, 300);
                            }
                            
                            // Actualizar regla de cálculo si viene en la respuesta
                            if (data.ordenCalculoTexto && data.ordenCalculoDescripcion) {
                                actualizarReglaCalculo(data.ordenCalculoTexto, data.ordenCalculoDescripcion);
                            }
                            
                            // Actualizar información de interés si viene en la respuesta
                            if (data.motivoInteres && data.porcentajeInteres !== undefined) {
                                // Buscar el contenedor de interés y actualizarlo
                                const interesContainer = document.querySelector('[id*="interes"], [class*="interes"]');
                                if (interesContainer && data.porcentajeInteres > 0) {
                                    const motivoElement = interesContainer.querySelector('p.mb-1, .text-muted');
                                    const porcentajeElement = interesContainer.querySelector('strong');
                                    if (motivoElement) motivoElement.textContent = data.motivoInteres;
                                    if (porcentajeElement) porcentajeElement.textContent = 'Interés aplicado: ' + data.porcentajeInteres + '%';
                                }
                            }
                            // Actualizar bloque Descuentos Aplicados: ocultar si no hay descuentos (p. ej. método no es efectivo)
                            const descuentosContainer = document.getElementById('descuentos-aplicados-container');
                            const descuentosLista = document.getElementById('descuentos-aplicados-lista');
                            const descuentosTotal = document.getElementById('descuentos-aplicados-total');
                            if (descuentosContainer && descuentosLista && descuentosTotal) {
                                const lista = (data.descuentosAplicados && data.descuentosAplicados.length > 0) ? data.descuentosAplicados : [];
                                const totalPct = (data.porcentajeDescuentoTotal !== undefined && data.porcentajeDescuentoTotal > 0) ? data.porcentajeDescuentoTotal : 0;
                                if (lista.length > 0 && totalPct > 0) {
                                    descuentosLista.innerHTML = lista.map(function(d) { return '<li>' + d + '</li>'; }).join('');
                                    descuentosTotal.innerHTML = '<strong class="text-dark">Total descuentos: ' + totalPct + '%</strong>';
                                    descuentosContainer.style.display = 'block';
                                } else {
                                    descuentosContainer.style.display = 'none';
                                }
                            }
                            
                            // Actualizar visibilidad de descuentos promocionales según puedeRecibirDescuentos
                            const descuentosPromocionalesContainer = document.getElementById('descuentos-promocionales-container');
                            if (descuentosPromocionalesContainer) {
                                if (data.puedeRecibirDescuentos !== undefined && !data.puedeRecibirDescuentos) {
                                    descuentosPromocionalesContainer.style.display = 'none';
                                    // Desmarcar todos los checkboxes de descuentos promocionales
                                    const checkboxesDescuentos = document.querySelectorAll('.descuento-promocional-checkbox');
                                    checkboxesDescuentos.forEach(function(cb) {
                                        cb.checked = false;
                                    });
                                } else if (data.puedeRecibirDescuentos !== undefined && data.puedeRecibirDescuentos) {
                                    descuentosPromocionalesContainer.style.display = 'block';
                                }
                            }
                        });
                    }
                } else {
                    // Si no hay meses seleccionados, mostrar $0.00
                    if (resumenMeses) {
                        resumenMeses.style.display = 'none';
                    }
                    if (campoMonto) {
                        campoMonto.dataset.updatingProgrammatically = 'true';
                        campoMonto.value = '0.00';
                        setTimeout(function() {
                            delete campoMonto.dataset.updatingProgrammatically;
                        }, 100);
                    }
                }
            }
            
            // Obtener el select múltiple de meses del formulario
            const selectMesMultiple = document.querySelector('select[name="alumnos_pagos[mes][]"], select[name="alumnos_pagos[mes]"]');
            
            // Función para sincronizar checkboxes con el select múltiple
            // NOTA: En modo múltiple, esta función NO debe usarse porque el select no puede distinguir entre cursos
            function sincronizarCheckboxesConSelect() {
                if (!selectMesMultiple || modoMultipleActivo) return; // No sincronizar en modo múltiple
                
                const valoresSeleccionados = Array.from(selectMesMultiple.selectedOptions).map(opt => parseInt(opt.value));
                
                mesesCheckboxes.forEach(function(checkbox) {
                    const mesCheckbox = parseInt(checkbox.dataset.mes);
                    const mesEnSelect = valoresSeleccionados.includes(mesCheckbox);
                    
                    if (mesEnSelect && !checkbox.checked) {
                        checkbox.checked = true;
                    } else if (!mesEnSelect && checkbox.checked) {
                        checkbox.checked = false;
                    }
                    
                    // Actualizar estilo visual
                    const container = document.querySelector(`[data-mes-checkbox-id="${checkbox.id}"]`);
                    if (container) {
                        actualizarEstiloMes(container, checkbox);
                    }
                });
                
                actualizarResumenMeses();
            }
            
            // Función para sincronizar select múltiple con checkboxes
            // NOTA: En modo múltiple, esta función NO debe usarse porque el select no puede distinguir entre cursos
            function sincronizarSelectConCheckboxes() {
                if (!selectMesMultiple || modoMultipleActivo) return; // No sincronizar en modo múltiple
                
                const mesesSeleccionados = new Set();
                mesesCheckboxes.forEach(function(checkbox) {
                    if (checkbox.checked) {
                        mesesSeleccionados.add(parseInt(checkbox.dataset.mes));
                    }
                });
                
                // Actualizar el select múltiple
                Array.from(selectMesMultiple.options).forEach(function(option) {
                    option.selected = mesesSeleccionados.has(parseInt(option.value));
                });
            }
            
            // Event listener para el switch de modo múltiple (si existe)
            const modoPagoMultipleHidden = document.getElementById('modo-pago-multiple-hidden');
            if (modoPagoMultiple) {
                modoPagoMultiple.addEventListener('change', function() {
                    modoMultipleActivo = this.checked;
                    if (this.checked) {
                        // Aplicar regla de meses consecutivos (solo primer mes habilitado por curso)
                        actualizarEstadoMeses();
                        // Mostrar y habilitar el select múltiple
                        if (selectMesMultiple) {
                            const colMes = selectMesMultiple.closest('.col-md-4');
                            if (colMes) {
                                colMes.style.display = 'block';
                                // Cambiar el label si existe
                                const labelMes = colMes.querySelector('label');
                                if (labelMes) {
                                    const small = labelMes.querySelector('small');
                                    if (!small) {
                                        const smallEl = document.createElement('small');
                                        smallEl.className = 'text-muted d-block';
                                        smallEl.textContent = 'Puede seleccionar múltiples meses';
                                        labelMes.appendChild(smallEl);
                                    }
                                }
                            }
                            selectMesMultiple.multiple = true;
                            selectMesMultiple.size = 5;
                            selectMesMultiple.style.display = 'block';
                            selectMesMultiple.setAttribute('name', 'alumnos_pagos[mes][]');
                        }
                        // Ocultar campo de mes, año y curso (no necesarios en modo múltiple)
                        const campoMesContainer = document.getElementById('campo-mes-container');
                        if (campoMesContainer) {
                            campoMesContainer.style.display = 'none';
                        }
                        const campoAno = document.querySelector('select[name="alumnos_pagos[ano]"]');
                        if (campoAno) {
                            const colAno = campoAno.closest('.col-md-4');
                            if (colAno) colAno.style.display = 'none';
                        }
                        const campoCursoContainer = document.getElementById('campo-curso-container');
                        if (campoCursoContainer) {
                            campoCursoContainer.style.display = 'none';
                        }
                        // Actualizar campo oculto
                        if (modoPagoMultipleHidden) modoPagoMultipleHidden.value = '1';
                        // No sincronizar con select en modo múltiple
                        actualizarResumenMeses();
                    } else {
                        modoMultipleActivo = false;
                        // Deshabilitar checkboxes de meses
                        mesesCheckboxes.forEach(function(checkbox) {
                            checkbox.checked = false;
                            checkbox.disabled = true;
                        });
                        if (resumenMeses) resumenMeses.style.display = 'none';
                        // Resetear el select múltiple
                        if (selectMesMultiple) {
                            Array.from(selectMesMultiple.options).forEach(opt => opt.selected = false);
                            selectMesMultiple.multiple = false;
                            selectMesMultiple.size = 1;
                            selectMesMultiple.setAttribute('name', 'alumnos_pagos[mes]');
                        }
                        // Mostrar campo de mes, año y curso (necesarios en modo simple)
                        const campoMesContainer = document.getElementById('campo-mes-container');
                        if (campoMesContainer) {
                            campoMesContainer.style.display = 'block';
                        }
                        const campoAno = document.querySelector('select[name="alumnos_pagos[ano]"]');
                        if (campoAno) {
                            const colAno = campoAno.closest('.col-md-4');
                            if (colAno) colAno.style.display = 'block';
                        }
                        const campoCursoContainer = document.getElementById('campo-curso-container');
                        if (campoCursoContainer) {
                            campoCursoContainer.style.display = 'block';
                        }
                        // Actualizar campo oculto
                        if (modoPagoMultipleHidden) modoPagoMultipleHidden.value = '0';
                    }
                });
            }
            
            // Event listeners para checkboxes de meses
            mesesCheckboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    if (modoMultipleActivo) {
                        // Actualizar estilo visual
                        const container = document.querySelector(`[data-mes-checkbox-id="${this.id}"]`);
                        if (container) {
                            actualizarEstiloMes(container, this);
                        }
                        // No sincronizar con select en modo múltiple
                        actualizarResumenMeses();
                    }
                });
            });
            
            // Event listeners para descuentos promocionales (cuando cambian, recalcular total)
            const descuentosPromocionalesCheckboxes = document.querySelectorAll('.descuento-promocional-checkbox');
            descuentosPromocionalesCheckboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function(e) {
                    if (modoMultipleActivo) {
                        actualizarResumenMeses();
                    }
                });
            });
            
            // Event listener para el select múltiple de meses
            // NOTA: En modo múltiple, no sincronizamos porque el select no puede distinguir entre cursos
            if (selectMesMultiple && !modoMultipleActivo) {
                selectMesMultiple.addEventListener('change', function() {
                    sincronizarCheckboxesConSelect();
                });
            }
            
            // Al cambiar el método de pago, recalcular el precio (afecta descuento por efectivo)
            const metodoPagoSelectEl = document.querySelector('.metodo-pago-select') || document.querySelector('select[name="alumnos_pagos[metodoPago]"]');
            if (metodoPagoSelectEl) {
                metodoPagoSelectEl.addEventListener('change', function() {
                    actualizarResumenMeses();
                });
            }
            
            // Botones "Seleccionar todos" - selecciona en orden cronológico (respeta regla: anterior debe estar seleccionado)
            document.querySelectorAll('.seleccionar-todos-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    if (!modoMultipleActivo) return;
                    const cursoNombre = this.dataset.curso;
                    const checkboxesCurso = Array.from(mesesCheckboxes).filter(function(cb) {
                        return cb.dataset.cursoNombre === cursoNombre;
                    });
                    
                    const porCurso = getMesesOrdenadosPorCurso();
                    const cursoId = checkboxesCurso[0]?.dataset.cursoId;
                    const ordenados = porCurso[cursoId] || [];
                    
                    const todosMarcados = ordenados.every(function(m) { return m.checkbox.checked; });
                    
                    if (todosMarcados) {
                        // Deseleccionar todos (en orden inverso)
                        ordenados.slice().reverse().forEach(function(m) {
                            m.checkbox.checked = false;
                            const container = document.querySelector(`[data-mes-checkbox-id="${m.checkbox.id}"]`);
                            if (container) actualizarEstiloMes(container, m.checkbox);
                        });
                    } else {
                        // Seleccionar en orden: primero, segundo, etc. (respeta dependencia)
                        ordenados.forEach(function(m) {
                            if (!m.checkbox.disabled) {
                                m.checkbox.checked = true;
                                const container = document.querySelector(`[data-mes-checkbox-id="${m.checkbox.id}"]`);
                                if (container) actualizarEstiloMes(container, m.checkbox);
                                actualizarEstadoMeses(); // habilitar el siguiente
                            }
                        });
                    }
                    
                    actualizarEstadoMeses();
                    if (typeof actualizarResumenMeses === 'function') actualizarResumenMeses();
                });
            });
            
            // Función para seleccionar el mes más antiguo del primer curso
            function seleccionarMesMasAntiguo() {
                if (mesesCheckboxes.length === 0) return;
                
                // Agrupar meses por curso
                const mesesPorCurso = {};
                mesesCheckboxes.forEach(function(checkbox) {
                    const cursoId = checkbox.dataset.cursoId;
                    if (!mesesPorCurso[cursoId]) {
                        mesesPorCurso[cursoId] = [];
                    }
                    mesesPorCurso[cursoId].push({
                        checkbox: checkbox,
                        mes: parseInt(checkbox.dataset.mes),
                        ano: parseInt(checkbox.dataset.ano),
                        cursoId: cursoId
                    });
                });
                
                // Obtener el primer curso (orden de aparición)
                const primerCursoId = Object.keys(mesesPorCurso)[0];
                if (!primerCursoId) return;
                
                // Encontrar el mes más antiguo del primer curso
                const mesesPrimerCurso = mesesPorCurso[primerCursoId];
                let mesMasAntiguo = mesesPrimerCurso[0];
                
                mesesPrimerCurso.forEach(function(mes) {
                    // Comparar por año primero, luego por mes
                    if (mes.ano < mesMasAntiguo.ano || 
                        (mes.ano === mesMasAntiguo.ano && mes.mes < mesMasAntiguo.mes)) {
                        mesMasAntiguo = mes;
                    }
                });
                
                // Seleccionar el checkbox del mes más antiguo
                if (mesMasAntiguo.checkbox) {
                    mesMasAntiguo.checkbox.checked = true;
                    const container = document.querySelector(`[data-mes-checkbox-id="${mesMasAntiguo.checkbox.id}"]`);
                    if (container) {
                        actualizarEstiloMes(container, mesMasAntiguo.checkbox);
                    }
                }
            }
            
            // Inicializar estado al final: aplicar regla de meses consecutivos (solo primer mes habilitado por curso)
            if (hayMesesAdeudados) {
                actualizarEstadoMeses();
                
                // Configurar select múltiple
                if (selectMesMultiple) {
                    const colMes = selectMesMultiple.closest('.col-md-4');
                    if (colMes) colMes.style.display = 'block';
                    selectMesMultiple.multiple = true;
                    selectMesMultiple.size = 5;
                    selectMesMultiple.style.display = 'block';
                    selectMesMultiple.setAttribute('name', 'alumnos_pagos[mes][]');
                }
                
                // Ocultar campo de mes, año y curso (no necesarios en modo múltiple)
                const campoMesContainer = document.getElementById('campo-mes-container');
                if (campoMesContainer) {
                    campoMesContainer.style.display = 'none';
                }
                const campoAno = document.querySelector('select[name="alumnos_pagos[ano]"]');
                if (campoAno) {
                    const colAno = campoAno.closest('.col-md-4');
                    if (colAno) colAno.style.display = 'none';
                }
                const campoCursoContainer = document.getElementById('campo-curso-container');
                if (campoCursoContainer) {
                    campoCursoContainer.style.display = 'none';
                }
                
                // Actualizar campo oculto
                if (modoPagoMultipleHidden) modoPagoMultipleHidden.value = '1';
                
                // Seleccionar automáticamente el mes más antiguo del primer curso
                seleccionarMesMasAntiguo();
                
                // Actualizar resumen para calcular el monto inicial
                // NOTA: No sincronizamos con el select múltiple porque no puede distinguir entre cursos
                actualizarResumenMeses();
            } else {
                // Si no hay meses adeudados, deshabilitar checkboxes
                mesesCheckboxes.forEach(function(checkbox) {
                    checkbox.disabled = true;
                });
                if (modoPagoMultipleHidden) modoPagoMultipleHidden.value = '0';
            }
            
            // Validación del formulario: no permitir enviar sin meses seleccionados en modo múltiple
            const form = document.querySelector('form[name="alumnos_pagos"]');
            if (form && hayMesesAdeudados) {
                form.addEventListener('submit', function(e) {
                    const mesesMarcados = Array.from(mesesCheckboxes).filter(cb => cb.checked);
                    
                    // Asegurar que el campo oculto esté establecido correctamente
                    if (modoPagoMultipleHidden) {
                        modoPagoMultipleHidden.value = mesesMarcados.length > 0 ? '1' : '0';
                    }
                    
                    // Debug: Log para ver qué se está enviando
                    if (mesesMarcados.length === 0) {
                        e.preventDefault();
                        e.stopPropagation();
                        alert('Por favor, seleccione al menos un mes para registrar el pago.');
                        return false;
                    }
                    
                    // Verificar que el monto sea mayor a 0
                    const montoValue = parseFloat(campoMonto ? campoMonto.value : 0);
                    if (montoValue <= 0) {
                        e.preventDefault();
                        e.stopPropagation();
                        alert('El monto debe ser mayor a $0.00 para registrar el pago.');
                        return false;
                    }
                });
            }
            
            // Calcular monto inicial si hay meses disponibles
            {% if alumno and mesesAdeudados is defined and mesesAdeudados|length > 0 %}
            // Esperar a que el DOM esté completamente cargado
            setTimeout(function() {
                // Verificar si hay algún mes seleccionado por defecto
                const mesesCheckboxes = document.querySelectorAll('.mes-adeudado-checkbox:checked');
                if (mesesCheckboxes.length > 0 && typeof actualizarResumenMeses === 'function') {
                    actualizarResumenMeses();
                }
            }, 100);
            {% endif %}
        });
    </script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            // Forzar la fecha correcta del instituto en el campo de fecha
            {% if fechaActualInstituto is defined %}
            const campoFecha = document.querySelector('input[name="alumnos_pagos[fecha]"]');
            if (campoFecha && !campoFecha.value) {
                campoFecha.value = '{{ fechaActualInstituto }}';
            }
            {% endif %}

            // Redirigir al seleccionar alumno (actualiza URL con ?id=X para cargar deudas del alumno)
            // Usar jQuery .on() para compatibilidad con Chosen.js - addEventListener no captura bien el change de Chosen
            $('#alumnos_pagos_alumno').on('change', function() {
                var alumnoId = $(this).val();
                if (alumnoId) {
                    var currentUrl = new URL(window.location.href);
                    currentUrl.searchParams.set('id', alumnoId);
                    // Mantener descuentos promocionales seleccionados en la URL
                    var paramsToDelete = [];
                    currentUrl.searchParams.forEach(function(value, key) {
                        if (key.startsWith('descuentos_promocionales')) paramsToDelete.push(key);
                    });
                    paramsToDelete.forEach(function(key) { currentUrl.searchParams.delete(key); });
                    var checkboxes = document.querySelectorAll('.descuento-promocional-checkbox:checked');
                    checkboxes.forEach(function(cb) {
                        currentUrl.searchParams.append('descuentos_promocionales[]', cb.value);
                    });
                    window.location.href = currentUrl.toString();
                }
            });
        });
    </script>
{% endblock %}
