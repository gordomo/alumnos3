{% extends 'base.html.twig' %}

{% block title %}Editar Pago{% endblock %}

{% block panelTitle %}Editar Pago{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">{{ alumno.nombreApellido }}</h4>
                    </div>
                    <div class="card-body">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}

                        {{ include('alumnos_pagos/_form.html.twig', {
                            'button_label': 'Guardar',
                            'alumno': alumno
                        }) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
