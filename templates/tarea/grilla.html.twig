{% extends 'base.html.twig' %}
{% block title %}{{ tarea.titulo }}{% endblock %}
{% block panelTitle %}Tareas{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path(rutas.index) }}">Tareas</a></li>
            <li class="breadcrumb-item"><a href="{{ path(rutas.curso, {'id': curso.id}) }}">{{ curso.nombre }}</a></li>
            <li class="breadcrumb-item active">{{ tarea.titulo }}</li>
        </ol>
    </nav>

    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-check2-square"></i> {{ tarea.titulo }}
                <small>{{ tarea.fecha|date(date_format) }}</small>
            </h5>
            {% if not soloLectura %}
                <a href="{{ path(rutas.editar, {'id': tarea.id}) }}" class="btn btn-light btn-sm">
                    <i class="bi bi-pencil"></i> Editar
                </a>
            {% endif %}
        </div>
        <div class="card-body">
            <div class="alert alert-light">
                {% if tarea.periodo %}
                    <span class="badge {{ tarea.periodo.esExamen ? 'bg-info text-dark' : 'bg-primary' }}">{{ tarea.periodo.nombre }}</span>
                {% endif %}
                {% if tarea.fechaEntrega %}
                    Entrega: <strong>{{ tarea.fechaEntrega|date(date_format) }}</strong>.
                {% endif %}
                {% if tarea.descripcion %}
                    <div class="mt-2">{{ tarea.descripcion|nl2br }}</div>
                {% endif %}
            </div>

            {% if inscripciones is empty %}
                <p class="text-muted mb-0">Este curso no tiene alumn@s inscript@s.</p>
            {% else %}
                <form method="post" action="{{ path(rutas.guardar, {'id': tarea.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('tarea_grilla' ~ tarea.id) }}">

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Alumn@</th>
                                    <th class="text-center" style="width: 120px;">Entregó</th>
                                    <th>Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for inscripcion in inscripciones %}
                                    {% set entrega = entregas[inscripcion.id]|default(null) %}
                                    <tr>
                                        <td>{{ inscripcion.alumno.apellido }}, {{ inscripcion.alumno.nombre }}</td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input"
                                                   name="entregada[{{ inscripcion.id }}]" value="1"
                                                   {% if entrega and entrega.entregada %}checked{% endif %}
                                                   {% if soloLectura %}disabled{% endif %}>
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm"
                                                   name="observaciones[{{ inscripcion.id }}]"
                                                   value="{{ entrega ? entrega.observaciones : '' }}"
                                                   placeholder="Opcional"
                                                   {% if soloLectura %}readonly{% endif %}>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {% if not soloLectura %}
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Sin tildar y sin observación, la fila no se guarda: no tildado significa que no entregó.
                            </small>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Guardar entregas
                            </button>
                        </div>
                    {% else %}
                        <p class="text-muted mb-0"><i class="bi bi-lock"></i> Solo lectura: no podés modificar las entregas de este curso.</p>
                    {% endif %}
                </form>
            {% endif %}
        </div>
    </div>

    <a href="{{ path(rutas.curso, {'id': curso.id}) }}" class="btn btn-secondary mt-3">← Volver al curso</a>
</div>
{% endblock %}
