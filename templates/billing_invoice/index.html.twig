{% extends 'base.html.twig' %}

{% block title %}Mi suscripción{% endblock %}

{% block panelTitle %}Mi suscripción{% endblock %}

{% block body %}
{% set s = suscripcion %}
{% set factura = s.factura %}

<div class="container-fluid px-4 mt-3" style="padding-bottom: 3rem;">

    {# ---------- Estado, arriba y en una línea ---------- #}
    {% set encabezados = {
        'al_dia':       {'clase': 'success',  'icono': 'bi-check-circle-fill',        'texto': 'Estás al día'},
        'exenta':       {'clase': 'secondary','icono': 'bi-gift-fill',                'texto': 'Tu instituto no paga suscripción'},
        'en_revision':  {'clase': 'info',     'icono': 'bi-hourglass-split',          'texto': 'Estamos verificando tu pago'},
        'por_vencer':   {'clase': 'warning',  'icono': 'bi-clock-history',            'texto': 'Tu suscripción está por vencer'},
        'vencida':      {'clase': 'danger',   'icono': 'bi-exclamation-triangle-fill','texto': 'Tu suscripción está vencida'},
        'solo_lectura': {'clase': 'danger',   'icono': 'bi-lock-fill',                'texto': 'Sistema en modo consulta'},
        'bloqueada':    {'clase': 'danger',   'icono': 'bi-slash-circle-fill',        'texto': 'Panel bloqueado'}
    } %}
    {# "Al día" con facturas impagas encima es una contradicción. El servicio las trata como al
       día porque no tienen vencimiento y no disparan ningún plazo, pero decirle a alguien que no
       debe nada arriba de siete facturas pendientes es mentirle. Se muestra distinto sin cambiar
       el estado real, que es el que manda sobre los bloqueos. #}
    {% set impagas = s.impagas|default([])|length %}
    {# El vencimiento más próximo de todas, no el de la más vieja: la más vieja puede no tener
       fecha y las nuevas sí, y ahí decir "ninguna vence" sería falso. #}
    {% set proximoVto = null %}
    {% for f in s.impagas|default([]) %}
        {% if f.dueDate and (proximoVto is null or f.dueDate < proximoVto) %}
            {% set proximoVto = f.dueDate %}
        {% endif %}
    {% endfor %}
    {% set estadoVisual = (s.estado == 'al_dia' and impagas > 0) ? 'pendiente' : s.estado %}
    {% set encabezados = encabezados|merge({
        'pendiente': {'clase': 'primary', 'icono': 'bi-receipt', 'texto': 'Tenés facturas pendientes'}
    }) %}
    {% set enc = encabezados[estadoVisual]|default(encabezados.al_dia) %}

    <div class="card mb-3 border-{{ enc.clase }}">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1 text-{{ enc.clase }}">
                    <i class="bi {{ enc.icono }}"></i> {{ enc.texto }}
                </h5>
                <p class="mb-0 text-muted small">
                    {% if estadoVisual == 'pendiente' %}
                        {% if proximoVto %}
                            La más próxima vence el {{ proximoVto|date('d/m/Y') }}.
                            Todavía estás en fecha: no hay nada vencido.
                        {% else %}
                            Ninguna tiene fecha de vencimiento, así que no corre ningún plazo ni se
                            limita el sistema. Podés pagarlas cuando quieras.
                        {% endif %}
                    {% elseif s.estado == 'al_dia' %}
                        No tenés nada pendiente. La próxima factura se emite el 1° del mes que viene.
                    {% elseif s.estado == 'exenta' %}
                        Tu instituto está exento de facturación. No se emiten facturas ni se bloquea el acceso.
                    {% elseif s.estado == 'en_revision' %}
                        Ya recibimos tu comprobante. En cuanto lo confirmemos te va a figurar como pagado.
                    {% elseif s.estado == 'por_vencer' %}
                        Vence {% if s.dias == 0 %}hoy{% elseif s.dias == 1 %}mañana{% else %}en {{ s.dias }} días{% endif %},
                        el {{ factura.dueDate|date('d/m/Y') }}.
                    {% elseif s.estado == 'vencida' %}
                        Venció el {{ factura.dueDate|date('d/m/Y') }}, hace {{ s.atraso }} día(s).
                        {% if s.limiteSoloLectura %}
                            El {{ s.limiteSoloLectura|date('d/m/Y') }} el sistema pasa a modo consulta.
                        {% endif %}
                    {% elseif s.estado == 'solo_lectura' %}
                        Podés ver todo y seguir registrando los pagos de tus alumn@s, pero no dar de alta ni
                        enviar comunicaciones.
                        {% if s.limiteBloqueo %}El {{ s.limiteBloqueo|date('d/m/Y') }} se bloquea el panel.{% endif %}
                    {% else %}
                        Para volver a usar el sistema hay que regularizar la suscripción.
                    {% endif %}
                </p>
            </div>

            {% if s.total > 0 %}
                <div class="text-end">
                    <div class="text-muted small">Debés</div>
                    <div class="fs-3 fw-bold text-{{ enc.clase }}">${{ s.total|number_format(2, ',', '.') }}</div>
                    {% if impagas > 1 %}
                        <div class="small text-muted">en {{ impagas }} facturas</div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    {# Dos columnas: a la izquierda lo único que se hace en esta pantalla, a la derecha lo que se
       consulta. A una sola columna el contenido quedaba en 46rem y media pantalla vacía al lado. #}
    <div class="row">
        <div class="col-lg-7 mb-3">
            {% if factura and not s.factura.isPaid() and s.estado != 'exenta' %}
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0"><i class="bi bi-credit-card"></i> Cómo pagar</h6>
                    </div>
                    <div class="card-body">
                        {# Primero se elige QUÉ se paga y después CÓMO. Antes el panel pagaba
                           siempre la más vieja y el botón ofrecía $1.000 abajo de un total de
                           $7.000, sin forma de elegir ni de entender cuál de los dos valía. #}
                        {% if impagas > 1 %}
                            <div class="border-bottom pb-2 mb-3" id="selector-facturas">
                                <div class="d-flex justify-content-between align-items-center mb-2 px-3">
                                    <span class="text-muted small">Qué querés pagar</span>
                                    <button type="button" class="btn btn-link btn-sm p-0" data-marcar-todas>
                                        Marcar todas
                                    </button>
                                </div>

                                {# Cada mes con su renglón separado y el mismo detalle que las
                                   facturas anteriores: pegadas una contra otra se leían como un
                                   bloque y costaba ver dónde terminaba una y empezaba la otra. #}
                                <div class="list-group list-group-flush">
                                    {% for f in s.impagas %}
                                        <label class="list-group-item d-flex justify-content-between align-items-center gap-2"
                                               for="fac{{ f.id }}" style="cursor: pointer;">
                                            <span class="d-flex align-items-center gap-2">
                                                <input class="form-check-input m-0 flex-shrink-0" type="checkbox" checked
                                                       id="fac{{ f.id }}" value="{{ f.id }}"
                                                       data-importe="{{ f.totalAmount }}" data-factura>
                                                <span>
                                                    <span class="d-block">{{ f.formattedPeriod }}</span>
                                                    <span class="small text-muted">
                                                        {{ f.activeStudentsCount }} alumn@s
                                                        {% if f.diasDeAtraso > 0 %}
                                                            <span class="badge bg-danger ms-1">
                                                                Vencida hace {{ f.diasDeAtraso }} día(s)
                                                            </span>
                                                        {% elseif f.dueDate %}
                                                            · vence el {{ f.dueDate|date('d/m/Y') }}
                                                        {% else %}
                                                            · sin vencimiento
                                                        {% endif %}
                                                    </span>
                                                </span>
                                            </span>
                                            <span class="fw-semibold text-nowrap">
                                                ${{ f.totalAmount|number_format(2, ',', '.') }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>

                                <div class="d-flex justify-content-between align-items-baseline border-top pt-2 px-3">
                                    <strong><span data-cantidad>0</span> seleccionada(s)</strong>
                                    <span class="fs-5 fw-bold" data-total-texto>$0,00</span>
                                </div>
                            </div>
                        {% else %}
                            <div class="d-flex justify-content-between align-items-baseline border-bottom pb-2 mb-3">
                                <div>
                                    <span class="text-muted small d-block">Estás pagando</span>
                                    <strong>{{ factura.formattedPeriod }}</strong>
                                    {% if factura.dueDate %}
                                        <span class="text-muted small">· vence el {{ factura.dueDate|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>
                                <div class="fs-5 fw-bold" data-total-texto>
                                    ${{ factura.totalAmount|number_format(2, ',', '.') }}
                                </div>
                            </div>
                        {% endif %}

                        {% if s.estado == 'en_revision' %}
                            <p class="mb-0 text-muted">
                                Ya nos enviaste el comprobante de
                                <strong>{{ factura.formattedPeriod }}</strong>. Estamos verificándolo.
                            </p>
                        {% else %}
                            <ul class="nav nav-tabs mb-3" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-transferencia" type="button">
                                        <i class="bi bi-bank"></i> Transferencia
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mp" type="button">
                                        <i class="bi bi-wallet2"></i> Mercado Pago
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-cobrador" type="button">
                                        <i class="bi bi-person-walking"></i> Coordinar con cobrador
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="tab-transferencia">
                                    {% if config.datosTransferencia %}
                                        <div class="alert alert-light border">
                                            <div class="small text-muted mb-1">Transferí a esta cuenta:</div>
                                            <div style="white-space: pre-line;">{{ config.datosTransferencia }}</div>
                                        </div>
                                    {% else %}
                                        <div class="alert alert-warning small mb-3">
                                            Todavía no cargamos los datos de la cuenta. Escribinos y te los pasamos.
                                        </div>
                                    {% endif %}

                                    {{ include('billing_invoice/_form_comprobante.html.twig', {
                                        'factura': factura, 'metodo': 'transferencia',
                                        'ayuda': 'Subí el comprobante de la transferencia y lo verificamos.'
                                    }) }}
                                </div>

                                <div class="tab-pane fade" id="tab-mp">
                                    {% if config.mercadoPagoConfigurado %}
                                        {% if config.mpModoPrueba %}
                                            <div class="alert alert-warning small">
                                                <strong>Mercado Pago está en modo prueba.</strong>
                                                Los pagos que hagas acá no son reales y no cancelan la factura.
                                                Para pagar de verdad usá transferencia o coordiná con un cobrador.
                                            </div>
                                        {% endif %}

                                        <p>
                                            Pagás con tarjeta, débito o dinero en cuenta desde Mercado Pago.
                                            Cuando el pago se acredita, la factura se cancela sola: no hace falta
                                            que nos avises ni que subas nada.
                                        </p>

                                        <form method="post" action="{{ path('billing_invoice_mercadopago', {'id': factura.id}) }}"
                                              data-form-pago>
                                            <input type="hidden" name="_token" value="{{ csrf_token('mercadopago' ~ factura.id) }}">
                                            <button class="btn btn-primary">
                                                <i class="bi bi-wallet2"></i>
                                                Pagar <span data-total-texto>$0,00</span> con Mercado Pago
                                            </button>
                                        </form>
                                    {% else %}
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-info-circle"></i>
                                            El pago con Mercado Pago —y la adhesión al débito automático— está en
                                            preparación. Por ahora usá transferencia, o pedí que pase un cobrador.
                                        </p>
                                    {% endif %}
                                </div>
                                <div class="tab-pane fade" id="tab-cobrador">
                                    {{ include('billing_invoice/_form_comprobante.html.twig', {
                                        'factura': factura, 'metodo': 'cobrador',
                                        'ayuda': 'Pedinos que pase alguien a cobrar en persona. Decinos dónde y
                                                  en qué horario te queda cómodo y te contactamos para coordinar.'
                                    }) }}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center justify-content-center text-muted">
                        <div class="text-center">
                            <i class="bi bi-check2-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">No tenés nada para pagar.</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-5 mb-3">

    {# ---------- Cómo se calcula ----------
       Material de consulta: se lee una vez, cuando el instituto quiere entender por qué le
       cobramos lo que le cobramos. Antes ocupaba media pantalla al lado de la acción y competía
       con ella; acá sigue a mano pero no estorba. #}
    <details class="card mb-3">
        <summary class="card-header bg-light" style="cursor: pointer;">
            <strong>¿Cómo se calcula lo que pago?</strong>
        </summary>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between">
                        <span>Alumn@s activos hoy</span>
                        <strong>{{ alumnosActivos }}</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Precio por alumn@</span>
                        <strong>${{ precioPorAlumno|number_format(2, ',', '.') }}</strong>
                    </div>
                    {% if instituto.minimoMensual %}
                        <div class="d-flex justify-content-between">
                            <span>Mínimo mensual</span>
                            <strong>${{ instituto.minimoMensual|number_format(2, ',', '.') }}</strong>
                        </div>
                    {% endif %}
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">Estimado del mes que viene</span>
                        <span class="fs-5 fw-bold">${{ proximoMes|number_format(2, ',', '.') }}</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <p class="small text-muted mb-0">
                        Se factura por mes cerrado: el 1° se emite la factura del mes anterior con los
                        alumn@s que tuviste activos, y vence el {{ config.diaVencimiento }}. Si das de baja
                        alumn@s, el mes siguiente pagás menos.
                    </p>
                </div>
            </div>
        </div>
    </details>

    {# ---------- Historial ----------
       Solo lo que NO está arriba para pagar. Antes las pendientes salían dos veces en la misma
       pantalla -con checkbox en el panel y otra vez como fila acá-, y esa repetición era la que
       hacía sentir la pantalla amontonada. #}
    {% set idsAPagar = [] %}
    {% for f in s.impagas|default([]) %}
        {% set idsAPagar = idsAPagar|merge([f.id]) %}
    {% endfor %}
    {% set anteriores = historial|filter(f => f.id not in idsAPagar) %}

    {# En la columna angosta una tabla de seis columnas no entra. Como lista se lee mejor y de
       todos modos acá solo hay cosas cerradas: lo que importa es el período, el importe y en qué
       terminó. #}
    <div class="card">
        <div class="card-header bg-light"><strong>Facturas anteriores</strong></div>
        <div class="list-group list-group-flush">
            {% for f in anteriores %}
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div>{{ f.formattedPeriod }}</div>
                        <div class="small text-muted">
                            {{ f.activeStudentsCount }} alumn@s
                            {% if f.isPaid() %}
                                <span class="badge bg-success ms-1">Pagada</span>
                            {% elseif f.isPendingApproval() %}
                                <span class="badge bg-info text-dark ms-1">En revisión</span>
                            {% elseif f.isCancelled() %}
                                <span class="badge bg-secondary ms-1">Cancelada</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="fw-semibold">${{ f.totalAmount|number_format(2, ',', '.') }}</div>
                        <div class="small">
                            <a href="{{ path('billing_invoice_show', {'id': f.id}) }}">Ver</a>
                            ·
                            <a href="{{ path('billing_invoice_pdf', {'id': f.id}) }}" target="_blank" data-no-loading>PDF</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="list-group-item text-muted text-center py-4">
                    {{ idsAPagar ? 'Ninguna cerrada todavía: las que tenés están al lado.'
                                 : 'Todavía no hay facturas emitidas.' }}
                </div>
            {% endfor %}
        </div>
    </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    // Conecta los checkboxes con los tres formularios de pago: el total que muestran los botones
    // y los ids que viajan al enviar salen siempre de lo que está marcado. Sin esto habría que
    // repetir los checkboxes dentro de cada formulario.
    (function () {
        const casillas = Array.from(document.querySelectorAll('[data-factura]'));
        const formularios = Array.from(document.querySelectorAll('[data-form-pago]'));

        if (!formularios.length) {
            return;
        }

        const plata = (n) => '$' + n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        function elegidas() {
            return casillas.filter((c) => c.checked);
        }

        function actualizar() {
            const marcadas = elegidas();
            const total = marcadas.reduce((suma, c) => suma + parseFloat(c.dataset.importe || '0'), 0);

            document.querySelectorAll('[data-total-texto]').forEach((el) => {
                el.textContent = plata(total);
            });

            const cantidad = document.querySelector('[data-cantidad]');
            if (cantidad) {
                cantidad.textContent = marcadas.length;
            }

            // Sin nada marcado no hay nada que pagar.
            formularios.forEach((form) => {
                form.querySelectorAll('button[type=submit], button:not([type])').forEach((b) => {
                    b.disabled = casillas.length > 0 && marcadas.length === 0;
                });
            });
        }

        // Los ids se agregan al enviar y no antes: así no quedan campos ocultos desincronizados
        // con lo que la persona ve marcado.
        formularios.forEach((form) => {
            form.addEventListener('submit', function () {
                form.querySelectorAll('input[name="facturas[]"]').forEach((e) => e.remove());

                elegidas().forEach((c) => {
                    const campo = document.createElement('input');
                    campo.type = 'hidden';
                    campo.name = 'facturas[]';
                    campo.value = c.value;
                    form.appendChild(campo);
                });
            });
        });

        casillas.forEach((c) => c.addEventListener('change', actualizar));

        const marcarTodas = document.querySelector('[data-marcar-todas]');
        if (marcarTodas) {
            marcarTodas.addEventListener('click', function () {
                const faltaAlguna = casillas.some((c) => !c.checked);
                casillas.forEach((c) => { c.checked = faltaAlguna; });
                marcarTodas.textContent = faltaAlguna ? 'Desmarcar todas' : 'Marcar todas';
                actualizar();
            });
        }

        actualizar();
    })();
    </script>
{% endblock %}
