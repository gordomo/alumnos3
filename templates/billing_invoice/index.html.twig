{% extends 'base.html.twig' %}

{% block title %}Mi suscripción{% endblock %}

{% block panelTitle %}Mi suscripción{% endblock %}

{% block body %}
{% set s = suscripcion %}
{% set factura = s.factura %}

<div class="container-fluid px-4 mt-3" style="padding-bottom: 3rem;">

    {# ---------- Estado, arriba y en una línea ---------- #}
    {% set encabezados = {
        'al_dia':       {'clase': 'success',  'icono': 'bi-check-circle-fill',        'texto': 'Estás al día'},
        'exenta':       {'clase': 'secondary','icono': 'bi-gift-fill',                'texto': 'Tu instituto no paga suscripción'},
        'en_revision':  {'clase': 'info',     'icono': 'bi-hourglass-split',          'texto': 'Estamos verificando tu pago'},
        'por_vencer':   {'clase': 'warning',  'icono': 'bi-clock-history',            'texto': 'Tu suscripción está por vencer'},
        'vencida':      {'clase': 'danger',   'icono': 'bi-exclamation-triangle-fill','texto': 'Tu suscripción está vencida'},
        'solo_lectura': {'clase': 'danger',   'icono': 'bi-lock-fill',                'texto': 'Sistema en modo consulta'},
        'bloqueada':    {'clase': 'danger',   'icono': 'bi-slash-circle-fill',        'texto': 'Panel bloqueado'}
    } %}
    {# "Al día" con facturas impagas encima es una contradicción. El servicio las trata como al
       día porque no tienen vencimiento y no disparan ningún plazo, pero decirle a alguien que no
       debe nada arriba de siete facturas pendientes es mentirle. Se muestra distinto sin cambiar
       el estado real, que es el que manda sobre los bloqueos. #}
    {% set impagas = s.impagas|default([])|length %}
    {# El vencimiento más próximo de todas, no el de la más vieja: la más vieja puede no tener
       fecha y las nuevas sí, y ahí decir "ninguna vence" sería falso. #}
    {% set proximoVto = null %}
    {% for f in s.impagas|default([]) %}
        {% if f.dueDate and (proximoVto is null or f.dueDate < proximoVto) %}
            {% set proximoVto = f.dueDate %}
        {% endif %}
    {% endfor %}
    {% set estadoVisual = (s.estado == 'al_dia' and impagas > 0) ? 'pendiente' : s.estado %}
    {% set encabezados = encabezados|merge({
        'pendiente': {'clase': 'primary', 'icono': 'bi-receipt', 'texto': 'Tenés facturas pendientes'}
    }) %}
    {% set enc = encabezados[estadoVisual]|default(encabezados.al_dia) %}

    <div class="card mb-3 border-{{ enc.clase }}">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h5 class="mb-1 text-{{ enc.clase }}">
                    <i class="bi {{ enc.icono }}"></i> {{ enc.texto }}
                </h5>
                <p class="mb-0 text-muted small">
                    {% if estadoVisual == 'pendiente' %}
                        {% if proximoVto %}
                            La más próxima vence el {{ proximoVto|date('d/m/Y') }}.
                            Todavía estás en fecha: no hay nada vencido.
                        {% else %}
                            Ninguna tiene fecha de vencimiento, así que no corre ningún plazo ni se
                            limita el sistema. Podés pagarlas cuando quieras.
                        {% endif %}
                    {% elseif s.estado == 'al_dia' %}
                        No tenés nada pendiente. La próxima factura se emite el 1° del mes que viene.
                    {% elseif s.estado == 'exenta' %}
                        Tu instituto está exento de facturación. No se emiten facturas ni se bloquea el acceso.
                    {% elseif s.estado == 'en_revision' %}
                        Ya recibimos tu comprobante. En cuanto lo confirmemos te va a figurar como pagado.
                    {% elseif s.estado == 'por_vencer' %}
                        Vence {% if s.dias == 0 %}hoy{% elseif s.dias == 1 %}mañana{% else %}en {{ s.dias }} días{% endif %},
                        el {{ factura.dueDate|date('d/m/Y') }}.
                    {% elseif s.estado == 'vencida' %}
                        Venció el {{ factura.dueDate|date('d/m/Y') }}, hace {{ s.atraso }} día(s).
                        {% if s.limiteSoloLectura %}
                            El {{ s.limiteSoloLectura|date('d/m/Y') }} el sistema pasa a modo consulta.
                        {% endif %}
                    {% elseif s.estado == 'solo_lectura' %}
                        Podés ver todo y seguir registrando los pagos de tus alumn@s, pero no dar de alta ni
                        enviar comunicaciones.
                        {% if s.limiteBloqueo %}El {{ s.limiteBloqueo|date('d/m/Y') }} se bloquea el panel.{% endif %}
                    {% else %}
                        Para volver a usar el sistema hay que regularizar la suscripción.
                    {% endif %}
                </p>
            </div>

            {% if s.total > 0 %}
                <div class="text-end">
                    <div class="text-muted small">{{ impagas > 1 ? 'Total de todas' : 'Total a pagar' }}</div>
                    <div class="fs-3 fw-bold text-{{ enc.clase }}">${{ s.total|number_format(2, ',', '.') }}</div>
                    {% if impagas > 1 %}
                        <div class="small text-muted">en {{ impagas }} facturas</div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row">
        {# ---------- Cómo pagar ---------- #}
        <div class="col-lg-7 mb-3">
            {% if factura and not s.factura.isPaid() and s.estado != 'exenta' %}
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h6 class="mb-0"><i class="bi bi-credit-card"></i> Cómo pagar</h6>
                    </div>
                    <div class="card-body">
                        {# Se paga de a una factura, la más vieja primero. Sin decirlo, el botón
                           ofrece pagar $1.000 abajo de un total de $7.000 y no se entiende cuál
                           de los dos números vale. #}
                        <div class="d-flex justify-content-between align-items-baseline border-bottom pb-2 mb-3">
                            <div>
                                <span class="text-muted small d-block">Estás pagando</span>
                                <strong>{{ factura.formattedPeriod }}</strong>
                                {% if factura.dueDate %}
                                    <span class="text-muted small">· vence el {{ factura.dueDate|date('d/m/Y') }}</span>
                                {% endif %}
                            </div>
                            <div class="fs-5 fw-bold">${{ factura.totalAmount|number_format(2, ',', '.') }}</div>
                        </div>

                        {% if impagas > 1 %}
                            <p class="small text-muted">
                                Te quedan {{ impagas - 1 }} factura(s) más. Se pagan de a una,
                                empezando por la más vieja.
                            </p>
                        {% endif %}

                        {% if s.estado == 'en_revision' %}
                            <p class="mb-0 text-muted">
                                Ya nos enviaste el comprobante de
                                <strong>{{ factura.formattedPeriod }}</strong>. Estamos verificándolo.
                            </p>
                        {% else %}
                            <ul class="nav nav-tabs mb-3" role="tablist">
                                <li class="nav-item">
                                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-transferencia" type="button">
                                        <i class="bi bi-bank"></i> Transferencia
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-efectivo" type="button">
                                        <i class="bi bi-cash"></i> Efectivo
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-mp" type="button">
                                        <i class="bi bi-wallet2"></i> Mercado Pago
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content">
                                <div class="tab-pane fade show active" id="tab-transferencia">
                                    {% if config.datosTransferencia %}
                                        <div class="alert alert-light border">
                                            <div class="small text-muted mb-1">Transferí a esta cuenta:</div>
                                            <div style="white-space: pre-line;">{{ config.datosTransferencia }}</div>
                                        </div>
                                    {% else %}
                                        <div class="alert alert-warning small mb-3">
                                            Todavía no cargamos los datos de la cuenta. Escribinos y te los pasamos.
                                        </div>
                                    {% endif %}

                                    {{ include('billing_invoice/_form_comprobante.html.twig', {
                                        'factura': factura, 'metodo': 'transferencia',
                                        'ayuda': 'Subí el comprobante de la transferencia y lo verificamos.'
                                    }) }}
                                </div>

                                <div class="tab-pane fade" id="tab-efectivo">
                                    <p class="small text-muted">
                                        Si pagaste en efectivo, avisanos acá y lo confirmamos de nuestro lado.
                                        Si tenés recibo, adjuntalo.
                                    </p>
                                    {{ include('billing_invoice/_form_comprobante.html.twig', {
                                        'factura': factura, 'metodo': 'efectivo',
                                        'ayuda': 'El comprobante es opcional en efectivo, pero ayuda.'
                                    }) }}
                                </div>

                                <div class="tab-pane fade" id="tab-mp">
                                    {% if config.mercadoPagoConfigurado %}
                                        {% if config.mpModoPrueba %}
                                            <div class="alert alert-warning small">
                                                <strong>Mercado Pago está en modo prueba.</strong>
                                                Los pagos que hagas acá no son reales y no cancelan la factura.
                                                Para pagar de verdad usá transferencia o efectivo.
                                            </div>
                                        {% endif %}

                                        <p>
                                            Pagás con tarjeta, débito o dinero en cuenta desde Mercado Pago.
                                            Cuando el pago se acredita, la factura se cancela sola: no hace falta
                                            que nos avises ni que subas nada.
                                        </p>

                                        <form method="post" action="{{ path('billing_invoice_mercadopago', {'id': suscripcion.factura.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('mercadopago' ~ suscripcion.factura.id) }}">
                                            <button class="btn btn-primary">
                                                <i class="bi bi-wallet2"></i>
                                                Pagar ${{ suscripcion.factura.totalAmount|number_format(2, ',', '.') }} con Mercado Pago
                                            </button>
                                        </form>
                                    {% else %}
                                        <p class="text-muted mb-0">
                                            <i class="bi bi-info-circle"></i>
                                            El pago con Mercado Pago —y la adhesión al débito automático— está en
                                            preparación. Por ahora usá transferencia o efectivo.
                                        </p>
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center justify-content-center text-muted">
                        <div class="text-center">
                            <i class="bi bi-check2-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2 mb-0">No tenés nada para pagar.</p>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {# ---------- Cómo se calcula ---------- #}
        <div class="col-lg-5 mb-3">
            <div class="card h-100">
                <div class="card-header bg-light"><strong>Cómo se calcula</strong></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <span>Alumn@s activos hoy</span>
                        <strong>{{ alumnosActivos }}</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Precio por alumn@</span>
                        <strong>${{ precioPorAlumno|number_format(2, ',', '.') }}</strong>
                    </div>
                    {% if instituto.minimoMensual %}
                        <div class="d-flex justify-content-between">
                            <span>Mínimo mensual</span>
                            <strong>${{ instituto.minimoMensual|number_format(2, ',', '.') }}</strong>
                        </div>
                    {% endif %}
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold">Estimado del mes que viene</span>
                        <span class="fs-5 fw-bold">${{ proximoMes|number_format(2, ',', '.') }}</span>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        Se factura por mes cerrado: el 1° se emite la factura del mes anterior con los
                        alumn@s que tuviste activos, y vence el {{ config.diaVencimiento }}. Si das de baja
                        alumn@s, el mes siguiente pagás menos.
                    </p>
                </div>
            </div>
        </div>
    </div>

    {# ---------- Historial ---------- #}
    <div class="card">
        <div class="card-header bg-light"><strong>Facturas</strong></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Período</th>
                        <th class="text-center">Alumn@s</th>
                        <th class="text-end">Importe</th>
                        <th>Vence</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                {% for f in historial %}
                    <tr>
                        <td class="text-nowrap">{{ f.formattedPeriod }}</td>
                        <td class="text-center">{{ f.activeStudentsCount }}</td>
                        <td class="text-end fw-semibold">${{ f.totalAmount|number_format(2, ',', '.') }}</td>
                        <td class="text-nowrap small">
                            {% if f.dueDate %}
                                {{ f.dueDate|date('d/m/Y') }}
                            {% else %}
                                <span class="text-muted">sin vencimiento</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if f.isPaid() %}
                                <span class="badge bg-success">Pagada</span>
                            {% elseif f.isPendingApproval() %}
                                <span class="badge bg-info text-dark">En revisión</span>
                            {% elseif f.isRejected() %}
                                <span class="badge bg-danger">Rechazada</span>
                            {% elseif f.isCancelled() %}
                                <span class="badge bg-secondary">Cancelada</span>
                            {% elseif f.diasDeAtraso > 0 %}
                                {# El rojo se reserva para lo que de verdad está vencido. Pintar de
                                   rojo siete facturas que no vencieron hace que el rojo no
                                   signifique nada. #}
                                <span class="badge bg-danger">Vencida hace {{ f.diasDeAtraso }} día(s)</span>
                            {% else %}
                                <span class="badge bg-secondary">Pendiente</span>
                            {% endif %}
                        </td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('billing_invoice_show', {'id': f.id}) }}" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="{{ path('billing_invoice_pdf', {'id': f.id}) }}" target="_blank" data-no-loading
                               class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Todavía no hay facturas emitidas.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
