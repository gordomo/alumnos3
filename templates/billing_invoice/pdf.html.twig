<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Factura #{{ invoice.id }}</title>
    <style>
        @page { margin: 20mm; }
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 10pt; color: #263238; }
        h1 { margin: 0; font-size: 24pt; }
        h2 { font-size: 11pt; margin: 22pt 0 8pt; }
        p { margin: 4pt 0; }
        table { width: 100%; border-collapse: collapse; }
        .cabecera { border-bottom: 2pt solid #263238; margin-bottom: 18pt; }
        .cabecera td { padding-bottom: 12pt; }
        .datos td { width: 50%; vertical-align: top; }
        .detalle { margin-top: 18pt; }
        .detalle th, .detalle td { border: 1px solid #d4dce0; padding: 8pt; }
        .detalle th { background: #edf1f4; }
        .derecha { text-align: right; }
        .centro { text-align: center; }
        .pie { margin-top: 22pt; font-size: 9pt; }
        .aclaracion { background: #f3f5f7; padding: 10pt; margin-top: 12pt; }
    </style>
</head>
<body>
{% set estados = {'pending':'Pendiente', 'pending_approval':'En revisión', 'paid':'Pagada', 'rejected':'Rechazada', 'cancelled':'Cancelada'} %}
<table class="cabecera"><tr>
    <td><h1>FACTURA</h1><p>Nº {{ '%06d'|format(invoice.id) }}</p></td>
    <td class="derecha"><strong>{{ estados[invoice.status]|default(invoice.status) }}</strong></td>
</tr></table>
<table class="datos"><tr>
    <td><strong>{{ productos[vertical] }}</strong><p>Team Builder</p><p>Sistema de gestión de {{ term('instituto_plural') }}</p></td>
    <td><strong>{{ instituto.nombre }}</strong>
        {% if instituto.email %}<p>{{ instituto.email }}</p>{% endif %}
        {% if instituto.tel %}<p>Tel: {{ instituto.tel }}</p>{% endif %}
        {% if instituto.dir %}<p>{{ instituto.dir }}</p>{% endif %}
    </td>
</tr></table>
<h2>Período: {{ invoice.formattedPeriod }}</h2>
<table class="detalle">
    <thead><tr><th>Concepto</th><th>Cantidad</th><th>Precio unitario</th><th>Total</th></tr></thead>
    <tbody><tr>
        <td>Suscripción mensual por {{ term('alumnos_formal') }} activos</td>
        <td class="centro">{{ invoice.activeStudentsCount }}</td>
        <td class="derecha">${{ invoice.pricePerStudent|number_format(2, ',', '.') }}</td>
        <td class="derecha">${{ invoice.totalAmount|number_format(2, ',', '.') }}</td>
    </tr></tbody>
    <tfoot><tr><th colspan="3" class="derecha">TOTAL A PAGAR</th><th class="derecha">${{ invoice.totalAmount|number_format(2, ',', '.') }}</th></tr></tfoot>
</table>
<div class="pie">
    <p><strong>Fecha de emisión:</strong> {{ invoice.createdAt|date(app_date_format|default('d/m/Y')) }}</p>
    {% if invoice.dueDate %}<p><strong>Vencimiento:</strong> {{ invoice.dueDate|date(app_date_format|default('d/m/Y')) }}</p>{% endif %}
    {% if invoice.paidAt %}<p><strong>Fecha de pago:</strong> {{ invoice.paidAt|date(app_date_format|default('d/m/Y')) }}</p>{% endif %}
    <div class="aclaracion">Los importes corresponden a la factura emitida. Cambiar el precio actual no modifica esta factura.
        {% if invoice.totalAmount > invoice.activeStudentsCount * invoice.pricePerStudent %}<p>El total incluye el mínimo mensual acordado.</p>{% endif %}
    </div>
    {% if invoice.notes %}<p><strong>Notas:</strong> {{ invoice.notes|nl2br }}</p>{% endif %}
</div>
</body>
</html>
