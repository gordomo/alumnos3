{#
    Formulario para declarar un pago de la suscripción. Se usa desde las pestañas de transferencia
    y de efectivo: lo único que cambia es el método que viaja y el texto de ayuda.

    Parámetros: factura, metodo ('transferencia'|'efectivo'), ayuda.
#}
<form method="post" action="{{ path('billing_invoice_pay', {'id': factura.id}) }}" enctype="multipart/form-data">
    <input type="hidden" name="_token" value="{{ csrf_token('pay_invoice_' ~ factura.id) }}">
    <input type="hidden" name="payment_method" value="{{ metodo }}">

    <div class="mb-2">
        <label class="form-label small mb-1" for="proof_{{ metodo }}">
            Comprobante
            {% if metodo == 'transferencia' %}<span class="text-danger">*</span>{% endif %}
        </label>
        <input type="file" class="form-control form-control-sm" id="proof_{{ metodo }}"
               name="payment_proof" accept="image/jpeg,image/png,application/pdf"
               {% if metodo == 'transferencia' %}required{% endif %}>
        <div class="form-text">{{ ayuda }} JPG, PNG o PDF, hasta 5 MB.</div>
    </div>

    <div class="mb-2">
        <label class="form-label small mb-1" for="notas_{{ metodo }}">Comentario (opcional)</label>
        <input type="text" class="form-control form-control-sm" id="notas_{{ metodo }}" name="notas"
               maxlength="200" placeholder="Ej: transferí desde la cuenta del instituto">
    </div>

    <button type="submit" class="btn btn-primary btn-sm">
        <i class="bi bi-send"></i> Avisar que pagué ${{ factura.totalAmount|number_format(2, ',', '.') }}
    </button>
</form>
