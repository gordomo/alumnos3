{% extends 'base.html.twig' %}

{% block title %}Factura #{{ invoice.id }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .invoice-container {
                box-shadow: none !important;
                border: none !important;
            }
        }
        
        .invoice-container {
            max-width: 210mm;
            margin: 0 auto;
            background: white;
            padding: 20mm;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        
        .invoice-header {
            border-bottom: 3px solid #333;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .invoice-title {
            font-size: 2.5rem;
            font-weight: bold;
            color: #333;
            margin: 0;
        }
        
        .invoice-number {
            font-size: 1.2rem;
            color: #666;
            margin-top: 5px;
        }
        
        .invoice-status {
            display: inline-block;
            padding: 8px 20px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 0.9rem;
            margin-top: 10px;
        }
        
        .status-pending {
            background: #fff3cd;
            color: #856404;
            border: 2px solid #ffc107;
        }
        
        .status-pending-approval {
            background: #cfe2ff;
            color: #084298;
            border: 2px solid #0d6efd;
        }
        
        .status-paid {
            background: #d4edda;
            color: #155724;
            border: 2px solid #28a745;
        }
        
        .status-rejected {
            background: #f8d7da;
            color: #842029;
            border: 2px solid #dc3545;
        }
        
        .invoice-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }
        
        .invoice-from, .invoice-to {
            flex: 1;
        }
        
        .invoice-from h3, .invoice-to h3 {
            font-size: 1rem;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 15px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }
        
        .invoice-from p, .invoice-to p {
            margin: 5px 0;
            color: #333;
        }
        
        .invoice-details {
            margin-bottom: 30px;
        }
        
        .invoice-details h3 {
            font-size: 1rem;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 15px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 5px;
        }
        
        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        .invoice-table th {
            background: #f8f9fa;
            padding: 12px;
            text-align: left;
            border: 1px solid #dee2e6;
            font-weight: bold;
            color: #333;
        }
        
        .invoice-table td {
            padding: 12px;
            border: 1px solid #dee2e6;
        }
        
        .invoice-table tfoot th {
            background: #f8f9fa;
            font-size: 1.2rem;
        }
        
        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }
        
        .total-row {
            font-size: 1.3rem;
            font-weight: bold;
        }
        
        .invoice-footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 2px solid #ddd;
            font-size: 0.85rem;
            color: #666;
        }
        
        .invoice-footer p {
            margin: 5px 0;
        }
        
        .action-buttons {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
        }
        
        .action-buttons .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .action-buttons .btn-group-left {
            display: flex;
            gap: 10px;
        }
        
        .action-buttons .btn-group-right {
            display: flex;
            gap: 10px;
            margin-left: auto;
        }
        
        @media (max-width: 768px) {
            .action-buttons .btn-group {
                flex-direction: column;
                width: 100%;
            }
            
            .action-buttons .btn-group-right {
                margin-left: 0;
                width: 100%;
            }
            
            .action-buttons .btn-group-right .btn {
                flex: 1;
            }
        }
    </style>
{% endblock %}

{% block panelTitle %}
    <div class="no-print">
        Factura #{{ invoice.id }}
        <a href="{{ path('billing_invoice_index') }}" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
                            <a href="{{ path('billing_invoice_pdf', {'id': invoice.id}) }}" target="_blank" class="btn btn-primary btn-sm">
                                <i class="bi bi-file-pdf"></i> Descargar PDF
                            </a>
                            <button onclick="window.print()" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-printer"></i> Imprimir
                            </button>
    </div>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="invoice-container">
                <!-- Header -->
                <div class="invoice-header">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <h1 class="invoice-title">FACTURA</h1>
                            <div class="invoice-number">Nº {{ "%06d"|format(invoice.id) }}</div>
                        </div>
                        <div>
                            {% if invoice.isPaid %}
                                <span class="invoice-status status-paid">PAGADA</span>
                            {% elseif invoice.isPendingApproval %}
                                <span class="invoice-status status-pending-approval">PENDIENTE DE APROBACIÓN</span>
                            {% elseif invoice.isPending %}
                                <span class="invoice-status status-pending">PENDIENTE</span>
                            {% elseif invoice.isRejected %}
                                <span class="invoice-status status-rejected">RECHAZADA</span>
                            {% else %}
                                <span class="invoice-status" style="background: #e2e3e5; color: #383d41; border: 2px solid #6c757d;">CANCELADA</span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Información de Emisor y Receptor -->
                <div class="invoice-info">
                    <div class="invoice-from">
                        <h3>De:</h3>
                        <p><strong>TEAM INSTITUTE</strong></p>
                        <p>Sistema de Gestión de Institutos</p>
                        <p>by TEAM BUILDER</p>
                    </div>
                    <div class="invoice-to">
                        <h3>Para:</h3>
                        <p><strong>{{ instituto.nombre }}</strong></p>
                        {% if instituto.email %}
                            <p>{{ instituto.email }}</p>
                        {% endif %}
                        {% if instituto.tel %}
                            <p>Tel: {{ instituto.tel }}</p>
                        {% endif %}
                        {% if instituto.dir %}
                            <p>{{ instituto.dir }}</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Detalles de Facturación -->
                <div class="invoice-details">
                    <h3>Detalles de Facturación</h3>
                    <table class="invoice-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Concepto</th>
                                <th style="width: 15%;" class="text-center">Cantidad</th>
                                <th style="width: 20%;" class="text-right">Precio Unitario</th>
                                <th style="width: 25%;" class="text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong>Facturación mensual por alumnos activos</strong>
                                    <br>
                                    <small style="color: #666;">Período: {{ invoice.getFormattedPeriod() }}</small>
                                </td>
                                <td class="text-center">
                                    <strong>{{ invoice.activeStudentsCount }}</strong>
                                    <br>
                                    <small style="color: #666;">alumnos</small>
                                </td>
                                <td class="text-right">
                                    <strong>${{ invoice.pricePerStudent|number_format(2, ',', '.') }}</strong>
                                    <br>
                                    <small style="color: #666;">por alumno/mes</small>
                                </td>
                                <td class="text-right">
                                    <strong>${{ invoice.totalAmount|number_format(2, ',', '.') }}</strong>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-right total-row">TOTAL A PAGAR:</th>
                                <th class="text-right total-row" style="color: {% if invoice.isPaid %}#28a745{% else %}#dc3545{% endif %};">
                                    ${{ invoice.totalAmount|number_format(2, ',', '.') }}
                                </th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Información Adicional -->
                <div class="invoice-footer">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                        <div>
                            <p><strong>Fecha de Emisión:</strong> {{ invoice.createdAt|date(app_date_format|default('d/m/Y')) }}</p>
                            <p><strong>Período Facturado:</strong> {{ invoice.getFormattedPeriod() }}</p>
                        </div>
                        <div style="text-align: right;">
                            {% if invoice.paidAt %}
                                <p><strong>Fecha de Pago:</strong> {{ invoice.paidAt|date(app_date_format|default('d/m/Y')) }}</p>
                            {% endif %}
                            <p><strong>Estado:</strong> 
                                {% if invoice.isPaid %}
                                    Pagada
                                {% elseif invoice.isPendingApproval %}
                                    Pendiente de Aprobación
                                {% elseif invoice.isPending %}
                                    Pendiente de Pago
                                {% elseif invoice.isRejected %}
                                    Rechazada
                                {% else %}
                                    Cancelada
                                {% endif %}
                            </p>
                            {% if invoice.paymentRequestedAt %}
                                <p><strong>Fecha de Solicitud:</strong> {{ invoice.paymentRequestedAt|date((app_date_format|default('d/m/Y')) ~ ' H:i') }}</p>
                            {% endif %}
                            {% if invoice.rejectedAt %}
                                <p><strong>Fecha de Rechazo:</strong> {{ invoice.rejectedAt|date((app_date_format|default('d/m/Y')) ~ ' H:i') }}</p>
                                {% if invoice.rejectionReason %}
                                    <p><strong>Motivo de Rechazo:</strong> {{ invoice.rejectionReason }}</p>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                    
                    <div style="background: #f8f9fa; padding: 15px; border-radius: 5px; margin-top: 20px;">
                        <p style="margin: 0; font-size: 0.9rem;">
                            <strong>Nota:</strong> Esta factura fue generada con un precio de <strong>${{ invoice.pricePerStudent|number_format(2, ',', '.') }} por alumno/mes</strong>, 
                            vigente al momento de su creación ({{ invoice.createdAt|date((app_date_format|default('d/m/Y')) ~ ' H:i') }}). 
                            El precio mostrado es fijo y no cambiará aunque se modifique el precio actual del sistema.
                        </p>
                    </div>
                    
                    {% if invoice.notes %}
                    <div style="margin-top: 15px;">
                        <p><strong>Notas:</strong> {{ invoice.notes }}</p>
                    </div>
                    {% endif %}
                </div>

                <!-- Botones de Acción (no se imprimen) -->
                <div class="action-buttons no-print">
                    <!-- Botones principales -->
                    <div class="btn-group" style="justify-content: space-between; align-items: flex-start;">
                        <div class="btn-group-left">
                            <a href="{{ path('billing_invoice_index') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver al Listado
                            </a>
                        </div>
                        <div class="btn-group-right">
                            <a href="{{ path('billing_invoice_pdf', {'id': invoice.id}) }}" target="_blank" class="btn btn-primary">
                                <i class="bi bi-file-pdf"></i> Descargar PDF
                            </a>
                            <button onclick="window.print()" class="btn btn-outline-primary">
                                <i class="bi bi-printer"></i> Imprimir
                            </button>
                            {% if invoice.isPending %}
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                    <i class="bi bi-upload"></i> Subir Comprobante
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    
                    <!-- Estados de pago -->
                    {% if invoice.isPendingApproval %}
                        <div class="alert alert-info mt-3 mb-0">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-info-circle me-2 mt-1"></i>
                                <div class="flex-grow-1">
                                    <strong>Comprobante enviado:</strong> Tu comprobante de pago ha sido enviado y está pendiente de aprobación por el administrador.
                                    {% if invoice.paymentProofPath %}
                                        <div class="mt-2">
                                            <a href="{{ asset('uploads/payment_proofs/' ~ invoice.paymentProofPath) }}" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-file-earmark"></i> Ver Comprobante
                                            </a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% elseif invoice.isRejected %}
                        <div class="alert alert-danger mt-3 mb-0">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-x-circle me-2 mt-1"></i>
                                <div class="flex-grow-1">
                                    <strong>Pago rechazado:</strong> Tu comprobante de pago fue rechazado.
                                    {% if invoice.rejectionReason %}
                                        <div class="mt-2">
                                            <strong>Motivo:</strong> {{ invoice.rejectionReason }}
                                        </div>
                                    {% endif %}
                                    <div class="mt-3">
                                        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                            <i class="bi bi-upload"></i> Subir Nuevo Comprobante
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para subir comprobante de pago -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">Subir Comprobante de Pago</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="{{ path('billing_invoice_pay', {'id': invoice.id}) }}" enctype="multipart/form-data">
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ csrf_token('pay_invoice_' ~ invoice.id) }}">
                    
                    <div class="mb-3">
                        <label for="payment_proof" class="form-label">
                            <strong>Comprobante de Pago *</strong>
                        </label>
                        <input type="file" class="form-control" id="payment_proof" name="payment_proof" accept="image/jpeg,image/png,image/jpg,application/pdf" required>
                        <small class="form-text text-muted">
                            Formatos aceptados: JPG, PNG, PDF. Tamaño máximo: 5MB
                        </small>
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Importante:</strong> Una vez que subas el comprobante, la factura quedará pendiente de aprobación por el administrador. 
                        Recibirás una notificación cuando sea aprobada o rechazada.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload"></i> Subir Comprobante
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
