{# Template para el botón volver.
   Usa history.back() cuando hay historial para evitar loops (ej. Ficha ↔ Deudas).
   Si no hay historial (pestaña nueva, acceso directo), va a default_path.
   default_path: ruta por defecto (ej. listado de alumnos). #}
{% set back_path = default_path|default(path('dashboard_index')) %}
<a href="{{ back_path }}" class="btn btn-secondary back-button-js" data-fallback-href="{{ back_path }}">
    <i class="bi bi-arrow-left"></i> Volver
</a> 