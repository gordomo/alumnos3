{# Template para el indicador de carga #}
<div class="loading-overlay" style="display: none;">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p class="loading-text">Procesando...</p>
    </div>
</div>

<style>
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

.loading-spinner {
    text-align: center;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #f3f3f3;
    border-top: 5px solid #849d9a;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 15px;
}

.loading-text {
    color: #5c6f6c;
    font-size: 16px;
    margin: 0;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Clase para enlaces que no deben mostrar loading */
.no-loading {
    data-no-loading: true;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Obtener la URL base del sitio de forma dinámica
    const siteUrl = window.location.origin;
    
    // Función para mostrar el loading
    window.showLoading = function() {
        document.querySelector('.loading-overlay').style.display = 'flex';
    };

    // Función para ocultar el loading
    window.hideLoading = function() {
        document.querySelector('.loading-overlay').style.display = 'none';
    };

    // Función para detectar navegación hacia atrás usando PerformanceNavigationTiming
    function isBackNavigation() {
        if (window.performance && window.performance.getEntriesByType) {
            const navigationEntries = window.performance.getEntriesByType('navigation');
            if (navigationEntries.length > 0) {
                const navigation = navigationEntries[0];
                return navigation.type === 'back_forward';
            }
        }
        return false;
    }

    // Función para verificar si un enlace es de navegación
    function isNavigationLink(link) {
        // No mostrar loading para enlaces que abren en nueva pestaña
        if (link.target === '_blank') return false;
        
        // No mostrar loading para enlaces con data-no-loading
        if (link.hasAttribute('data-no-loading')) return false;

        if (link.classList.contains('search-choice-close')) return false;
        
        // No mostrar loading para enlaces que son dropdowns
        if (link.hasAttribute('data-bs-toggle') && link.getAttribute('data-bs-toggle') === 'dropdown') return false;
        
        // No mostrar loading para el botón de toggle del menú
        if (link.id === 'menu-toggle') return false;
        
        // Verificar si es un enlace interno usando la URL base del sitio
        const isInternalLink = link.href.startsWith(siteUrl) || 
                             link.href.startsWith('/') ||
                             !link.href.includes('://');
        
        if (!isInternalLink) return false;
        
        return true;
    }

    // Manejar envío de formularios
    document.querySelectorAll('form').forEach(form => {
        form.addEventListener('submit', function(e) {
            if (form.checkValidity()) {
                showLoading();
            }
        });
    });

    // Manejar clicks en enlaces usando delegación de eventos
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');
        if (link && isNavigationLink(link)) {
            showLoading();
        }
    });

    // Manejar navegación del navegador (botones adelante/atrás)
    window.addEventListener('popstate', function() {
        if (isBackNavigation()) {
            hideLoading();
        } else {
            showLoading();
        }
    });

    // Manejar el evento pageshow para detectar navegación
    window.addEventListener('pageshow', function(event) {
        if (event.persisted) {
            hideLoading();
        } else if (isBackNavigation()) {
            hideLoading();
        }
    });

    // Ocultar loading cuando la página termine de cargar
    window.addEventListener('load', function() {
        if (isBackNavigation()) {
            hideLoading();
        }
    });

    // Manejar la navegación AJAX si existe
    if (typeof window.fetch === 'function') {
        const originalFetch = window.fetch;
        window.fetch = function() {
            if (!isBackNavigation()) {
                showLoading();
            }
            return originalFetch.apply(this, arguments)
                .finally(() => {
                    hideLoading();
                });
        };
    }
});
</script> 