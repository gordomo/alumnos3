{% extends 'emails/base_email.html.twig' %}

{% block title %}Recuperación de Contraseña{% endblock %}

{% block content %}
    <h2>Hola {{ username }},</h2>
    
    <p>Hemos recibido una solicitud para restablecer la contraseña de tu cuenta.</p>
    
    <p>Para continuar con el proceso, haz clic en el siguiente botón:</p>
    
    <p style="text-align: center;">
        <a href="{{ url('app_reset_password', {'token': resetToken}) }}" class="button">
            Restablecer Contraseña
        </a>
    </p>
    
    <p>
        <small>
            Este enlace expirará en {{ expirationMessageHours }} horas por razones de seguridad.
            Si no solicitaste este cambio, puedes ignorar este mensaje.
        </small>
    </p>
    
    <p>
        Si el botón no funciona, copia y pega el siguiente enlace en tu navegador:<br>
        <small>{{ url('app_reset_password', {'token': resetToken}) }}</small>
    </p>
{% endblock %}

{% block footer %}
    <p><small>Este es un mensaje automático, por favor no respondas a este correo.</small></p>
{% endblock %} 