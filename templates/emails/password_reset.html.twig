{% extends 'emails/base_email.html.twig' %}

{% block title %}Recuperación de Contraseña{% endblock %}

{% block content %}
    <div style="text-align: center; margin-bottom: 30px;">
       <img src="http://pruebas.institutos.teambuilder.com.ar/assets/img/logoteam.png" alt="Logo" style="max-width: 100%;">
    </div>
    
    <h2 style="color: #5c6f6c; font-size: 24px; margin-bottom: 20px; text-align: center;">Hola {{ username }},</h2>
    
    <p style="color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 20px;">
        Hemos recibido una solicitud para restablecer la contraseña de tu cuenta.
    </p>
    
    <p style="color: #333; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
        Para continuar con el proceso, haz clic en el siguiente botón:
    </p>
    
    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ url('app_reset_password_confirm', {'token': resetToken}) }}" 
           style="display: inline-block; 
                  padding: 12px 30px; 
                  background-color: #d4a373; 
                  color: white; 
                  text-decoration: none; 
                  border-radius: 5px; 
                  font-weight: 500;
                  transition: background-color 0.3s ease;">
            Restablecer Contraseña
        </a>
    </div>
    
    <p style="color: #666; font-size: 14px; line-height: 1.6; margin-bottom: 20px;">
        <strong>Importante:</strong> Este enlace expirará en {{ expirationMessageHours }} horas por razones de seguridad.
        Si no solicitaste este cambio, puedes ignorar este mensaje.
    </p>
    
    <p style="color: #666; font-size: 14px; line-height: 1.6; margin-bottom: 20px;">
        Si el botón no funciona, copia y pega el siguiente enlace en tu navegador:<br>
        <a href="{{ url('app_reset_password_confirm', {'token': resetToken}) }}" 
           style="color: #d4a373; text-decoration: none; word-break: break-all;">
            {{ url('app_reset_password_confirm', {'token': resetToken}) }}
        </a>
    </p>
{% endblock %}

{% block footer %}
    <p style="color: #666; font-size: 12px; margin-top: 20px; text-align: center;">
        Este es un mensaje automático, por favor no respondas a este correo.
    </p>
{% endblock %} 