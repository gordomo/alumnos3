{% extends 'emails/base_email.html.twig' %}

{% block title %}Nueva solicitud de alta{% endblock %}

{% block content %}
    <h2>{{ solicitud.nombreInstituto }}</h2>

    <ul>
        <li><strong>Contacto:</strong> {{ solicitud.nombreContacto }}</li>
        <li><strong>Email:</strong> {{ solicitud.email }}</li>
        <li><strong>Teléfono:</strong> {{ solicitud.telefono|default('no dejó') }}</li>
        <li><strong>{{ Term('alumnos') }} estimad@s:</strong> {% if solicitud.alumnosEstimadosEtiqueta %}{{ solicitud.alumnosEstimadosEtiqueta }} {{ term('alumnos') }}{% else %}no contestó{% endif %}</li>
    </ul>

    {% if solicitud.mensaje %}
        <p><strong>Mensaje:</strong><br>{{ solicitud.mensaje|nl2br }}</p>
    {% endif %}

    <p style="text-align: center;">
        <a href="{{ url('admin_solicitud_show', {'id': solicitud.id}) }}" style="display: inline-block; padding: 12px 24px; background-color: {{ colores_boton[vertical]|default('#1b6ae0') }}; color: #ffffff !important; text-decoration: none; border-radius: 5px; font-weight: bold; margin: 20px 0;">Ver la solicitud</a>
    </p>
{% endblock %}

{% block footer %}
    <p><small>Aviso interno de Team Builder.</small></p>
{% endblock %}
