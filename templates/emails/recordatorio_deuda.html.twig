<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
        }
        .header {
            text-align: center;
            padding: 20px 0;
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 30px;
        }
        .logo {
            max-width: 150px;
            max-height: 100px;
            margin-bottom: 15px;
        }
        .instituto-name {
            font-size: 24px;
            font-weight: bold;
            color: #0d6efd;
            margin: 10px 0;
        }
        .content {
            padding: 20px 0;
        }
        .alerta {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
            border-radius: 4px;
        }
        .deuda-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: bold;
            color: #6c757d;
        }
        .info-value {
            color: #212529;
        }
        .monto-deuda {
            font-size: 24px;
            font-weight: bold;
            color: #dc3545;
            text-align: center;
            padding: 20px;
            background-color: #f8d7da;
            border-radius: 8px;
            margin: 20px 0;
        }
        .texto-personalizado {
            padding: 15px;
            background-color: #e7f1ff;
            border-left: 4px solid #0d6efd;
            margin: 20px 0;
            border-radius: 4px;
        }
        .footer {
            text-align: center;
            padding: 20px 0;
            font-size: 12px;
            color: #6c757d;
            border-top: 1px solid #dee2e6;
            margin-top: 30px;
        }
        .contact-info {
            margin-top: 10px;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            {% if logoUrl %}
                <img src="{{ logoUrl }}" alt="{{ instituto.nombre }}" class="logo">
            {% endif %}
            <div class="instituto-name">{{ instituto.nombre }}</div>
        </div>
        
        <div class="content">
            <h2 style="color: #0d6efd; margin-top: 0;">Recordatorio de Pago Pendiente</h2>
            
            <p>Estimado/a <strong>{{ alumno.nombre }} {{ alumno.apellido }}</strong>,</p>
            
            {# resumenVencidas llega desde el proceso automático, que manda un solo mail por
               alumno aunque deba varias cuotas. En un reenvío manual no viene. #}
            {% set variasCuotas = resumenVencidas is defined and resumenVencidas and resumenVencidas.cantidad > 1 %}

            <div class="alerta">
                <strong>⚠️ Recordatorio:</strong>
                {% if variasCuotas %}
                    Le recordamos que tiene <strong>{{ resumenVencidas.cantidad }} cuotas vencidas</strong> sin abonar.
                {% else %}
                    Le recordamos que tiene un pago pendiente.
                {% endif %}
            </div>

            <div class="deuda-info">
                <div class="info-row">
                    <span class="info-label">{% if variasCuotas %}Cuota más antigua{% else %}Curso{% endif %}:</span>
                    <span class="info-value">{{ deuda.curso.nombre }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Mes/Año:</span>
                    <span class="info-value">
                        {% set nombresMeses = {
                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                        } %}
                        {{ nombresMeses[deuda.mes] ?? deuda.mes }} / {{ deuda.ano }}
                    </span>
                </div>
            </div>
            
            <div class="monto-deuda">
                {% if variasCuotas %}
                    Total vencido: ${{ resumenVencidas.total|number_format(2, ',', '.') }}
                {% else %}
                    {# Monto más interés: mostrar solo el monto dejaba el recargo por mora afuera
                       y el mail decía menos de lo que hay que pagar. #}
                    Monto Pendiente: ${{ (deuda.monto + (deuda.interes ?? 0))|number_format(2, ',', '.') }}
                {% endif %}
            </div>
            
            {% if textoPersonalizado %}
            <div class="texto-personalizado">
                {{ textoPersonalizado|nl2br }}
            </div>
            {% endif %}
            
            <p>Por favor, acérquese a nuestras oficinas o contáctenos para realizar el pago.</p>
        </div>
        
        <div class="footer">
            <p><strong>{{ instituto.nombre }}</strong></p>
            <div class="contact-info">
                {% if instituto.dir %}
                    <p>{{ instituto.dir }}</p>
                {% endif %}
                {% if instituto.tel %}
                    <p>Teléfono: {{ instituto.tel }}</p>
                {% endif %}
                {% if instituto.email %}
                    <p>Email: {{ instituto.email }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>

