<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background-color: #ffffff;
        }
        .header {
            text-align: center;
            padding: 20px 0;
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 30px;
        }
        .logo {
            max-width: 150px;
            max-height: 100px;
            margin-bottom: 15px;
        }
        .instituto-name {
            font-size: 24px;
            font-weight: bold;
            color: #0d6efd;
            margin: 10px 0;
        }
        .content {
            padding: 20px 0;
        }
        .recibo-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }
        .info-row:last-child {
            border-bottom: none;
        }
        .info-label {
            font-weight: bold;
            color: #6c757d;
        }
        .info-value {
            color: #212529;
        }
        .monto-total {
            font-size: 24px;
            font-weight: bold;
            color: #198754;
            text-align: center;
            padding: 20px;
            background-color: #d1e7dd;
            border-radius: 8px;
            margin: 20px 0;
        }
        .texto-personalizado {
            padding: 15px;
            background-color: #e7f1ff;
            border-left: 4px solid #0d6efd;
            margin: 20px 0;
            border-radius: 4px;
        }
        .footer {
            text-align: center;
            padding: 20px 0;
            font-size: 12px;
            color: #6c757d;
            border-top: 1px solid #dee2e6;
            margin-top: 30px;
        }
        .contact-info {
            margin-top: 10px;
            font-size: 11px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            {% if logoUrl %}
                <img src="{{ logoUrl }}" alt="{{ instituto.nombre }}" class="logo">
            {% endif %}
            <div class="instituto-name">{{ instituto.nombre }}</div>
        </div>
        
        <div class="content">
            <h2 style="color: #0d6efd; margin-top: 0;">Recibo de Pago</h2>
            
            <p>Estimado/a <strong>{{ alumno.nombre }} {{ alumno.apellido }}</strong>,</p>
            
            <p>Le informamos que hemos registrado su pago:</p>
            
            <div class="recibo-info">
                <div class="info-row">
                    <span class="info-label">Fecha de Pago:</span>
                    <span class="info-value">{{ pago.fecha|date(app_date_format|default('d/m/Y')) }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Curso:</span>
                    <span class="info-value">{{ pago.curso.nombre }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Mes/Año:</span>
                    <span class="info-value">
                        {% set nombresMeses = {
                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                        } %}
                        {{ nombresMeses[pago.mes] ?? pago.mes }} / {{ pago.ano }}
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label">Método de Pago:</span>
                    <span class="info-value">{{ pago.metodoPago }}</span>
                </div>
                {% if pago.observacion %}
                <div class="info-row">
                    <span class="info-label">Observaciones:</span>
                    <span class="info-value">{{ pago.observacion }}</span>
                </div>
                {% endif %}
            </div>
            
            <div class="monto-total">
                Monto Pagado: ${{ pago.monto|number_format(2, ',', '.') }}
            </div>
            
            {% if textoPersonalizado %}
            <div class="texto-personalizado">
                {{ textoPersonalizado|nl2br }}
            </div>
            {% endif %}
            
            <p>Gracias por su pago.</p>
        </div>
        
        <div class="footer">
            <p><strong>{{ instituto.nombre }}</strong></p>
            <div class="contact-info">
                {% if instituto.dir %}
                    <p>{{ instituto.dir }}</p>
                {% endif %}
                {% if instituto.tel %}
                    <p>Teléfono: {{ instituto.tel }}</p>
                {% endif %}
                {% if instituto.email %}
                    <p>Email: {{ instituto.email }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</body>
</html>

