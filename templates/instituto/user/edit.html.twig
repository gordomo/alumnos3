{% extends 'base.html.twig' %}

{% block title %}Editar Usuario{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        .user-edit-card {
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            overflow: hidden;
        }

        .user-edit-warning {
            border: 0;
            border-bottom: 1px solid rgba(0,0,0,0.08);
            border-radius: 0;
            background: #fff7e8;
            color: #6a4a1d;
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Editar Usuario
{% endblock %}

{% block body %}
<div class="container-fluid pagina user-edit-page">
    <div class="row">
        <div class="col-12">
            <div class="card user-edit-card">
                {% if esPropioUsuario %}
                    <div class="alert alert-warning mb-0 user-edit-warning" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                            <div class="flex-grow-1">
                                <h5 class="alert-heading mb-2">¿Está seguro que desea modificar su propio usuario?</h5>
                                <p class="mb-0">Está editando su propia cuenta de usuario. Si modifica su contraseña o su email, será deslogueado automáticamente y deberá iniciar sesión nuevamente.</p>
                            </div>
                        </div>
                    </div>
                {% endif %}
                <div class="card-body">
                    {{ include('instituto/user/_form.html.twig', {'button_label': 'Actualizar', 'esPropioUsuario': esPropioUsuario|default(false), 'emailOriginal': emailOriginal|default('')}) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

