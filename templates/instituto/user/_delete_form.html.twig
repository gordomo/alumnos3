<form method="post" action="{{ path('instituto_user_delete', {'id': user.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este usuario?');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-sm btn-outline-danger btn-action-icon" title="Eliminar" data-toggle="tooltip">
        <i class="bi bi-trash"></i>
    </button>
</form>

