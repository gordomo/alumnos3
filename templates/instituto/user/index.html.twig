{% extends 'base.html.twig' %}

{% block title %}Usuarios del Instituto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --usr-primary: #5c6f6c;
            --usr-secondary: #849d9a;
            --usr-surface: #ffffff;
            --usr-text: #1f2a2d;
            --usr-muted: #647079;
            --usr-border: #e5eceb;
            --usr-shadow: 0 10px 28px rgba(19, 44, 43, 0.1);
        }

        .user-page {
            padding: 1.2rem 0.75rem;
            padding-bottom: 5.9rem;
        }

        .user-filter-card {
            border: 1px solid var(--usr-border);
            border-radius: 14px;
            box-shadow: var(--usr-shadow);
            padding: 1rem;
            margin-bottom: 1rem;
            background: var(--usr-surface);
            margin-left: 0;
            margin-right: 0;
            --bs-gutter-x: 0;
        }

        .user-filter-card .form-label {
            color: var(--usr-muted);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.35px;
        }

        .user-filter-card .form-control,
        .user-filter-card .form-select,
        .user-filter-card .btn {
            height: 40px;
            border-radius: 10px;
        }

        .user-filter-card .form-control,
        .user-filter-card .form-select {
            border-color: #d9e4e2;
            box-shadow: none;
        }

        .user-filter-card .form-control:focus,
        .user-filter-card .form-select:focus {
            border-color: var(--usr-secondary);
            box-shadow: 0 0 0 0.2rem rgba(132, 157, 154, 0.16);
        }

        .user-filter-actions .btn {
            min-width: 96px;
            font-weight: 600;
        }

        .user-filter-actions .btn-primary {
            border: none;
            background: linear-gradient(135deg, var(--usr-primary), var(--usr-secondary));
        }

        .user-panel {
            background: var(--usr-surface);
            border: 1px solid var(--usr-border);
            border-radius: 14px;
            box-shadow: var(--usr-shadow);
            overflow: hidden;
            width: 100%;
        }

        .user-table {
            margin-bottom: 0;
        }

        .user-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.2px;
            border-bottom: 1px solid #dce7e4;
            padding: 0.72rem 0.6rem;
            white-space: nowrap;
        }

        .user-table td {
            color: #27343a;
            font-size: 0.92rem;
            border-top-color: #ecf2f1;
            vertical-align: middle;
        }

        .role-badge {
            border-radius: 999px;
            padding: 0.3rem 0.55rem;
            font-size: 0.73rem;
            font-weight: 600;
        }

        .role-badge--main {
            background: linear-gradient(135deg, var(--usr-primary), var(--usr-secondary)) !important;
        }

        .user-actions {
            display: inline-flex;
            gap: 0.3rem;
        }

        .user-actions .btn {
            border-radius: 8px;
            width: 38px;
            min-width: 38px;
            padding: 0.2rem;
        }

        .user-footer {
            padding: 0.85rem 1rem 1rem;
            border-top: 1px solid #eef3f2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .user-pagination .pagination {
            margin-bottom: 0;
        }

        .user-pagination .page-link {
            border-radius: 8px;
            border-color: #d9e4e2;
            color: #4b5d61;
            margin: 0 0.15rem;
        }

        .user-pagination .page-item.active .page-link {
            background: var(--usr-primary);
            border-color: var(--usr-primary);
            color: #fff;
        }

        .user-floating-actions {
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            z-index: 1030;
        }

        .user-floating-btn {
            border: none;
            border-radius: 999px;
            padding: 0.58rem 0.95rem;
            font-size: 0.84rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: linear-gradient(135deg, #2c9e67, #228556);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
        }

        .user-floating-btn:hover {
            color: #fff;
            text-decoration: none;
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Usuarios del Instituto
{% endblock %}

{% block body %}
<div class="container-fluid mt-3 user-page">
    <div class="row mb-3">
        <div class="col-12">
            <form method="get" class="row g-3 user-filter-card ui-filter-card">
                <div class="col-md-6">
                    <label for="busqueda" class="form-label">Buscar por Email</label>
                    <input type="text" class="form-control" id="busqueda" name="busqueda" value="{{ busqueda }}" placeholder="Buscar usuario...">
                </div>
                <div class="col-md-3">
                    <label for="limit" class="form-label">Registros por página</label>
                    <select class="form-select" id="limit" name="limit">
                        <option value="10" {% if limit == 10 %}selected{% endif %}>10</option>
                        <option value="25" {% if limit == 25 %}selected{% endif %}>25</option>
                        <option value="50" {% if limit == 50 %}selected{% endif %}>50</option>
                        <option value="100" {% if limit == 100 %}selected{% endif %}>100</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end user-filter-actions">
                    <button type="submit" class="btn btn-primary me-2">Buscar</button>
                    <a href="{{ path('instituto_user_index') }}" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-12">
            <div class="user-panel p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover user-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% set role_names = {
                        'ROLE_USER': 'Usuario',
                        'ROLE_PROFESOR': 'Profesor',
                        'ROLE_ADMIN_INSTITUTO': 'Administrador del Instituto'
                    } %}
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if user.roles %}
                                    {% for role in user.roles %}
                                        {% if role in role_names|keys %}
                                            <span class="badge role-badge role-badge--main me-1">{{ role_names[role] }}</span>
                                        {% else %}
                                            <span class="badge bg-secondary role-badge me-1">{{ role }}</span>
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </td>
                            <td>
                                <div class="user-actions">
                                <a href="{{ path('instituto_user_show', {'id': user.id}) }}" 
                                   class="btn btn-sm btn-outline-info" 
                                   title="Ver" 
                                   data-toggle="tooltip">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('instituto_user_edit', {'id': user.id}) }}" 
                                   class="btn btn-sm btn-outline-primary" 
                                   title="Editar" 
                                   data-toggle="tooltip">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                {{ include('instituto/user/_delete_form.html.twig', {'user': user}) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">No se encontraron usuarios.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
            <div class="user-footer">
                <div>
                    Mostrando {{ users|length }} de {{ users.getTotalItemCount }} usuarios
                </div>
                <div class="user-pagination">
                    {{ knp_pagination_render(users) }}
                </div>
            </div>
        </div>
        </div>
    </div>
</div>

<div class="user-floating-actions">
    <a href="{{ path('instituto_user_new') }}" class="user-floating-btn">
        <i class="bi bi-plus-circle"></i> Crear Nuevo
    </a>
</div>
{% endblock %}

