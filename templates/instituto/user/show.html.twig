{% extends 'base.html.twig' %}

{% block title %}Ver Usuario{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        .user-show-card {
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            overflow: hidden;
        }

        .user-show-table th {
            width: 220px;
            background: #f5f9f8;
            color: #4a5a60;
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.25px;
            font-weight: 700;
        }

        .user-show-table td {
            color: #27343a;
            font-weight: 500;
        }

        .role-badge {
            border-radius: 999px;
            padding: 0.3rem 0.55rem;
            font-size: 0.73rem;
            font-weight: 600;
        }

        .role-badge--main {
            background: linear-gradient(135deg, var(--ui-primario), var(--ui-secundario)) !important;
        }

        .user-show-actions .btn {
            border-radius: 10px;
            min-width: 110px;
        }
    </style>
{% endblock %}

{% block panelTitle %}
    Detalle del Usuario
{% endblock %}

{% block body %}
<div class="container-fluid pagina user-show-page">
    <div class="row">
        <div class="col-12">
            <div class="card user-show-card">
                <div class="card-body">
                    <table class="table table-bordered user-show-table">
                        <tbody>
                            <tr>
                                <th>ID</th>
                                <td>{{ user.id }}</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>{{ user.email }}</td>
                            </tr>
                            <tr>
                                <th>Roles</th>
                                <td>
                                    {% set role_names = {
                                        'ROLE_USER': 'Usuario',
                                        'ROLE_PROFESOR': 'Profesor',
                                        'ROLE_ADMIN_INSTITUTO': 'Administrador del Instituto'
                                    } %}
                                    {% if user.roles %}
                                        {% for role in user.roles %}
                                            {% if role in role_names|keys %}
                                                <span class="badge role-badge role-badge--main me-1">{{ role_names[role] }}</span>
                                            {% else %}
                                                <span class="badge bg-secondary role-badge me-1">{{ role }}</span>
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>{{ Term('instituto') }}</th>
                                <td>{{ user.instituto ? user.instituto.nombre : '-' }}</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-end user-show-actions">
                        <a href="{{ path('instituto_user_index') }}" class="btn btn-secondary">Volver</a>
                        <a href="{{ path('instituto_user_edit', {'id': user.id}) }}" class="btn btn-primary">Editar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

