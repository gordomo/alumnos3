{% extends 'base.html.twig' %}
{% block title %}Consultas y preinscripciones{% endblock %}
{% block panelTitle %}Consultas y preinscripciones{% endblock %}
{% block body %}
<div class="container-fluid pagina py-3">
    <p class="text-muted">Solicitudes recibidas desde tu página pública. Confirmar una preinscripción permite continuar con el alta; no genera alumnos ni deudas automáticamente.</p>
    <form class="card mb-3" method="get"><div class="card-body d-flex gap-2 flex-wrap align-items-end"><div><label class="form-label" for="estado">Estado</label><select class="form-select" id="estado" name="estado">{% for valor, etiqueta in {pendiente:'Pendientes',confirmada:'Preinscripciones confirmadas',inscrita:'Inscripciones completadas',atendida:'Consultas atendidas',descartada:'Descartadas',todas:'Todas'} %}<option value="{{ valor }}" {{ estado == valor ? 'selected' : '' }}>{{ etiqueta }}</option>{% endfor %}</select></div><button class="btn btn-primary">Filtrar</button></div></form>
    <div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Fecha</th><th>Tipo</th><th>Nombre</th><th>Contacto</th><th>{{ Term('curso') }}</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    {% for s in solicitudes %}<tr><td>{{ s.fecha|date('d/m/Y H:i') }}</td><td>{{ s.tipo == 'contacto' ? 'Consulta' : 'Preinscripción' }}</td><td>{{ s.nombre }} {{ s.apellido }}</td><td>{{ s.email }}{% if s.telefono %}<br><small>{{ s.telefono }}</small>{% endif %}</td><td>{{ s.curso ? s.curso.nombre : '—' }}</td><td><span class="badge {{ s.estado == 'pendiente' ? 'bg-warning text-dark' : 'bg-light text-dark border' }}">{{ s.estado|capitalize }}</span></td><td><a class="btn btn-outline-primary btn-sm" href="{{ path('instituto_solicitudes_show',{id:s.id}) }}">Revisar</a></td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-5">No hay solicitudes en este estado.</td></tr>{% endfor %}
    </tbody></table></div></div><div class="mt-3">{{ knp_pagination_render(solicitudes) }}</div>
</div>
{% endblock %}
