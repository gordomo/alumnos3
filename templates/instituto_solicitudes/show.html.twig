{% extends 'base.html.twig' %}
{% if respuestaForm is defined %}{% form_theme respuestaForm 'bootstrap_5_layout.html.twig' %}{% endif %}
{% block title %}Revisar solicitud{% endblock %}
{% block panelTitle %}{{ solicitud.tipo == 'contacto' ? 'Consulta' : 'Preinscripción' }} de {{ solicitud.nombre }}{% endblock %}
{% block body %}
<div class="container-fluid pagina py-3" style="max-width:1100px">
<a class="btn btn-outline-secondary mb-3" href="{{ path('instituto_solicitudes_index') }}">Volver a la bandeja</a>
{% for tipo in ['success','warning'] %}{% for mensaje in app.flashes(tipo) %}<div class="alert alert-{{ tipo }}" role="status">{{ mensaje }}</div>{% endfor %}{% endfor %}
<div class="card mb-3"><div class="card-body p-4"><span class="badge bg-light text-dark border mb-3">{{ solicitud.estado|capitalize }}</span><h2 class="h4">{{ solicitud.nombre }} {{ solicitud.apellido }}</h2><p class="text-muted">Recibida el {{ solicitud.fecha|date('d/m/Y H:i') }}</p>
<dl class="row"><dt class="col-sm-3">Email de contacto</dt><dd class="col-sm-9"><a href="mailto:{{ solicitud.email|url_encode }}">{{ solicitud.email }}</a></dd>{% if solicitud.telefono %}<dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">{{ solicitud.telefono }}</dd>{% endif %}{% if solicitud.tipo == 'preinscripcion' %}<dt class="col-sm-3">{{ Term('curso') }}</dt><dd class="col-sm-9">{{ solicitud.curso ? solicitud.curso.nombre : 'El curso fue eliminado' }}</dd>{% endif %}</dl>
{% if solicitud.mensaje %}<div class="border rounded p-3 bg-light" style="white-space:pre-line;overflow-wrap:anywhere">{{ solicitud.mensaje }}</div>{% endif %}
{% if solicitud.estado == 'pendiente' %}<form method="post" action="{{ path('instituto_solicitudes_resolver',{id:solicitud.id}) }}" class="d-flex flex-wrap gap-2 mt-4"><input type="hidden" name="_token" value="{{ csrf_token('solicitud_publica_' ~ solicitud.id) }}">{% if solicitud.tipo == 'preinscripcion' %}<button class="btn btn-primary" name="accion" value="confirmada">Confirmar preinscripción</button>{% else %}<button class="btn btn-primary" name="accion" value="atendida">Marcar como atendida</button>{% endif %}<button class="btn btn-outline-secondary" name="accion" value="descartada">Descartar</button></form>{% endif %}
</div></div>
{% if respuestaForm is defined %}
<div class="card mb-3" id="respuestas"><div class="card-body p-4"><h3 class="h5">Responder por email</h3><p class="text-muted">Para: <strong>{{ solicitud.email }}</strong>. Las contestaciones llegarán al email de {{ solicitud.instituto.nombre }}.</p>
{% if not puedeResponder %}<div class="alert alert-warning">Primero configurá un email válido en <a href="{{ path('instituto_config_edit') }}">Información general</a> para recibir las contestaciones.</div>{% endif %}
{{ form_start(respuestaForm) }}{{ form_errors(respuestaForm) }}<fieldset {{ not puedeResponder ? 'disabled' : '' }}>{{ form_row(respuestaForm.asunto) }}{{ form_row(respuestaForm.mensaje) }}{{ form_widget(respuestaForm.envio) }}<div class="d-flex gap-3 align-items-center flex-wrap mt-3"><button class="btn btn-primary" type="submit"><i class="bi bi-send"></i> Enviar respuesta</button><span class="small text-muted">{{ solicitud.tipo == 'contacto' ? 'Si está pendiente, se marcará como atendida después del envío.' : 'Responder no modifica el estado de la preinscripción.' }}</span></div></fieldset>{{ form_end(respuestaForm) }}
</div></div>
{% if respuestas %}<div class="card mb-3"><div class="card-body p-4"><h3 class="h5 mb-3">Historial de respuestas</h3><p class="small text-muted">Últimas 50 respuestas. Los envíos también aparecen en Historial de Emails.</p>{% for r in respuestas %}<article class="border rounded p-3 mb-3"><div class="d-flex justify-content-between flex-wrap gap-2"><strong>{{ r.asunto }}</strong><span class="badge {{ r.estado == 'enviada' ? 'bg-success' : (r.estado == 'fallida' ? 'bg-warning text-dark' : 'bg-secondary') }}">{{ r.estado == 'enviada' ? 'Enviada' : (r.estado == 'fallida' ? 'Envío no confirmado' : 'En proceso') }}</span></div><p class="small text-muted mt-2">{{ r.fecha|date('d/m/Y H:i') }} · Para {{ r.destinatario }}{% if r.autor %} · {{ r.autor.email }}{% endif %}</p><div style="white-space:pre-line;overflow-wrap:anywhere">{{ r.mensaje }}</div>{% if r.estado != 'enviada' %}<p class="small text-muted mt-3 mb-0">El texto se conserva. Verificá el estado antes de redactar un nuevo envío para evitar duplicados.</p>{% endif %}</article>{% endfor %}</div></div>{% endif %}
{% endif %}
{% if solicitud.estado == 'confirmada' %}<div class="card"><div class="card-body p-4"><h3 class="h5">Completar la inscripción</h3><p>La preinscripción fue revisada. Contactá a la persona y completá los datos obligatorios del alta. Los pagos y deudas se generan con las reglas habituales del sistema cuando guardás la inscripción.</p>
{% if existentes %}<p class="alert alert-info">Encontramos {{ term('alumnos') }} de tu institución con ese correo. Revisalos antes de crear un alta nueva.</p>{% for alumno in existentes %}<div class="border rounded p-3 mb-2"><a href="{{ path('app_alumno_show',{id:alumno.id}) }}">{{ alumno.nombre }} {{ alumno.apellido }} · Ver ficha</a><p class="small text-muted mt-2 mb-2">Si aún no está en el curso, gestioná su inscripción desde el listado de {{ term('alumnos') }}. Después podés vincularla acá.</p><form method="post" action="{{ path('instituto_solicitudes_resolver',{id:solicitud.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('solicitud_publica_' ~ solicitud.id) }}"><input type="hidden" name="alumno" value="{{ alumno.id }}"><button class="btn btn-outline-primary" name="accion" value="inscrita">Vincular inscripción realizada</button></form></div>{% endfor %}{% endif %}
<a class="btn btn-primary mt-2" href="{{ path('app_alumno_new',{preinscripcion:solicitud.id}) }}">Continuar con un alta nueva</a></div></div>{% endif %}
{% if solicitud.alumno %}<div class="alert alert-success">Inscripción completada: <a href="{{ path('app_alumno_show',{id:solicitud.alumno.id}) }}">Ver ficha {{ term('del_alumno') }}</a>.</div>{% endif %}
</div>
{% endblock %}
