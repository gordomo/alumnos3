{% extends 'base.html.twig' %}

{% block title %}Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_index') }}">Alumnos</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_show', {'id': alumno.id}) }}">{{ alumno.nombre }} {{ alumno.apellido }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Gestión de Deudas</li>
                </ol>
            </nav>
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}</h4>
                    <a href="{{ path('app_alumnos_pagos_new', {'id': alumno.id}) }}" class="btn btn-success">
                        <i class="bi bi-cash-coin"></i> Registrar Pago
                    </a>
                </div>
                <div class="card-body">
                    {% if deudasPorCurso|length > 0 %}
                        <div class="alert alert-info">
                            <p><i class="bi bi-info-circle"></i> Las deudas se calculan automáticamente basándose en los cursos activos del alumno y los pagos realizados. Para cancelar una deuda, registre un pago que la cubra completamente.</p>
                        </div>
                        
                        <div class="alert alert-secondary">
                            <h5><i class="bi bi-book"></i> Cursos activos del alumno</h5>
                            {% for cursoId, datos in deudasPorCurso %}
                                {% set historico = datos.historico %}
                                {% set curso = datos.curso %}
                                <div class="mb-3">
                                    <strong>{{ curso.nombre }}</strong>
                                    <ul class="mb-0">
                                        <li><strong>Fecha de inscripción:</strong> {{ historico.fechaAlta|date('d/m/Y') }}</li>
                                        <li><strong>Precio mensual:</strong> ${{ historico.precioMensual|number_format(2, ',', '.') }}</li>
                                        <li><strong>Período del curso:</strong> {{ historico.fechaInicioPeriodo|date('d/m/Y') }} - {{ historico.fechaFinPeriodo ? historico.fechaFinPeriodo|date('d/m/Y') : 'Sin fecha de fin' }}</li>
                                        <li>
                                            <strong>Generación de deudas:</strong> 
                                            {% set modo = historico.modoGeneracionDeuda %}
                                            {% if modo == 'inicio_curso' %}
                                                <span class="badge bg-primary">Desde el inicio del curso</span>
                                                <br><small class="text-muted">
                                                    Primera deuda: {{ historico.fechaInicioPeriodo|mes_es }}
                                                    {% if historico.fechaAlta > historico.fechaInicioPeriodo %}
                                                        <br><em>Nota: El alumno se inscribió el {{ historico.fechaAlta|date('d/m/Y') }}, pero se le generan deudas desde el inicio del curso ({{ historico.fechaInicioPeriodo|date('d/m/Y') }}).</em>
                                                    {% endif %}
                                                </small>
                                            {% elseif modo == 'proximo_mes' %}
                                                <span class="badge bg-warning text-dark">Desde el mes siguiente a la inscripción</span>
                                                <br><small class="text-muted">Primera deuda: {{ historico.fechaAlta|date_modify('+1 month')|mes_es }}</small>
                                            {% else %}
                                                <span class="badge bg-info">Desde el mes de inscripción</span>
                                                <br><small class="text-muted">
                                                    Primera deuda: {{ historico.fechaAlta|mes_es }}
                                                    {% if historico.fechaAlta > historico.fechaInicioPeriodo %}
                                                        <br><em>Nota: El alumno se inscribió después del inicio del curso ({{ historico.fechaInicioPeriodo|date('d/m/Y') }}), por lo que las deudas comienzan desde su fecha de inscripción.</em>
                                                    {% endif %}
                                                </small>
                                            {% endif %}
                                        </li>
                                    </ul>
                                </div>
                            {% endfor %}
                        </div>
                        
                        <div class="alert alert-warning">
                            <h5><i class="bi bi-calendar-check"></i> Vencimientos configurados</h5>
                            <p>El instituto {{ alumno.instituto.nombre }} tiene configurados los siguientes vencimientos para las cuotas mensuales:</p>
                            
                            {% set vencimientos = alumno.instituto.vencimientos %}
                            {% if vencimientos|length > 0 %}
                                {% set vencimientos_sorted = vencimientos|sort((a, b) => a.diaVencimiento <=> b.diaVencimiento) %}
                                <ul>
                                {% for vencimiento in vencimientos_sorted %}
                                    <li>
                                        <strong>{{ loop.index }}º vencimiento:</strong> Día {{ vencimiento.diaVencimiento }} de cada mes
                                        {% if vencimiento.porcentajeInteres > 0 %}
                                            (recargo del {{ vencimiento.porcentajeInteres }}% desde esta fecha)
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                </ul>
                                <p class="mb-0"><strong>Nota:</strong> Las deudas del mes actual se consideran vencidas a partir del día {{ vencimientos_sorted|first.diaVencimiento }} del mes.</p>
                            {% else %}
                                <p>No hay vencimientos configurados para este instituto. Se considera el día 5 de cada mes como fecha de vencimiento por defecto.</p>
                            {% endif %}
                        </div>
                        
                        <div class="accordion" id="accordionDeudas">
                            {% for cursoId, datos in deudasPorCurso %}
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading{{ cursoId }}">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ cursoId }}" aria-expanded="true" aria-controls="collapse{{ cursoId }}">
                                            <strong>{{ datos.curso.nombre }}</strong> - {{ datos.deudas|length }} deudas pendientes
                                        </button>
                                    </h2>
                                    <div id="collapse{{ cursoId }}" class="accordion-collapse collapse show" aria-labelledby="heading{{ cursoId }}" data-bs-parent="#accordionDeudas">
                                        <div class="accordion-body">
                                            <table class="table table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Periodo</th>
                                                        <th>Monto</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for deuda in datos.deudas %}
                                                        <tr>
                                                            <td>
                                                                {% set meses = {
                                                                    1: 'Enero',
                                                                    2: 'Febrero',
                                                                    3: 'Marzo',
                                                                    4: 'Abril',
                                                                    5: 'Mayo',
                                                                    6: 'Junio',
                                                                    7: 'Julio',
                                                                    8: 'Agosto',
                                                                    9: 'Septiembre',
                                                                    10: 'Octubre',
                                                                    11: 'Noviembre',
                                                                    12: 'Diciembre'
                                                                } %}
                                                                {{ meses[deuda.mes] }} {{ deuda.ano }}
                                                            </td>
                                                            <td>
                                                                {% set monto_total = deuda.monto + (deuda.interes ?? 0) %}
                                                                ${{ monto_total|number_format(2, ',', '.') }}
                                                                {% if deuda.interes > 0 %}
                                                                    <br><small class="text-muted">(Base: ${{ deuda.monto|number_format(2, ',', '.') }} + Interés: ${{ deuda.interes|number_format(2, ',', '.') }})</small>
                                                                {% endif %}
                                                            </td>
                                                            <td>
                                                                {% set hoy = "now"|date("Y-m-d") %}
                                                                {% set mes_actual = "now"|date("n") %}
                                                                {% set ano_actual = "now"|date("Y") %}
                                                                {% set dia_actual = "now"|date("d") %}
                                                                
                                                                {% set vencimientos = alumno.instituto.vencimientos %}
                                                                {% set primer_vencimiento = null %}
                                                                {% set primer_dia_vencimiento = 5 %}
                                                                
                                                                {% if vencimientos|length > 0 %}
                                                                    {% set vencimientos_sorted = vencimientos|sort((a, b) => a.diaVencimiento <=> b.diaVencimiento) %}
                                                                    {% set primer_vencimiento = vencimientos_sorted|first %}
                                                                    {% set primer_dia_vencimiento = primer_vencimiento.diaVencimiento %}
                                                                {% endif %}
                                                                
                                                                {% if deuda.mes < mes_actual and deuda.ano <= ano_actual %}
                                                                    <span class="badge bg-danger">Vencida</span>
                                                                {% elseif deuda.mes == mes_actual and deuda.ano == ano_actual %}
                                                                    {% if dia_actual >= primer_dia_vencimiento %}
                                                                        <span class="badge bg-danger">Vencida</span>
                                                                    {% else %}
                                                                        <span class="badge bg-warning">Mes actual - Pendiente de pago</span>
                                                                    {% endif %}
                                                                {% else %}
                                                                    <span class="badge bg-info">Futura</span>
                                                                {% endif %}
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-success">
                            <p><i class="bi bi-check-circle"></i> El alumno no tiene deudas pendientes.</p>
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    {{ include('components/back_button.html.twig', {
                        'default_path': path('app_alumno_index'),
                        'force_reload': true
                    }) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 