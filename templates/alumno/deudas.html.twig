{% extends 'base.html.twig' %}

{% block title %}Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_index') }}">Alumnos</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_show', {'id': alumno.id}) }}">{{ alumno.nombre }} {{ alumno.apellido }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Gestión de Deudas</li>
                </ol>
            </nav>
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}</h4>
                </div>
                <div class="card-body">
                    {% if deudasPorCurso|length > 0 %}
                        <div class="alert alert-info">
                            <p><i class="bi bi-info-circle"></i> Esta página permite gestionar las deudas pendientes del alumno. Puedes:</p>
                            <ul>
                                <li>Cancelar deudas individuales si fueron generadas por error</li>
                                <li>Cancelar todas las deudas pendientes de un curso</li>
                                <li>Cancelar solo las deudas futuras de un curso (manteniendo las deudas del mes actual y anteriores)</li>
                            </ul>
                        </div>
                        
                        <div class="alert alert-warning">
                            <h5><i class="bi bi-calendar-check"></i> Vencimientos configurados</h5>
                            <p>El instituto {{ alumno.instituto.nombre }} tiene configurados los siguientes vencimientos para las cuotas mensuales:</p>
                            
                            {% set vencimientos = alumno.instituto.vencimientos %}
                            {% if vencimientos|length > 0 %}
                                {% set vencimientos_sorted = vencimientos|sort((a, b) => a.diaVencimiento <=> b.diaVencimiento) %}
                                <ul>
                                {% for vencimiento in vencimientos_sorted %}
                                    <li>
                                        <strong>{{ loop.index }}º vencimiento:</strong> Día {{ vencimiento.diaVencimiento }} de cada mes
                                        {% if vencimiento.porcentajeInteres > 0 %}
                                            (recargo del {{ vencimiento.porcentajeInteres }}% después de esta fecha)
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                </ul>
                                <p class="mb-0"><strong>Nota:</strong> Las deudas del mes actual se consideran vencidas después del día {{ vencimientos_sorted|first.diaVencimiento }} del mes.</p>
                            {% else %}
                                <p>No hay vencimientos configurados para este instituto. Se considera el día 5 de cada mes como fecha de vencimiento por defecto.</p>
                            {% endif %}
                        </div>
                        
                        <div class="accordion" id="accordionDeudas">
                            {% for cursoId, datos in deudasPorCurso %}
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading{{ cursoId }}">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ cursoId }}" aria-expanded="true" aria-controls="collapse{{ cursoId }}">
                                            <strong>{{ datos.curso.nombre }}</strong> - {{ datos.deudas|length }} deudas pendientes
                                        </button>
                                    </h2>
                                    <div id="collapse{{ cursoId }}" class="accordion-collapse collapse show" aria-labelledby="heading{{ cursoId }}" data-bs-parent="#accordionDeudas">
                                        <div class="accordion-body">
                                            <div class="mb-3 d-flex justify-content-end">
                                                <form method="post" action="{{ path('app_alumno_cancelar_deudas_curso', {'id': alumno.id, 'cursoId': cursoId}) }}" class="me-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancelar-deudas-curso' ~ cursoId) }}">
                                                    <input type="hidden" name="solo_futuras" value="1">
                                                    <button type="submit" class="btn btn-warning btn-sm" onclick="return confirm('¿Estás seguro de que deseas cancelar todas las deudas FUTURAS para este curso? Esta acción no se puede deshacer.')">
                                                        <i class="bi bi-calendar-x"></i> Cancelar deudas futuras
                                                    </button>
                                                </form>
                                                <form method="post" action="{{ path('app_alumno_cancelar_deudas_curso', {'id': alumno.id, 'cursoId': cursoId}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancelar-deudas-curso' ~ cursoId) }}">
                                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de que deseas cancelar TODAS las deudas pendientes para este curso? Esta acción no se puede deshacer.')">
                                                        <i class="bi bi-trash"></i> Cancelar todas las deudas
                                                    </button>
                                                </form>
                                            </div>
                                            
                                            <table class="table table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Periodo</th>
                                                        <th>Monto</th>
                                                        <th>Estado</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for deuda in datos.deudas %}
                                                        <tr>
                                                            <td>
                                                                {% set meses = {
                                                                    1: 'Enero',
                                                                    2: 'Febrero',
                                                                    3: 'Marzo',
                                                                    4: 'Abril',
                                                                    5: 'Mayo',
                                                                    6: 'Junio',
                                                                    7: 'Julio',
                                                                    8: 'Agosto',
                                                                    9: 'Septiembre',
                                                                    10: 'Octubre',
                                                                    11: 'Noviembre',
                                                                    12: 'Diciembre'
                                                                } %}
                                                                {{ meses[deuda.mes] }} {{ deuda.ano }}
                                                            </td>
                                                            <td>${{ deuda.monto|number_format(2, ',', '.') }}</td>
                                                            <td>
                                                                {% set hoy = "now"|date("Y-m-d") %}
                                                                {% set mes_actual = "now"|date("n") %}
                                                                {% set ano_actual = "now"|date("Y") %}
                                                                {% set dia_actual = "now"|date("d") %}
                                                                
                                                                {% set vencimientos = alumno.instituto.vencimientos %}
                                                                {% set primer_vencimiento = null %}
                                                                {% set primer_dia_vencimiento = 5 %}
                                                                
                                                                {% if vencimientos|length > 0 %}
                                                                    {% set vencimientos_sorted = vencimientos|sort((a, b) => a.diaVencimiento <=> b.diaVencimiento) %}
                                                                    {% set primer_vencimiento = vencimientos_sorted|first %}
                                                                    {% set primer_dia_vencimiento = primer_vencimiento.diaVencimiento %}
                                                                {% endif %}
                                                                
                                                                {% if deuda.mes < mes_actual and deuda.ano <= ano_actual %}
                                                                    <span class="badge bg-danger">Vencida</span>
                                                                {% elseif deuda.mes == mes_actual and deuda.ano == ano_actual %}
                                                                    {% if dia_actual > primer_dia_vencimiento %}
                                                                        <span class="badge bg-danger">Vencida</span>
                                                                    {% else %}
                                                                        <span class="badge bg-warning">Mes actual - Pendiente de pago</span>
                                                                    {% endif %}
                                                                {% else %}
                                                                    <span class="badge bg-info">Futura</span>
                                                                {% endif %}
                                                            </td>
                                                            <td>
                                                                <form method="post" action="{{ path('app_alumno_cancelar_deuda', {'id': alumno.id, 'deudaId': deuda.id}) }}" style="display: inline-block;">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancelar-deuda' ~ deuda.id) }}">
                                                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de que deseas cancelar esta deuda? Esta acción no se puede deshacer.')">
                                                                        <i class="bi bi-trash"></i> Cancelar
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-success">
                            <p><i class="bi bi-check-circle"></i> El alumno no tiene deudas pendientes.</p>
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    {{ include('components/back_button.html.twig', {
                        'default_path': path('app_alumno_index'),
                        'force_reload': true
                    }) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 