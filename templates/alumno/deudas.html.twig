{% extends 'base.html.twig' %}

{% block title %}Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_index') }}">Alumn@s</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_alumno_show', {'id': alumno.id}) }}">{{ alumno.nombre }} {{ alumno.apellido }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Gestión de Deudas</li>
                </ol>
            </nav>
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Gestión de Deudas - {{ alumno.nombre }} {{ alumno.apellido }}</h4>
                    <a href="{{ path('app_alumnos_pagos_new', {'id': alumno.id}) }}" class="btn btn-success">
                        <i class="bi bi-cash-coin"></i> Registrar Pago
                    </a>
                </div>
                <div class="card-body">
                    {% if deudasPorCurso|length > 0 %}
                        <div class="alert alert-info">
                            <p><i class="bi bi-info-circle"></i> Las deudas se calculan automáticamente basándose en los cursos activos del alumno y los pagos realizados. Para cancelar una deuda, registre un pago que la cubra completamente.</p>
                        </div>

                        {% if saldoFavorTotal is defined and saldoFavorTotal > 0 %}
                            <div class="alert alert-success d-flex justify-content-between align-items-center">
                                <div>
                                    <i class="bi bi-wallet2" style="font-size: 1.3rem;"></i>
                                    <strong>Saldo a favor disponible: ${{ saldoFavorTotal|number_format(2, ',', '.') }}</strong>
                                    <br><small class="text-muted">Este saldo puede ser aplicado a deudas pendientes.</small>
                                </div>
                                <a href="{{ path('app_saldo_favor_index', {'id': alumno.id}) }}" class="btn btn-success btn-sm">
                                    <i class="bi bi-arrow-right-circle"></i> Gestionar Saldos a Favor
                                </a>
                            </div>
                        {% else %}
                            <div class="d-flex justify-content-end mb-2">
                                <a href="{{ path('app_saldo_favor_index', {'id': alumno.id}) }}" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-wallet2"></i> Saldos a Favor
                                </a>
                            </div>
                        {% endif %}

                        {# Cuota de inscripción anual: va en su propio bloque porque no
                           pertenece a ningún curso ni a ningún mes de cursada. #}
                        {% if cuotasInscripcion is defined and cuotasInscripcion|length > 0 %}
                            <div class="card border-warning mb-3">
                                <div class="card-header bg-warning bg-opacity-25">
                                    <strong><i class="bi bi-person-plus"></i> Cuota de inscripción</strong>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Año</th>
                                                <th class="text-end">Monto</th>
                                                <th class="text-end">Pendiente</th>
                                                <th class="text-end">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for cuota in cuotasInscripcion %}
                                                <tr>
                                                    <td><strong>{{ cuota.ano }}</strong></td>
                                                    <td class="text-end">${{ cuota.monto|number_format(2, ',', '.') }}</td>
                                                    <td class="text-end text-danger">
                                                        <strong>${{ cuota.montoPendiente|number_format(2, ',', '.') }}</strong>
                                                    </td>
                                                    <td class="text-end">
                                                        <a href="{{ path('app_alumnos_pagos_por_deuda', {'id': cuota.id}) }}"
                                                           class="btn btn-sm btn-success">
                                                            <i class="bi bi-cash-coin"></i> Registrar pago
                                                        </a>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endif %}

                        <div class="alert alert-secondary">
                            <h5><i class="bi bi-book"></i> Cursos del alumno</h5>
                            {% for cursoId, datos in deudasPorCurso %}
                                {% set historico = datos.historico %}
                                {% set curso = datos.curso %}
                                {% set cursoActivo = datos.cursoActivo|default(true) %}
                                <div class="mb-3">
                                    <strong>{{ curso.nombre }}</strong>
                                    {% if not cursoActivo %}
                                        <span class="badge bg-secondary">Curso inactivo</span>
                                    {% endif %}
                                    {% if historico %}
                                    <ul class="mb-0">
                                        <li><strong>Fecha de inscripción:</strong> {{ historico.fechaAlta|date('d/m/Y') }}</li>
                                        <li><strong>Precio mensual:</strong> ${{ historico.precioMensual|number_format(2, ',', '.') }}</li>
                                        <li><strong>Período del curso:</strong> {{ historico.fechaInicioPeriodo|date('d/m/Y') }} - {{ historico.fechaFinPeriodo ? historico.fechaFinPeriodo|date('d/m/Y') : 'Sin fecha de fin' }}</li>
                                        <li>
                                            <strong>Generación de deudas:</strong> 
                                            {% set modo = historico.modoGeneracionDeuda %}
                                            {% if modo == 'inicio_curso' %}
                                                <span class="badge bg-primary">Desde el inicio del curso</span>
                                                <br><small class="text-muted">
                                                    Primera deuda: {{ historico.fechaInicioPeriodo|mes_es }}
                                                    {% if historico.fechaAlta > historico.fechaInicioPeriodo %}
                                                        <br><em>Nota: El alumno se inscribió el {{ historico.fechaAlta|date('d/m/Y') }}, pero se le generan deudas desde el inicio del curso ({{ historico.fechaInicioPeriodo|date('d/m/Y') }}).</em>
                                                    {% endif %}
                                                </small>
                                            {% elseif modo == 'proximo_mes' %}
                                                <span class="badge bg-success text-white">Desde el mes siguiente a la inscripción</span>
                                                <br><small class="text-muted">Primera deuda: {{ historico.fechaAlta|date_modify('+1 month')|mes_es }}</small>
                                            {% else %}
                                                <span class="badge bg-info">Desde el mes de inscripción</span>
                                                <br><small class="text-muted">
                                                    Primera deuda: {{ historico.fechaAlta|mes_es }}
                                                    {% if historico.fechaAlta > historico.fechaInicioPeriodo %}
                                                        <br><em>Nota: El alumno se inscribió después del inicio del curso ({{ historico.fechaInicioPeriodo|date('d/m/Y') }}), por lo que las deudas comienzan desde su fecha de inscripción.</em>
                                                    {% endif %}
                                                </small>
                                            {% endif %}
                                        </li>
                                    </ul>
                                    {% else %}
                                        <p class="text-muted mb-0"><small>Deudas pendientes de un curso donde el alumno ya no está inscrito.</small></p>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                        
                        <div class="alert alert-warning">
                            <h5><i class="bi bi-calendar-check"></i> Vencimientos configurados</h5>
                            <p>El instituto {{ alumno.instituto.nombre }} tiene configurados los siguientes vencimientos para las cuotas mensuales:</p>
                            
                            {% set vencimientos = alumno.instituto.vencimientos %}
                            {% if vencimientos|length > 0 %}
                                {% set vencimientos_sorted = vencimientos|sort((a, b) => a.diaVencimiento <=> b.diaVencimiento) %}
                                <ul>
                                {% for vencimiento in vencimientos_sorted %}
                                    <li>
                                        <strong>{{ loop.index }}º vencimiento:</strong> Día {{ vencimiento.diaVencimiento }} de cada mes
                                        {% if vencimiento.porcentajeInteres > 0 %}
                                            (recargo del {{ vencimiento.porcentajeInteres }}% desde esta fecha)
                                        {% endif %}
                                    </li>
                                {% endfor %}
                                </ul>
                                <p class="mb-0"><strong>Nota:</strong> Las deudas del mes actual se consideran vencidas a partir del día {{ vencimientos_sorted|first.diaVencimiento }} del mes.</p>
                            {% else %}
                                <p>No hay vencimientos configurados para este instituto. Se considera el día 5 de cada mes como fecha de vencimiento por defecto.</p>
                            {% endif %}
                        </div>
                        
                        <div class="accordion" id="accordionDeudas">
                            {% for cursoId, datos in deudasPorCurso %}
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="heading{{ cursoId }}">
                                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ cursoId }}" aria-expanded="true" aria-controls="collapse{{ cursoId }}">
                                            <strong>{{ datos.curso.nombre }}</strong> - 
                                            {% set estado = estadoPorCurso[cursoId]|default({'estado': 'al_dia', 'vencidas': 0, 'pendientes': 0}) %}
                                            {% if estado.estado == 'vencido' %}
                                                <span class="badge bg-danger ms-2"><i class="bi bi-exclamation-triangle-fill"></i>
                                                    {{ estado.vencidas }} cuota{{ estado.vencidas > 1 ? 's' : '' }} vencida{{ estado.vencidas > 1 ? 's' : '' }}
                                                </span>
                                            {% else %}
                                                <span class="badge bg-success ms-2"><i class="bi bi-check-circle-fill"></i> Curso al día</span>
                                                {% if estado.pendientes > 0 %}
                                                    <span class="badge bg-primary ms-2">
                                                        {{ estado.pendientes }} cuota{{ estado.pendientes > 1 ? 's' : '' }} por vencer
                                                    </span>
                                                {% endif %}
                                            {% endif %}
                                            {% if not datos.cursoActivo|default(true) %}
                                                <span class="badge bg-secondary ms-2">Curso inactivo</span>
                                            {% endif %}
                                        </button>
                                    </h2>
                                    <div id="collapse{{ cursoId }}" class="accordion-collapse collapse show" aria-labelledby="heading{{ cursoId }}" data-bs-parent="#accordionDeudas">
                                        <div class="accordion-body">
                                            {% if datos.deudas|length == 0 %}
                                                <div class="alert alert-success mb-0">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    <strong>Curso al día.</strong> El alumno no tiene cuotas pendientes de este curso hasta el mes actual.
                                                </div>
                                            {% else %}
                                            <div class="d-flex justify-content-between align-items-center mb-3">
                                                <div>
                                                    {% if not datos.cursoActivo|default(true) %}
                                                        <div class="alert alert-warning mb-0 py-2">
                                                            <small><i class="bi bi-exclamation-triangle"></i> El alumno ya no está inscrito en este curso, pero tiene deudas pendientes.</small>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                <form method="post" action="{{ path('app_alumno_cancelar_deudas_curso', {'id': alumno.id, 'cursoId': cursoId}) }}" onsubmit="return confirm('¿Está seguro de que desea cancelar todas las deudas pendientes de este curso? Esta acción no se puede deshacer.');" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancelar-deudas-curso' ~ cursoId) }}">
                                                    <input type="hidden" name="solo_futuras" value="0">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-x-circle"></i> Cancelar todas las deudas
                                                    </button>
                                                </form>
                                            </div>
                                            
                                            <table class="table table-striped table-hover">
                                                <thead>
                                                    <tr>
                                                        <th>Periodo</th>
                                                        <th>Monto</th>
                                                        <th>Estado</th>
                                                        <th style="width: 120px;">Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {% for deuda in datos.deudas %}
                                                        <tr>
                                                            <td>
                                                                {% set meses = {
                                                                    1: 'Enero',
                                                                    2: 'Febrero',
                                                                    3: 'Marzo',
                                                                    4: 'Abril',
                                                                    5: 'Mayo',
                                                                    6: 'Junio',
                                                                    7: 'Julio',
                                                                    8: 'Agosto',
                                                                    9: 'Septiembre',
                                                                    10: 'Octubre',
                                                                    11: 'Noviembre',
                                                                    12: 'Diciembre'
                                                                } %}
                                                                {{ meses[deuda.mes] }} {{ deuda.ano }}
                                                            </td>
                                                            <td>
                                                                {% set monto_total = deuda.monto + (deuda.interes ?? 0) %}
                                                                ${{ monto_total|number_format(2, ',', '.') }}
                                                                {% if deuda.interes > 0 %}
                                                                    <br><small class="text-muted">(Base: ${{ deuda.monto|number_format(2, ',', '.') }} + Interés: ${{ deuda.interes|number_format(2, ',', '.') }})</small>
                                                                {% endif %}
                                                            </td>
                                                            <td>
                                                                {% if deuda.ano < anoActualInstituto or (deuda.ano == anoActualInstituto and deuda.mes < mesActualInstituto) %}
                                                                    <span class="badge bg-danger">Vencida</span>
                                                                {% elseif deuda.ano == anoActualInstituto and deuda.mes == mesActualInstituto %}
                                                                    {% if diaActualInstituto >= primerDiaVencimiento %}
                                                                        <span class="badge bg-danger">Vencida</span>
                                                                    {% else %}
                                                                        <span class="badge bg-primary">Mes actual - Pendiente de pago</span>
                                                                    {% endif %}
                                                                {% endif %}
                                                            </td>
                                                            <td>
                                                                {# Las cuotas de una inscripcion ya cerrada vienen de la tabla y traen id, asi
                                                                   que se pueden cobrar de a una. La pantalla general de cobro no sirve para
                                                                   ellas: arma los meses desde las inscripciones activas. #}
                                                                {% if deuda.id is defined and deuda.id %}
                                                                    <a href="{{ path('app_alumnos_pagos_por_deuda', {'id': deuda.id}) }}"
                                                                       class="btn btn-sm btn-success" title="Cobrar esta cuota">
                                                                        <i class="bi bi-cash-coin"></i> Cobrar
                                                                    </a>
                                                                {% endif %}
                                                                <form method="post" action="{{ path('app_alumno_cancelar_deuda', {'id': alumno.id, 'cursoId': deuda.curso.id, 'mes': deuda.mes, 'ano': deuda.ano}) }}" onsubmit="return confirm('¿Está seguro de que desea perdonar/cancelar esta deuda?');" style="display: inline;">
                                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancelar-deuda' ~ deuda.curso.id ~ '-' ~ deuda.mes ~ '-' ~ deuda.ano) }}">
                                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Perdonar/Cancelar deuda">
                                                                        <i class="bi bi-x-circle"></i>
                                                                    </button>
                                                                </form>
                                                            </td>
                                                        </tr>
                                                    {% endfor %}
                                                </tbody>
                                            </table>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-success">
                            <p><i class="bi bi-check-circle"></i> El alumno no tiene deudas pendientes.</p>
                        </div>
                    {% endif %}
                </div>
                <div class="card-footer">
                    {{ include('components/back_button.html.twig', {
                        'default_path': path('app_alumno_index'),
                        'force_reload': true
                    }) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 