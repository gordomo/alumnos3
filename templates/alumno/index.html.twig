{% extends 'base.html.twig' %}

{% block title %}Alumno index{% endblock %}

{% block panelTitle %}
    Alumnos <a href="{{ path('app_alumno_new') }}" class="btn btn-success btn-sm">Nuevo Alumno</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-5">
            <form method="post" action="{{ path('app_alumno_index', {'activo': activo }) }}">
                <div class="input-group mb-3">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por Nombre y Apellido" value="{{ busqueda }}" aria-label="Recipient's username" aria-describedby="button-addon2">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-7">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link {% if activo == 'todos' %} active {% endif %}" aria-current="page" href="{{ path('app_alumno_index') }}">Todos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if activo == '1' %} active {% endif %}" href="{{ path('app_alumno_index', {'activo': 1}) }}">Activos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if activo == '0' %} active {% endif %}" href="{{ path('app_alumno_index', {'activo': 0}) }}">Inactivos</a>
                </li>
                {# <li class="nav-item">
                    <a class="btn btn-warning importar" href="#">
                        Importar
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                    </a>
                    <div class="excel">
                        <form action="{{ path('app_excel_import_alumnos') }}" enctype="multipart/form-data" method="POST">
                            <input type="file" id="file" name="file" accept=".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel">
                            <input type="submit">
                        </form>
                    </div>
                </li>
                <li class="nav-item">
                    {% if totalAgregados != '' %}
                        <div class="alert alert-primary" role="alert" style="padding: 0.4rem 1rem;">
                            Se agregaron {{ totalAgregados }} alumnos correctamente
                        </div>
                    {% endif %}
                </li>#}
                <li class="nav-item" >
                    <select class="form-select" aria-label="Cursos" name="cursoSelected" id="filtroCursos">
                        <option value="0">Filtrar por Cursos</option>
                        {% for curso in cursos %}
                            <option {% if cursoSelected == curso.id %} selected {% endif %} value="{{ curso.id }}">{{ curso.nombre }}</option>
                        {% endfor %}
                    </select>
                </li>
            </ul>
        </div>
        {% if alumnosQueNoGuardadamos | length > 0 %}
            <div class="col-12 alert alert-danger" role="alert" style="padding: 0.4rem 1rem; margin: 5px 10px">
                <h5>Alumnos que no pudimos agregar: </h5>
                {% for alumnoQueNoGuardadamos in alumnosQueNoGuardadamos %}
                    Nombre: {{ alumnoQueNoGuardadamos.nombre }} {{ alumnoQueNoGuardadamos.apellido }} - Email: {{ alumnoQueNoGuardadamos.email }} - DNI: {{ alumnoQueNoGuardadamos.dni }}<br>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% if total > 0 %}
        <p class="mt-3">total: {{ total }} alumnos {% if activo == '1' %}activo{% elseif activo == '0' %}inactivo{% endif %}{% if (total > 1 and activo != 'todos') %}s{% endif %}</p>
    {% endif %}
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a href="{{ path('app_alumno_index', {'sort': 'apellido', 'order': sort == 'apellido' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                        Apellido
                        <i class="bi bi-arrow-{{ sort == 'apellido' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>
                    <a href="{{ path('app_alumno_index', {'sort': 'nombre', 'order': sort == 'nombre' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                        Nombre
                        <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>Celular</th>
                <th>Email</th>
                <th>Contacto de Emergencia</th>
                <th>Cursos</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for alumno in alumnos %}
            <tr class="{% if (alumno.activo) %}activo{% else %}inactivo{% endif %}">
                <td>{{ alumno.apellido }}</td>
                <td>{{ alumno.nombre }}</td>
                <td>{{ alumno.celular }}</td>
                <td>{{ alumno.email }}</td>
                <td>{{ alumno.contactoEmergencia }}</td>
                <td>
                    {% for curso in alumno.curso %}
                        {{ curso.nombre }}
                        {% if not loop.last %}
                            /
                        {% endif %}
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('app_alumno_show', {'id': alumno.id}) }}" style="min-width: auto;width: 45px;" class="btn btn-sm btn-outline-primary" title="Ver" data-toggle="tooltip" data-placement="left">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('app_alumno_edit', {'id': alumno.id}) }}" style="min-width: auto;width: 45px;" class="btn btn-sm btn-outline-secondary" title="Editar" data-toggle="tooltip" data-placement="top">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-info" style="min-width: auto;width: 45px;" title="Gestionar Cursos" data-toggle="tooltip" data-placement="top" data-bs-toggle="modal" data-bs-target="#cursosModal{{ alumno.id }}">
                        <i class="bi bi-book"></i>
                    </button>
                    {% if (alumno.activo) %}
                        <a href="{{ path('app_alumnos_pagos_new', {'id': alumno.id}) }}" style="min-width: auto;width: 45px;" class="btn btn-sm btn-success" title="Registrar Pago" data-toggle="tooltip" data-placement="top">
                            <i class="bi bi-cash"></i>
                        </a>
                    {% endif %}
                    <a href="{{ path('app_alumnos_pagos_index', {'alumno': alumno.id}) }}" style="min-width: auto;width: 45px;" class="btn btn-sm btn-outline-success" title="Ver Pagos" data-toggle="tooltip" data-placement="top">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('app_alumno_deudas', {'id': alumno.id}) }}" style="min-width: auto;width: 45px;" class="btn btn-sm btn-outline-warning" title="Gestionar Deudas" data-toggle="tooltip" data-placement="top">
                        <i class="bi bi-cash-coin"></i>
                    </a>
                    {{ alumno.tieneDeudasVencidas() and alumno.activo ? '<i class="bi bi-bell p-2" style="color: red" data-toggle="tooltip" title="Tiene deudas vencidas"></i>' : '' }}
                </td>
            </tr>
            {{ include('alumno/_cursos_modal.html.twig') }}
        {% else %}
            <tr>
                <td colspan="23">No se encontraron registros</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        <tr>
            <td colspan="8">
                {{ knp_pagination_render(alumnos) }}
            </td>
        </tr>
        </tfoot>
    </table>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $('.importar').click(
            function(e) {
                e.preventDefault();
                $('.importar').hide();
                $('.excel').show();
            }
        );

        $('#filtroCursos').change(
            () => {
                location.href = "{{ path('app_alumno_index', {'activo': activo}) }}&cursoSelected=" + $('#filtroCursos').val();
            }
        );
    </script>
{% endblock %}