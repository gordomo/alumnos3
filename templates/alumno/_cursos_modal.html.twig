<!-- Modal para gestionar cursos -->
<div class="modal fade" id="cursosModal{{ alumno.id }}" tabindex="-1" aria-labelledby="cursosModalLabel{{ alumno.id }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cursosModalLabel{{ alumno.id }}">Gestionar Cursos - {{ alumno.nombre }} {{ alumno.apellido }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form class="curso-form" data-alumno-id="{{ alumno.id }}">
                <div class="modal-body">
                    {% for curso in cursos %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="cursos[]" value="{{ curso.id }}" id="curso{{ curso.id }}_{{ alumno.id }}"
                                {% if alumno.curso.contains(curso) %}checked{% endif %}>
                            <label class="form-check-label" for="curso{{ curso.id }}_{{ alumno.id }}">
                                {{ curso.nombre }}
                            </label>
                        </div>
                    {% endfor %}

                    <hr class="my-3 mori">
                    <div class="form-check" id="comenzarDeudaContainer_{{ alumno.id }}">
                        <input class="form-check-input" type="checkbox" name="comenzar_deuda_proximo_mes" id="comenzarDeudaProximoMes_{{ alumno.id }}">
                        <label class="form-check-label fw-semibold" for="comenzarDeudaProximoMes_{{ alumno.id }}">
                            Comenzar deuda a partir del próximo mes
                        </label>
                        <small class="text-muted d-block mt-1">
                            Si no se marca, la deuda comienza en el mes corriente. Si se marca, comienza el próximo mes.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div> 