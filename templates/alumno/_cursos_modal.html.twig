<!-- Modal para gestionar cursos -->
<div class="modal fade" id="cursosModal{{ alumno.id }}" tabindex="-1" aria-labelledby="cursosModalLabel{{ alumno.id }}" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cursosModalLabel{{ alumno.id }}">Gestionar Cursos - {{ alumno.nombre }} {{ alumno.apellido }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form class="curso-form" data-alumno-id="{{ alumno.id }}">
                <div class="modal-body">
                    {% for curso in cursos %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="cursos[]" value="{{ curso.id }}" id="curso{{ curso.id }}_{{ alumno.id }}"
                                {% if alumno.curso.contains(curso) %}checked{% endif %}>
                            <label class="form-check-label" for="curso{{ curso.id }}_{{ alumno.id }}">
                                {{ curso.nombre }}
                            </label>
                        </div>
                    {% endfor %}

                    <hr class="my-3">
                    <div id="comenzarDeudaContainer_{{ alumno.id }}" style="display: none;">
                        <label class="form-label fw-semibold">¿Desde cuándo generar deudas?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="modo_generacion_deuda" value="inscripcion" id="modoInscripcion_{{ alumno.id }}" checked>
                            <label class="form-check-label" for="modoInscripcion_{{ alumno.id }}">
                                Desde el mes de inscripción
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="modo_generacion_deuda" value="proximo_mes" id="modoProximoMes_{{ alumno.id }}">
                            <label class="form-check-label" for="modoProximoMes_{{ alumno.id }}">
                                Desde el mes siguiente a la inscripción
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="modo_generacion_deuda" value="inicio_curso" id="modoInicioCurso_{{ alumno.id }}">
                            <label class="form-check-label" for="modoInicioCurso_{{ alumno.id }}">
                                Desde el inicio del curso
                            </label>
                        </div>
                        <small class="text-muted d-block mt-2">
                            Selecciona desde qué momento se deben generar las deudas para los cursos nuevos.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div> 