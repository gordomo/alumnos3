{% extends 'base.html.twig' %}

{% block title %}Editar Alumno{% endblock %}

{% block panelTitle %}
    Editar Alumno
{% endblock %}

{% block body %}
<div class="container mt-3 d-flex justify-content-center">
    <div class="col-lg-12">
        
        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('alumno/_form.html.twig', {'button_label': 'Guardar'}) }}
            </div>
        </div>
        <div class="mt-3 text-center">
            {{ include('alumno/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $('.predictivo').chosen();
        $('#alumno_hermanos').val([{{ hermanos|join(', ') }}]);
        $('#alumno_hermanos').trigger("chosen:updated");
    </script>
{% endblock %}