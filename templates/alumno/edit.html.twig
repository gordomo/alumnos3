{% extends 'base.html.twig' %}

{% block title %}Editar Alumno{% endblock %}

{% block panelTitle %}
    Editar Alumno
{% endblock %}

{% block body %}
<style>
    /* Hacer que el contenido ocupe todo el ancho disponible */
    .container {
        max-width: 100% !important;
        width: 100% !important;
        padding-left: 1.5rem !important;
        padding-right: 1.5rem !important;
    }
    
    /* Asegurar que las cards ocupen todo el ancho */
    .card {
        width: 100% !important;
        max-width: 100% !important;
    }
</style>
<div class="container-fluid px-4 mt-4 mb-4" style="width: 100%; max-width: 100%;">
    <div class="row">
        <div class="col-12">
                {{ include('alumno/_form.html.twig', {'button_label': 'Guardar'}) }}
            </div>
        </div>
</div>

<!-- Modal de advertencia de eliminación -->
{% if deleteWarning is defined and deleteWarning %}
{% set sePuedeEliminar = deleteWarning.sePuedeEliminar is defined ? deleteWarning.sePuedeEliminar : true %}

{# Singular y plural: "1 inscripciones" se lee mal. #}
{% set etiquetas = {
    'inscripciones': ['inscripción', 'inscripciones'],
    'asistencias': ['asistencia', 'asistencias'],
    'calificaciones': ['nota', 'notas'],
    'deudas': ['cuota', 'cuotas'],
    'pagos': ['pago', 'pagos'],
    'saldosFavor': ['saldo a favor', 'saldos a favor'],
    'emails': ['email enviado', 'emails enviados']
} %}

{# Un renglón con lo que tiene cargado, en lugar de una tabla de siete filas: para decidir
   alcanza con saber que hay datos y cuántos. #}
{% set detalle = [] %}
{% for clave, formas in etiquetas %}
    {% set cantidad = deleteWarning.resumen[clave]|default(0) %}
    {% if cantidad > 0 %}
        {% set detalle = detalle|merge([cantidad ~ ' ' ~ (cantidad == 1 ? formas[0] : formas[1])]) %}
    {% endif %}
{% endfor %}

{# modal-dialog-scrollable: el cuerpo scrollea solo y el pie con los botones queda siempre a
   la vista. Sin eso, y con el modal-body que faltaba, el panel crecía más alto que la pantalla
   y los botones quedaban fuera. #}
<div class="modal fade show" id="deleteWarningModal" tabindex="-1" aria-labelledby="deleteWarningModalLabel" aria-hidden="false" style="display: block;">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header {{ sePuedeEliminar ? 'bg-danger text-white' : 'bg-warning text-dark' }}">
                <h5 class="modal-title" id="deleteWarningModalLabel">
                    {% if sePuedeEliminar %}
                        <i class="bi bi-trash me-2"></i>¿Borrar a {{ alumno.nombreApellido }}?
                    {% else %}
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>No se puede borrar a {{ alumno.nombreApellido }}
                    {% endif %}
                </h5>
                <button type="button" class="btn-close {{ sePuedeEliminar ? 'btn-close-white' : '' }}"
                        aria-label="Cerrar" onclick="window.location.reload();"></button>
            </div>

            <div class="modal-body">
                {% if sePuedeEliminar %}
                    <p class="mb-2">
                        Se borra junto con el alumno y <strong>no se puede recuperar</strong>.
                    </p>
                    {% if detalle is not empty %}
                        <p class="mb-3">Tiene cargado: {{ detalle|join(' · ') }}.</p>
                    {% endif %}
                    <p class="small text-muted mb-0">
                        Si se fue del instituto, conviene <strong>darlo de baja</strong>: sale de los
                        listados igual, pero se conserva su historial.
                    </p>
                {% else %}
                    <p class="mb-3">
                        {% set pagos = deleteWarning.resumen.pagos %}
                        Tiene <strong>{{ pagos }} {{ pagos == 1 ? 'pago registrado' : 'pagos registrados' }}</strong>.
                        Borrarlo cambiaría hacia atrás lo cobrado en meses que ya cerraste.
                    </p>

                    <div class="alert alert-info mb-3">
                        <strong>Dale de baja en su lugar.</strong>
                        Sale de los listados y del dashboard, deja de generársele deuda y no recibe más
                        recordatorios. Se conserva todo: pagos, notas, asistencias e historial. Si tiene
                        deuda, se le sigue cobrando desde Pagos, y si vuelve lo reactivás sin perder nada.
                    </div>

                    {% if deleteWarning.cursos|length > 0 %}
                        <p class="small mb-1">
                            Se le da de baja de:
                            {% for curso in deleteWarning.cursos %}
                                <span class="badge bg-secondary">{{ curso }}</span>
                            {% endfor %}
                        </p>
                    {% endif %}

                    {% if detalle is not empty %}
                        <p class="small text-muted mb-0">Se conserva: {{ detalle|join(' · ') }}.</p>
                    {% endif %}
                {% endif %}
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="window.location.reload();">
                    Cancelar
                </button>

                <form method="post" action="{{ path('app_alumno_desactivar', {'id': alumno.id}) }}" style="display: inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('desactivar' ~ alumno.id) }}">
                    <input type="hidden" name="motivo" value="Baja administrativa">
                    <button type="submit" class="btn {{ sePuedeEliminar ? 'btn-outline-secondary' : 'btn-warning' }}"
                            onclick="window.showLoading();">
                        <i class="bi bi-box-arrow-right"></i> Dar de baja
                    </button>
                </form>

                {% if sePuedeEliminar %}
                    <form method="post" action="{{ path('app_alumno_delete', {'id': alumno.id}) }}" style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ alumno.id) }}">
                        <input type="hidden" name="force_delete" value="1">
                        <button type="submit" class="btn btn-danger" onclick="window.showLoading();">
                            <i class="bi bi-trash"></i> Borrar definitivamente
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // Clic fuera del panel: se recarga para limpiar la advertencia de la sesión.
    document.getElementById('deleteWarningModal').addEventListener('click', function (e) {
        if (e.target === this) {
            window.location.reload();
        }
    });
});
</script>
{% endif %}
{% endblock %}
