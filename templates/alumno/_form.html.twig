{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
<div class="form-group">
    <div class="row g-3 mb-3">
        {% for field in [
            {form: form.nombre, label: 'Nombre'},
            {form: form.apellido, label: 'Apellido'},
            {form: form.f_nac, label: 'Fecha de Nacimiento'},
            {form: form.l_nac, label: 'Lugar de Nacimiento'},
            {form: form.telefono_fijo, label: 'Teléfono fijo'},
            {form: form.email, label: 'Email'},
            {form: form.dni, label: 'DNI'},
            {form: form.celular, label: 'Celular'},
            {form: form.n_tutor, label: 'Nombre Tutor'},
            {form: form.t_tutor, label: 'Teléfono Tutor'},
            {form: form.contacto_emergencia, label: 'Contacto de Emergencia'},
            {form: form.corre_tutor, label: 'Email Tutor'},
            {form: form.dni_tutor, label: 'DNI Tutor'},
            {form: form.escuela, label: 'Escuela'},
            {form: form.extras, label: 'Extras'},
            {form: form.g_sanguineo, label: 'Grupo Sanguineo'},
            {form: form.enfermedad, label: 'Enfermedad'},
            {form: form.alergico, label: 'Alergico'},
            {form: form.medicacion, label: 'Medicacion'},
            {form: form.como_conociste, label: 'Como nos Conociste'},
            {form: form.activo, label: 'Activo'},
            {form: form.hermanos, label: 'Hermanos'},
            {form: form.curso, label: 'Curso'}
        ] %}
            <div class="col-md-4">
                {{ form_label(field.form, field.label, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(field.form, {'attr': {'class': 'form-control'}}) }}
                <small class="form-error text-danger">
                    {{ form_errors(field.form) }}
                </small>
            </div>
        {% endfor %}
    </div>
    <div class="row mb-3">
        <div class="col text-end">
            <a class="btn btn-secondary" href="{{ path('app_alumno_index') }}">Volver</a>
            <button class="btn btn-success">{{ button_label|default('Guardar') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}