{# Relaciones y Cursos #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #d1e7dd; border-bottom: 2px solid #198754;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-people" style="color: #198754;"></i> Relaciones y Cursos
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.hermanos.vars.id }}" class="form-label fw-semibold text-dark">
                        Hermanos
                    </label>
                    <small class="text-muted d-block mb-2">Puede seleccionar múltiples hermanos. Use Ctrl+Click (o Cmd+Click en Mac) para seleccionar varios.</small>
                    {{ form_widget(form.hermanos, {'attr': {'class': 'form-control chosen-select'}}) }}
                    {{ form_errors(form.hermanos) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.curso.vars.id }}" class="form-label fw-semibold text-dark">
                        Cursos
                    </label>
                    <small class="text-muted d-block mb-2">Puede seleccionar múltiples cursos. Use Ctrl+Click (o Cmd+Click en Mac) para seleccionar varios.</small>
                    {{ form_widget(form.curso, {'attr': {'class': 'form-control chosen-select'}}) }}
                    {{ form_errors(form.curso) }}
                </div>
            </div>
        </div>

        <div class="row mb-1">
            <div class="col-md-12">
                <div class="form-check mt-2">
                    {{ form_widget(form.comenzarDeudaProximoMes, {'attr': {'class': 'form-check-input'}}) }}
                    <label class="form-check-label fw-semibold text-dark" for="{{ form.comenzarDeudaProximoMes.vars.id }}">
                        Comenzar deuda a partir del próximo mes
                    </label>
                </div>
                <small class="text-muted d-block mt-1">
                    Si no se marca, la deuda comienza en el mes corriente. Si se marca, comienza el próximo mes.
                </small>
                {{ form_errors(form.comenzarDeudaProximoMes) }}
            </div>
        </div>
    </div>
</div>

{# Botones de Acción #}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2 border-top">
    <div class="d-flex gap-2">
        {{ include('components/back_button.html.twig', {'default_path': path('app_alumno_index')}) }}
        <button type="submit" class="btn btn-success">
            <i class="bi bi-save"></i> {{ button_label|default('Guardar') }}
        </button>
    </div>
    {% if alumno is defined and alumno.id is defined and alumno.id %}
        <div>
            {{ include('alumno/_delete_form.html.twig') }}
        </div>
    {% endif %}
</div>

{{ form_end(form) }}
