{% extends 'base.html.twig' %}

{% block title %}Detalle del Alumno{% endblock %}

{% block panelTitle %}
    Detalle del Alumno
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Información Personal</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">Nombre</th>
                                <td>{{ alumno.nombre }}</td>
                            </tr>
                            <tr>
                                <th>Apellido</th>
                                <td>{{ alumno.apellido }}</td>
                            </tr>
                            <tr>
                                <th>DNI</th>
                                <td>{{ alumno.dni }}</td>
                            </tr>
                            <tr>
                                <th>Fecha de Nacimiento</th>
                                <td>{{ alumno.fNac ? alumno.fNac|date(app_date_format|default('d/m/Y')) : '' }}</td>
                            </tr>
                            <tr>
                                <th>Lugar de Nacimiento</th>
                                <td>{{ alumno.lNac }}</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>{{ alumno.email }}</td>
                            </tr>
                            <tr>
                                <th>Teléfono Fijo</th>
                                <td>{{ alumno.telefonoFijo }}</td>
                            </tr>
                            <tr>
                                <th>Celular</th>
                                <td>{{ alumno.celular }}</td>
                            </tr>
                            <tr>
                                <th>Curso</th>
                                <td>
                                    {% for curso in alumno.curso %}
                                        {{ curso.nombre }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">Grupo Sanguíneo</th>
                                <td>{{ alumno.gSanguineo }}</td>
                            </tr>
                            <tr>
                                <th>Alergias</th>
                                <td>{{ alumno.alergico }}</td>
                            </tr>
                            <tr>
                                <th>Enfermedades</th>
                                <td>{{ alumno.enfermedad }}</td>
                            </tr>
                            <tr>
                                <th>Medicación</th>
                                <td>{{ alumno.medicacion }}</td>
                            </tr>
                            <tr>
                                <th>Escuela</th>
                                <td>{{ alumno.escuela }}</td>
                            </tr>
                            <tr>
                                <th>Hermanos</th>
                                <td>
                                    {% if hermanos is not empty %}
                                        {% for key, hermano in hermanos %}
                                            {{ hermano.nombre }} {{ hermano.apellido }}{% if hermanos|length > 1 and key+1 < hermanos|length %}, {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        No tiene hermanos registrados
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Contacto de Emergencia</th>
                                <td>{{ alumno.contactoEmergencia }}</td>
                            </tr>
                            <tr>
                                <th>¿Cómo nos conoció?</th>
                                <td>{{ alumno.comoConociste }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Información del Tutor</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">Nombre del Tutor</th>
                                <td>{{ alumno.nTutor }}</td>
                            </tr>
                            <tr>
                                <th>Teléfono del Tutor</th>
                                <td>{{ alumno.tTutor }}</td>
                            </tr>
                            <tr>
                                <th>Email del Tutor</th>
                                <td>{{ alumno.correTutor }}</td>
                            </tr>
                            <tr>
                                <th>DNI del Tutor</th>
                                <td>{{ alumno.dniTutor }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Acciones</h6>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap align-items-start">
                {{ include('components/back_button.html.twig', {
                    'default_path': path('app_alumno_index'),
                    'force_reload': true
                }) }}
                <a href="{{ path('app_alumno_edit', {'id': alumno.id}) }}" class="btn btn-primary" style="white-space: nowrap;">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a href="{{ path('app_alumno_deudas', {'id': alumno.id, 'return_url': app.request.uri}) }}" class="btn btn-warning" style="white-space: nowrap;">
                    <i class="bi bi-cash-coin"></i> Gestionar Deudas
                </a>
                <a href="{{ path('app_alumnos_pagos_new', {'id': alumno.id}) }}" class="btn btn-success" style="white-space: nowrap;">
                    <i class="bi bi-journal-check"></i> Registrar Pago
                </a>
                
                <a href="{{ path('app_email_log_alumno', {'id': alumno.id}) }}" class="btn btn-secondary" style="white-space: nowrap;">
                    <i class="bi bi-envelope-check"></i> Ver Emails Enviados
                </a>
                
                {% if alumno.email %}
                {% set horasDesdeUltimoRecordatorio = null %}
                {% set puedeEnviar = true %}
                {% if ultimoRecordatorio %}
                    {% set ahora = date() %}
                    {% set diferencia = ahora.diff(ultimoRecordatorio.fechaEnvio) %}
                    {% set horasDesdeUltimoRecordatorio = (diferencia.days * 24) + diferencia.h %}
                    {% set puedeEnviar = horasDesdeUltimoRecordatorio >= 48 %}
                {% endif %}
                
                <div style="display: inline-block; white-space: nowrap;">
                    <form method="post" action="{{ path('app_email_send_recordatorio', {'id': alumno.id}) }}" style="display: inline;" onsubmit="return confirm('¿Enviar recordatorio de deudas pendientes a {{ alumno.email }}?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('send_recordatorio' ~ alumno.id) }}">
                        <button type="submit" class="btn btn-info" {% if not puedeEnviar %}disabled{% endif %} style="white-space: nowrap;">
                            <i class="bi bi-envelope"></i> Enviar Recordatorio
                        </button>
                    </form>
                    {% if ultimoRecordatorio %}
                    <div class="mt-2">
                        <small class="text-muted">
                            {% if ultimoRecordatorio.estado == 'enviado' %}
                                <i class="bi bi-check-circle text-success"></i> Último envío: {{ ultimoRecordatorio.fechaEnvio|date('d/m/Y H:i') }}
                                {% if not puedeEnviar %}
                                    <br><span class="text-warning">⏳ Espera {{ 48 - horasDesdeUltimoRecordatorio }} horas para reenviar</span>
                                {% endif %}
                            {% else %}
                                <i class="bi bi-x-circle text-danger"></i> Último intento falló: {{ ultimoRecordatorio.fechaEnvio|date('d/m/Y H:i') }}
                            {% endif %}
                        </small>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                
                {{ include('alumno/_delete_form.html.twig') }}
            </div>
        </div>
    </div>

    {# Historial de Cursos #}
    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-info text-white">
            <h6 class="m-0 font-weight-bold"><i class="bi bi-clock-history"></i> Historial de Cursos</h6>
        </div>
        <div class="card-body">
            {% set historicos = alumno.cursosHistoricos|sort((a, b) => b.fechaAlta <=> a.fechaAlta) %}
            {% if historicos|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th>Precio Mensual</th>
                                <th>Período del Curso</th>
                                <th>Fecha de Inscripción</th>
                                <th>Fecha de Baja</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for historico in historicos %}
                                <tr>
                                    <td>
                                        <strong>{{ historico.nombreCurso ?? historico.curso.nombre }}</strong>
                                        {% if historico.nombreCurso and historico.nombreCurso != historico.curso.nombre %}
                                            <br><small class="text-muted">(Ahora: {{ historico.curso.nombre }})</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        ${{ (historico.precioMensual ?? historico.curso.precio)|number_format(2, ',', '.') }}
                                        {% if historico.precioMensual and historico.precioMensual != historico.curso.precio %}
                                            <br><small class="text-muted">(Ahora: ${{ historico.curso.precio|number_format(2, ',', '.') }})</small>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% set fecha_inicio = historico.fechaInicio ?? historico.curso.fechaInicio %}
                                        {% set fecha_fin = historico.fechaFin ?? historico.curso.fechaFin %}
                                        {{ fecha_inicio|date(app_date_format|default('d/m/Y')) }} - {{ fecha_fin|date(app_date_format|default('d/m/Y')) }}
                                    </td>
                                    <td>{{ historico.fechaAlta|date(app_date_format|default('d/m/Y')) }}</td>
                                    <td>
                                        {% if historico.fechaBaja %}
                                            {{ historico.fechaBaja|date(app_date_format|default('d/m/Y')) }}
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if historico.activo %}
                                            <span class="badge bg-success">Cursando</span>
                                        {% elseif historico.motivoBaja == 'baja_administrativa' %}
                                            <span class="badge bg-warning text-dark">Baja administrativa</span>
                                        {% elseif historico.motivoBaja == 'finalizado' %}
                                            <span class="badge bg-primary">Finalizado</span>
                                        {% elseif historico.motivoBaja == 'no_finalizado' %}
                                            <span class="badge bg-danger">No finalizado</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactivo</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3">
                    <i class="bi bi-info-circle"></i> 
                    <strong>Nota:</strong> Este historial preserva los datos del curso al momento de la inscripción. 
                    Si ves diferencias entre el precio/nombre original y el actual, es porque el curso fue modificado después de la inscripción.
                </div>
            {% else %}
                <p class="text-muted">El alumno no tiene historial de cursos registrado.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
