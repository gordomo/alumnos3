{# templates/profesor/_form.html.twig #}
<div style="max-width: 100%; width: 100%;">
{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

{# Información sobre creación de usuario #}
<div class="alert alert-info border-info shadow-sm mb-4" role="alert">
    <div class="d-flex align-items-start">
        <i class="bi bi-info-circle-fill me-3" style="font-size: 1.5rem;"></i>
        <div>
            <h5 class="alert-heading mb-2">Creación de Usuario</h5>
            <p class="mb-0">
                Al crear este profesor, se generará automáticamente un usuario para acceder al sistema.
                Para obtener la contraseña, el profesor deberá utilizar la funcionalidad 
                <strong>"¿Olvidó su contraseña?"</strong> en la página de inicio de sesión.
            </p>
        </div>
    </div>
</div>

{# Información Personal #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #f8f9fa; border-bottom: 2px solid #dee2e6;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-person" style="color: #0d6efd;"></i> Información Personal
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="mb-3">
                    <label for="{{ form.nombre.vars.id }}" class="form-label fw-semibold text-dark">
                        Nombre <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label for="{{ form.apellido.vars.id }}" class="form-label fw-semibold text-dark">
                        Apellido <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.apellido, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.apellido) }}
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label for="{{ form.dni.vars.id }}" class="form-label fw-semibold text-dark">
                        DNI <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.dni, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dni) }}
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.email.vars.id }}" class="form-label fw-semibold text-dark">
                        Email <span class="text-danger">*</span>
                    </label>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.tel.vars.id }}" class="form-label fw-semibold text-dark">
                        Teléfono
                    </label>
                    {{ form_widget(form.tel, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.tel) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Información Laboral #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #e7f1ff; border-bottom: 2px solid #0d6efd;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-briefcase" style="color: #0d6efd;"></i> Información Laboral
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.precioHora.vars.id }}" class="form-label fw-semibold text-dark">
                        Precio/Hora
                    </label>
                    {{ form_widget(form.precioHora, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.precioHora) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label for="{{ form.viatico.vars.id }}" class="form-label fw-semibold text-dark">
                        Viático
                    </label>
                    {{ form_widget(form.viatico, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.viatico) }}
                </div>
            </div>
        </div>
    </div>
</div>

{# Cursos Asignados #}
<div class="card mb-4 shadow-sm">
    <div class="card-header" style="background-color: #d1e7dd; border-bottom: 2px solid #198754;">
        <h4 class="mb-0 text-dark">
            <i class="bi bi-book" style="color: #198754;"></i> Cursos Asignados
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="mb-2">
                    <label for="{{ form.cursos.vars.id }}" class="form-label fw-semibold text-dark">
                        Cursos
                    </label>
                    <small class="text-muted d-block mb-2">Puede seleccionar múltiples cursos. Use Ctrl+Click (o Cmd+Click en Mac) para seleccionar varios.</small>
                    {{ form_widget(form.cursos, {'attr': {'class': 'form-control chosen-select'}}) }}
                    {{ form_errors(form.cursos) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% if mostrar_confirmacion is defined and mostrar_confirmacion %}
    <div class="alert alert-warning mt-3">
        <p><strong>Atención:</strong> Algunos cursos ya han comenzado y tienen registros de asistencia para este profesor.</p>
        <p>Si cambia los cursos asignados, podría afectar los registros de asistencia existentes.</p>
        <div class="form-check mt-3">
            <input type="checkbox" class="form-check-input" id="confirmar_cambio_cursos" name="confirmar_cambio_cursos" value="1" required>
            <label class="form-check-label" for="confirmar_cambio_cursos">
                Confirmo que deseo continuar con los cambios en los cursos asignados
            </label>
        </div>
    </div>
{% endif %}

{# Botones de Acción #}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-2">
    <div class="d-flex gap-2">
        {{ include('components/back_button.html.twig', {'default_path': path('app_profesor_index')}) }}
        <button type="submit" class="btn btn-success">
            <i class="bi bi-save"></i> {{ button_label|default('Guardar') }}
        </button>
    </div>
    {% if profesor is defined and profesor.id is defined and profesor.id %}
        <div>
            {{ include('profesor/_delete_form.html.twig') }}
        </div>
    {% endif %}
</div>

{{ form_end(form) }}

<style>
    /* Estilos para mejorar la visualización del campo de cursos con Chosen */
    #{{ form.cursos.vars.id }}_chosen {
        width: 100% !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices {
        height: 200px !important;
        min-height: 200px !important;
        max-height: 200px !important;
        overflow-y: auto;
        overflow-x: visible !important;
        padding: 8px;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        background-color: #fff;
        display: flex !important;
        flex-wrap: wrap !important;
        width: 100% !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-choice {
        margin: 4px 4px 4px 0 !important;
        padding: 6px 25px 6px 10px !important;
        background-color: #0d6efd !important;
        color: #fff !important;
        border: none !important;
        border-radius: 0.375rem !important;
        font-size: 0.875rem !important;
        line-height: 1.4 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        display: inline-flex !important;
        align-items: center !important;
        position: relative !important;
        max-width: 300px !important;
        max-height: 70px !important;
        width: auto !important;
        min-width: 80px;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-choice span {
        color: #fff !important;
        display: inline-block !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        max-width: 250px !important;
        width: auto !important;
        padding-right: 5px;
        line-height: 1.4;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close {
        position: absolute !important;
        top: 50% !important;
        right: 8px !important;
        transform: translateY(-50%) !important;
        color: #fff !important;
        opacity: 1 !important;
        width: 16px !important;
        height: 16px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: rgba(255, 255, 255, 0.2) !important;
        border-radius: 50% !important;
        cursor: pointer !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:hover {
        background-color: rgba(255, 255, 255, 0.4) !important;
        color: #fff !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-choice .search-choice-close:before {
        content: "×" !important;
        font-size: 18px !important;
        line-height: 1 !important;
        color: #fff !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-drop {
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 0.375rem 0.375rem;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-results {
        max-height: 300px;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-results li.highlighted {
        background-color: #0d6efd;
        color: #fff;
    }
    
    /* Asegurar que el input de búsqueda sea visible */
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-field {
        flex: 1 1 auto !important;
        min-width: 200px !important;
    }
    
    #{{ form.cursos.vars.id }}_chosen .chosen-choices li.search-field input[type="text"] {
        color: #212529 !important;
        height: auto !important;
        min-height: 30px;
        width: 100% !important;
    }
</style>

<script>
$(document).ready(function() {
    const cursosSelectId = '{{ form.cursos.vars.id }}';
    const cursosSelect = $('#' + cursosSelectId);
    
    if (cursosSelect.length && $.fn.chosen) {
        // Función para asegurar que los textos se muestren correctamente
        function actualizarTextosCursos() {
            const chosenContainer = $('#' + cursosSelectId + '_chosen');
            if (chosenContainer.length) {
                // Obtener todas las opciones seleccionadas del select original
                const selectedOptions = cursosSelect.find('option:selected');
                
                // Obtener todos los tags de cursos seleccionados en Chosen
                const choiceElements = chosenContainer.find('.chosen-choices li.search-choice');
                
                choiceElements.each(function(index) {
                    const choiceElement = $(this);
                    const span = choiceElement.find('span');
                    const choiceValue = choiceElement.attr('data-option-array-index');
                    
                    // Asegurar que el span sea visible y tenga el color correcto
                    span.css({
                        'color': '#fff !important',
                        'display': 'inline-block !important',
                        'visibility': 'visible !important',
                        'opacity': '1 !important',
                        'white-space': 'normal !important',
                        'word-wrap': 'break-word !important',
                        'overflow': 'visible !important',
                        'text-overflow': 'clip !important',
                        'max-width': 'none !important',
                        'width': 'auto !important'
                    });
                    
                    // Obtener el texto de la opción correspondiente
                    let optionText = '';
                    if (choiceValue !== undefined && cursosSelect[0].options[choiceValue]) {
                        optionText = cursosSelect[0].options[choiceValue].text;
                    } else if (selectedOptions.length > index) {
                        optionText = selectedOptions.eq(index).text();
                    }
                    
                    // Si tenemos texto y el span está vacío o tiene texto diferente, actualizarlo
                    if (optionText && (span.text().trim() !== optionText.trim() || !span.text().trim())) {
                        span.text(optionText);
                    }
                    
                    // Asegurar que el elemento padre también tenga los estilos correctos
                    choiceElement.css({
                        'max-width': 'none !important',
                        'width': 'auto !important',
                        'overflow': 'visible !important'
                    });
                });
            }
        }
        
        // Esperar a que Chosen se inicialice completamente
        cursosSelect.on('chosen:ready', function() {
            actualizarTextosCursos();
            setTimeout(actualizarTextosCursos, 200);
            setTimeout(actualizarTextosCursos, 500);
        });
        
        // Escuchar cambios en el select para actualizar los textos
        cursosSelect.on('change', function() {
            setTimeout(actualizarTextosCursos, 100);
        });
        
        // Si Chosen ya está inicializado, ejecutar directamente
        if (cursosSelect.data('chosen')) {
            setTimeout(actualizarTextosCursos, 100);
            setTimeout(actualizarTextosCursos, 300);
        }
        
        // También ejecutar después de que la página esté completamente cargada
        setTimeout(actualizarTextosCursos, 1000);
    }
});
</script>
</div>
