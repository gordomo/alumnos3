{% extends 'base.html.twig' %}

{% block title %}Profesor index{% endblock %}

{% block panelTitle %}
    Profesores <a href="{{ path('app_profesor_new') }}"class="btn btn-success btn-sm">Nuevo Profesor</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-6">
            <form method="get" action="{{ path('app_profesor_index') }}">
                <div class="input-group mb-3">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por Nombre y Apellido" aria-label="Recipient's username" aria-describedby="button-addon2">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-6">
            <a class="btn btn-primary" href="{{ path('app_profesor_index') }}">ver todos</a>
        </div>
    </div>
    <br>
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a href="{{ path('app_profesor_index', {'sort': 'apellido', 'order': sort == 'apellido' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                        Apellido
                        <i class="bi bi-arrow-{{ sort == 'apellido' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>
                    <a href="{{ path('app_profesor_index', {'sort': 'nombre', 'order': sort == 'nombre' ? (order == 'asc' ? 'desc' : 'asc') : 'asc'}) }}" class="text-decoration-none text-dark">
                        Nombre
                        <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>Telefono</th>
                <th>Cursos</th>
                <th>Precio/Hora</th>
                <th>Viatico</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for profesor in profesors %}
            <tr>
                <td>{{ profesor.apellido }}</td>
                <td>{{ profesor.nombre }}</td>
                <td>{{ profesor.tel }}</td>
                <td>
                    {% for curso in profesor.curso %}
                        <a href="{{ path('app_curso_edit', {'id': curso.id}) }}">{{ curso.nombre }}</a><br>
                    {% endfor %}
                </td>
                <td>
                    ${{ profesor.precioHora }}
                </td>
                <td>${{ profesor.viatico }}</td>
                <td>
                    <a href="{{ path('app_profesor_show', {'id': profesor.id}) }}"><i class="bi bi-eye"></i></a>
                    <a href="{{ path('app_profesor_edit', {'id': profesor.id}) }}"><i class="bi bi-pencil"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">No se encontraron registros</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <td colspan="8">
                    {{ knp_pagination_render(profesors) }}
                </td>
            </tr>
        </tfoot>
    </table>
</div>
    
{% endblock %}
