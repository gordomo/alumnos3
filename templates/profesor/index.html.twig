{% extends 'base.html.twig' %}

{% block title %}{{ Term('profesor') }} index{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>

        .profesor-toolbar {
            background: var(--ui-superficie);
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            padding: 1rem;
            margin-bottom: 1rem;
            margin-left: 0;
            margin-right: 0;
        }

        .profesor-search .form-control,
        .profesor-search .btn {
            height: 40px;
            border-radius: 10px;
        }

        .profesor-search .form-control {
            border-color: #d9e4e2;
            box-shadow: none;
        }

        .profesor-search .form-control:focus {
            border-color: var(--ui-secundario);
            box-shadow: 0 0 0 0.2rem var(--marca-tenue);
        }

        .profesor-search .btn-outline-secondary {
            border-color: #d9e4e2;
            color: #556067;
        }

        .profesor-search .btn-outline-secondary:hover {
            background: #f1f6f5;
            color: #3f4a50;
        }

        .profesor-reset-btn {
            border-radius: 10px;
            font-weight: 600;
            height: 40px;
            border-color: #d9e4e2;
            color: #556067;
            background: #fff;
        }

        .profesor-reset-btn:hover {
            background: #f1f6f5;
            color: #3f4a50;
            border-color: #cfdcda;
        }

        .profesor-panel {
            background: var(--ui-superficie);
            border: 1px solid var(--ui-borde);
            border-radius: 14px;
            box-shadow: var(--ui-sombra);
            overflow: hidden;
        }

        .profesor-table {
            margin-bottom: 0;
        }

        .profesor-table thead th {
            background: #f5f9f8;
            color: #4a5a60;
            font-weight: 700;
            font-size: 0.82rem;
            letter-spacing: 0.2px;
            border-bottom: 1px solid #dce7e4;
            padding: 0.72rem 0.6rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        .profesor-table td {
            vertical-align: middle;
            padding: 0.66rem 0.6rem;
            border-top-color: #ecf2f1;
            color: #27343a;
            font-size: 0.92rem;
        }

        .profesor-table tbody tr:hover {
            background: #fbfdfd;
        }

        .profesor-sort-link {
            color: #425257;
            text-decoration: none;
            font-weight: 700;
        }

        .profesor-sort-link:hover {
            color: #2f4348;
        }

        .curso-chip {
            display: inline-flex;
            align-items: center;
            margin: 0.1rem 0.25rem 0.1rem 0;
            padding: 0.22rem 0.5rem;
            border-radius: 999px;
            border: 1px solid #d9e4e2;
            background: #f6faf9;
            color: #425257;
            font-size: 0.78rem;
            text-decoration: none;
        }

        .curso-chip:hover {
            background: #edf6f4;
            color: #2f4348;
            text-decoration: none;
        }

        .money-value {
            font-weight: 700;
            color: #218c58;
        }

        .actions-group {
            display: inline-flex;
            gap: 0.35rem;
        }

        .actions-group .btn {
            border-radius: 8px;
            padding: 0.2rem 0.55rem;
        }

        .profesor-pagination {
            padding: 0.85rem 1rem 1rem;
            display: flex;
            justify-content: center;
            border-top: 1px solid #eef3f2;
        }

        .profesor-pagination .pagination {
            margin-bottom: 0;
        }

        .profesor-pagination .page-link {
            border-radius: 8px;
            border-color: #d9e4e2;
            color: #4b5d61;
            margin: 0 0.15rem;
        }

        .profesor-pagination .page-item.active .page-link {
            background: var(--ui-primario);
            border-color: var(--ui-primario);
            color: #fff;
        }

        .profesor-empty {
            color: #718088;
            font-style: italic;
        }

        @media (max-width: 768px) {

            .profesor-toolbar {
                padding: 0.85rem;
            }

        }
    </style>
{% endblock %}

{% block panelTitle %}
    {{ Term('profesores') }}
{% endblock %}

{% block body %}
<div class="container-fluid pagina profesor-page">
    <div class="row profesor-toolbar ui-filter-card">
        <div class="col-md-6">
            <form method="get" action="{{ path('app_profesor_index') }}" class="profesor-search">
                <div class="input-group">
                    <input name="busqueda" type="text" class="form-control" placeholder="Buscar por nombre y apellido" value="{{ busqueda ? busqueda : '' }}" aria-label="Buscar {{ term('profesor') }}">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2"><i class="bi bi-search"></i></button>
                </div>
            </form>
        </div>
        <div class="col-md-6 d-flex justify-content-md-end align-items-center mt-2 mt-md-0">
            <a class="btn btn-outline-secondary profesor-reset-btn" href="{{ path('app_profesor_index') }}">
                <i class="bi bi-arrow-clockwise me-1"></i> Ver todos
            </a>
        </div>
    </div>

    <div class="profesor-panel">
    <div class="table-responsive">
    <table class="table profesor-table">
        <thead>
            <tr>
                <th>
                    <a href="{{ path('app_profesor_index', {'sort': 'apellido', 'order': sort == 'apellido' ? (order == 'asc' ? 'desc' : 'asc') : 'asc', 'busqueda': busqueda}) }}" class="profesor-sort-link">
                        Apellido
                        <i class="bi bi-arrow-{{ sort == 'apellido' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>
                    <a href="{{ path('app_profesor_index', {'sort': 'nombre', 'order': sort == 'nombre' ? (order == 'asc' ? 'desc' : 'asc') : 'asc', 'busqueda': busqueda}) }}" class="profesor-sort-link">
                        Nombre
                        <i class="bi bi-arrow-{{ sort == 'nombre' ? (order == 'asc' ? 'up' : 'down') : 'up-down' }}"></i>
                    </a>
                </th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>{{ Term('cursos') }}</th>
                <th>Precio/Hora</th>
                <th>Viatico</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        {% for profesor in profesors %}
            <tr>
                <td>{{ profesor.apellido }}</td>
                <td>{{ profesor.nombre }}</td>
                <td>{{ profesor.tel }}</td>
                <td>{{ profesor.email }}</td>
                <td>
                    {% for curso in profesor.cursos %}
                        <a href="{{ path('app_curso_edit', {'id': curso.id}) }}" class="curso-chip">{{ curso.nombre }}</a>
                    {% else %}
                        <span class="text-muted">Sin {{ term('cursos') }}</span>
                    {% endfor %}
                </td>
                <td>
                    <span class="money-value">${{ profesor.precioHora }}</span>
                </td>
                <td><span class="money-value">${{ profesor.viatico }}</span></td>
                <td>
                    {{ include('components/action_buttons.html.twig', {
                        'show_url': path('app_profesor_show', {'id': profesor.id}),
                        'edit_url': path('app_profesor_edit', {'id': profesor.id})
                    }) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8" class="text-center profesor-empty py-4">No se encontraron registros</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    <div class="profesor-pagination">
        {{ knp_pagination_render(profesors) }}
    </div>
    </div>
</div>

<div class="pagina-acciones">
    <a href="{{ path('app_profesor_new') }}" class="pagina-boton-flotante">
        <i class="bi bi-plus-circle"></i> Nuevo {{ Term('profesor') }}
    </a>
</div>

{% endblock %}
