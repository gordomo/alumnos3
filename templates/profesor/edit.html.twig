{% extends 'base.html.twig' %}

{% block title %}Edit Profesor{% endblock %}

{% block body %}
<div class="container mt-3 d-flex justify-content-center">
    <div class="col-lg-12">
        <h1 class="mb-4 text-center">Editar Profesor</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('profesor/_form.html.twig', {'button_label': 'Guardar', 'mostrar_confirmacion': mostrar_confirmacion|default(false)}) }}
