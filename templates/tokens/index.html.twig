{% extends 'base.html.twig' %}

{% block title %}Gestión de Tokens{% endblock %}

{% block body %}
<div class="container-fluid">
    {% set now = date() %}
    {% set firstOfNextMonth = now|date_modify('first day of next month')|date('Y-m-d') %}
    {% set daysUntilReset = (firstOfNextMonth|date('U') - now|date('U')) / 86400 %}
    {% set isUrgent = daysUntilReset <= 7 %}
    {% set isVeryUrgent = daysUntilReset <= 3 %}
    
    {% if isUrgent %}
    <!-- Alerta Urgente de Reseteo (Solo si faltan 7 días o menos) -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="alert {% if isVeryUrgent %}alert-danger{% else %}alert-warning{% endif %} border-0 shadow-sm mb-0" style="{% if isVeryUrgent %}background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;{% else %}background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #212529;{% endif %}">
                <div class="d-flex align-items-center justify-content-between flex-wrap">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2" style="font-size: 1.5rem;"></i>
                        <div>
                            <strong style="font-size: 1.1rem;">
                                {% if isVeryUrgent %}
                                    ⚠️ ¡ATENCIÓN! El reseteo de tokens es en {{ daysUntilReset|round }} día{{ daysUntilReset|round != 1 ? 's' : '' }}!
                                {% else %}
                                    ⏰ El reseteo mensual de tokens es en {{ daysUntilReset|round }} día{{ daysUntilReset|round != 1 ? 's' : '' }}
                                {% endif %}
                            </strong>
                            <div class="small mt-1" style="opacity: 0.9;">
                                Todos los tokens se resetean a 0 el {{ firstOfNextMonth|date('d/m/Y') }}
                            </div>
                        </div>
                    </div>
                    {% if balance.balance > 0 %}
                        <div class="mt-2 mt-md-0">
                            <span class="badge {% if isVeryUrgent %}bg-light text-danger{% else %}bg-light text-warning{% endif %}" style="font-size: 1rem; padding: 0.5rem 1rem;">
                                <i class="bi bi-coin"></i> {{ balance.balance }} tokens disponibles
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}
    
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">
                <i class="bi bi-coin"></i> Gestión de Tokens
            </h1>
        </div>
    </div>

    <!-- Balance Actual -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted mb-3">Balance Actual</h5>
                    <h2 class="display-4 mb-0" style="color: {% if balance.balance > 100 %}green{% elseif balance.balance > 20 %}orange{% else %}red{% endif %};">
                        {{ balance.balance }}
                    </h2>
                    <p class="text-muted mt-2 mb-0">tokens disponibles</p>
                    <small class="text-muted">Actualizado: {{ balance.updatedAt|date('d/m/Y H:i') }}</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted mb-3">Consumo Semanal</h5>
                    <h2 class="display-4 mb-0 text-primary">{{ weeklyConsumption }}</h2>
                    <p class="text-muted mt-2 mb-0">tokens consumidos</p>
                    <small class="text-muted">Esta semana</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title text-muted mb-3">Consumo Mensual</h5>
                    <h2 class="display-4 mb-0 text-info">{{ monthlyConsumption }}</h2>
                    <p class="text-muted mt-2 mb-0">tokens consumidos</p>
                    <small class="text-muted">Este mes</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Consumo por Acción -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart"></i> Consumo Semanal por Acción</h5>
                </div>
                <div class="card-body">
                    {% if weeklyConsumptionByAction|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Acción</th>
                                        <th class="text-end">Tokens</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in weeklyConsumptionByAction %}
                                        <tr>
                                            <td>{{ item.action }}</td>
                                            <td class="text-end"><strong>{{ item.total }}</strong></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center mb-0">No hay consumo esta semana</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Consumo Mensual por Acción</h5>
                </div>
                <div class="card-body">
                    {% if monthlyConsumptionByAction|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Acción</th>
                                        <th class="text-end">Tokens</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in monthlyConsumptionByAction %}
                                        <tr>
                                            <td>{{ item.action }}</td>
                                            <td class="text-end"><strong>{{ item.total }}</strong></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center mb-0">No hay consumo este mes</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Costos de Acciones -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> Costos de Acciones</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {% for action in allActions %}
                            <div class="col-md-4 mb-3">
                                <div class="border rounded p-3">
                                    <h6 class="mb-1">{{ action.name }}</h6>
                                    <p class="text-muted small mb-2">{{ action.description }}</p>
                                    <span class="badge bg-primary">Costo: {{ action.cost }} token{{ action.cost != 1 ? 's' : '' }}</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transacciones Recientes -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Transacciones Recientes</h5>
                </div>
                <div class="card-body">
                    {% if recentTransactions|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Acción</th>
                                        <th>Descripción</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for transaction in recentTransactions %}
                                        <tr>
                                            <td>{{ transaction.createdAt|date('d/m/Y H:i') }}</td>
                                            <td><code>{{ transaction.action }}</code></td>
                                            <td>{{ transaction.description }}</td>
                                            <td class="text-end">
                                                <span class="badge {% if transaction.amount > 0 %}bg-success{% else %}bg-danger{% endif %}">
                                                    {% if transaction.amount > 0 %}+{% endif %}{{ transaction.amount }}
                                                </span>
                                            </td>
                                            <td class="text-end"><strong>{{ transaction.balanceAfter }}</strong></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center mb-0">No hay transacciones registradas</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Alerta de Reseteo Mensual -->
    <div class="row mt-4">
        <div class="col-12">
            {% set now = date() %}
            {% set firstOfNextMonth = now|date_modify('first day of next month')|date('Y-m-d') %}
            {% set daysUntilReset = (firstOfNextMonth|date('U') - now|date('U')) / 86400 %}
            {% set isUrgent = daysUntilReset <= 7 %}
            {% set isVeryUrgent = daysUntilReset <= 3 %}
            
            <div class="alert {% if isVeryUrgent %}alert-danger{% elseif isUrgent %}alert-warning{% else %}alert-info{% endif %} border-0 shadow-lg" style="{% if isVeryUrgent %}background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;{% elseif isUrgent %}background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); color: #212529;{% else %}background: linear-gradient(135deg, #17a2b8 0%, #138496 100%); color: white;{% endif %}">
                <div class="d-flex align-items-start">
                    <div class="flex-shrink-0 me-3">
                        <i class="bi bi-calendar-x-fill" style="font-size: 3rem; {% if not isVeryUrgent and not isUrgent %}opacity: 0.9;{% endif %}"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="alert-heading mb-3 d-flex align-items-center flex-wrap">
                            <span class="me-2">Reseteo Mensual de Tokens</span>
                            {% if isVeryUrgent %}
                                <span class="badge bg-light text-danger ms-2" style="font-size: 0.9rem; padding: 0.5rem 0.75rem; animation: pulse 2s infinite;">
                                    <i class="bi bi-exclamation-triangle-fill"></i> ¡URGENTE!
                                </span>
                            {% elseif isUrgent %}
                                <span class="badge bg-light text-warning ms-2" style="font-size: 0.9rem; padding: 0.5rem 0.75rem;">
                                    <i class="bi bi-clock-fill"></i> Próximo
                                </span>
                            {% endif %}
                        </h4>
                        
                        <div class="mb-3">
                            <p class="mb-3" style="font-size: 1.1rem; line-height: 1.6;">
                                <strong>⚠️ Importante:</strong> Todos los tokens se resetean a <strong>0</strong> el día <strong>1 de cada mes</strong>.
                            </p>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm" style="background: {% if isVeryUrgent or isUrgent %}rgba(255,255,255,0.95){% else %}rgba(255,255,255,0.2){% endif %};">
                                        <div class="card-body text-center">
                                            <i class="bi bi-calendar3" style="font-size: 1.5rem; color: {% if isVeryUrgent %}#dc3545{% elseif isUrgent %}#ff9800{% else %}#17a2b8{% endif %};"></i>
                                            <div class="mt-2">
                                                <small class="d-block text-muted">Próximo Reseteo</small>
                                                <strong style="font-size: 1.1rem; color: {% if isVeryUrgent %}#dc3545{% elseif isUrgent %}#ff9800{% else %}#17a2b8{% endif %};">{{ firstOfNextMonth|date('d/m/Y') }}</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-sm" style="background: {% if isVeryUrgent or isUrgent %}rgba(255,255,255,0.95){% else %}rgba(255,255,255,0.2){% endif %};">
                                        <div class="card-body text-center">
                                            <i class="bi bi-clock-history" style="font-size: 1.5rem; color: {% if isVeryUrgent %}#dc3545{% elseif isUrgent %}#ff9800{% else %}#17a2b8{% endif %};"></i>
                                            <div class="mt-2">
                                                <small class="d-block text-muted">Días Restantes</small>
                                                <strong style="font-size: 1.5rem; color: {% if isVeryUrgent %}#dc3545{% elseif isUrgent %}#ff9800{% else %}#17a2b8{% endif %};">
                                                    {{ daysUntilReset|round }}
                                                </strong>
                                                <small class="d-block text-muted">día{{ daysUntilReset|round != 1 ? 's' : '' }}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <hr style="border-color: {% if isVeryUrgent or isUrgent %}rgba(255,255,255,0.3){% else %}rgba(0,0,0,0.1){% endif %}; margin: 1.5rem 0;">
                        
                        <div class="d-flex align-items-start">
                            <i class="bi bi-lightbulb-fill me-2 mt-1" style="font-size: 1.2rem;"></i>
                            <div>
                                <strong style="font-size: 1.05rem;">💡 Recomendaciones:</strong>
                                <ul class="mb-0 mt-2" style="padding-left: 1.5rem; font-size: 1rem; line-height: 1.8;">
                                    <li>Usa tus tokens antes del fin de mes para aprovecharlos al máximo</li>
                                    <li>Solicita tokens cerca del día 1 para tener todo el mes para usarlos</li>
                                    {% if balance.balance > 0 %}
                                        <li><strong>Tienes {{ balance.balance }} tokens disponibles</strong> - ¡úsalos antes del reseteo!</li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <style>
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
    </style>

    <!-- Alerta de tokens bajos -->
    {% if balance.balance < 20 %}
        <div class="row mt-2">
            <div class="col-12">
                <div class="alert alert-warning">
                    <h5 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Tokens Insuficientes</h5>
                    <p class="mb-0">Tu balance de tokens está bajo. Contacta al administrador para solicitar más tokens.</p>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

