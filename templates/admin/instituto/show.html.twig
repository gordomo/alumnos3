{% extends 'base.html.twig' %}

{% block title %}
    Detalles del Instituto: {{ instituto.nombre }}
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <h2>Detalles del Instituto</h2>
            <ul class="list-group">
                <li class="list-group-item"><strong>Nombre:</strong> {{ instituto.nombre }}</li>
                <li class="list-group-item"><strong>Dirección:</strong> {{ instituto.dir }}</li>
                <li class="list-group-item"><strong>Teléfono:</strong> {{ instituto.tel }}</li>
                <li class="list-group-item"><strong>Email:</strong> {{ instituto.email }}</li>
                <li class="list-group-item"><strong>Usuarios:</strong> 
                    <ul class="list-group">
                    {% for usuario in instituto.usuarios %}
                    <li class="list-group-item">
                        {{ usuario.email }}
                    </li>
                    {% endfor %}
                    </ul>
                </li>
                <!-- Agrega más detalles según lo que tiene la entidad Instituto -->
            </ul>
        </div>
        
        <div class="col-md-6">
            <h2>Logo del Instituto</h2>
            {% if instituto.logo %}
                <img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" alt="Logo de {{ instituto.nombre }}" class="img-thumbnail">
            {% else %}
                <p>No se ha subido un logo.</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-5">
        <a href="{{ path('admin_instituto_index') }}" class="btn btn-secondary">Volver al Listado</a>
    </div>
</div>
{% endblock %}