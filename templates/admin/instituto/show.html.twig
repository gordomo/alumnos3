{% extends 'admin/_layout.html.twig' %}
{% block title %}{{ instituto.nombre }}{% endblock %}
{% block panelTitle %}{{ instituto.nombre }}{% endblock %}
{% block admin_body %}
<div class="container-fluid pagina">
    <div class="sa-toolbar"><p>Datos, actividad y cuentas de esta institución.</p><div class="sa-toolbar-actions">{{ include('components/back_button.html.twig', {'default_path': path('admin_instituto_index')}) }}<a href="{{ path('admin_instituto_edit', {'id': instituto.id}) }}" class="btn btn-primary">Editar institución</a></div></div>
    <div class="row g-3">
        <div class="col-lg-8"><section class="card h-100"><div class="card-header"><i class="bi bi-building" aria-hidden="true"></i> Información general</div><div class="card-body">
            <dl class="row sa-detail-list mb-0">
                <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">{{ instituto.nombre }}</dd>
                <dt class="col-sm-4">Estado</dt><dd class="col-sm-8"><span class="badge {{ instituto.activo ? 'bg-success' : 'bg-secondary' }}">{{ instituto.activo ? 'Activo' : 'Dado de baja' }}</span></dd>
                <dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8">{{ instituto.email ?: 'Sin especificar' }}</dd>
                <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">{{ instituto.tel ?: 'Sin especificar' }}</dd>
                <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">{{ instituto.dir ?: 'Sin especificar' }}</dd>
                <dt class="col-sm-4">Plan</dt><dd class="col-sm-8">{{ instituto.plan == 'premium' ? 'Premium' : 'Básico' }}{% if instituto.ayudaIaPrueba %} · Prueba de IA habilitada{% endif %}</dd>
            </dl>
        </div></section></div>
        <div class="col-lg-4"><section class="card h-100"><div class="card-header"><i class="bi bi-image" aria-hidden="true"></i> Logo</div><div class="card-body text-center">
            {% if instituto.logo %}<img src="{{ asset('uploads/logos/' ~ instituto.logo) }}" alt="Logo de {{ instituto.nombre }}" class="img-fluid" style="max-height: 160px; object-fit: contain;">{% else %}<div class="sa-empty"><i class="bi bi-image" aria-hidden="true"></i><p>Sin logo cargado.</p></div>{% endif %}
        </div></section></div>
    </div>
    <section class="mt-4 mb-4" aria-labelledby="actividad-alumnos">
        <h2 id="actividad-alumnos" class="sa-section-title">{{ Term('alumnos') }}</h2><p class="sa-description">Actividad registrada en la institución.</p>
        <div class="row g-3">{% for metrica in [{titulo: 'Total', valor: total_alumnos}, {titulo: 'Activos', valor: alumnos_activos}, {titulo: 'Inactivos', valor: alumnos_inactivos}] %}<div class="col-sm-4"><div class="sa-metric"><span>{{ metrica.titulo }}</span><strong>{{ metrica.valor }}</strong></div></div>{% endfor %}</div>
    </section>
    <section class="mb-4" aria-labelledby="actividad-usuarios">
        <h2 id="actividad-usuarios" class="sa-section-title">Usuarios</h2><p class="sa-description">Distribución de las cuentas por tipo de acceso.</p>
        <div class="row g-3">{% for metrica in [{titulo: 'Total de usuarios', valor: total_usuarios}, {titulo: 'Administradores', valor: usuarios_admin}, {titulo: Term('profesores'), valor: usuarios_profesor}, {titulo: 'Otros usuarios', valor: otros_usuarios}] %}<div class="col-6 col-lg-3"><div class="sa-metric"><span>{{ metrica.titulo }}</span><strong>{{ metrica.valor }}</strong></div></div>{% endfor %}</div>
    </section>
    <section class="card sa-table-card"><div class="card-header"><h2 class="mb-0">Cuentas de la institución</h2></div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th scope="col">Correo electrónico</th><th scope="col">Tipo de acceso</th></tr></thead><tbody>
        {% for usuario in instituto.usuarios %}<tr><td>{{ usuario.email }}</td><td>{% if 'ROLE_ADMIN_INSTITUTO' in usuario.roles %}<span class="badge bg-primary">Administrador</span>{% elseif 'ROLE_PROFESOR' in usuario.roles %}<span class="badge bg-secondary">{{ Term('profesor') }}</span>{% else %}<span class="badge bg-secondary">Usuario</span>{% endif %}</td></tr>{% else %}<tr><td colspan="2"><div class="sa-empty"><p>No hay usuarios registrados.</p></div></td></tr>{% endfor %}
    </tbody></table></div></div></section>
</div>
{% endblock %}
