{# templates/admin/instituto/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Lista de Institutos{% endblock %}

{% block panelTitle %}
    Lista de Institutos <a href="{{ path('admin_instituto_new') }}" class="btn btn-success btn-sm">Nuevo instituto</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    {# Filtros #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('admin_instituto_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="nombre" class="form-label">Buscar por nombre</label>
                    <input type="text" 
                           class="form-control" 
                           id="nombre" 
                           name="nombre" 
                           value="{{ nombre }}" 
                           placeholder="Nombre del instituto">
                </div>
                {% if usuariosAdmin is defined and usuariosAdmin|length > 0 %}
                    <div class="col-md-4">
                        <label for="usuarioCreador" class="form-label">Usuario creador</label>
                        <select class="form-select" id="usuarioCreador" name="usuarioCreador">
                            <option value="">Todos los usuarios</option>
                            {% for usuarioAdmin in usuariosAdmin %}
                                <option value="{{ usuarioAdmin.id }}" 
                                        {% if usuarioCreadorId == usuarioAdmin.id|default('') %}selected{% endif %}>
                                    {{ usuarioAdmin.email }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                    <a href="{{ path('admin_instituto_index') }}" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    {# Tabla de resultados #}
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Usuario Creador</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if institutos|length > 0 %}
                            {% for instituto in institutos %}
                                <tr>
                                    <td>{{ instituto.id }}</td>
                                    <td>{{ instituto.nombre }}</td>
                                    <td>{{ instituto.email|default('-') }}</td>
                                    <td>{{ instituto.dir|default('-') }}</td>
                                    <td>{{ instituto.tel|default('-') }}</td>
                                    <td>
                                        {% set usuarioCreador = null %}
                                        {% set adminsActivos = instituto.admins|filter(a => a.activo)|sort((a, b) => a.id <=> b.id) %}
                                        {% if adminsActivos|length > 0 %}
                                            {% set usuarioCreador = adminsActivos|first.user %}
                                            <a href="{{ path('admin_user_show', {'id': usuarioCreador.id}) }}">
                                                {{ usuarioCreador.email }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">-</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_instituto_edit', {'id': instituto.id}) }}" 
                                           class="btn btn-sm btn-outline-primary btn-action-icon" 
                                           data-toggle="tooltip" 
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="{{ path('admin_instituto_show', {'id': instituto.id}) }}" 
                                           class="btn btn-sm btn-outline-info btn-action-icon" 
                                           data-toggle="tooltip" 
                                           title="Ver">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    No se encontraron institutos con los filtros aplicados.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>

            {# Paginación #}
            {% if institutos|length > 0 %}
                <div class="d-flex justify-content-center mt-3">
                    {{ knp_pagination_render(institutos) }}
                </div>
                <div class="text-center text-muted mt-2">
                    Mostrando {{ institutos.getCurrentPageNumber }} de {{ institutos.getPageCount }} página(s) 
                    - Total: {{ institutos.getTotalItemCount }} instituto(s)
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
