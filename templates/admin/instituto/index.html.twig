{# templates/admin/instituto/index.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Lista de Institutos{% endblock %}

{% block panelTitle %}
    Lista de Institutos <a href="{{ path('admin_instituto_new') }}" class="btn btn-success btn-sm">Nuevo instituto</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <table class="table table-striped table-responsive">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Dir</th>
                    <th>Tel</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for instituto in institutos %}
                    <tr>
                        <td>{{ instituto.nombre }}</td>
                        <td>{{ instituto.dir }}</td>
                        <td>{{ instituto.tel }}</td>
                        <td>
                            <a href="{{ path('admin_instituto_edit', {'id': instituto.id}) }}"><i class="bi bi-pencil" data-toggle="tooltip" title="editar"></i></a>
                            <a href="{{ path('admin_instituto_show', {'id': instituto.id}) }}"><i class="bi bi-eye" data-toggle="tooltip" title="ver"></i></a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    

{% endblock %}
{% block javascripts %}
    {{ parent() }}
        <script>
            $(document).ready(function(){
                $("[data-toggle=tooltip]").tooltip({ placement: 'right'});
            });
        </script>
{% endblock %}