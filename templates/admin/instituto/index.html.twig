{% extends 'admin/_layout.html.twig' %}
{% block title %}{{ Term('instituto_plural') }}{% endblock %}
{% block panelTitle %}{{ Term('instituto_plural') }}{% endblock %}
{% block admin_body %}
<div class="container-fluid pagina">
    <div class="sa-toolbar">
        <p>Administrá las instituciones, sus planes y sus cuentas de acceso.</p>
        <a href="{{ path('admin_instituto_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo {{ term('instituto') }}</a>
    </div>
    <section class="sa-filters" aria-labelledby="institutos-filtros">
        <h2 id="institutos-filtros" class="sa-filter-title">Buscar y filtrar</h2>
        <form method="get" action="{{ path('admin_instituto_index') }}" class="row g-3">
            <div class="col-md-4">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="search" class="form-control" id="nombre" name="nombre" value="{{ nombre }}" placeholder="Buscar una institución">
            </div>
            {% if usuariosAdmin is defined and usuariosAdmin|length > 0 %}
                <div class="col-md-4">
                    <label for="usuarioCreador" class="form-label">Creada por</label>
                    <select class="form-select" id="usuarioCreador" name="usuarioCreador">
                        <option value="">Todos los administradores</option>
                        {% for usuarioAdmin in usuariosAdmin %}<option value="{{ usuarioAdmin.id }}" {{ usuarioCreadorId == usuarioAdmin.id|default('') ? 'selected' : '' }}>{{ usuarioAdmin.email }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
                <a href="{{ path('admin_instituto_index') }}" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </section>
    <section class="card sa-table-card" aria-labelledby="institutos-listado">
        <div class="card-header d-flex justify-content-between align-items-center"><h2 id="institutos-listado" class="mb-0">Instituciones</h2><span class="badge bg-secondary">{{ institutos.getTotalItemCount }} en total</span></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead><tr><th scope="col">{{ Term('instituto') }}</th><th scope="col">Contacto</th><th scope="col">Plan</th><th scope="col">Creada por</th><th scope="col" class="text-end">Acciones</th></tr></thead>
                    <tbody>
                        {% for instituto in institutos %}
                            <tr>
                                <td><div class="sa-name">{{ instituto.nombre }}</div><div class="sa-secondary">#{{ instituto.id }} · <span class="{{ instituto.activo ? '' : 'text-danger' }}">{{ instituto.activo ? 'Activo' : 'Dado de baja' }}</span></div></td>
                                <td>{{ instituto.email|default('Sin correo') }}<div class="sa-secondary">{{ instituto.tel|default('Sin teléfono') }}{% if instituto.dir %} · {{ instituto.dir }}{% endif %}</div></td>
                                <td><span class="badge {{ instituto.plan == 'premium' ? 'bg-primary' : 'bg-secondary' }}">{{ instituto.plan == 'premium' ? 'Premium' : 'Básico' }}</span>{% if instituto.ayudaIaPrueba %}<div class="sa-secondary">Prueba de IA habilitada</div>{% endif %}</td>
                                <td>
                                    {% set adminsActivos = instituto.admins|filter(a => a.activo)|sort((a, b) => a.id <=> b.id) %}
                                    {% if adminsActivos|length > 0 %}
                                        {% set creador = adminsActivos|first.user %}
                                        {% if is_granted('ROLE_SUPER_ADMIN') %}<a href="{{ path('admin_user_show', {'id': creador.id}) }}">{{ creador.email }}</a>{% else %}{{ creador.email }}{% endif %}
                                    {% else %}<span class="text-muted">Sin asignar</span>{% endif %}
                                </td>
                                <td><div class="sa-row-actions"><a href="{{ path('admin_instituto_show', {'id': instituto.id}) }}" class="btn btn-sm btn-outline-secondary">Ver</a><a href="{{ path('admin_instituto_edit', {'id': instituto.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a></div></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5"><div class="sa-empty"><i class="bi bi-building" aria-hidden="true"></i><p>No se encontraron instituciones con estos filtros.</p></div></td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if institutos|length > 0 %}<div class="sa-table-footer"><span class="small text-muted">Página {{ institutos.getCurrentPageNumber }} de {{ institutos.getPageCount }}</span>{{ knp_pagination_render(institutos) }}</div>{% endif %}
        </div>
    </section>
</div>
{% endblock %}
