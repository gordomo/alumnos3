{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
<input type="hidden" name="timezone" id="instituto_timezone" value="">
<div class="form-group">
    <div class="row g-3 mb-3">
        {% for field in [
            {form: form.nombre, label: 'Nombre'},
            {form: form.dir, label: 'Dirección'},
            {form: form.email, label: 'Email'},
            {form: form.password, label: 'Password'},
            {form: form.tel, label: 'Teléfono'},
            {form: form.logo, label: 'Logo'},
        ] %}
            <div class="col-md-4">
                {{ form_label(field.form, field.label, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(field.form, {'attr': {'class': 'form-control'}}) }}
                <small class="form-error text-danger">
                    {{ form_errors(field.form) }}
                </small>
            </div>
        {% endfor %}
    </div>
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6 text-muted">Suscripción</legend>
        <div class="row g-3">
            <div class="col-md-4">
                {{ form_label(form.precioPorAlumno, 'Precio por alumn@', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.precioPorAlumno, {'attr': {'class': 'form-control'}}) }}
                <div class="form-text">{{ form_help(form.precioPorAlumno) }}</div>
                <small class="form-error text-danger">{{ form_errors(form.precioPorAlumno) }}</small>
            </div>
            <div class="col-md-4">
                {{ form_label(form.minimoMensual, 'Mínimo mensual', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.minimoMensual, {'attr': {'class': 'form-control'}}) }}
                <div class="form-text">{{ form_help(form.minimoMensual) }}</div>
                <small class="form-error text-danger">{{ form_errors(form.minimoMensual) }}</small>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="form-check mt-4">
                    {{ form_widget(form.suscripcionExenta, {'attr': {'class': 'form-check-input'}}) }}
                    {{ form_label(form.suscripcionExenta, 'Exento de suscripción', {'label_attr': {'class': 'form-check-label'}}) }}
                    <div class="form-text">{{ form_help(form.suscripcionExenta) }}</div>
                </div>
            </div>
        </div>
    </fieldset>

    <div class="row mb-3">
        <div class="col text-end">
            {{ include('components/back_button.html.twig', {'default_path': path('admin_instituto_index')}) }}
            <button class="btn btn-success">{{ button_label|default('Guardar') }}</button>
        </div>
    </div>
</div>
<script>
(function() {
    try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        var el = document.getElementById('instituto_timezone');
        if (el && tz) el.value = tz;
    } catch (e) {}
})();
</script>
{{ form_end(form) }}