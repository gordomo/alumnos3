{% extends 'base.html.twig' %}

{% block title %}Gestión de Tokens - Administración{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">
                <i class="bi bi-coin"></i> Gestión de Tokens - Administración
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Institutos y sus Balances de Tokens</h5>
                </div>
                <div class="card-body">
                    {% if institutos|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Instituto</th>
                                        <th class="text-end">Balance</th>
                                        <th>Última Actualización</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in institutos %}
                                        <tr>
                                            <td>
                                                <strong>{{ item.instituto.nombre }}</strong><br>
                                                <small class="text-muted">{{ item.instituto.email }}</small>
                                            </td>
                                            <td class="text-end">
                                                <h5 class="mb-0" style="color: {% if item.balance.balance > 100 %}green{% elseif item.balance.balance > 20 %}orange{% else %}red{% endif %};">
                                                    {{ item.balance.balance }}
                                                </h5>
                                                <small class="text-muted">tokens</small>
                                            </td>
                                            <td>
                                                {{ item.balance.updatedAt|date('d/m/Y H:i') }}
                                            </td>
                                            <td class="text-center">
                                                <a href="{{ path('admin_tokens_add', {'id': item.instituto.id}) }}" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="bi bi-plus-circle"></i> Agregar Tokens
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted text-center mb-0">No hay institutos registrados</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

