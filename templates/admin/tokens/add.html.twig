{% extends 'base.html.twig' %}

{% block title %}Agregar Tokens - {{ instituto.nombre }}{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 mb-0">
                <i class="bi bi-plus-circle"></i> Agregar Tokens - {{ instituto.nombre }}
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Agregar Tokens</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <strong>Balance actual:</strong> {{ balance.balance }} tokens
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="amount" class="form-label">Cantidad de Tokens</label>
                            <input type="number" 
                                   class="form-control" 
                                   id="amount" 
                                   name="amount" 
                                   min="1" 
                                   required
                                   placeholder="Ingrese la cantidad de tokens a agregar">
                            <small class="form-text text-muted">La cantidad debe ser mayor a 0</small>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Descripción (opcional)</label>
                            <textarea class="form-control" 
                                      id="description" 
                                      name="description" 
                                      rows="3"
                                      placeholder="Descripción de la transacción (ej: Pago mensual, Bonificación, etc.)"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('admin_tokens_index') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Agregar Tokens
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Transacciones Recientes</h5>
                </div>
                <div class="card-body">
                    {% if recentTransactions|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for transaction in recentTransactions %}
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <small class="text-muted">{{ transaction.createdAt|date('d/m/Y H:i') }}</small><br>
                                            <strong>{{ transaction.description }}</strong>
                                        </div>
                                        <span class="badge {% if transaction.amount > 0 %}bg-success{% else %}bg-danger{% endif %}">
                                            {% if transaction.amount > 0 %}+{% endif %}{{ transaction.amount }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted text-center mb-0">No hay transacciones recientes</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

