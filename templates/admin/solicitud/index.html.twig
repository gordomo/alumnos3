{% extends 'base.html.twig' %}

{% block title %}Solicitudes de alta{% endblock %}
{% block panelTitle %}Solicitudes de alta{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap gap-2 mb-4">
        {% set filtros = {'': 'Todas', 'pendiente': 'Pendientes', 'confirmada': 'Confirmadas', 'descartada': 'Descartadas'} %}
        {% for valor, etiqueta in filtros %}
            <a href="{{ path('admin_solicitud_index', valor ? {'estado': valor} : {}) }}"
               class="btn btn-sm {{ estadoSeleccionado == (valor ?: null) ? 'btn-primary' : 'btn-outline-primary' }}">
                {{ etiqueta }}
                {% if valor == 'pendiente' and pendientes > 0 %}
                    <span class="badge bg-light text-dark ms-1">{{ pendientes }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            {% if solicitudes|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Recibida</th>
                                <th>Instituto</th>
                                <th>Contacto</th>
                                <th>Alumn@s</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for solicitud in solicitudes %}
                                <tr class="{{ solicitud.estado == 'pendiente' ? 'table-warning' : '' }}">
                                    <td class="text-nowrap">{{ solicitud.fechaSolicitud|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <strong>{{ solicitud.nombreInstituto }}</strong>
                                        {% if solicitud.instituto %}
                                            <div class="small text-muted">
                                                <a href="{{ path('admin_instituto_edit', {'id': solicitud.instituto.id}) }}">
                                                    Ver el instituto
                                                </a>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ solicitud.nombreContacto }}
                                        <div class="small text-muted">{{ solicitud.email }}</div>
                                    </td>
                                    <td>{{ solicitud.alumnosEstimadosEtiqueta|default('—') }}</td>
                                    <td>
                                        {% if solicitud.estado == 'pendiente' %}
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        {% elseif solicitud.estado == 'confirmada' %}
                                            <span class="badge bg-success">Confirmada</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Descartada</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('admin_solicitud_show', {'id': solicitud.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                    <p class="mb-0 mt-2">No hay solicitudes para mostrar.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
