{% extends 'admin/_layout.html.twig' %}
{% block title %}Usuarios administradores{% endblock %}
{% block panelTitle %}Usuarios administradores{% endblock %}
{% block admin_body %}
<div class="container-fluid pagina">
    <div class="sa-toolbar"><p>Gestioná las cuentas que administran la plataforma y sus instituciones.</p><a href="{{ path('admin_user_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nuevo administrador</a></div>
    <section class="card sa-table-card" aria-labelledby="usuarios-titulo">
        <div class="card-header d-flex justify-content-between align-items-center"><h2 id="usuarios-titulo" class="mb-0">Cuentas administradoras</h2><span class="badge bg-secondary">{{ users|length }} en total</span></div>
        <div class="card-body"><div class="table-responsive">
            <table class="table table-hover"><thead><tr><th scope="col">Cuenta</th><th scope="col">Rol</th><th scope="col">{{ Term('instituto') }}</th><th scope="col" class="text-end">Acciones</th></tr></thead><tbody>
                {% for user in users %}<tr>
                    <td><span class="sa-name">{{ user.email }}</span><div class="sa-secondary">#{{ user.id }}</div></td>
                    <td>{% if 'ROLE_SUPER_ADMIN' in user.roles %}<span class="badge bg-primary">Superadministrador</span>{% elseif 'ROLE_ADMIN' in user.roles %}<span class="badge bg-secondary">Administrador</span>{% endif %}</td>
                    <td>{{ user.instituto ? user.instituto.nombre : 'Sin institución asignada' }}</td>
                    <td><div class="sa-row-actions"><a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary">Ver</a><a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-primary">Editar</a></div></td>
                </tr>{% else %}<tr><td colspan="4"><div class="sa-empty"><i class="bi bi-people" aria-hidden="true"></i><p>Todavía no hay usuarios administradores.</p></div></td></tr>{% endfor %}
            </tbody></table>
        </div></div>
    </section>
</div>
{% endblock %}
