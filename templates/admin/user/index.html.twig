{% extends 'base.html.twig' %}

{% block title %}Usuarios Administradores{% endblock %}

{% block panelTitle %}
    Usuarios Administradores <a href="{{ path('admin_user_new') }}" class="btn btn-success btn-sm">Nuevo Usuario</a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Instituto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                                    <span class="badge bg-danger">Super Administrador</span>
                                {% elseif 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-primary">Administrador</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.instituto %}
                                    {{ user.instituto.nombre }}
                                {% else %}
                                    <span class="text-muted">Sin instituto</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('admin_user_show', {'id': user.id}) }}" class="btn btn-sm btn-outline-info" title="Ver">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-outline-secondary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                {{ include('admin/user/_delete_form.html.twig', {'user': user}) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center">No se encontraron usuarios administradores</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
