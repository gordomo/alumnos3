<form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este usuario administrador?');" style="display: inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn btn-danger btn-sm" title="Eliminar">
        <i class="bi bi-trash"></i>
    </button>
</form>
