<details class="sa-danger">
    <summary>Eliminar usuario administrador</summary>
    <div>
        <p class="small text-muted">Esta acción elimina la cuenta de <strong>{{ user.email }}</strong>. Revisá sus instituciones asignadas antes de continuar.</p>
        <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este usuario administrador?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
            <button type="submit" class="btn btn-outline-danger">Eliminar cuenta</button>
        </form>
    </div>
</details>
