{% extends 'base.html.twig' %}

{% block title %}Ver Usuario Administrador{% endblock %}

{% block body %}
<div class="container mt-3 d-flex justify-content-center">
    <div class="col-lg-12">
        <h1 class="mb-4 text-center">Detalle del Usuario Administrador</h1>
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th>Roles</th>
                            <td>
                                {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                                    <span class="badge bg-danger">Super Administrador</span>
                                {% elseif 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-primary">Administrador</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Instituto</th>
                            <td>
                                {% if user.instituto %}
                                    <a href="{{ path('admin_instituto_show', {'id': user.instituto.id}) }}">{{ user.instituto.nombre }}</a>
                                {% else %}
                                    <span class="text-muted">Sin instituto asignado</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="text-end">
                    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">Volver</a>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-primary">Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
