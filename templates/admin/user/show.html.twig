{% extends 'admin/_layout.html.twig' %}

{% block title %}Ver Usuario Administrador{% endblock %}

{% block panelTitle %}Ver Usuario Administrador{% endblock %}

{% block admin_body %}
<div class="container-fluid pagina">
    <div class="sa-compact">
        <div class="sa-toolbar"><p>Cuenta de acceso y sus instituciones asignadas.</p></div>
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table align-middle">
                    <tbody>
                        <tr>
                            <th>ID</th>
                            <td>{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th>Roles</th>
                            <td>
                                {% if 'ROLE_SUPER_ADMIN' in user.roles %}
                                    <span class="badge bg-primary">Superadministrador</span>
                                {% elseif 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-primary">Administrador</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ Term('instituto') }}</th>
                            <td>
                                {% if user.instituto %}
                                    <a href="{{ path('admin_instituto_show', {'id': user.instituto.id}) }}">{{ user.instituto.nombre }}</a>
                                {% else %}
                                    <span class="text-muted">Sin {{ term('instituto') }} asignado</span>
                                {% endif %}
                            </td>
                        </tr>
                    </tbody>
                </table>

                {% if institutosCreados is defined and institutosCreados|length > 0 %}
                    <div class="mt-4">
                        <h2 class="sa-section-title mb-3">{{ Term('instituto_plural') }} creados</h2>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre</th>
                                        <th>Email</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for institutoAdmin in institutosCreados %}
                                        <tr>
                                            <td>{{ institutoAdmin.instituto.id }}</td>
                                            <td>
                                                <a href="{{ path('admin_instituto_show', {'id': institutoAdmin.instituto.id}) }}">
                                                    {{ institutoAdmin.instituto.nombre }}
                                                </a>
                                            </td>
                                            <td>{{ institutoAdmin.instituto.email }}</td>
                                            <td>
                                                {% if institutoAdmin.activo %}
                                                    <span class="badge bg-success">Activo</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('admin_instituto_show', {'id': institutoAdmin.instituto.id}) }}" class="btn btn-sm btn-primary">
                                                    Ver
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <div class="mt-4">
                        <p class="text-muted">Este usuario no ha creado ningún {{ term('instituto') }}.</p>
                    </div>
                {% endif %}

                <div class="sa-actions">
                    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">Volver</a>
                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}" class="btn btn-primary">Editar</a>
                </div>
            </div>
        </div>
        {{ include('admin/user/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
