{% extends 'base.html.twig' %}

{% block title %}Cobranzas{% endblock %}

{% block panelTitle %}Cobranzas{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <!-- Filtros -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('admin_billing_invoice_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="instituto" class="form-label">Instituto</label>
                    <select name="instituto" id="instituto" class="form-select">
                        <option value="">Todos los institutos</option>
                        {% for instituto in institutos %}
                            <option value="{{ instituto.id }}" {% if selectedInstituto == instituto.id %}selected{% endif %}>
                                {{ instituto.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label">Estado</label>
                    <select name="status" id="status" class="form-select">
                        <option value="all" {% if selectedStatus == 'all' or selectedStatus is empty %}selected{% endif %}>Todas</option>
                        <option value="pending_approval" {% if selectedStatus == 'pending_approval' %}selected{% endif %}>En revisión</option>
                        <option value="pending" {% if selectedStatus == 'pending' %}selected{% endif %}>Pendientes</option>
                        <option value="paid" {% if selectedStatus == 'paid' %}selected{% endif %}>Pagadas</option>
                        <option value="rejected" {% if selectedStatus == 'rejected' %}selected{% endif %}>Rechazadas</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    <a href="{{ path('admin_billing_invoice_index') }}" class="btn btn-secondary ms-2">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <a href="{{ path('admin_billing_invoice_index', {'status': 'pending_approval'}) }}" class="text-decoration-none">
                <div class="card border-warning h-100">
                    <div class="card-body">
                        <div class="text-uppercase text-muted small">Esperan que revisemos</div>
                        <div class="display-6 mb-0 text-warning">{{ stats.pending_approval }}</div>
                        <div class="small text-muted">comprobantes declarados</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <a href="{{ path('admin_billing_invoice_index', {'status': 'pending'}) }}" class="text-decoration-none">
                <div class="card border-danger h-100">
                    <div class="card-body">
                        <div class="text-uppercase text-muted small">Vencidas sin pagar</div>
                        <div class="display-6 mb-0 text-danger">{{ stats.vencidas }}</div>
                        <div class="small text-muted">de {{ stats.pending }} pendiente(s)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-3">
            <div class="card border-primary h-100">
                <div class="card-body">
                    <div class="text-uppercase text-muted small">A cobrar</div>
                    <div class="h3 mb-0 text-primary">${{ stats.a_cobrar|number_format(2, ',', '.') }}</div>
                    <div class="small text-muted">pendientes + en revisión</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success h-100">
                <div class="card-body">
                    <div class="text-uppercase text-muted small">Pagadas</div>
                    <div class="display-6 mb-0 text-success">{{ stats.paid }}</div>
                    <div class="small text-muted">{{ stats.rejected }} rechazada(s)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Facturas -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Facturas ({{ invoices|length }})</h5>
        </div>
        <div class="card-body">
            {% if invoices|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Instituto</th>
                                <th>Período</th>
                                <th>Alumn@s</th>
                                <th>Monto</th>
                                <th>Vence</th>
                                <th>Estado</th>
                                <th>Método</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for invoice in invoices %}
                                <tr class="{% if invoice.isPendingApproval %}table-warning{% elseif invoice.isPending and invoice.diasDeAtraso > 0 %}table-danger{% endif %}">
                                    <td>#{{ invoice.id }}</td>
                                    <td>{{ invoice.instituto.nombre }}</td>
                                    <td>{{ invoice.getFormattedPeriod() }}</td>
                                    <td>{{ invoice.activeStudentsCount }}</td>
                                    <td>${{ invoice.totalAmount|number_format(2, ',', '.') }}</td>
                                    <td>
                                        {% if invoice.dueDate %}
                                            {{ invoice.dueDate|date('d/m/Y') }}
                                            {% if invoice.isPending and invoice.diasDeAtraso > 0 %}
                                                <span class="d-block small text-danger">{{ invoice.diasDeAtraso }} día(s) de atraso</span>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if invoice.isPaid %}
                                            <span class="badge bg-success">Pagada</span>
                                        {% elseif invoice.isPendingApproval %}
                                            <span class="badge bg-warning text-dark">En revisión</span>
                                        {% elseif invoice.isPending %}
                                            <span class="badge bg-secondary">Pendiente</span>
                                        {% elseif invoice.isRejected %}
                                            <span class="badge bg-danger">Rechazada</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Cancelada</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if invoice.paymentMethod %}
                                            {{ invoice.paymentMethodEtiqueta }}
                                        {% else %}
                                            <span class="text-muted">&mdash;</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_billing_invoice_show', {'id': invoice.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> No se encontraron facturas con los filtros seleccionados.
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
