{% extends 'base.html.twig' %}

{% block title %}Configuración de Facturación{% endblock %}

{% block panelTitle %}
    Configuración de Facturación 
    <a href="{{ path('admin_billing_config_new') }}" class="btn btn-success btn-sm">
        <i class="bi bi-plus-circle"></i> Nueva Configuración
    </a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-cash-stack"></i> Precio por Alumno - Configuración de Facturación
                    </h5>
                </div>
                <div class="card-body">
                    {% if configs|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Clave</th>
                                        <th>Precio por Alumno/Mes</th>
                                        <th>Descripción</th>
                                        <th>Última Actualización</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for config in configs %}
                                        <tr>
                                            <td>{{ config.id }}</td>
                                            <td><code>{{ config.configKey }}</code></td>
                                            <td>
                                                <strong class="text-success" style="font-size: 1.2rem;">
                                                    ${{ config.pricePerStudentMonthly|number_format(2, ',', '.') }}
                                                </strong>
                                            </td>
                                            <td>{{ config.description ?? '-' }}</td>
                                            <td>{{ config.updatedAt|date((app_date_format|default('d/m/Y')) ~ ' H:i') }}</td>
                                            <td>
                                                <a href="{{ path('admin_billing_config_show', {'id': config.id}) }}" 
                                                   class="btn btn-sm btn-outline-info btn-action-icon" 
                                                   title="Ver detalles">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('admin_billing_config_edit', {'id': config.id}) }}" 
                                                   class="btn btn-sm btn-outline-primary btn-action-icon" 
                                                   title="Editar">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                {{ include('admin/billing_config/_delete_form.html.twig', {'config': config}) }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i> No hay configuraciones de facturación. 
                            <a href="{{ path('admin_billing_config_new') }}" class="alert-link">Crear una nueva configuración</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
