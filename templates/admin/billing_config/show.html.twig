{% extends 'base.html.twig' %}

{% block title %}Ver Configuración de Facturación{% endblock %}

{% block panelTitle %}
    Detalles de Configuración de Facturación
    <a href="{{ path('admin_billing_config_index') }}" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-eye"></i> Información de la Configuración
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">{{ config.id }}</dd>

                        <dt class="col-sm-4">Clave de Configuración:</dt>
                        <dd class="col-sm-8"><code>{{ config.configKey }}</code></dd>

                        <dt class="col-sm-4">Precio por Alumno/Mes:</dt>
                        <dd class="col-sm-8">
                            <strong class="text-success" style="font-size: 1.5rem;">
                                ${{ config.pricePerStudentMonthly|number_format(2, ',', '.') }}
                            </strong>
                        </dd>

                        <dt class="col-sm-4">Descripción:</dt>
                        <dd class="col-sm-8">{{ config.description ?? '<span class="text-muted">Sin descripción</span>'|raw }}</dd>

                        <dt class="col-sm-4">Fecha de Creación:</dt>
                        <dd class="col-sm-8">{{ config.createdAt|date((app_date_format|default('d/m/Y')) ~ ' H:i:s') }}</dd>

                        <dt class="col-sm-4">Última Actualización:</dt>
                        <dd class="col-sm-8">{{ config.updatedAt|date((app_date_format|default('d/m/Y')) ~ ' H:i:s') }}</dd>
                    </dl>

                    <div class="alert alert-info mt-4">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Nota:</strong> Este precio se utiliza para calcular las facturas mensuales de todos los institutos. 
                        El precio se multiplica por la cantidad de alumnos activos de cada instituto.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('admin_billing_config_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver al Listado
                        </a>
                        <div>
                            <a href="{{ path('admin_billing_config_edit', {'id': config.id}) }}" class="btn btn-primary">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
