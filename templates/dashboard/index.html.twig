{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block panelTitle %}
    Dashboard
{% endblock %}

{% block body %}
    <div class="container-fluid mt-4">
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <h5 class="card-title">Total Deudores</h5>
                        <h2 class="card-text">{{ totalDeudores }}</h2>
                        <p class="card-text small">{{ porcentajeDeudores|number_format(2, ',', '.') }}% del total de alumnos</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <h5 class="card-title">Deudores Críticos</h5>
                        <h2 class="card-text">{{ deudoresCriticos }}</h2>
                        <p class="card-text small">Más de 3 meses sin pagar</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <h5 class="card-title">Monto Total Adeudado</h5>
                        <h2 class="card-text">${{ montoTotalAdeudado|number_format(2, ',', '.') }}</h2>
                        <p class="card-text small">Promedio: ${{ montoPromedioAdeudado|number_format(2, ',', '.') }}</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <h5 class="card-title">Promedio de Meses</h5>
                        <h2 class="card-text">{{ promedioMesesAdeudados|number_format(1) }}</h2>
                        <p class="card-text small">Por deudor</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card" style="box-shadow: 5px 5px 10px;">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Distribución de Deudas por Curso</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th>Curso</th>
                                        <th>Deudores</th>
                                        <th>Monto Total</th>
                                        <th>% del Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for curso in deudasPorCurso %}
                                        <tr>
                                            <td>{{ curso.nombre }}</td>
                                            <td>{{ curso.deudores }}</td>
                                            <td>${{ curso.monto|number_format(2, ',', '.') }}</td>
                                            <td>{{ curso.porcentaje|number_format(1) }}%</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card" style="box-shadow: 5px 5px 10px;">
                    <div class="card-header">
                        <h3 class="card-title">Lista de Deudores</h3>
                    </div>
                    <div class="card-body">
                        <form method="get" class="mb-3">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <input type="text" name="busqueda" class="form-control" placeholder="Buscar alumno..." value="{{ busqueda }}">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" type="submit">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <select name="sort" class="form-control">
                                        <option value="alumnoNombre" {% if sort == 'alumnoNombre' %}selected{% endif %}>Ordenar por Nombre</option>
                                        <option value="ultimoPago" {% if sort == 'ultimoPago' %}selected{% endif %}>Ordenar por Último Pago</option>
                                        <option value="mesesAdeudados" {% if sort == 'mesesAdeudados' %}selected{% endif %}>Ordenar por Meses Adeudados</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select name="order" class="form-control">
                                        <option value="asc" {% if order == 'asc' %}selected{% endif %}>Ascendente</option>
                                        <option value="desc" {% if order == 'desc' %}selected{% endif %}>Descendente</option>
                                    </select>
                                </div>
                            </div>
                        </form>

                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Último Pago</th>
                                        <th>Meses Adeudados</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for deudor in pagination %}
                                        <tr>
                                            <td>{{ deudor.alumno.apellido }}, {{ deudor.alumno.nombre }}</td>
                                            <td>
                                                {% if deudor.ultimoPago %}
                                                    {{ deudor.ultimoPago.fecha|date('d/m/Y') }}
                                                {% else %}
                                                    Sin pagos
                                                {% endif %}
                                            </td>
                                            <td>
                                                <span class="meses-adeudados" data-bs-toggle="modal" data-bs-target="#mesesModal{{ deudor.alumno.id }}" style="cursor: pointer;">
                                                    {{ deudor.mesesAdeudados|slice(0, 2)|map(mes => mes.nombre)|join(', ') }}
                                                    {% if deudor.mesesAdeudados|length > 2 %}
                                                        <span class="text-muted">(+{{ deudor.mesesAdeudados|length - 2 }} más)</span>
                                                    {% endif %}
                                                </span>

                                                <!-- Modal para mostrar todos los meses -->
                                                <div class="modal fade" id="mesesModal{{ deudor.alumno.id }}" tabindex="-1" aria-labelledby="mesesModalLabel{{ deudor.alumno.id }}" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="mesesModalLabel{{ deudor.alumno.id }}">
                                                                    Meses Adeudados - {{ deudor.alumno.apellido }}, {{ deudor.alumno.nombre }}
                                                                </h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="list-group">
                                                                    {% for mes in deudor.mesesAdeudados %}
                                                                        <div class="list-group-item">
                                                                            <div class="d-flex justify-content-between align-items-center">
                                                                                <div>
                                                                                    <h6 class="mb-1">{{ mes.nombre }}</h6>
                                                                                    <small class="text-muted">Curso: {{ mes.curso }}</small>
                                                                                </div>
                                                                                <div class="text-end">
                                                                                    <strong>${{ mes.curso_obj.precio|number_format(2, ',', '.') }}</strong>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    {% endfor %}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <a href="{{ path('app_alumno_show', {'id': deudor.alumno.id}) }}" title="Ver" data-toggle="tooltip" data-placement="left"  class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('app_alumnos_pagos_new', {'id': deudor.alumno.id}) }}" title="Registrar Pago" data-toggle="tooltip" data-placement="top" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-cash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center">No hay deudores registrados</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="navigation d-flex justify-content-center mt-4">
                            {{ knp_pagination_render(pagination) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}