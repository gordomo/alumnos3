{% extends 'base.html.twig' %}

{% block title %}Asistencias de Alumnos{% endblock %}

{% block body %}
<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Asistencias de Alumnos</h1>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <form method="get" action="{{ path('app_asistencia_alumnos_index') }}" class="row g-3">
                <div class="col-md-4">
                    <label for="fecha" class="form-label">Fecha</label>
                    <input type="date" class="form-control" id="fecha" name="fecha" value="{{ fecha }}" max="{{ "now"|date("Y-m-d") }}">
                </div>
                <div class="col-md-4">
                    <label for="curso" class="form-label">Curso</label>
                    <select class="form-select chosen-select" id="curso" name="curso">
                        <option value="">Seleccione un curso</option>
                        {% for curso in cursos %}
                            <option value="{{ curso.id }}" {% if cursoSeleccionado and cursoSeleccionado.id == curso.id %}selected{% endif %}>
                                {{ curso.nombre }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    {% set rutaForm = 'app_asistencia_alumnos_index' %}
    {% include 'asistencia/_form.html.twig' %}
</div>
{% endblock %} 