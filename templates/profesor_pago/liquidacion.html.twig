{% extends 'base.html.twig' %}

{% block title %}Liquidación de Profesores{% endblock %}

{% block panelTitle %}
    Liquidación de Profesores
{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0">Liquidación de Profesores</h4>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-month"></i> Seleccionar Período</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Mes</label>
                    <select name="mes" class="form-select">
                        {% set meses = {
                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                        } %}
                        {% for num, nombre in meses %}
                            <option value="{{ num }}" {% if mes == num %}selected{% endif %}>{{ nombre }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Año</label>
                    <select name="ano" class="form-select">
                        {% for y in range('now'|date('Y') - 2, 'now'|date('Y') + 1) %}
                            <option value="{{ y }}" {% if ano == y %}selected{% endif %}>{{ y }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    {% set nombresMeses = {
        1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
        5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
        9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
    } %}

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Liquidación de {{ nombresMeses[mes] }} {{ ano }}</h5>
        </div>
        <div class="card-body">
    {% if liquidaciones is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No hay profesores registrados en el instituto.
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Profesor</th>
                        <th>Tipo de Pago</th>
                        <th class="text-end">Monto Calculado</th>
                        <th class="text-end">Pagado</th>
                        <th class="text-end">Saldo Pendiente</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in liquidaciones %}
                        {% set profesor = item.profesor %}
                        {% set liq = item.liquidacion %}
                        <tr>
                            <td>
                                <strong>{{ profesor.apellido }}, {{ profesor.nombre }}</strong>
                                <br>
                                <small class="text-muted">{{ profesor.email }}</small>
                            </td>
                            <td>
                                {% set tipos = {
                                    'por_hora': 'Por Hora',
                                    'fijo_mensual': 'Fijo Mensual',
                                    'porcentaje': 'Porcentaje',
                                    'combinado': 'Combinado'
                                } %}
                                <span class="badge bg-info">{{ tipos[profesor.tipoPago] ?? 'Por Hora' }}</span>
                                {% set conReglaPropia = liq.detalle_calculo.cursos|default([])|filter(c => c.origen_regla|default('profesor') == 'curso')|length %}
                                {% if conReglaPropia > 0 %}
                                    <br>
                                    <small class="text-muted" title="Estos cursos se liquidan con su propia regla">
                                        {{ conReglaPropia }} curso(s) con regla propia
                                    </small>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <strong>${{ liq.monto_calculado|number_format(2, ',', '.') }}</strong>
                            </td>
                            <td class="text-end">
                                {% if liq.total_pagado > 0 %}
                                    <span class="text-success">${{ liq.total_pagado|number_format(2, ',', '.') }}</span>
                                {% else %}
                                    <span class="text-muted">$0,00</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if liq.saldo_pendiente > 0 %}
                                    <span class="text-danger fw-bold">${{ liq.saldo_pendiente|number_format(2, ',', '.') }}</span>
                                {% elseif liq.saldo_pendiente < 0 %}
                                    <span class="text-warning">-${{ (liq.saldo_pendiente * -1)|number_format(2, ',', '.') }}</span>
                                {% else %}
                                    <span class="text-success">$0,00</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    {% if liq.saldo_pendiente > 0 %}
                                        <a href="{{ path('app_profesor_pago_registrar', {'profesorId': profesor.id, 'mes': mes, 'ano': ano}) }}" 
                                           class="btn btn-sm btn-success" title="Registrar Pago">
                                            <i class="bi bi-cash-coin"></i> Pagar
                                        </a>
                                    {% endif %}
                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                            data-bs-toggle="collapse" data-bs-target="#detalle-{{ profesor.id }}"
                                            title="Ver Detalle">
                                        <i class="bi bi-eye"></i> Detalle
                                    </button>
                                    <a href="{{ path('app_profesor_pago_reglas', {'profesorId': profesor.id}) }}"
                                       class="btn btn-sm btn-outline-secondary" title="Pago por curso">
                                        <i class="bi bi-sliders"></i> Pago por curso
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr class="collapse" id="detalle-{{ profesor.id }}">
                            <td colspan="6" class="bg-light">
                                <div class="p-3">
                                    <h6>Detalle de Cálculo</h6>
                                    
                                    {{ include('profesor_pago/_detalle_calculo.html.twig', {'detalle': liq.detalle_calculo}) }}

                                    {% if liq.pagos_realizados is not empty %}
                                        <hr>
                                        <h6>Pagos Realizados</h6>
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Método</th>
                                                    <th class="text-end">Monto</th>
                                                    <th>Observación</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% for pago in liq.pagos_realizados %}
                                                    <tr>
                                                        <td>{{ pago.fechaPago|date('d/m/Y') }}</td>
                                                        <td><span class="badge bg-secondary">{{ pago.metodoPago }}</span></td>
                                                        <td class="text-end">${{ pago.monto|number_format(2, ',', '.') }}</td>
                                                        <td>{{ pago.observacion ?? '-' }}</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
        </div>
    </div>
</div>
{% endblock %}
