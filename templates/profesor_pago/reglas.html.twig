{% extends 'base.html.twig' %}

{% block title %}Pago por curso — {{ profesor.apellido }}, {{ profesor.nombre }}{% endblock %}

{% block panelTitle %}Pago por curso{% endblock %}

{% block body %}
<div class="container-fluid mt-3" style="padding-bottom: 3rem;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_profesor_pago_liquidacion') }}">Liquidación</a></li>
            <li class="breadcrumb-item active">{{ profesor.apellido }}, {{ profesor.nombre }}</li>
        </ol>
    </nav>

    <div class="card mb-3">
        <div class="card-body">
            <h6 class="mb-2">Cómo se le paga a este profesor</h6>
            <p class="mb-1 small">
                Por default, todos sus cursos se liquidan con la configuración de su ficha:
                <strong>
                    {%- if profesor.tipoPago == 'fijo_mensual' %}fijo mensual
                    {%- elseif profesor.tipoPago == 'porcentaje' %}porcentaje
                    {%- elseif profesor.tipoPago == 'combinado' %}combinado (fijo + porcentaje)
                    {%- else %}por hora
                    {%- endif -%}
                </strong>{% if profesor.precioHora %}, valor hora ${{ profesor.precioHora|number_format(2, ',', '.') }}{% endif %}.
            </p>
            <p class="mb-0 small text-muted">
                Acá se define la excepción: el curso con su regla prendida se liquida como diga
                esta pantalla y no como dice la ficha. Así el mismo profesor puede cobrar por hora
                en un curso y un porcentaje en otro.
            </p>
        </div>
    </div>

    {% if cursos is empty %}
        <div class="alert alert-light border">
            <i class="bi bi-info-circle"></i> Este profesor todavía no tiene cursos asignados.
            Se le asignan al editar el curso.
        </div>
    {% else %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('reglas_pago_' ~ profesor.id) }}">

        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 8rem;">Regla propia</th>
                            <th>Curso</th>
                            <th style="width: 12rem;">Modalidad</th>
                            <th>Valores</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for curso in cursos %}
                        {% set regla = reglas[curso.id]|default(null) %}
                        {% set modalidad = regla ? regla.modalidad : 'por_hora' %}
                        <tr>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input regla-switch" type="checkbox"
                                           name="regla_activa[{{ curso.id }}]" value="1"
                                           id="activa_{{ curso.id }}"
                                           data-curso="{{ curso.id }}"
                                           {% if regla and regla.activo %}checked{% endif %}>
                                    <label class="form-check-label small" for="activa_{{ curso.id }}">usar</label>
                                </div>
                            </td>
                            <td>
                                <strong>{{ curso.nombre }}</strong>
                                <div class="small text-muted">
                                    cuota ${{ curso.precio|number_format(2, ',', '.') }}
                                    {% if curso.horarios|length > 0 %}
                                        ·
                                        {% for h in curso.horarios %}{{ h.dia }} {{ h.duracion|format_duracion }}{% if not loop.last %}, {% endif %}{% endfor %}
                                    {% else %}
                                        · <span class="text-danger">sin horarios cargados</span>
                                    {% endif %}
                                </div>
                                {% if regla and not regla.activo %}
                                    <span class="badge bg-secondary">regla guardada, apagada</span>
                                {% endif %}
                            </td>
                            <td>
                                <select name="modalidad[{{ curso.id }}]" class="form-select form-select-sm modalidad-select"
                                        data-curso="{{ curso.id }}">
                                    {% for valor, etiqueta in modalidades %}
                                        <option value="{{ valor }}" {% if modalidad == valor %}selected{% endif %}>{{ etiqueta }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>
                                <div class="row g-2 campos-curso" data-curso="{{ curso.id }}">
                                    <div class="col-6 campo-por-hora">
                                        <label class="form-label small mb-0">Valor hora</label>
                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                               name="valores[{{ curso.id }}][precio_hora]"
                                               placeholder="{{ profesor.precioHora ?: 'del profesor' }}"
                                               value="{{ regla and regla.precioHora is not null ? regla.precioHora : '' }}">
                                    </div>
                                    <div class="col-6 campo-por-hora">
                                        <label class="form-label small mb-0">Viático por clase</label>
                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                               name="valores[{{ curso.id }}][viatico]"
                                               placeholder="{{ profesor.viatico ?: 'del profesor' }}"
                                               value="{{ regla and regla.viatico is not null ? regla.viatico : '' }}">
                                    </div>
                                    <div class="col-6 campo-porcentaje">
                                        <label class="form-label small mb-0">Porcentaje</label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" step="0.01" min="0" max="100" class="form-control"
                                                   name="valores[{{ curso.id }}][porcentaje]"
                                                   value="{{ regla and regla.porcentaje is not null ? regla.porcentaje : '' }}">
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-6 campo-fijo">
                                        <label class="form-label small mb-0">Monto fijo del curso</label>
                                        <input type="number" step="0.01" min="0" class="form-control form-control-sm"
                                               name="valores[{{ curso.id }}][monto_fijo]"
                                               value="{{ regla and regla.montoFijo is not null ? regla.montoFijo : '' }}">
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('app_profesor_pago_liquidacion') }}" class="btn btn-secondary">← Volver</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar reglas
                </button>
            </div>
        </div>

        <p class="small text-muted mt-2">
            Un valor vacío en <em>valor hora</em> o <em>viático</em> usa el de la ficha del
            profesor. Cero significa que en ese curso no se paga ese concepto.
        </p>
    </form>

    <script>
    // Muestra de cada fila solo los campos que su modalidad necesita, y deshabilita la fila
    // completa cuando la regla no está prendida.
    (function () {
        function aplicar(cursoId) {
            const fila = document.querySelector('.campos-curso[data-curso="' + cursoId + '"]');
            const select = document.querySelector('.modalidad-select[data-curso="' + cursoId + '"]');
            const activa = document.querySelector('.regla-switch[data-curso="' + cursoId + '"]');
            if (!fila || !select || !activa) {
                return;
            }

            const modalidad = select.value;
            const visibles = {
                por_hora: '.campo-por-hora',
                porcentaje: '.campo-porcentaje',
                fijo_mensual: '.campo-fijo'
            }[modalidad];

            fila.querySelectorAll('.campo-por-hora, .campo-porcentaje, .campo-fijo').forEach(function (campo) {
                campo.style.display = campo.matches(visibles) ? '' : 'none';
            });

            select.disabled = !activa.checked;
            fila.querySelectorAll('input').forEach(function (input) {
                input.disabled = !activa.checked;
            });
            fila.style.opacity = activa.checked ? '1' : '0.5';
        }

        document.querySelectorAll('.regla-switch').forEach(function (sw) {
            sw.addEventListener('change', function () { aplicar(sw.dataset.curso); });
            aplicar(sw.dataset.curso);
        });

        document.querySelectorAll('.modalidad-select').forEach(function (select) {
            select.addEventListener('change', function () { aplicar(select.dataset.curso); });
        });
    })();
    </script>
    {% endif %}
</div>
{% endblock %}
