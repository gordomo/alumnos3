{% extends 'base.html.twig' %}

{% block title %}Registrar Pago a Profesor{% endblock %}

{% block panelTitle %}
    Registrar Pago a Profesor
{% endblock %}

{% block body %}
<div class="container-fluid px-4 mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-cash-coin"></i> Registrar Pago</h5>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h6>Profesor</h6>
                        <p class="mb-1"><strong>{{ profesor.apellido }}, {{ profesor.nombre }}</strong></p>
                        <p class="mb-0 text-muted">{{ profesor.email }}</p>
                    </div>

                    <div class="mb-4">
                        <h6>Período</h6>
                        {% set nombresMeses = {
                            1: 'Enero', 2: 'Febrero', 3: 'Marzo', 4: 'Abril',
                            5: 'Mayo', 6: 'Junio', 7: 'Julio', 8: 'Agosto',
                            9: 'Septiembre', 10: 'Octubre', 11: 'Noviembre', 12: 'Diciembre'
                        } %}
                        <p class="mb-0"><strong>{{ nombresMeses[mes] }} {{ ano }}</strong></p>
                    </div>

                    <form method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('profesor_pago_registrar' ~ profesor.id) }}">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Monto <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" class="form-control" name="monto" 
                                       value="{{ liquidacion.saldo_pendiente|number_format(2, '.', '') }}" required>
                                <small class="text-muted">Monto sugerido: ${{ liquidacion.saldo_pendiente|number_format(2, ',', '.') }}</small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fecha de Pago <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" name="fecha_pago" 
                                       value="{{ fecha_actual_instituto }}" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Método de Pago <span class="text-danger">*</span></label>
                            <select name="metodo_pago" class="form-select" required>
                                <option value="">Seleccione...</option>
                                {% for metodo in metodos_pago %}
                                <option value="{{ metodo.nombre }}">{{ metodo.nombre }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Observación</label>
                            <textarea class="form-control" name="observacion" rows="3"></textarea>
                        </div>

                        <div class="mb-3 p-3 border rounded bg-light">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="1"
                                       name="salda_total" id="salda_total">
                                <label class="form-check-label fw-semibold" for="salda_total">
                                    Con este pago la liquidación del mes queda saldada
                                </label>
                            </div>
                            <small class="text-muted d-block mt-1">
                                Marcalo si acordaste pagar menos de lo calculado y la deuda se da por
                                cerrada. El mes deja de mostrar saldo pendiente y la diferencia queda
                                registrada. Si vas a pagar el total, dejalo sin marcar.
                            </small>
                            <div class="mt-2 small" id="aviso_diferencia" style="display: none;">
                                <span class="badge bg-warning text-dark">
                                    Se van a dejar de pagar $<span id="monto_diferencia">0,00</span>
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_profesor_pago_liquidacion', {'mes': mes, 'ano': ano}) }}" 
                               class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                            <button type="submit" class="btn btn-success" onclick="showLoading()">
                                <i class="bi bi-save"></i> Registrar Pago
                            </button>
                        </div>
                    </form>

                    <script>
                    // Avisa cuánto se deja de pagar cuando se marca que el pago salda el total.
                    (function () {
                        const pendiente = {{ liquidacion.saldo_pendiente|number_format(2, '.', '') }};
                        const monto = document.querySelector('input[name="monto"]');
                        const salda = document.getElementById('salda_total');
                        const aviso = document.getElementById('aviso_diferencia');
                        const texto = document.getElementById('monto_diferencia');

                        function actualizar() {
                            const diferencia = pendiente - parseFloat(monto.value || '0');
                            const mostrar = salda.checked && diferencia > 0.009;
                            aviso.style.display = mostrar ? '' : 'none';
                            if (mostrar) {
                                texto.textContent = diferencia.toLocaleString('es-AR', {
                                    minimumFractionDigits: 2, maximumFractionDigits: 2
                                });
                            }
                        }

                        monto.addEventListener('input', actualizar);
                        salda.addEventListener('change', actualizar);
                        actualizar();
                    })();
                    </script>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-calculator"></i> Detalle de Liquidación</h6>
                </div>
                <div class="card-body">
                    {% set detalle = liquidacion.detalle_calculo %}
                    
                    {{ include('profesor_pago/_detalle_calculo.html.twig', {'detalle': detalle, 'compacto': true}) }}

                    <hr>
                    <div class="bg-light p-3 rounded">
                        <p class="mb-1"><strong>Total Calculado:</strong></p>
                        <h4 class="mb-0 text-primary">${{ liquidacion.monto_calculado|number_format(2, ',', '.') }}</h4>
                    </div>

                    {% if liquidacion.total_pagado > 0 %}
                        <div class="mt-3 p-3 bg-success bg-opacity-10 rounded">
                            <p class="mb-1"><strong>Ya Pagado:</strong></p>
                            <h5 class="mb-0 text-success">${{ liquidacion.total_pagado|number_format(2, ',', '.') }}</h5>
                        </div>
                    {% endif %}

                    {% if liquidacion.saldado|default(false) %}
                        <div class="mt-3 p-3 bg-success bg-opacity-10 rounded">
                            <p class="mb-1"><strong>Saldo Pendiente:</strong></p>
                            <h4 class="mb-1 text-success">$0,00</h4>
                            <span class="badge bg-success">Saldado por el instituto</span>
                            {% if liquidacion.diferencia|default(0) > 0 %}
                                <div class="small text-muted mt-1">
                                    Se dejaron de pagar ${{ liquidacion.diferencia|number_format(2, ',', '.') }}
                                    respecto del cálculo.
                                </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <div class="mt-3 p-3 bg-danger bg-opacity-10 rounded">
                            <p class="mb-1"><strong>Saldo Pendiente:</strong></p>
                            <h4 class="mb-0 text-danger">${{ liquidacion.saldo_pendiente|number_format(2, ',', '.') }}</h4>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
