{% extends 'base.html.twig' %}

{% block title %}Ayuda{% endblock %}

{# El título va en la barra de arriba, igual que el resto de los módulos. Tenerlo acá adentro
   hacía que Ayuda se viera distinta a todas las demás pantallas al entrar. #}
{% block panelTitle %}Ayuda{% endblock %}

{% block body %}
<div class="container-fluid pagina ayuda-pagina">
    <div class="mb-4">
        <p class="text-muted mb-0">
            <strong class="ayuda-intro-titulo">Cómo funciona cada parte del sistema</strong>, con el paso a paso y capturas de las
            pantallas reales. Solo se muestran los temas de las secciones a las que tenés acceso.
        </p>
    </div>

    {{ include('ayuda/_chat.html.twig') }}

    {% if temas is not empty %}
        <form id="ayuda-busqueda-form" data-no-loading data-resultados-url="{{ path('app_ayuda_resultados') }}" method="get" action="{{ path('app_ayuda_index') }}" class="mb-4" role="search" aria-label="Buscar en la ayuda">
            <label for="ayuda-consulta" class="form-label">¿Con qué necesitás ayuda?</label>
            <div class="input-group">
                <input type="search" id="ayuda-consulta" name="q" class="form-control" maxlength="300"
                       value="{{ consulta }}" placeholder="Por ejemplo: cómo registrar un pago">
                <button class="btn btn-primary" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Buscar</button>
            </div>
            <p id="ayuda-busqueda-estado" class="small text-muted mt-2 mb-0" role="status"></p>
        </form>
    {% endif %}

    <div id="ayuda-resultados-contenido" aria-live="polite" aria-atomic="true">
        {{ include('ayuda/_resultados.html.twig') }}
    </div>

    {% if temas is empty %}
        <div class="alert alert-info mb-0">
            Todavía no hay temas de ayuda disponibles para tu tipo de usuario.
        </div>
    {% else %}
        <div class="row">
            {% for slug, tema in temas %}
                <div class="col-md-6 col-lg-4 mb-3">
                    <a href="{{ path('app_ayuda_tema', {'tema': slug}) }}"
                       class="card h-100 text-decoration-none ayuda-card">
                        <div class="card-body">
                            <h5 class="card-title mb-2">
                                <i class="bi {{ tema.icono }} text-primary"></i> {{ tema.titulo }}
                            </h5>
                            <p class="card-text text-muted small mb-0">{{ tema.resumen }}</p>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .ayuda-pagina .ayuda-card .card-title,
        .ayuda-pagina #ayuda-chat-titulo,
        .ayuda-pagina #ayuda-resultados,
        .ayuda-pagina #ayuda-resultados-contenido h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--ui-texto);
        }
        .ayuda-pagina .form-label,
        .ayuda-pagina .ayuda-intro-titulo {
            font-size: 1.25rem;
            font-weight: 650;
            color: var(--ui-texto);
        }
        .ayuda-card { transition: box-shadow .15s ease, transform .15s ease; }
        .ayuda-card:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.1); transform: translateY(-2px); }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/ayuda-busqueda.js') }}" defer></script>
    <script src="{{ asset('assets/js/ayuda-chat.js') }}" defer></script>
{% endblock %}
