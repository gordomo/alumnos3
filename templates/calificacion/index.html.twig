{% extends 'base.html.twig' %}

{% block title %}Calificaciones{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-mortarboard"></i> Calificaciones</h4>
        </div>
        <div class="card-body">
            {% if cursos is empty %}
                <p class="text-muted mb-0">No hay cursos disponibles para calificar.</p>
            {% else %}
                <p class="text-muted">Elegí un curso para ver sus evaluaciones y cargar notas.</p>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Curso</th>
                                <th>Período</th>
                                <th class="text-center">Evaluaciones</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for curso in cursos %}
                                <tr>
                                    <td><strong>{{ curso.nombre }}</strong></td>
                                    <td class="small text-muted">
                                        {{ curso.fechaInicio ? curso.fechaInicio|date(date_format) : '-' }}
                                        —
                                        {{ curso.fechaFin ? curso.fechaFin|date(date_format) : '-' }}
                                    </td>
                                    <td class="text-center">
                                        {% set cantidad = evaluacionesPorCurso[curso.id]|default(0) %}
                                        {% if cantidad > 0 %}
                                            <span class="badge bg-primary">{{ cantidad }}</span>
                                        {% else %}
                                            <span class="text-muted">sin evaluaciones</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        {% if curso.cerrado %}
                                            <span class="badge bg-secondary">Cerrado</span>
                                        {% else %}
                                            <span class="badge bg-success">Activo</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path(rutas.curso, {'id': curso.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-list-check"></i> Ver notas
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
