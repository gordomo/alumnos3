{% extends 'base.html.twig' %}

{% block title %}Calificaciones{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-mortarboard"></i> Calificaciones</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-0">
                <h5 class="alert-heading"><i class="bi bi-info-circle"></i> El instituto todavía no usa calificaciones</h5>
                <p class="mb-2">
                    Para empezar a cargar notas hay que elegir una escala de calificación:
                    numérica, conceptual o ambas.
                </p>
                {% if puedeConfigurar %}
                    <hr>
                    <a href="{{ path('instituto_config_index', {'tab': 'general'}) }}" class="btn btn-primary">
                        <i class="bi bi-gear"></i> Ir a Configuración Académica
                    </a>
                {% else %}
                    <hr>
                    <p class="mb-0 small">
                        Pedile al administrador del instituto que configure la escala en
                        <strong>Configuración del Instituto → Configuración Académica</strong>.
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
