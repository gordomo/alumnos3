{% extends 'base.html.twig' %}

{% block title %}Configuración de Vencimientos{% endblock %}

{% block panelTitle %}Configuración de Vencimientos{% endblock %}

{% block body %}
    <div class="container-fluid pagina">
        <div class="pagina-acciones">
        <a href="{{ path('vencimiento_new') }}" class="pagina-boton-flotante">
            <i class="bi bi-plus-circle"></i> Nuevo Vencimiento
        </a>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success">
                                {{ message }}
                            </div>
                        {% endfor %}

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Día de Vencimiento</th>
                                        <th>Porcentaje de Interés</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for vencimiento in vencimientos %}
                                        <tr>
                                            <td>{{ vencimiento.diaVencimiento }}</td>
                                            <td>{{ vencimiento.porcentajeInteres }}%</td>
                                            <td>
                                                {{ include('components/action_buttons.html.twig', {
                                                    'edit_url': path('vencimiento_edit', {'id': vencimiento.id}),
                                                    'delete_url': path('vencimiento_delete', {'id': vencimiento.id}),
                                                    'delete_confirm': '¿Está seguro que desea eliminar este vencimiento?',
                                                    'delete_token': csrf_token('delete' ~ vencimiento.id),
                                                    'delete_label': 'Eliminar'
                                                }) }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center">No se encontraron vencimientos configurados</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 