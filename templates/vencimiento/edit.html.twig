{% extends 'base.html.twig' %}

{% block title %}Editar Vencimiento{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Editar Vencimiento</h3>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group">
                                <label for="diaVencimiento">Día de Vencimiento (1-31)</label>
                                <input type="number" class="form-control" id="diaVencimiento" name="diaVencimiento" min="1" max="31" value="{{ vencimiento.diaVencimiento }}" required>
                            </div>
                            <div class="form-group">
                                <label for="porcentajeInteres">Porcentaje de Interés (0-100)</label>
                                <input type="number" class="form-control" id="porcentajeInteres" name="porcentajeInteres" min="0" max="100" step="0.01" value="{{ vencimiento.porcentajeInteres }}" required>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">Guardar</button>
                                <a href="{{ path('vencimiento_index') }}" class="btn btn-secondary">Volver</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %} 