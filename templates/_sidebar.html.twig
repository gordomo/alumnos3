<!-- Sidebar -->
<div class="d-flex" id="wrapper" style="border-right: 1px solid #000;">
    <div class="border-right" id="sidebar-wrapper" >
        {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMIN_INSTITUTO') or is_granted('ROLE_PROFESOR') or is_granted('ROLE_SUPER_ADMIN') or is_granted('ROLE_ALUMNO') %}
            <div class="sidebar-heading ps-4">
                {% if app.user.instituto %}
                    {{ app.user.instituto.nombre }}
                {% else %}
                    Super Admin
                {% endif %}
            </div>
            <div class="sidebar-headings small text-muted ps-4">{{ app.user.email }}</div>
            <hr class="my-0">
        {% endif %}
        
        <div class="list-group list-group-flush">
        {% if is_granted('ROLE_ALUMNO') %}
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_alumno_dashboard' %}active{% endif %}" href="{{ path('app_alumno_dashboard') }}">
                        <i class="bi bi-house"></i> Mi Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_alumno_notas' %}active{% endif %}" href="{{ path('app_alumno_notas') }}">
                        <i class="bi bi-mortarboard"></i> Mis Notas
                    </a>
                </li>
            </ul>
        {% endif %}

        {% if is_granted('ROLE_PROFESOR') %} 
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_profesor_dashboard' %}active{% endif %}" href="{{ path('app_profesor_dashboard') }}">
                        <i class="bi bi-bar-chart"></i> Mis Cursos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_asistencia_alumnos_index' %}active{% endif %}" href="{{ path('app_asistencia_alumnos_index') }}">
                        <i class="bi bi-clipboard-check"></i> Asistencias de Alumnos
                    </a>
                </li>
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'app_profesor_calificaciones' %}active{% endif %}" href="{{ path('app_profesor_calificaciones_index') }}">
                        <i class="bi bi-mortarboard"></i> Calificaciones
                    </a>
                </li>
            </ul>
        {% endif %}

        {% if  is_granted('ROLE_ADMIN_INSTITUTO')%}
            {# <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_instituto_index' %}active{% endif %}" href="{{ path('app_instituto_index') }}">
                        <i class="bi bi-building"></i> Instituto
                    </a>
                </li>
            </ul> #}

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'dashboard_index' %}active{% endif %}" href="{{ path('dashboard_index') }}">
                        <i class="bi bi-house"></i> Dashboard
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item dropdown dropend">
                    <a class="list-group-item list-group-item-action bg-light dropdown-toggle {% if app.request.get('_route') starts with 'app_curso_' %}active{% endif %}" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                        <i class="bi bi-book"></i> Cursos
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_curso_index' %}active{% endif %}" href="{{ path('app_curso_index') }}">Listado</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_curso_calendario' %}active{% endif %}" href="{{ path('app_curso_calendario') }}">Calendario</a></li>
                    </ul>
                </li>
            </ul>


            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item dropdown dropend">
                    <a class="list-group-item list-group-item-action bg-light dropdown-toggle {% if app.request.get('_route') starts with 'app_profesor_' or app.request.get('_route') in ['asistencias', 'informes'] %}active{% endif %}" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                        <i class="bi bi-briefcase"></i> Profesores
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_profesor_index' %}active{% endif %}" href="{{ path('app_profesor_index') }}">Listado</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'asistencias' %}active{% endif %}" href="{{ path('asistencias') }}">Asistencias</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'informes' %}active{% endif %}" href="{{ path('informes') }}">Informes</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_profesor_pago_liquidacion' %}active{% endif %}" href="{{ path('app_profesor_pago_liquidacion') }}">Liquidación</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_profesor_pago_index' %}active{% endif %}" href="{{ path('app_profesor_pago_index') }}">Historial de Pagos</a></li>
                    </ul>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item dropdown dropend">
                    <a class="list-group-item list-group-item-action bg-light dropdown-toggle {% if app.request.get('_route') == 'app_alumno_index' or app.request.get('_route') == 'app_instituto_asistencias_index' or app.request.get('_route') starts with 'app_evaluacion' %}active{% endif %}" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                        <i class="bi bi-mortarboard"></i> Alumnos
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_alumno_index' %}active{% endif %}" href="{{ path('app_alumno_index') }}">Listado</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_instituto_asistencias_index' %}active{% endif %}" href="{{ path('app_instituto_asistencias_index') }}">Asistencias</a></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') == 'app_instituto_asistencias_informe' %}active{% endif %}" href="{{ path('app_instituto_asistencias_informe') }}">Informes de Asistencia</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item {% if app.request.get('_route') starts with 'app_evaluacion' %}active{% endif %}" href="{{ path('app_evaluacion_index') }}">Calificaciones</a></li>
                    </ul>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'app_alumnos_pagos_index' %}active{% endif %}" href="{{ path('app_alumnos_pagos_index') }}">
                        <i class="bi bi-cash"></i> Pagos
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'billing_invoice_' %}active{% endif %}" href="{{ path('billing_invoice_index') }}">
                        <i class="bi bi-receipt"></i> Facturas
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'instituto_user_' %}active{% endif %}" href="{{ path('instituto_user_index') }}">
                        <i class="bi bi-people"></i> Usuarios
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'instituto_config_index' %}active{% endif %}" href="{{ path('instituto_config_index') }}">
                        <i class="bi bi-gear"></i> Configuración
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'app_email_log_' %}active{% endif %}" href="{{ path('app_email_log_index') }}">
                        <i class="bi bi-envelope-check"></i> Historial de Emails
                    </a>
                </li>
            </ul>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPER_ADMIN') %}
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') == 'admin_instituto_index' %}active{% endif %}" href="{{ path('admin_instituto_index') }}">
                        <i class="bi bi-building"></i> Institutos
                    </a>
                </li>
            </ul>
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'admin_billing_invoice_' %}active{% endif %}" href="{{ path('admin_billing_invoice_index') }}">
                        <i class="bi bi-receipt-cutoff"></i> Gestión de Facturas
                    </a>
                </li>
            </ul>
        {% endif %}

        {% if is_granted('ROLE_SUPER_ADMIN') %}
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'admin_user_' %}active{% endif %}" href="{{ path('admin_user_index') }}">
                        <i class="bi bi-people"></i> Usuarios Administradores
                    </a>
                </li>
            </ul>
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'admin_billing_config_' %}active{% endif %}" href="{{ path('admin_billing_config_index') }}">
                        <i class="bi bi-cash-stack"></i> Configuración de Facturación
                    </a>
                </li>
            </ul>
        {% endif %}

            {# Manual de uso. El propio controller filtra los temas por rol, así que este
               enlace vale para cualquier usuario logueado. #}
            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <a class="list-group-item list-group-item-action bg-light {% if app.request.get('_route') starts with 'app_ayuda_' %}active{% endif %}" href="{{ path('app_ayuda_index') }}">
                        <i class="bi bi-life-preserver"></i> Ayuda
                    </a>
                </li>
            </ul>

            <ul class="nav nav-tabs sidebar-dropdown-ul">
                <li class="nav-item">
                    <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="list-group-item list-group-item-action bg-light border-0 w-100 text-start">
                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
    <button class="btn btn-light border-1" id="menu-toggle">
        <i class="bi bi-arrow-left" id="arrow-icon"></i>
    </button>
</div>

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var menuToggle = document.getElementById('menu-toggle');
            var wrapper = document.getElementById('wrapper');
            var arrowIcon = document.getElementById('arrow-icon');
            
            if (menuToggle != undefined) {
                menuToggle.addEventListener('click', function () {
                    wrapper.classList.toggle('toggled');
                });
            }
        });
    </script>
{% endblock %}
<!-- /#sidebar-wrapper -->
