<!-- Sidebar -->
<div class="bg-light border-right" id="sidebar-wrapper">
    {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMIN_INSTITUTO') %}
        <div class="sidebar-heading">{{ app.user.email }} </div>
    {% endif %}
    
    
    <div class="list-group list-group-flush">
    {% if is_granted('ROLE_USER') or is_granted('ROLE_ADMIN') %}    
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('dashboard_index') }}">
            <i class="bi bi-bar-chart"></i> Dashboard
        </a>
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('app_curso_index') }}">
            <i class="bi bi-book"></i> Cursos
        </a>
        <ul class="nav nav-tabs sidebar-dropdown-ul ">
            <li class="nav-item dropdown dropend ">
                <a class="list-group-item list-group-item-action bg-light dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
                    <i class="bi bi-briefcase"></i> Profesores
                </a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="{{ path('app_profesor_index') }}">Listado</a></li>
                    <li><a class="dropdown-item" href="{{ path('asistencias') }}">Asistencias</a></li>
                    <li><a class="dropdown-item" href="{{ path('informes') }}">Informes</a></li>
                </ul>
            </li>
        </ul>
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('app_alumno_index') }}">
            <i class="bi bi-people"></i> Alumnos
        </a>

        <a class="list-group-item list-group-item-action bg-light " href="{{ path('dashboard_index', {'action': 'pagos'}) }}">
            <i class="bi bi-currency-dollar"></i> Pagos
        </a>
        
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('app_user_index') }}">
            <i class="bi bi-person-lines-fill"></i> Usuarios
        </a>
    {% endif %}
    {% if is_granted('ROLE_ADMIN_INSTITUTO') %}
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('admin_instituto_index') }}">
            <i class="bi bi-book"></i> Institutos
        </a>
    {% endif %}
        <a class="list-group-item list-group-item-action bg-light " href="{{ path('dashboard_index', {'action': 'pagos'}) }}">
            <i class="bi bi-gear"></i> Configuración
        </a>

        <a class="list-group-item list-group-item-action bg-light " href="{{ path('app_logout') }}">
            <i class="bi bi-arrow-bar-left"></i> Salir
        </a>
    </div>
    <button class="mt-2 border-1 w-100" id="menu-toggle">
        <i class="bi bi-arrow-left" id="arrow-icon"></i>
    </button>
</div>

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var menuToggle = document.getElementById('menu-toggle');
            var wrapper = document.getElementById('wrapper');
            if (menuToggle != undefined) {
                menuToggle.addEventListener('click', function () {
                    wrapper.classList.toggle('toggled');
                    var toggle = document.getElementById('menu-toggle');
                    var arrowIcon = document.getElementById('arrow-icon');
                    if ( toggle.style.position != 'absolute' ) {
                            toggle.style.position = 'absolute';
                            toggle.style.left = '0px';
                            toggle.classList.remove('w-100');
                            arrowIcon.classList.add('bi-arrow-right');
                            arrowIcon.classList.remove('bi-arrow-left');   
                    } else {
                        toggle.style.position = '';
                        toggle.style.left = '';
                        toggle.classList.add('w-100');
                        arrowIcon.classList.remove('bi-arrow-right');
                        arrowIcon.classList.add('bi-arrow-left');
                        
                    }
                });
            }
        });
    </script>
{% endblock %}
<!-- /#sidebar-wrapper -->
