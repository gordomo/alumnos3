{% extends 'base.html.twig' %}

{% block title %}Agenda{% endblock %}

{% block panelTitle %}Agenda{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="{{ asset('assets/css/calendario.css') }}?v=20261110-agenda">
    <link rel="stylesheet" href="{{ asset('assets/css/agenda.css') }}?v=20261110">

{% endblock %}

{% block body %}
<div class="container-fluid pagina agenda-page">
    <section class="agenda-toolbar" aria-label="Filtros y acciones de la agenda">
        <fieldset class="agenda-filtros">
            <legend>Mostrar en la agenda</legend>
            <div class="agenda-fuentes">
                {% for clave in fuentes %}
                    {% set fuente = catalogoFuentes[clave] %}
                    <label class="agenda-fuente" for="fuente_{{ clave }}">
                        <input class="form-check-input filtro-fuente" type="checkbox" value="{{ clave }}"
                               id="fuente_{{ clave }}" {% if clave in fuentesPorDefecto %}checked{% endif %}>
                        <span class="agenda-color" style="background: {{ fuente.color }}" aria-hidden="true"></span>
                        <span>{{ fuente.etiqueta }}</span>
                    </label>
                {% endfor %}
            </div>
        </fieldset>
        {% if puedeCargarEventos %}
            <div class="agenda-acciones">
                <a href="{{ path('app_agenda_eventos_listado') }}" class="btn btn-outline-secondary"><i class="bi bi-list-ul" aria-hidden="true"></i> Eventos cargados</a>
                <a href="{{ path('app_agenda_evento_nuevo', {'volver': 'agenda'}) }}" class="btn btn-primary"><i class="bi bi-plus-circle" aria-hidden="true"></i> Nuevo evento</a>
            </div>
        {% endif %}
    </section>
    <p id="agenda-sin-fuentes" class="agenda-aviso" role="status" hidden>Seleccioná al menos una categoría para mostrar eventos.</p>
    {% if puedeCargarEventos %}
        <details class="agenda-ayuda">
            <summary><i class="bi bi-info-circle" aria-hidden="true"></i> Cómo usar la agenda</summary>
            <p>Hacé clic en un día o arrastrá sobre varios para crear un evento. Los eventos propios se pueden mover arrastrándolos.
                Los horarios se administran en <a href="{{ path('app_curso_calendario') }}">{{ Term('cursos') }} → Calendario</a>.
                Activá la categoría <strong>{{ catalogoFuentes['clase'].etiqueta|default('Clases') }}</strong> para verlos también acá.</p>
        </details>
    {% endif %}

    <div id="calendario" class="calendario-panel"></div>
</div>

<div class="modal fade" id="modalEvento" tabindex="-1" aria-labelledby="modalEventoTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEventoTitulo">Evento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><strong>Cuándo:</strong> <span id="modalEventoCuando">-</span></p>
                <p class="mb-1"><strong>Qué es:</strong> <span id="modalEventoFuente">-</span></p>
                <p class="mb-1" id="modalEventoCursoFila"><strong>{{ Term('curso') }}:</strong> <span id="modalEventoCurso">-</span></p>
                <p class="mb-0" id="modalEventoDetalleFila"><span id="modalEventoDetalle"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/es.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const etiquetas = {{ catalogoFuentes|json_encode|raw }};
        const urlEventos = '{{ path(rutas.eventos) }}';
        const modal = new bootstrap.Modal(document.getElementById('modalEvento'));

        // 900px es donde siete nombres de día completos todavía entran sin cortarse.
        function anchoComodo() {
            return window.innerWidth >= 900;
        }

        function formatoDelDia() {
            return anchoComodo() ? { weekday: 'long' } : { weekday: 'short' };
        }

        function fuentesElegidas() {
            return Array.from(document.querySelectorAll('.filtro-fuente:checked')).map(c => c.value);
        }

        const calendario = new FullCalendar.Calendar(document.getElementById('calendario'), {
            locale: 'es',
            initialView: 'dayGridMonth',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: 'dayGridMonth,timeGridWeek,listMonth'
            },
            buttonText: { today: 'Hoy', month: 'Mes', week: 'Semana', list: 'Lista' },

            // Nombre del día completo si la pantalla da, abreviado si no.
            dayHeaderFormat: formatoDelDia(),
            // El alto se calcula a mano en ajustarAlto(): aspectRatio no alcanza porque las
            // filas del mes cambian de 5 a 6 según el mes.
            height: 'auto',
            // Sin esto la vista de mes muestra "8" en lugar de "08:00".
            eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
            // Un día con muchas clases se colapsa en "+N más" en lugar de estirar la fila.
            // Sin la sexta semana vacía cuando el mes no la necesita.
            fixedWeekCount: false,
            dayMaxEvents: 4,
            moreLinkText: function (cantidad) { return '+' + cantidad + ' más'; },
            allDaySlot: true,
            nowIndicator: true,

            {% if puedeCargarEventos %}
            // Agendar con un clic en el día, en lugar de ir a buscar el formulario. El rango que
            // se selecciona arrastrando viaja como fecha de inicio y fin.
            selectable: true,
            select: function (info) {
                const desde = info.startStr.slice(0, 10);
                // En FullCalendar el fin de una selección de días completos es exclusivo: el
                // último día seleccionado es el anterior.
                const fin = new Date(info.end.getTime() - 86400000);
                const hasta = fin.toISOString().slice(0, 10);

                let url = '{{ path('app_agenda_evento_nuevo', {'volver': 'agenda'}) }}&fecha=' + desde;
                if (hasta > desde) {
                    url += '&fechaFin=' + hasta;
                }

                window.location.href = url;
            },

            // Solo los eventos propios traen editable: true desde el servidor, así que las
            // clases, los exámenes y los vencimientos no se pueden arrastrar.
            editable: true,
            eventStartEditable: true,
            eventDurationEditable: true,

            eventDrop: function (info) { moverEvento(info); },
            eventResize: function (info) { moverEvento(info); },
            {% endif %}
            // Se le piden al servidor solo los eventos del rango visible, con las fuentes
            // que estén tildadas: cambiar de mes no trae el año entero.
            events: function (info, exito, error) {
                const params = new URLSearchParams({
                    start: info.startStr,
                    end: info.endStr
                });
                const fuentes = fuentesElegidas();
                document.getElementById('agenda-sin-fuentes').hidden = fuentes.length > 0;
                if (fuentes.length === 0) {
                    exito([]);
                    return;
                }
                fuentes.forEach(f => params.append('fuentes[]', f));

                fetch(urlEventos + '?' + params.toString(), { headers: { 'Accept': 'application/json' } })
                    .then(r => r.ok ? r.json() : Promise.reject(r.status))
                    .then(exito)
                    .catch(error);
            },
            datesSet: function () { ajustarAlto(); },

            eventClick: function (info) {
                if (typeof hideLoading === 'function') { hideLoading(); }
                info.jsEvent.preventDefault();

                const props = info.event.extendedProps || {};
                const fuente = etiquetas[props.fuente];

                document.getElementById('modalEventoTitulo').textContent = info.event.title;
                document.getElementById('modalEventoCuando').textContent = info.event.start
                    ? info.event.start.toLocaleString('es-AR', {
                        weekday: 'long', day: 'numeric', month: 'long',
                        hour: info.event.allDay ? undefined : '2-digit',
                        minute: info.event.allDay ? undefined : '2-digit'
                      })
                    : '-';
                document.getElementById('modalEventoFuente').textContent = props.tipo || (fuente ? fuente.etiqueta : '-');

                const filaCurso = document.getElementById('modalEventoCursoFila');
                if (props.curso) {
                    document.getElementById('modalEventoCurso').textContent = props.curso;
                    filaCurso.style.display = '';
                } else {
                    filaCurso.style.display = 'none';
                }

                const filaDetalle = document.getElementById('modalEventoDetalleFila');
                if (props.detalle) {
                    document.getElementById('modalEventoDetalle').textContent = props.detalle;
                    filaDetalle.style.display = '';
                } else {
                    filaDetalle.style.display = 'none';
                }

                modal.show();
            }
        });

        {% if puedeCargarEventos %}
        // Guarda la fecha nueva de un evento arrastrado. Si el servidor no lo acepta, el evento
        // vuelve a donde estaba en lugar de quedar mostrando algo que no se guardó.
        function moverEvento(info) {
            const id = info.event.extendedProps.eventoId;
            if (!id) {
                info.revert();
                return;
            }

            const datos = new URLSearchParams({
                _token: '{{ csrf_token('mover_evento') }}',
                inicio: info.event.start.toISOString(),
                todo_el_dia: info.event.allDay ? '1' : '0'
            });

            if (info.event.end) {
                datos.append('fin', info.event.end.toISOString());
            }

            // El id va como marca en la ruta generada y se reemplaza acá: el path termina en
            // /mover, así que no alcanza con pegarle el número al final.
            const url = '{{ path('app_agenda_evento_mover', {'id': '__ID__'}) }}'.replace('__ID__', id);

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
                body: datos.toString()
            })
                .then(r => r.ok ? r.json() : Promise.reject(r.status))
                .then(function (respuesta) {
                    if (!respuesta.ok) {
                        info.revert();
                    }
                })
                .catch(function () { info.revert(); });
        }
        {% endif %}

        // El calendario se adapta al espacio disponible, sin forzar celdas cuadradas
        // que vuelvan interminable un mes en pantallas anchas.
        function ajustarAlto() {
            const tipo = calendario.view.type;
            if (tipo === 'listMonth' || (tipo === 'dayGridMonth' && !anchoComodo())) {
                calendario.setOption('height', 'auto');
                return;
            }
            const panel = document.getElementById('calendario');
            const disponible = window.innerHeight - Math.max(0, panel.getBoundingClientRect().top) - 24;
            const altura = Math.round(Math.max(520, Math.min(840, disponible)));
            if (calendario.getOption('height') !== altura) {
                calendario.setOption('height', altura);
            }
        }

        calendario.render();
        ajustarAlto();

        // Al cambiar el tamaño de la ventana se rehacen las tres opciones que dependen del ancho.
        window.addEventListener('resize', function () {
            calendario.setOption('dayHeaderFormat', formatoDelDia());
            ajustarAlto();
        });

        document.querySelectorAll('.filtro-fuente').forEach(function (check) {
            check.addEventListener('change', function () { calendario.refetchEvents(); });
        });
    });
    </script>
{% endblock %}
